# Cloudflare Pages / Netlify header config. Active once the site moves
# off GitHub Pages (GH Pages doesn't support custom headers). Until then
# this file is ignored by the GH Pages deploy.
#
# Goals:
# - Replace the meta-tag CSP with a real HTTP CSP that can enforce
#   frame-ancestors and use nonces.
# - Add HSTS, Strict-Referrer-Policy, X-Frame-Options.
# - Long-cache static assets with content hashes; never-cache HTML.

# connect-src below is GENERATED. Do not hand-edit it:
#   node scripts/sync-headers-csp.mjs --write-public
# It names the production API origin so this file is correct as committed,
# which is what matters for the only hosts that read it — Cloudflare Pages and
# Netlify run a plain `npm run build` and copy this file through, never seeing
# the GitHub Pages deploy workflow. It was previously left at 'self' on the
# theory that a committed origin would rot; the deploy rewrite that was
# supposed to compensate runs in a workflow those hosts do not use, so the
# result was a file that named no API origin on precisely the deploys where it
# is enforced. Rot is handled instead by scripts/deploy-guards.test.mjs, which
# fails when this file and the production origin disagree.
#
# A deploy whose PUBLIC_API_URL differs from production (a preview) still gets
# the right header: the workflow re-derives dist/_headers from that value.
#
# This policy and the meta CSP in src/layouts/BaseLayout.astro are two
# copies of one intent and must be kept in step. They had already drifted
# once: this file still allowed fonts.gstatic.com and fonts.googleapis.com
# after the typefaces were self-hosted, so adopting it would have LOOSENED
# the policy the site enforces today, silently, because fonts would still
# have worked.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' mailto:; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.lumecon.ai; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin

# Hashed static assets — cache hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons + manifest can cache a long time but not immutable.
/favicon.ico
  Cache-Control: public, max-age=2592000

/site.webmanifest
  Cache-Control: public, max-age=604800

# HTML must revalidate so deploys are visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
