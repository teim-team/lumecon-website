{
  "name": "lumecon",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/check-public-origins.mjs --skip-if-unset",
    "build": "astro check && astro build",
    "postbuild": "node scripts/sync-headers-csp.mjs dist --skip-if-unset",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write 'src/**/*.{astro,ts,css,json}'",
    "format:check": "prettier --check 'src/**/*.{astro,ts,css,json}'",
    "test:smoke": "playwright test",
    "naics:duotone": "node scripts/naics/duotone.mjs scripts/naics/sources",
    "naics:export-app": "node scripts/naics/export-app.mjs",
    "team:headshots": "node scripts/team/headshots.mjs",
    "shots:examples": "node scripts/screenshots/capture-examples.mjs",
    "shots:commons": "node scripts/screenshots/capture-commons.mjs .shots-commons && CAPTURE_VARIANT=consultant node scripts/screenshots/capture-commons.mjs .shots-commons && node scripts/screenshots/optimize-commons.mjs .shots-commons",
    "docs:copy": "node --experimental-strip-types scripts/docs/export-copy.mjs",
    "docs:plan": "node scripts/docs/export-plan.mjs",
    "llms:roster": "node scripts/docs/llms-roster.mjs",
    "stress": "node --experimental-strip-types scripts/test/stress.mjs",
    "llms:pages": "node --experimental-strip-types scripts/docs/llms-pages.mjs",
    "docs:questions": "node scripts/docs/methodology-questions.mjs",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.3",
    "fuse.js": "7.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "~1.63",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3"
  }
}
