{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/pricing/index.html",
        "http://localhost/methodology/index.html",
        "http://localhost/cedar/index.html",
        "http://localhost/naics/index.html",
        "http://localhost/glossary/index.html",
        "http://localhost/login/index.html",
        "http://localhost/signup/index.html",
        "http://localhost/choose-plan/index.html",
        "http://localhost/checkout/index.html?tier=sprout",
        "http://localhost/welcome/index.html",
        "http://localhost/film/index.html",
        "http://localhost/ai-and-data-use/index.html",
        "http://localhost/accessibility/index.html",
        "http://localhost/privacy/index.html",
        "http://localhost/terms/index.html",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "uses-text-compression": "off",
        "csp-xss": "off",
        "is-on-https": "off",
        "uses-long-cache-ttl": "off",
        "unused-javascript": "off",
        "unused-css-rules": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
