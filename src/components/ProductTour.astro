---
/**
 * Product tour — alternating feature rows built from real
 * screenshots of the Lumecon workspace (sample study data), each
 * with a dark-mode capture of the app's own dark theme, plus a wide
 * region-map strip. The rows showcase screens the hero trio only
 * hints at: number lineage, comparison and the living workspace.
 */
import '../styles/tour.css';

const ROWS = [
  {
    id: 'trace',
    kicker: 'Defensible by design',
    title: 'Trace any number back to its layers',
    body: 'Every figure carries a Trace this number button. One click opens the lineage: direct, indirect and induced effects, the operations that generate them and the industries they land in, each with its share.',
    img: '/app/trace.webp',
    imgDark: '/app/trace-dark.webp',
    alt: 'Lumecon lineage panel titled Where $214,300,000 comes from, breaking economic output into direct, indirect and induced layers, by operation and by industry with share bars.',
  },
  {
    id: 'compare',
    kicker: 'Progress you can show',
    title: 'Compare studies across years and scenarios',
    body: 'Put two studies side by side and the change column does the arithmetic: jobs, GDP contribution, labor income, output and tax impacts, each with its percentage change. Renewal season starts from a table you already have.',
    img: '/app/compare.webp',
    imgDark: '/app/compare-dark.webp',
    alt: 'Lumecon compare view of two community college expansion studies, showing jobs, GDP contribution, labor income, economic output and tax impacts with green percentage-change values.',
  },
  {
    id: 'workspace',
    kicker: 'A living workspace',
    title: 'Studies stay live, from first draft to finished report',
    body: 'The workspace keeps every study in one place: drafts to continue, runs in progress and completed results ready to open, compare or export as a workbook, CSV tables or a printable summary.',
    img: '/app/dashboard.webp',
    imgDark: '/app/dashboard-dark.webp',
    alt: 'Lumecon workspace home with lanes for starting, in-progress and completed studies, including completed studies with jobs and output headlines.',
  },
];
---

<section class="tour" id="product" aria-labelledby="tour-title">
  <div class="tour-inner">
    <header class="tour-head">
      <p class="tour-kicker reveal-soft">Inside the product</p>
      <h2 class="tour-title reveal-soft" id="tour-title" data-stagger="1">
        The numbers each room respects, from software you run yourself.
      </h2>
      <p class="tour-lede reveal-soft" data-stagger="2">
        A lineage behind every number, comparisons that do the arithmetic and a workspace built
        for recurring work.
      </p>
    </header>

    <div class="tour-rows">
      {
        ROWS.map((row, i) => (
          <article class={`tour-row${i % 2 === 1 ? ' tour-row--flip' : ''}`} id={`tour-${row.id}`}>
            <div class={`tour-row__text ${i % 2 === 1 ? 'reveal-right' : 'reveal-left'}`}>
              <p class="tour-row__kicker">{row.kicker}</p>
              <h3 class="tour-row__title">{row.title}</h3>
              <p class="tour-row__body">{row.body}</p>
            </div>
            <figure class={`tour-row__shot ${i % 2 === 1 ? 'reveal-left' : 'reveal-right'}`}>
              <picture>
                <source srcset={row.imgDark} media="(prefers-color-scheme: dark)" />
                <img
                  src={row.img}
                  alt={row.alt}
                  width="1600"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </figure>
          </article>
        ))
      }
    </div>

    <figure class="tour-map reveal-soft">
      <picture>
        <source srcset="/app/map-card-dark.webp" media="(prefers-color-scheme: dark)" />
        <img
          src="/app/map-card.webp"
          alt="Lumecon region map of Connecticut with county boundaries, beside a panel reading Statewide, Connecticut: the statewide result."
          width="1600"
          height="458"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <figcaption>
        Geographies follow the real economy: counties, states, the nation, reservations and trust
        lands are all first-class regions.
      </figcaption>
    </figure>
  </div>
</section>
