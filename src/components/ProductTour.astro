---
/**
 * Product tour — Implan-pattern feature rows built from real
 * screenshots of the Lumecon workspace (captured from the app with
 * sample study data), plus a coverage band and a wide map strip.
 *
 * The section header intentionally has no marker highlight: the
 * page's three highlight colors are already spent on the hero
 * (green), platforms (gold) and why (teal), and the brand rule is
 * one highlight color per page, no repeats.
 */
import '../styles/tour.css';

const ROWS = [
  {
    id: 'scopes',
    kicker: 'One study, every lens',
    title: 'Statewide and homelands results, side by side',
    body: 'A whole-nation study reads as one sentence up top: jobs and output, in plain language. Switch scope to see the same study on homelands, with the subset relationship spelled out so nobody double-counts.',
    img: '/app/homelands.webp',
    w: 1600,
    h: 1000,
    alt: 'Lumecon results page on the Homelands scope tab, estimating 1,928 jobs and $496,200,000 in economic output on homelands, with four key figures below.',
  },
  {
    id: 'trace',
    kicker: 'Defensible by design',
    title: 'Trace any number back to its layers',
    body: 'Every figure carries a Trace this number button. One click opens the lineage: direct, indirect and induced effects, the operations that generate them and the industries they land in, each with its share.',
    img: '/app/trace.webp',
    w: 1600,
    h: 1000,
    alt: 'Lumecon lineage panel titled Where $1,240,500,000 comes from, breaking economic output into direct, indirect and induced layers, by operation and by industry with share bars.',
  },
  {
    id: 'compare',
    kicker: 'Progress you can show',
    title: 'Compare studies across years and scenarios',
    body: 'Put two studies side by side and the change column does the arithmetic: jobs, GDP contribution, labor income, output and tax impacts, each with its percentage change. Renewal season starts from a table you already have.',
    img: '/app/compare.webp',
    w: 1600,
    h: 1000,
    alt: 'Lumecon compare view of FY2024 against FY2025 studies, showing jobs, GDP contribution, labor income, economic output and tax impacts with green percentage-change values.',
  },
  {
    id: 'workspace',
    kicker: 'A living workspace',
    title: 'Studies stay live, from first draft to finished report',
    body: 'The workspace keeps every study in one place: drafts to continue, runs in progress and completed results ready to open, compare or export as a workbook, CSV tables or a printable summary.',
    img: '/app/dashboard.webp',
    w: 1600,
    h: 1000,
    alt: 'Lumecon workspace home with lanes for starting, in-progress and completed studies, including three completed nation economic footprint studies with jobs and output headlines.',
  },
];
---

<section class="tour" id="product" aria-labelledby="tour-title">
  <div class="tour-inner">
    <header class="tour-head">
      <p class="tour-kicker reveal-soft">Inside the product</p>
      <h2 class="tour-title reveal-soft" id="tour-title" data-stagger="1">
        The numbers each room respects, from software you run yourself.
      </h2>
      <p class="tour-lede reveal-soft" data-stagger="2">
        These are screenshots of the Lumecon workspace running a sample whole-nation study, captured
        straight from the product.
      </p>
    </header>

    <div class="tour-rows">
      {
        ROWS.map((row, i) => (
          <article class={`tour-row${i % 2 === 1 ? ' tour-row--flip' : ''}`} id={`tour-${row.id}`}>
            <div class={`tour-row__text ${i % 2 === 1 ? 'reveal-right' : 'reveal-left'}`}>
              <p class="tour-row__kicker">{row.kicker}</p>
              <h3 class="tour-row__title">{row.title}</h3>
              <p class="tour-row__body">{row.body}</p>
            </div>
            <figure class={`tour-row__shot ${i % 2 === 1 ? 'reveal-left' : 'reveal-right'}`}>
              <img
                src={row.img}
                alt={row.alt}
                width={row.w}
                height={row.h}
                loading="lazy"
                decoding="async"
              />
            </figure>
          </article>
        ))
      }
    </div>

    <figure class="tour-map reveal-soft">
      <img
        src="/app/map-card.webp"
        alt="Lumecon region map of Washington with tribal homelands outlined and labeled, beside a panel reading Statewide, Washington: the statewide result with Tulalip, WA at its heart."
        width="1600"
        height="402"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        Geographies follow the real economy: reservations, trust lands and overlapping jurisdictions
        are treated as first-class regions.
      </figcaption>
    </figure>
  </div>
</section>
