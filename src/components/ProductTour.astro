---
/**
 * Product tour — alternating feature rows built from real
 * screenshots of the Lumecon workspace (sample analysis data), each
 * with a dark-mode capture of the app's own dark theme. The rows
 * broaden the single results view in the hero with number lineage,
 * comparison and the living workspace. The old wide map strip is gone;
 * a fourth screenshot repeated the argument and read as an orphaned
 * fragment on mobile.
 *
 * This tour is Cedar Impact's. Cedar Grove had a row here for a while,
 * carrying one of its own captures; it came out because the section's
 * heading and lede are about Cedar Impact's results, and a Grove frame
 * under them read as a fourth Impact surface. Grove keeps the nav, the
 * footer, the product-family mentions on /cedar and /pricing, and its
 * own page at /cedar-grove.
 */
import '../styles/tour.css';

const ROWS = [
  {
    id: 'trace',
    product: 'Cedar Impact',
    kicker: 'Result lineage',
    title: 'Trace a reported result to its components',
    body: 'Each headline figure includes a “Trace this number” control. Follow a result through direct, indirect and induced effects, the operations that generate them and the industries where they land.',
    img: '/app/trace.webp',
    width: 1920,
    height: 1004,
    alt: 'Lumecon lineage panel titled Where $1,240,500,000 comes from for a sample Tribal Nation analysis, breaking economic output into direct, indirect and induced layers, by operation and industry.',
  },
  {
    id: 'compare',
    product: 'Cedar Impact',
    kicker: 'Analysis comparison',
    title: 'Compare analyses over time',
    body: 'Put years or scenarios side by side and see the change in jobs, labor income, GDP contribution, economic output and tax impacts. When the next budget cycle begins, the comparison is already there.',
    img: '/app/compare.webp',
    width: 1920,
    height: 1200,
    alt: 'Lumecon comparison of a sample Tribal Nation economic footprint in fiscal years 2023 and 2025, showing changes in jobs, GDP contribution, labor income, economic output and tax impacts.',
  },
  {
    id: 'workspace',
    // Cedar Impact, not Cedar Commons: the frame shows the personal
    // workspace (drafts, comparisons, exports), which every plan includes.
    // Labeling it Commons made basic persistence look Sapling-only.
    product: 'Cedar Impact',
    kicker: 'Analysis history',
    title: 'Return to prior analyses without rebuilding them',
    body: 'Drafts, completed analyses, comparisons and exports stay together in your Workspace, ready to reopen, compare or export as a workbook, CSV tables or a printable summary.',
    img: '/app/dashboard.webp',
    width: 1920,
    height: 1200,
    alt: 'Lumecon workspace home with lanes for starting, in-progress and completed analyses, including completed analyses with jobs and output headlines.',
  },
];
---

<section class="tour" id="product" aria-labelledby="tour-title">
  <div class="tour-inner">
    <header class="tour-head">
      <p class="tour-kicker reveal-soft">Inside the product</p>
      <h2 class="tour-title reveal-soft" id="tour-title" data-stagger="1">
        Review the evidence behind every result.
      </h2>
      <p class="tour-lede reveal-soft" data-stagger="2">
        Cedar Impact keeps source data, approved assumptions and model layers attached to each
        figure, so reviewers can examine how a result was produced.
      </p>
      <p class="tour-samplenote reveal-soft" data-stagger="3">
        Screenshots show illustrative sample analyses.
      </p>
    </header>

    <div class="tour-rows">
      {
        ROWS.map((row, i) => (
          <article class={`tour-row${i % 2 === 1 ? ' tour-row--flip' : ''}`} id={`tour-${row.id}`}>
            <div class={`tour-row__text ${i % 2 === 1 ? 'reveal-right' : 'reveal-left'}`}>
              <p class="tour-row__kicker">
                <span class="tour-row__product">{row.product}</span>
                {row.kicker}
              </p>
              <h3 class="tour-row__title">{row.title}</h3>
              <p class="tour-row__body">{row.body}</p>
            </div>
            {/* data-zoom: these are 1920px renders shown at a third of that,
                so clicking one opens it full size. See Lightbox.astro. */}
            <figure
              class={`tour-row__shot ${i % 2 === 1 ? 'reveal-left' : 'reveal-right'}`}
              data-zoom
            >
              <picture>
                {/* width/height are the intrinsic ratio, kept so the browser
                     reserves the box before the file arrives. The rendered size
                     is CSS-driven (`.tour-row__shot img`), so the shot scales
                     with its column instead of sitting at a fixed 1920x1080. */}
                <img
                  src={row.img}
                  alt={row.alt}
                  width={row.width}
                  height={row.height}
                  sizes="(max-width: 900px) 100vw, 50vw"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </figure>
          </article>
        ))
      }
    </div>
  </div>
</section>
