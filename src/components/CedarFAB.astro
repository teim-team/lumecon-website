---
/**
 * Contextual Cedar launcher anchored to the bottom-right of marketing
 * pages. It stays out of the opening composition, then appears once the
 * page intro has passed. While the visitor scrolls, it steps away from
 * controls and high-value reading surfaces rather than covering them.
 * Click toggles a self-contained Cedar chat panel that lives entirely
 * inside this component, so it works the same everywhere it is offered.
 *
 * The dormant nudge markup remains available for a future deliberate
 * prompt, but it never opens itself. Unprompted bubbles competed with
 * the page and made the product feel less considered.
 *
 * The chat conversation logic itself (classification, API call,
 * transcript rendering) lives in src/lib/cedarChat.ts. This
 * component is responsible only for the FAB chrome + open/close
 * behaviour; bootChat() does the rest.
 *
 * The chat surface markup itself (.cedar-chat, header, transcript,
 * chips, form) is the shared <CedarChat /> component, so the FAB and
 * the inline /cedar panel render the exact same surface and can't
 * drift. Surface styles come from src/styles/cedar-chat.css, imported
 * by that component.
 */
import CedarChat from './CedarChat.astro';
---

<button
  type="button"
  class="cedar-fab"
  id="cedarFab"
  aria-expanded="false"
  aria-controls="cedarFabPanel"
  aria-hidden="true"
  aria-label="Ask Cedar"
  tabindex="-1"
  data-cedar-visibility="waiting"
  title="Ask Cedar"
>
  <span class="cedar-fab__dot" aria-hidden="true"></span>
  <span class="cedar-fab__icon cedar-fab__icon--mark" aria-hidden="true">
    <img src="/brand/lumecon-logo-mark-teal.png" alt="" width="30" height="30" decoding="async" />
  </span>
  <span class="cedar-fab__icon cedar-fab__icon--close" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <line x1="6" y1="6" x2="18" y2="18"></line>
      <line x1="18" y1="6" x2="6" y2="18"></line>
    </svg>
  </span>
  <span class="cedar-fab__copy">
    <span class="cedar-fab__label cedar-fab__label--ask">Ask Cedar</span>
    <span class="cedar-fab__context">Questions about Lumecon</span>
  </span>
  <span class="cedar-fab__label cedar-fab__label--close">Close</span>
</button>

{
  /* One-time-per-session helper nudge. Hidden until the timer in the
     script below shows it; role="status" announces the offer politely
     to screen readers when it appears. */
}
<div class="cedar-nudge" id="cedarNudge" role="status" hidden>
  <button
    type="button"
    class="cedar-nudge__dismiss"
    id="cedarNudgeDismiss"
    aria-label="Dismiss this message"
  >
    <svg
      viewBox="0 0 24 24"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="6" y1="6" x2="18" y2="18"></line>
      <line x1="18" y1="6" x2="6" y2="18"></line>
    </svg>
  </button>
  {/* Two lines on a phone. The bubble's job is to say what the circle
      beside it is and that it answers questions — not to explain itself
      at length over the page someone is reading. */}
  <p class="cedar-nudge__text">
    Hi, I'm Cedar. Ask me anything about Lumecon or economic impact analysis.
  </p>
</div>

{
  /* Self-contained Cedar chat panel. Hidden until the FAB opens it.
     Class-scoped (cedar-fab-panel + child .cedar-chat etc.) so it
     coexists with the inline Cedar chat on the homepage without
     element-id collisions. */
}
<div
  class="cedar-fab-panel"
  id="cedarFabPanel"
  role="dialog"
  aria-label="Ask Cedar"
  aria-modal="true"
  aria-hidden="true"
  hidden
>
  <button
    class="cedar-fab-panel__close"
    type="button"
    aria-label="Close Cedar"
    data-cedar-fab-close
  >
    <svg
      viewBox="0 0 16 16"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
    >
      <path d="m3.5 3.5 9 9m0-9-9 9"></path>
    </svg>
  </button>
  <CedarChat />
</div>

<script>
  /* The launcher shell stays small. The full intent bank is loaded only
     after someone opens Cedar, so a visitor who never uses chat does not
     pay to download or initialize it. */
  import { trackEvent } from '../lib/observability';
  import { CONSENT_EVENT } from '../lib/consent';

  let chatModule: Promise<typeof import('../lib/cedarChat')> | undefined;

  const ensureChat = async (panel: HTMLElement): Promise<void> => {
    try {
      chatModule ??= import('../lib/cedarChat');
      const { bootChat } = await chatModule;
      bootChat(panel, { surface: 'fab' });
    } catch (error) {
      // A rejected dynamic import is otherwise cached for the rest of the
      // page session. Clear it so closing and reopening Cedar can retry if a
      // transient network interruption was the cause.
      chatModule = undefined;
      throw error;
    }
  };

  function setup(): void {
    const fab = document.getElementById('cedarFab');
    const panel = document.getElementById('cedarFabPanel');
    if (!fab || !panel) return;

    // FAB-specific open/close handlers. Guard against double-binding
    // when astro:page-load re-fires this script.
    if ((fab as HTMLElement & { __cedarBound?: boolean }).__cedarBound) return;
    (fab as HTMLElement & { __cedarBound?: boolean }).__cedarBound = true;

    const setChatLoading = (loading: boolean): void => {
      panel.dataset.cedarLoading = loading ? 'true' : 'false';
      panel.setAttribute('aria-busy', String(loading));
      const chat = panel.querySelector<HTMLElement>('.cedar-chat');
      if (chat) chat.inert = loading;
      for (const control of panel.querySelectorAll<HTMLInputElement | HTMLButtonElement>(
        '.cedar-chat input, .cedar-chat button',
      )) {
        control.disabled = loading;
        if (control instanceof HTMLInputElement) {
          control.placeholder = loading ? 'Opening Cedar…' : 'Ask Cedar a question...';
        }
      }
    };

    // ---- Helper nudge (one per browser session) ----
    const nudge = document.getElementById('cedarNudge');
    const NUDGE_KEY = 'lumecon-cedar-nudge-seen';
    const markNudgeSeen = (): void => {
      try {
        sessionStorage.setItem(NUDGE_KEY, '1');
      } catch {
        /* storage unavailable */
      }
    };
    const hideNudge = (): void => {
      if (nudge && !nudge.hidden) nudge.hidden = true;
    };
    const nudgeSeen = (): boolean => {
      try {
        return sessionStorage.getItem(NUDGE_KEY) === '1';
      } catch {
        /* Storage unavailable: treat as seen rather than showing the
           bubble on every page of a visit. */
        return true;
      }
    };

    /* The launcher is supporting navigation, not part of the hero. Keep it
       out of the opening composition, and do not let a fixed control cover
       a price, definition, product screen or another control farther down
       the page. The collision list combines semantic controls with the few
       page surfaces whose whole rectangle carries meaning. */
    const main = document.querySelector<HTMLElement>('main');
    const intro = main?.firstElementChild instanceof HTMLElement ? main.firstElementChild : null;
    const avoidSelector = [
      'table',
      '[data-zoom]',
      '.pr-free',
      '.pr-plan',
      '.pr-grove',
      '.meth-defs__row',
      '.naics-tile',
      '.place-panel',
      /* /why-lumecon: the written-out lineage is a rectangle whose whole
         content is the point, and the destination rows and the portraits
         are controls. */
      '.why-trace',
      '.why-checks',
      '.why-person',
      '.footer',
    ].join(',');
    let visibilityFrame = 0;

    const setLauncherVisibility = (visible: boolean, reason: 'waiting' | 'avoiding'): void => {
      if (!visible && document.activeElement === fab) return;
      fab.dataset.cedarVisibility = visible ? 'visible' : reason;
      if (visible) {
        fab.removeAttribute('aria-hidden');
        fab.removeAttribute('tabindex');
      } else {
        fab.setAttribute('aria-hidden', 'true');
        fab.setAttribute('tabindex', '-1');
        hideNudge();
      }
    };

    const introHasPassed = (): boolean => {
      if (!intro) return window.scrollY > Math.min(240, window.innerHeight * 0.3);
      const navBottom = document
        .querySelector<HTMLElement>('body > nav')
        ?.getBoundingClientRect().bottom;
      const clearLine = Math.max(88, (navBottom || 72) + 16);
      return intro.getBoundingClientRect().bottom <= clearLine;
    };

    const overlapsProtectedContent = (): boolean => {
      const fabRect = fab.getBoundingClientRect();
      const clearance = 10;
      const zones = document.querySelectorAll<HTMLElement>(avoidSelector);
      for (const zone of zones) {
        if (
          zone === fab ||
          fab.contains(zone) ||
          panel.contains(zone) ||
          nudge?.contains(zone) ||
          zone.hidden
        ) {
          continue;
        }
        const rect = zone.getBoundingClientRect();
        if (!rect.width || !rect.height || rect.bottom <= 0 || rect.top >= window.innerHeight) {
          continue;
        }
        if (
          rect.right > fabRect.left - clearance &&
          rect.left < fabRect.right + clearance &&
          rect.bottom > fabRect.top - clearance &&
          rect.top < fabRect.bottom + clearance
        ) {
          return true;
        }
      }
      return false;
    };

    const updateLauncherVisibility = (): void => {
      visibilityFrame = 0;
      if (document.body.classList.contains('cedar-popped')) return;
      if (!introHasPassed()) {
        setLauncherVisibility(false, 'waiting');
        return;
      }
      setLauncherVisibility(!overlapsProtectedContent(), 'avoiding');
    };

    const scheduleLauncherVisibility = (): void => {
      if (visibilityFrame) return;
      visibilityFrame = window.requestAnimationFrame(updateLauncherVisibility);
    };

    let opening = false;
    const open = async () => {
      if (opening || document.body.classList.contains('cedar-popped')) return;
      opening = true;
      markNudgeSeen();
      hideNudge();
      setLauncherVisibility(true, 'waiting');
      panel.hidden = false;
      panel.setAttribute('aria-hidden', 'false');
      document.body.classList.add('cedar-popped');
      document
        .querySelectorAll<HTMLElement>('body > nav, body > main, body > footer')
        .forEach((el) => {
          el.inert = true;
        });
      fab.setAttribute('aria-expanded', 'true');
      fab.setAttribute('aria-label', 'Close Cedar');
      fab.setAttribute('title', 'Close Cedar');
      setChatLoading(true);
      try {
        await ensureChat(panel);
        // The visitor may have used the close button while Cedar was
        // loading. Do not focus a hidden panel when the import finishes.
        if (panel.hidden || !document.body.classList.contains('cedar-popped')) return;
        setChatLoading(false);
        const input = panel.querySelector<HTMLInputElement>('[data-cedar-input]');
        window.setTimeout(() => {
          if (!panel.hidden) input?.focus({ preventScroll: true });
        }, 180);
        trackEvent('cedar.fab.open');
      } catch (error) {
        console.error('Unable to start Cedar chat', error);
        // Never leave the rest of the page inert behind an unresponsive
        // dialog. Closing gives the visitor a clear retry path.
        close();
      } finally {
        opening = false;
      }
    };
    const close = () => {
      // If focus is inside the panel when it closes, hand it back to the
      // FAB so keyboard users aren't dropped at the top of the document.
      const returnFocus = panel.contains(document.activeElement);
      setChatLoading(false);
      panel.hidden = true;
      panel.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('cedar-popped');
      document
        .querySelectorAll<HTMLElement>('body > nav, body > main, body > footer')
        .forEach((el) => {
          el.inert = false;
        });
      fab.setAttribute('aria-expanded', 'false');
      fab.setAttribute('aria-label', 'Ask Cedar');
      fab.setAttribute('title', 'Ask Cedar');
      if (returnFocus) (fab as HTMLElement).focus({ preventScroll: true });
      trackEvent('cedar.fab.close');
      scheduleLauncherVisibility();
    };

    // The panel is a modal-ish dialog: while it's open, keep Tab focus
    // cycling between the FAB (which is the Close control in this state)
    // and the panel's controls so keyboard users can't tab out into the
    // page behind it. Queried live each time so dynamically added chips,
    // feedback, and follow-up buttons are included.
    const focusables = (): HTMLElement[] => {
      const sel =
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';
      const inPanel = Array.from(panel.querySelectorAll<HTMLElement>(sel)).filter(
        (el) => !el.hidden && el.offsetParent !== null,
      );
      // The FAB hides while the docked panel is open; only include it in
      // the cycle when it is actually visible.
      return (fab as HTMLElement).offsetParent !== null
        ? [fab as HTMLElement, ...inPanel]
        : inPanel;
    };

    fab.addEventListener('click', (e) => {
      e.stopPropagation();
      if (document.body.classList.contains('cedar-popped')) close();
      else void open();
    });
    fab.addEventListener('blur', scheduleLauncherVisibility);

    panel.querySelector('[data-cedar-fab-close]')?.addEventListener('click', () => close());

    /* /cedar itself answers in its own inline chat, so the bubble would
       be pointing at a second Cedar on a page that already has one.
       Matched exactly: `startsWith('/cedar')` also swallowed
       /cedar-impact, /cedar-grove and /cedar-commons, which is why the
       bubble never appeared on any of the product pages. */
    const onCedarPage = /^\/cedar\/?$/.test(window.location.pathname);
    if (nudge && !onCedarPage) {
      const dismiss = document.getElementById('cedarNudgeDismiss');
      dismiss?.addEventListener('click', () => {
        markNudgeSeen();
        const returnFocus = nudge.contains(document.activeElement);
        hideNudge();
        if (returnFocus) (fab as HTMLElement).focus({ preventScroll: true });
        trackEvent('cedar.nudge.dismiss');
      });
      /* The bubble greets once per visit, ON A PHONE ONLY.
         ---------------------------------------------------------------
         It was off entirely: unprompted popups read as spam beside the
         quieter desktop composition, and that judgement still holds
         there. A phone is a different situation. The launcher is a
         60px circle with no label beside it, so nothing on the screen
         says what it is, and the thing it offers is the fastest way to
         an answer on the surface with the least room to read.

         The restraint that made the original call is kept: it waits
         until the opening composition has been read past, it is gone
         for the rest of the session once dismissed or once Cedar is
         opened, it never reappears on the next page, and it never
         steals focus — `role="status"` announces it politely and the
         page keeps the caret. */
      const PHONE = window.matchMedia('(max-width: 600px)');
      const NUDGE_DELAY_MS = 7000;
      /* After the delay, wait for a moment when the launcher is actually
         on screen, then give up. The launcher steps aside constantly
         while a page is being scrolled, so "is it ready yet" has to be
         asked repeatedly rather than once: an earlier version armed a
         fresh timer on every visibility change, which meant a continuous
         scroll reset it forever and the bubble never appeared at all. */
      const NUDGE_POLL_MS = 900;
      const NUDGE_GIVE_UP_MS = 45000;
      let pollTimer: number | undefined;
      let deadline = 0;

      /* The bubble's own rectangle, not the launcher's. `visible` is
         computed from the 60px FAB, and the bubble is up to 300px wide
         sitting above and to the left of it — so the launcher can be
         clear of a screenshot, a price or a control while the bubble
         covers it. The bubble is `hidden` when this runs and therefore
         has no box to measure, so the box is derived from the same
         numbers the stylesheet uses. */
      const nudgeWouldOverlap = (): boolean => {
        const fabRect = fab.getBoundingClientRect();
        const width = Math.min(300, window.innerWidth - 27.2);
        const height = 120; // two lines of copy plus its padding and tail
        const gap = 10;
        const box = {
          left: fabRect.right - width,
          right: fabRect.right,
          top: fabRect.top - gap - height,
          bottom: fabRect.top - gap,
        };
        for (const zone of document.querySelectorAll<HTMLElement>(avoidSelector)) {
          if (zone === fab || fab.contains(zone) || panel.contains(zone) || zone.hidden) continue;
          const r = zone.getBoundingClientRect();
          if (!r.width || !r.height || r.bottom <= 0 || r.top >= window.innerHeight) continue;
          if (r.right > box.left && r.left < box.right && r.bottom > box.top && r.top < box.bottom) {
            return true;
          }
        }
        return false;
      };

      const canShow = (): boolean =>
        PHONE.matches &&
        !nudgeSeen() &&
        !document.body.classList.contains('cedar-popped') &&
        /* Never over the consent banner, which owns the same corner. */
        !document.body.classList.contains('consent-pending') &&
        /* `visible` is the launcher's own ready state (see
           setLauncherVisibility). While it is 'waiting' or 'avoiding'
           there is nothing on screen for the bubble to point at. */
        fab.dataset.cedarVisibility === 'visible' &&
        !nudgeWouldOverlap();

      const stopPolling = (): void => {
        window.clearTimeout(pollTimer);
        pollTimer = undefined;
      };

      const tryShow = (): void => {
        if (!nudge || !nudge.hidden) return stopPolling();
        if (nudgeSeen() || Date.now() > deadline) return stopPolling();
        if (canShow()) {
          nudge.hidden = false;
          /* Marked seen the moment it appears, not when it is
             dismissed: one greeting per visit either way. */
          markNudgeSeen();
          trackEvent('cedar.nudge.show');
          return stopPolling();
        }
        pollTimer = window.setTimeout(tryShow, NUDGE_POLL_MS);
      };

      const armNudge = (): void => {
        if (!PHONE.matches || nudgeSeen() || pollTimer !== undefined) return;
        deadline = Date.now() + NUDGE_DELAY_MS + NUDGE_GIVE_UP_MS;
        pollTimer = window.setTimeout(tryShow, NUDGE_DELAY_MS);
      };

      armNudge();
      /* Rotating to a phone mid-visit arms it; rotating away hides a
         bubble that no longer has a launcher to point at. */
      PHONE.addEventListener('change', () => {
        if (PHONE.matches) armNudge();
        else {
          stopPolling();
          hideNudge();
        }
      });
      /* A first-time visitor spends their first seconds on the consent
         banner, which owns this corner and blocks the bubble. Start the
         clock again once they have answered it, rather than letting the
         greeting expire behind a dialog they were reading. */
      window.addEventListener(CONSENT_EVENT, () => {
        stopPolling();
        armNudge();
      });

      /* Tapping the bubble opens Cedar, because a person who reaches
         for a message that says "ask me" is asking. */
      nudge.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('#cedarNudgeDismiss')) return;
        /* Same reason the launcher stops propagation: this click opens
           the panel, and the document-level close-on-outside-click
           handler below would otherwise see the very same click land
           outside the now-open panel and shut it again. */
        event.stopPropagation();
        hideNudge();
        trackEvent('cedar.nudge.accept');
        void open();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (!document.body.classList.contains('cedar-popped')) return;
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (items.length < 2) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement as HTMLElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      } else if (active !== fab && !panel.contains(active)) {
        // Focus escaped the dialog — pull it back to the first control.
        e.preventDefault();
        first.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!document.body.classList.contains('cedar-popped')) return;
      // Use composedPath rather than panel.contains(target): a chip
      // click handler inside the panel may detach the clicked
      // element (e.g. the follow-up chip row removes itself before
      // the click finishes bubbling). composedPath captures the
      // original ancestor chain at dispatch time, so it still
      // recognises the click as inside the panel.
      const path = e.composedPath();
      if (path.includes(panel) || path.includes(fab)) return;
      close();
    });

    window.addEventListener('scroll', scheduleLauncherVisibility, { passive: true });
    window.addEventListener('resize', scheduleLauncherVisibility, { passive: true });
    window.addEventListener('load', scheduleLauncherVisibility, { once: true });
    if ('ResizeObserver' in window && main) {
      const layoutObserver = new ResizeObserver(scheduleLauncherVisibility);
      layoutObserver.observe(main);
      if (intro && intro !== main) layoutObserver.observe(intro);
    }
    void document.fonts?.ready.then(scheduleLauncherVisibility);
    scheduleLauncherVisibility();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .cedar-fab {
    position: fixed;
    /* Lift the bottom-anchored FAB above iOS Safari's home-indicator
       strip on notch iPhones (viewport-fit=cover lets the viewport
       extend under it). env() falls back to 0 on hosts without a
       safe area. */
    right: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-right, 0px));
    bottom: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-bottom, 0px));
    z-index: 80;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.55rem;
    padding: 0.55rem 0.85rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: 0.5rem;
    box-shadow:
      0 4px 12px rgba(10, 15, 38, 0.08),
      0 8px 24px rgba(10, 15, 38, 0.04);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      background 0.2s var(--ease),
      box-shadow 0.2s var(--ease),
      opacity 0.16s var(--ease),
      transform 0.2s var(--ease);
  }
  .cedar-fab[data-cedar-visibility='visible'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  /* Closed state: a compact product-mark label. Keeping this to one line
     prevents a persistent helper from covering definitions, prices or CTAs. */
  .cedar-fab:hover {
    background: var(--cream);
    transform: translateY(-2px);
    box-shadow:
      0 6px 16px rgba(10, 15, 38, 0.1),
      0 12px 32px rgba(10, 15, 38, 0.06);
  }
  @media (prefers-reduced-motion: reduce) {
    .cedar-fab {
      transition: none;
    }
    .cedar-fab:hover {
      transform: none;
    }
  }
  .cedar-fab:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 4px;
  }
  .cedar-fab__dot {
    display: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 1px var(--rule-strong);
    flex: 0 0 auto;
  }
  .cedar-fab__copy {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .cedar-fab__label--ask {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .cedar-fab__context {
    display: none;
  }
  .cedar-fab__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cedar-fab__icon svg {
    display: block;
  }
  .cedar-fab__icon--close,
  .cedar-fab__label--close {
    display: none;
  }
  .cedar-fab__icon--mark {
    display: inline-flex;
  }
  .cedar-fab__icon--mark img {
    display: block;
    width: 30px;
    height: 30px;
  }
  .cedar-fab__icon--close {
    width: 22px;
    height: 22px;
  }

  /* On small screens the launcher collapses to a compact circle so it
     never covers CTAs, pricing cards or other page controls. The full
     two-line pill only exists at desktop widths. */
  @media (max-width: 760px) {
    /* 60px, not 48. A thumb-sized target on a phone, and large enough
       that the mark reads as the brand rather than as a generic chat
