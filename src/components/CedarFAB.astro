---
/**
 * Cedar launcher anchored to the bottom-right of every page that offers
 * it. It is there from the first frame and stays there (owner,
 * 2026-09-27): it no longer waits for the intro or steps aside over
 * tables, prices and the footer, because a launcher that comes and goes
 * reads as broken. It is the same pill as Cedar Press and teim-app: the
 * teal status dot, "Ask Cedar", and whose Cedar it is, with no logo.
 * Click toggles a self-contained Cedar chat panel that lives entirely
 * inside this component, so it works the same everywhere it is offered.
 *
 * The greeting note ("Hi, I'm Cedar...") rises above the launcher once
 * the visitor has scrolled into the page, at every width, and stays until
 * it is dismissed or Cedar is opened. Dismissing it holds for the rest of
 * the visit.
 *
 * The chat conversation logic itself (classification, API call,
 * transcript rendering) lives in src/lib/cedarChat.ts. This
 * component is responsible only for the FAB chrome + open/close
 * behaviour; bootChat() does the rest.
 *
 * The chat surface markup itself (.cedar-chat, header, transcript,
 * chips, form) is the shared <CedarChat /> component, so the FAB and
 * the inline /cedar panel render the exact same surface and can't
 * drift. Surface styles come from src/styles/cedar-chat.css, imported
 * by that component.
 */
import CedarChat from './CedarChat.astro';
---

<button
  type="button"
  class="cedar-fab"
  id="cedarFab"
  aria-expanded="false"
  aria-controls="cedarFabPanel"
  aria-label="Ask Cedar"
  data-cedar-visibility="visible"
  title="Ask Cedar"
>
  <span class="cedar-fab__dot" aria-hidden="true"></span>
  <span class="cedar-fab__icon cedar-fab__icon--close" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <line x1="6" y1="6" x2="18" y2="18"></line>
      <line x1="18" y1="6" x2="6" y2="18"></line>
    </svg>
  </span>
  <span class="cedar-fab__copy">
    <span class="cedar-fab__label cedar-fab__label--ask">Ask Cedar</span>
    <span class="cedar-fab__context">Lumecon</span>
  </span>
  <span class="cedar-fab__label cedar-fab__label--close">Close</span>
</button>

{
  /* The greeting note. Hidden until the visitor scrolls into the page;
     role="status" announces it politely to screen readers when it
     appears, and it never takes focus. */
}
<div class="cedar-nudge" id="cedarNudge" role="status" hidden>
  <button
    type="button"
    class="cedar-nudge__dismiss"
    id="cedarNudgeDismiss"
    aria-label="Dismiss this message"
  >
    <svg
      viewBox="0 0 24 24"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="6" y1="6" x2="18" y2="18"></line>
      <line x1="18" y1="6" x2="6" y2="18"></line>
    </svg>
  </button>
  {/* Two short lines. The note says who Cedar is and what to ask, and
      nothing more over the page someone is reading. */}
  <p class="cedar-nudge__text">
    Hi, I'm Cedar. I'm here to help with anything about Lumecon or economic impact analysis.
  </p>
</div>

{
  /* Self-contained Cedar chat panel. Hidden until the FAB opens it.
     Class-scoped (cedar-fab-panel + child .cedar-chat etc.) so it
     coexists with the inline Cedar chat on the homepage without
     element-id collisions. */
}
<div
  class="cedar-fab-panel"
  id="cedarFabPanel"
  role="dialog"
  aria-label="Ask Cedar"
  aria-modal="true"
  aria-hidden="true"
  hidden
>
  <button
    class="cedar-fab-panel__close"
    type="button"
    aria-label="Close Cedar"
    data-cedar-fab-close
  >
    <svg
      viewBox="0 0 16 16"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
    >
      <path d="m3.5 3.5 9 9m0-9-9 9"></path>
    </svg>
  </button>
  <CedarChat />
</div>

<script>
  /* The launcher shell stays small. The full intent bank is loaded only
     after someone opens Cedar, so a visitor who never uses chat does not
     pay to download or initialize it. */
  import { trackEvent } from '../lib/observability';
  import { CONSENT_EVENT } from '../lib/consent';

  let chatModule: Promise<typeof import('../lib/cedarChat')> | undefined;

  const ensureChat = async (panel: HTMLElement): Promise<void> => {
    try {
      chatModule ??= import('../lib/cedarChat');
      const { bootChat } = await chatModule;
      bootChat(panel, { surface: 'fab' });
    } catch (error) {
      // A rejected dynamic import is otherwise cached for the rest of the
      // page session. Clear it so closing and reopening Cedar can retry if a
      // transient network interruption was the cause.
      chatModule = undefined;
      throw error;
    }
  };

  function setup(): void {
    const fab = document.getElementById('cedarFab');
    const panel = document.getElementById('cedarFabPanel');
    if (!fab || !panel) return;

    // FAB-specific open/close handlers. Guard against double-binding
    // when astro:page-load re-fires this script.
    if ((fab as HTMLElement & { __cedarBound?: boolean }).__cedarBound) return;
    (fab as HTMLElement & { __cedarBound?: boolean }).__cedarBound = true;

    const setChatLoading = (loading: boolean): void => {
      panel.dataset.cedarLoading = loading ? 'true' : 'false';
      panel.setAttribute('aria-busy', String(loading));
      const chat = panel.querySelector<HTMLElement>('.cedar-chat');
      if (chat) chat.inert = loading;
      for (const control of panel.querySelectorAll<HTMLInputElement | HTMLButtonElement>(
        '.cedar-chat input, .cedar-chat button',
      )) {
        control.disabled = loading;
        if (control instanceof HTMLInputElement) {
          control.placeholder = loading ? 'Opening Cedar…' : 'Ask Cedar a question...';
        }
      }
    };

    // ---- The greeting note ----
    /* It greets on every page until the visitor answers it: dismissing it
       or opening Cedar holds for the rest of the visit. Merely having seen
       it does not, so a visitor who scrolled past it on one page meets it
       again on the next, the way IMPLAN's does. */
    const nudge = document.getElementById('cedarNudge');
    const NUDGE_KEY = 'lumecon-cedar-nudge-dismissed';
    const markNudgeDone = (): void => {
      try {
        sessionStorage.setItem(NUDGE_KEY, '1');
      } catch {
        /* storage unavailable */
      }
    };
    const hideNudge = (): void => {
      if (nudge && !nudge.hidden) nudge.hidden = true;
    };
    const nudgeDone = (): boolean => {
      try {
        return sessionStorage.getItem(NUDGE_KEY) === '1';
      } catch {
        /* Storage unavailable: the note still shows, and dismissing it
           still hides it for this page. */
        return false;
      }
    };

    /* The launcher is always there (owner, 2026-09-27). It used to wait
       out the opening composition and then step aside whenever it touched
       a table, a price, a definition row or the footer, which on a long
       page meant it was gone as often as it was present and read as
       broken. `data-cedar-visibility` stays for the tests and styles that
       read it, and is always `visible`. */
    fab.dataset.cedarVisibility = 'visible';
    fab.removeAttribute('aria-hidden');
    fab.removeAttribute('tabindex');
    let opening = false;
    const open = async () => {
      if (opening || document.body.classList.contains('cedar-popped')) return;
      opening = true;
      markNudgeDone();
      hideNudge();
      panel.hidden = false;
      panel.setAttribute('aria-hidden', 'false');
      document.body.classList.add('cedar-popped');
      document
        .querySelectorAll<HTMLElement>('body > nav, body > main, body > footer')
        .forEach((el) => {
          el.inert = true;
        });
      fab.setAttribute('aria-expanded', 'true');
      fab.setAttribute('aria-label', 'Close Cedar');
      fab.setAttribute('title', 'Close Cedar');
      setChatLoading(true);
      try {
        await ensureChat(panel);
        // The visitor may have used the close button while Cedar was
        // loading. Do not focus a hidden panel when the import finishes.
        if (panel.hidden || !document.body.classList.contains('cedar-popped')) return;
        setChatLoading(false);
        const input = panel.querySelector<HTMLInputElement>('[data-cedar-input]');
        window.setTimeout(() => {
          if (!panel.hidden) input?.focus({ preventScroll: true });
        }, 180);
        trackEvent('cedar.fab.open');
      } catch (error) {
        console.error('Unable to start Cedar chat', error);
        // Never leave the rest of the page inert behind an unresponsive
        // dialog. Closing gives the visitor a clear retry path.
        close();
      } finally {
        opening = false;
      }
    };
    const close = () => {
      // If focus is inside the panel when it closes, hand it back to the
      // FAB so keyboard users aren't dropped at the top of the document.
      const returnFocus = panel.contains(document.activeElement);
      setChatLoading(false);
      panel.hidden = true;
      panel.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('cedar-popped');
      document
        .querySelectorAll<HTMLElement>('body > nav, body > main, body > footer')
        .forEach((el) => {
          el.inert = false;
        });
      fab.setAttribute('aria-expanded', 'false');
      fab.setAttribute('aria-label', 'Ask Cedar');
      fab.setAttribute('title', 'Ask Cedar');
      if (returnFocus) (fab as HTMLElement).focus({ preventScroll: true });
      trackEvent('cedar.fab.close');
    };

    // The panel is a modal-ish dialog: while it's open, keep Tab focus
    // cycling between the FAB (which is the Close control in this state)
    // and the panel's controls so keyboard users can't tab out into the
    // page behind it. Queried live each time so dynamically added chips,
    // feedback, and follow-up buttons are included.
    const focusables = (): HTMLElement[] => {
      const sel =
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';
      const inPanel = Array.from(panel.querySelectorAll<HTMLElement>(sel)).filter(
        (el) => !el.hidden && el.offsetParent !== null,
      );
      // The FAB hides while the docked panel is open; only include it in
      // the cycle when it is actually visible.
      return (fab as HTMLElement).offsetParent !== null
        ? [fab as HTMLElement, ...inPanel]
        : inPanel;
    };

    fab.addEventListener('click', (e) => {
      e.stopPropagation();
      if (document.body.classList.contains('cedar-popped')) close();
      else void open();
    });

    panel.querySelector('[data-cedar-fab-close]')?.addEventListener('click', () => close());

    /* /cedar itself answers in its own inline chat, so the note would be
       pointing at a second Cedar on a page that already has one. Matched
       exactly: `startsWith('/cedar')` also swallows /cedar-impact,
       /cedar-grove and /cedar-commons. */
    const onCedarPage = /^\/cedar\/?$/.test(window.location.pathname);
    if (nudge && !onCedarPage) {
      const dismiss = document.getElementById('cedarNudgeDismiss');
      dismiss?.addEventListener('click', (event) => {
        event.stopPropagation();
        markNudgeDone();
        const returnFocus = nudge.contains(document.activeElement);
        hideNudge();
        if (returnFocus) (fab as HTMLElement).focus({ preventScroll: true });
        trackEvent('cedar.nudge.dismiss');
      });

      /* When it rises: once the visitor has scrolled into the page (a
         third of a screen, or the page's whole scroll when it is shorter
         than that) and at least a moment after load, so it arrives as the
         reader moves rather than with the first paint. At every width.
         It then stays, over whatever is behind it, until it is dismissed
         or Cedar is opened: it no longer hides when it crosses a table or
         the footer. On a phone it waits while the consent banner, which
         owns the same corner, is up. */
      const PHONE = window.matchMedia('(max-width: 640px)');
      const MIN_DELAY_MS = 1500;
      const loadedAt = Date.now();
      let delayTimer: number | undefined;

      const scrolledIn = (): boolean => {
        const room = document.documentElement.scrollHeight - window.innerHeight;
        const need = Math.min(window.innerHeight / 3, Math.max(room - 4, 0));
        return window.scrollY >= need;
      };

      const canShow = (): boolean =>
        !nudgeDone() &&
        !document.body.classList.contains('cedar-popped') &&
        !(PHONE.matches && document.body.classList.contains('consent-pending')) &&
        scrolledIn();

      const tryShow = (): void => {
        if (!nudge.hidden || !canShow()) return;
        const wait = MIN_DELAY_MS - (Date.now() - loadedAt);
        if (wait > 0) {
          window.clearTimeout(delayTimer);
          delayTimer = window.setTimeout(tryShow, wait);
          return;
        }
        nudge.hidden = false;
        trackEvent('cedar.nudge.show');
      };

      window.addEventListener('scroll', tryShow, { passive: true });
      window.addEventListener('resize', tryShow, { passive: true });
      /* A first-time visitor answers the consent banner first. */
      window.addEventListener(CONSENT_EVENT, tryShow);
      /* A page with nothing to scroll still gets its greeting. */
      window.setTimeout(tryShow, MIN_DELAY_MS);

      /* Tapping or clicking the note opens Cedar, because a person who
         reaches for a message that says "I'm here to help" is asking. */
      nudge.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('#cedarNudgeDismiss')) return;
        /* This click opens the panel, and the document-level
           close-on-outside-click handler below would otherwise see the
           same click land outside the now-open panel and shut it. */
        event.stopPropagation();
        hideNudge();
        trackEvent('cedar.nudge.accept');
        void open();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (!document.body.classList.contains('cedar-popped')) return;
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (items.length < 2) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement as HTMLElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      } else if (active !== fab && !panel.contains(active)) {
        // Focus escaped the dialog — pull it back to the first control.
        e.preventDefault();
        first.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!document.body.classList.contains('cedar-popped')) return;
      // Use composedPath rather than panel.contains(target): a chip
      // click handler inside the panel may detach the clicked
      // element (e.g. the follow-up chip row removes itself before
      // the click finishes bubbling). composedPath captures the
      // original ancestor chain at dispatch time, so it still
      // recognises the click as inside the panel.
      const path = e.composedPath();
      if (path.includes(panel) || path.includes(fab)) return;
      close();
    });

  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .cedar-fab {
    position: fixed;
    /* Lift the bottom-anchored FAB above iOS Safari's home-indicator
       strip on notch iPhones (viewport-fit=cover lets the viewport
       extend under it). env() falls back to 0 on hosts without a
       safe area. */
    right: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-right, 0px));
    bottom: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-bottom, 0px));
    z-index: 80;
    /* The Cedar Press pill (press.css `.cedar-widget__launcher`): status
       dot, name, whose Cedar. Visible from the first frame and never
       hidden again while the page is open. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid rgba(15, 181, 165, 0.35);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(10, 15, 38, 0.1);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    transition:
      background 0.2s var(--ease),
      box-shadow 0.2s var(--ease),
      opacity 0.16s var(--ease),
      transform 0.2s var(--ease);
  }
  @media (hover: hover) {
    .cedar-fab:hover {
      border-color: var(--accent);
      background: rgba(15, 181, 165, 0.08);
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(10, 15, 38, 0.14);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cedar-fab {
      transition: none;
    }
    .cedar-fab:hover {
      transform: none;
    }
  }
  .cedar-fab:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 4px;
  }
  /* The "online" light, the same teal as Cedar Press's. */
  .cedar-fab__dot {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
  }
  .cedar-fab__copy {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .cedar-fab__label--ask {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .cedar-fab__label--ask,
  .cedar-fab__context {
    white-space: nowrap;
  }
  .cedar-fab__context {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    line-height: 1.2;
    margin-top: 0.1rem;
  }
  .cedar-fab__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cedar-fab__icon svg {
    display: block;
  }
  .cedar-fab__icon--close,
  .cedar-fab__label--close {
    display: none;
  }
  .cedar-fab__icon--close {
    width: 22px;
    height: 22px;
  }

  /* Phones: the same pill and the same words, tucked closer into the
     corner and clear of iOS Safari's home indicator, as Cedar Press does. */
  @media (max-width: 760px) {
    .cedar-fab,
    body.cedar-popped .cedar-fab {
      right: calc(1rem + env(safe-area-inset-right, 0px));
      bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    }
  }

  /* Open state = a clear navy "Close" pill (the launcher steps aside). */
  body.cedar-popped .cedar-fab {
    background: var(--navy);
    color: #fff;
    border-color: transparent;
    gap: 0.5rem;
    padding: 0.7rem 1.05rem;
    border-radius: 999px;
    box-shadow: 0 6px 16px rgba(10, 15, 38, 0.3);
  }
  body.cedar-popped .cedar-fab:hover {
    background: var(--navy2);
    transform: none;
  }
  body.cedar-popped .cedar-fab__dot,
  body.cedar-popped .cedar-fab__copy {
    display: none;
  }
  body.cedar-popped .cedar-fab__icon--close {
    display: inline-flex;
  }
  body.cedar-popped .cedar-fab__label--close {
    display: inline;
  }

  /* ---------- The self-contained chat panel ----------
     Docked, not floating: the open panel pins flush to the bottom of
     the viewport like a bottom sheet, top corners only. The FAB hides
     while the panel is open (the panel carries its own close button),
     and returns when it closes. */
  .cedar-fab-panel {
    position: fixed;
    bottom: env(safe-area-inset-bottom, 0px);
    right: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-right, 0px));
    width: min(380px, calc(100vw - 1.8rem));
    max-height: calc(100dvh - 5rem);
    z-index: 85;
    display: flex;
    flex-direction: column;
    animation: cedar-pop-in 0.25s var(--ease);
  }
  .cedar-fab-panel[hidden] {
    display: none;
  }
  :global(body.cedar-popped) .cedar-fab {
    display: none;
  }
  .cedar-fab-panel__close {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    z-index: 3;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
  .cedar-fab-panel__close:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .cedar-fab-panel__close:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -4px;
  }
  .cedar-fab-panel__close svg {
    width: 14px;
    height: 14px;
  }
  /* Leave room for the close button so it never overlaps the Online
     status in the chat header. */
  .cedar-fab-panel :global(.cedar-chat__status) {
    margin-right: 3rem;
  }
  .cedar-fab-panel :global(.cedar-chat) {
    width: 100%;
    border-radius: 8px 8px 0 0;
    border-bottom: 0;
    max-height: calc(100dvh - 5rem);
    display: flex;
    flex-direction: column;
    box-shadow:
      0 24px 60px -16px rgba(10, 15, 38, 0.28),
      0 4px 16px rgba(10, 15, 38, 0.14);
  }
  .cedar-fab-panel :global(.cedar-chat__transcript) {
    flex: 1 1 auto;
    min-height: 180px;
  }
  @keyframes cedar-pop-in {
    from {
      transform: translateY(12px) scale(0.97);
      opacity: 0;
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cedar-fab-panel {
      animation: none;
    }
  }

  /* ---------- The helper nudge ---------- */
  .cedar-nudge {
    position: fixed;
    right: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-right, 0px));
    bottom: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-bottom, 0px) + 4.15rem);
    z-index: 79;
    width: min(280px, calc(100vw - 1.8rem));
    padding: 0.9rem 1rem 0.85rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: 0.5rem;
    box-shadow:
      0 12px 32px rgba(10, 15, 38, 0.14),
      0 4px 12px rgba(10, 15, 38, 0.08);
    animation: cedar-pop-in 0.25s var(--ease);
  }
  /* Speech-bubble tail: a rotated square hanging off the bottom edge,
     pointing down at the launcher pill. It shares the bubble's surface
     and border so the two read as one shape; the half that overlaps the
     bubble covers the border line behind it. */
  .cedar-nudge::after {
    content: '';
    position: absolute;
    bottom: -7px;
    right: 30px;
    width: 12px;
    height: 12px;
    background: var(--surface);
    border-right: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    transform: rotate(45deg);
  }
  .cedar-nudge[hidden] {
    display: none;
  }
  :global(body.cedar-popped) .cedar-nudge {
    display: none;
  }
  /* The note opens Cedar when clicked, so it reads as a target. The
     dismiss control inside it keeps its own cursor and stops the click
     from reaching that handler. */
  .cedar-nudge {
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    .cedar-nudge {
      animation: none;
    }
  }
  .cedar-nudge__text {
    margin: 0 2.35rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--ink);
  }
