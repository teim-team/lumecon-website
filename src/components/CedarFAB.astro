---
/**
 * Contextual Cedar launcher anchored to the bottom-right of marketing
 * pages. It stays out of the opening composition, then appears once the
 * page intro has passed. While the visitor scrolls, it steps away from
 * controls and high-value reading surfaces rather than covering them.
 * Click toggles a self-contained Cedar chat panel that lives entirely
 * inside this component, so it works the same everywhere it is offered.
 *
 * The dormant nudge markup remains available for a future deliberate
 * prompt, but it never opens itself. Unprompted bubbles competed with
 * the page and made the product feel less considered.
 *
 * The chat conversation logic itself (classification, API call,
 * transcript rendering) lives in src/lib/cedarChat.ts. This
 * component is responsible only for the FAB chrome + open/close
 * behaviour; bootChat() does the rest.
 *
 * The chat surface markup itself (.cedar-chat, header, transcript,
 * chips, form) is the shared <CedarChat /> component, so the FAB and
 * the inline /cedar panel render the exact same surface and can't
 * drift. Surface styles come from src/styles/cedar-chat.css, imported
 * by that component.
 */
import CedarChat from './CedarChat.astro';
---

<button
  type="button"
  class="cedar-fab"
  id="cedarFab"
  aria-expanded="false"
  aria-controls="cedarFabPanel"
  aria-hidden="true"
  tabindex="-1"
  data-cedar-visibility="waiting"
  title="Ask Cedar"
>
  <span class="cedar-fab__dot" aria-hidden="true"></span>
  <span class="cedar-fab__icon cedar-fab__icon--mark" aria-hidden="true">
    <img
      src="/brand/lumecon-logo-mark-teal.png"
      alt=""
      width="30"
      height="30"
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="cedar-fab__icon cedar-fab__icon--close" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <line x1="6" y1="6" x2="18" y2="18"></line>
      <line x1="18" y1="6" x2="6" y2="18"></line>
    </svg>
  </span>
  <span class="cedar-fab__copy">
    <span class="cedar-fab__label cedar-fab__label--ask">Ask Cedar</span>
    <span class="cedar-fab__context">Questions about Lumecon</span>
  </span>
  <span class="cedar-fab__label cedar-fab__label--close">Close</span>
</button>

{
  /* One-time-per-session helper nudge. Hidden until the timer in the
     script below shows it; role="status" announces the offer politely
     to screen readers when it appears. */
}
<div class="cedar-nudge" id="cedarNudge" role="status" hidden>
  <button
    type="button"
    class="cedar-nudge__dismiss"
    id="cedarNudgeDismiss"
    aria-label="Dismiss this message"
  >
    <svg
      viewBox="0 0 24 24"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="6" y1="6" x2="18" y2="18"></line>
      <line x1="18" y1="6" x2="6" y2="18"></line>
    </svg>
  </button>
  <p class="cedar-nudge__text">
    Hi, I'm Cedar. If you have any questions about Lumecon or economic impact analysis, I'm happy to
    help.
  </p>
</div>

{
  /* Self-contained Cedar chat panel. Hidden until the FAB opens it.
     Class-scoped (cedar-fab-panel + child .cedar-chat etc.) so it
     coexists with the inline Cedar chat on the homepage without
     element-id collisions. */
}
<div
  class="cedar-fab-panel"
  id="cedarFabPanel"
  role="dialog"
  aria-label="Ask Cedar"
  aria-hidden="true"
  hidden
>
  <button
    class="cedar-fab-panel__close"
    type="button"
    aria-label="Close Cedar"
    data-cedar-fab-close
  >
    <svg
      viewBox="0 0 16 16"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
    >
      <path d="m3.5 3.5 9 9m0-9-9 9"></path>
    </svg>
  </button>
  <CedarChat />
</div>

<script>
  /* Bundled module: imports the shared Cedar chat runtime + the
     observability surface from src/lib. Re-runs on view transitions
     via astro:page-load. */
  import { bootChat } from '../lib/cedarChat';
  import { trackEvent } from '../lib/observability';

  function setup(): void {
    const fab = document.getElementById('cedarFab');
    const panel = document.getElementById('cedarFabPanel');
    if (!fab || !panel) return;

    // Boot the chat runtime (idempotent — guards on data-cedar-booted).
    bootChat(panel, { surface: 'fab' });

    // FAB-specific open/close handlers. Guard against double-binding
    // when astro:page-load re-fires this script.
    if ((fab as HTMLElement & { __cedarBound?: boolean }).__cedarBound) return;
    (fab as HTMLElement & { __cedarBound?: boolean }).__cedarBound = true;

    // ---- Helper nudge (one per browser session) ----
    const nudge = document.getElementById('cedarNudge');
    const NUDGE_KEY = 'lumecon-cedar-nudge-seen';
    const markNudgeSeen = (): void => {
      try {
        sessionStorage.setItem(NUDGE_KEY, '1');
      } catch {
        /* storage unavailable */
      }
    };
    const hideNudge = (): void => {
      if (nudge && !nudge.hidden) nudge.hidden = true;
    };

    /* The launcher is supporting navigation, not part of the hero. Keep it
       out of the opening composition, and do not let a fixed control cover
       a price, definition, product screen or another control farther down
       the page. The collision list combines semantic controls with the few
       page surfaces whose whole rectangle carries meaning. */
    const main = document.querySelector<HTMLElement>('main');
    const intro = main?.firstElementChild instanceof HTMLElement ? main.firstElementChild : null;
    const avoidSelector = [
      'a[href]',
      'button',
      'input',
      'select',
      'textarea',
      'summary',
      '[role="button"]',
      '[tabindex]:not([tabindex="-1"])',
      'table',
      '[data-zoom]',
      '.pr-free',
      '.pr-plan',
      '.pr-grove',
      '.meth-defs__row',
      '.naics-tile',
      '.footer',
    ].join(',');
    let visibilityFrame = 0;

    const setLauncherVisibility = (visible: boolean, reason: 'waiting' | 'avoiding'): void => {
      if (!visible && document.activeElement === fab) return;
      fab.dataset.cedarVisibility = visible ? 'visible' : reason;
      if (visible) {
        fab.removeAttribute('aria-hidden');
        fab.removeAttribute('tabindex');
      } else {
        fab.setAttribute('aria-hidden', 'true');
        fab.setAttribute('tabindex', '-1');
        hideNudge();
      }
    };

    const introHasPassed = (): boolean => {
      if (!intro) return window.scrollY > Math.min(240, window.innerHeight * 0.3);
      const navBottom = document
        .querySelector<HTMLElement>('body > nav')
        ?.getBoundingClientRect().bottom;
      const clearLine = Math.max(88, (navBottom || 72) + 16);
      return intro.getBoundingClientRect().bottom <= clearLine;
    };

    const overlapsProtectedContent = (): boolean => {
      const fabRect = fab.getBoundingClientRect();
      const clearance = 10;
      const zones = document.querySelectorAll<HTMLElement>(avoidSelector);
      for (const zone of zones) {
        if (
          zone === fab ||
          fab.contains(zone) ||
          panel.contains(zone) ||
          nudge?.contains(zone) ||
          zone.hidden
        ) {
          continue;
        }
        const rect = zone.getBoundingClientRect();
        if (!rect.width || !rect.height || rect.bottom <= 0 || rect.top >= window.innerHeight) {
          continue;
        }
        if (
          rect.right > fabRect.left - clearance &&
          rect.left < fabRect.right + clearance &&
          rect.bottom > fabRect.top - clearance &&
          rect.top < fabRect.bottom + clearance
        ) {
          return true;
        }
      }
      return false;
    };

    const updateLauncherVisibility = (): void => {
      visibilityFrame = 0;
      if (document.body.classList.contains('cedar-popped')) return;
      if (!introHasPassed()) {
        setLauncherVisibility(false, 'waiting');
        return;
      }
      setLauncherVisibility(!overlapsProtectedContent(), 'avoiding');
    };

    const scheduleLauncherVisibility = (): void => {
      if (visibilityFrame) return;
      visibilityFrame = window.requestAnimationFrame(updateLauncherVisibility);
    };

    const open = () => {
      markNudgeSeen();
      hideNudge();
      setLauncherVisibility(true, 'waiting');
      panel.hidden = false;
      panel.setAttribute('aria-hidden', 'false');
      document.body.classList.add('cedar-popped');
      fab.setAttribute('aria-expanded', 'true');
      fab.setAttribute('aria-label', 'Close Cedar');
      fab.setAttribute('title', 'Close Cedar');
      const input = panel.querySelector<HTMLInputElement>('[data-cedar-input]');
      window.setTimeout(() => input?.focus({ preventScroll: true }), 180);
      trackEvent('cedar.fab.open');
    };
    const close = () => {
      // If focus is inside the panel when it closes, hand it back to the
      // FAB so keyboard users aren't dropped at the top of the document.
      const returnFocus = panel.contains(document.activeElement);
      panel.hidden = true;
      panel.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('cedar-popped');
      fab.setAttribute('aria-expanded', 'false');
      fab.removeAttribute('aria-label');
      fab.setAttribute('title', 'Ask Cedar');
      if (returnFocus) (fab as HTMLElement).focus({ preventScroll: true });
      trackEvent('cedar.fab.close');
      scheduleLauncherVisibility();
    };

    // The panel is a modal-ish dialog: while it's open, keep Tab focus
    // cycling between the FAB (which is the Close control in this state)
    // and the panel's controls so keyboard users can't tab out into the
    // page behind it. Queried live each time so dynamically added chips,
    // feedback, and follow-up buttons are included.
    const focusables = (): HTMLElement[] => {
      const sel =
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';
      const inPanel = Array.from(panel.querySelectorAll<HTMLElement>(sel)).filter(
        (el) => !el.hidden && el.offsetParent !== null,
      );
      // The FAB hides while the docked panel is open; only include it in
      // the cycle when it is actually visible.
      return (fab as HTMLElement).offsetParent !== null
        ? [fab as HTMLElement, ...inPanel]
        : inPanel;
    };

    fab.addEventListener('click', (e) => {
      e.stopPropagation();
      if (document.body.classList.contains('cedar-popped')) close();
      else open();
    });
    fab.addEventListener('blur', scheduleLauncherVisibility);

    panel.querySelector('[data-cedar-fab-close]')?.addEventListener('click', () => close());

    // Keep the dormant nudge's explicit dismiss path wired. There is no
    // auto-show timer, and /cedar uses its inline chat instead of this FAB.
    if (nudge && !window.location.pathname.startsWith('/cedar')) {
      const dismiss = document.getElementById('cedarNudgeDismiss');
      dismiss?.addEventListener('click', () => {
        markNudgeSeen();
        const returnFocus = nudge.contains(document.activeElement);
        hideNudge();
        if (returnFocus) (fab as HTMLElement).focus({ preventScroll: true });
        trackEvent('cedar.nudge.dismiss');
      });
      /* The auto-show timer is disabled: unprompted popups read as
         spam next to the quieter v3 design. The bubble markup stays
         (dismiss handler above) in case a future surface opens it
         deliberately, but nothing pops on its own. */
    }
    document.addEventListener('keydown', (e) => {
      if (!document.body.classList.contains('cedar-popped')) return;
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (items.length < 2) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement as HTMLElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      } else if (active !== fab && !panel.contains(active)) {
        // Focus escaped the dialog — pull it back to the first control.
        e.preventDefault();
        first.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!document.body.classList.contains('cedar-popped')) return;
      // Use composedPath rather than panel.contains(target): a chip
      // click handler inside the panel may detach the clicked
      // element (e.g. the follow-up chip row removes itself before
      // the click finishes bubbling). composedPath captures the
      // original ancestor chain at dispatch time, so it still
      // recognises the click as inside the panel.
      const path = e.composedPath();
      if (path.includes(panel) || path.includes(fab)) return;
      close();
    });

    window.addEventListener('scroll', scheduleLauncherVisibility, { passive: true });
    window.addEventListener('resize', scheduleLauncherVisibility, { passive: true });
    window.addEventListener('load', scheduleLauncherVisibility, { once: true });
    if ('ResizeObserver' in window && main) {
      const layoutObserver = new ResizeObserver(scheduleLauncherVisibility);
      layoutObserver.observe(main);
      if (intro && intro !== main) layoutObserver.observe(intro);
    }
    void document.fonts?.ready.then(scheduleLauncherVisibility);
    scheduleLauncherVisibility();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .cedar-fab {
    position: fixed;
    /* Lift the bottom-anchored FAB above iOS Safari's home-indicator
       strip on notch iPhones (viewport-fit=cover lets the viewport
       extend under it). env() falls back to 0 on hosts without a
       safe area. */
    right: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-right, 0px));
    bottom: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-bottom, 0px));
    z-index: 80;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.55rem;
    padding: 0.55rem 0.85rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: 0.5rem;
    box-shadow:
      0 4px 12px rgba(10, 15, 38, 0.08),
      0 8px 24px rgba(10, 15, 38, 0.04);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      background 0.2s var(--ease),
      box-shadow 0.2s var(--ease),
      opacity 0.16s var(--ease),
      transform 0.2s var(--ease);
  }
  .cedar-fab[data-cedar-visibility='visible'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  /* Closed state: a compact product-mark label. Keeping this to one line
     prevents a persistent helper from covering definitions, prices or CTAs. */
  .cedar-fab:hover {
    background: var(--cream);
    transform: translateY(-2px);
    box-shadow:
      0 6px 16px rgba(10, 15, 38, 0.1),
      0 12px 32px rgba(10, 15, 38, 0.06);
  }
  @media (prefers-reduced-motion: reduce) {
    .cedar-fab {
      transition: none;
    }
    .cedar-fab:hover {
      transform: none;
    }
  }
  .cedar-fab:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 4px;
  }
  .cedar-fab__dot {
    display: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 1px var(--rule-strong);
    flex: 0 0 auto;
  }
  .cedar-fab__copy {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .cedar-fab__label--ask {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .cedar-fab__context {
    display: none;
  }
  .cedar-fab__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cedar-fab__icon svg {
    display: block;
  }
  .cedar-fab__icon--close,
  .cedar-fab__label--close {
    display: none;
  }
  .cedar-fab__icon--mark {
    display: inline-flex;
  }
  .cedar-fab__icon--mark img {
    display: block;
    width: 30px;
    height: 30px;
  }
  .cedar-fab__icon--close {
    width: 22px;
    height: 22px;
  }

  /* On small screens the launcher collapses to a compact circle so it
     never covers CTAs, pricing cards or other page controls. The full
     two-line pill only exists at desktop widths. */
  @media (max-width: 760px) {
    .cedar-fab,
    body.cedar-popped .cedar-fab {
      width: 48px;
      height: 48px;
      padding: 0;
      gap: 0;
      border-radius: 50%;
      justify-content: center;
      right: calc(0.7rem + env(safe-area-inset-right, 0px));
      bottom: calc(0.7rem + env(safe-area-inset-bottom, 0px));
    }
    .cedar-fab__copy,
    .cedar-fab__label--close {
      display: none;
    }
    .cedar-fab__icon--mark {
      display: inline-flex;
    }
    body.cedar-popped .cedar-fab__icon--mark {
      display: none;
    }
    .cedar-fab__dot {
      position: absolute;
      top: 4px;
      right: 4px;
    }
    body.cedar-popped .cedar-fab__dot {
      display: none;
    }
  }

  /* Open state = a clear navy "Close" pill (the launcher steps aside). */
  body.cedar-popped .cedar-fab {
    background: var(--navy);
    color: #fff;
    border-color: transparent;
    gap: 0.5rem;
    padding: 0.7rem 1.05rem;
    border-radius: 999px;
    box-shadow: 0 6px 16px rgba(10, 15, 38, 0.3);
  }
  body.cedar-popped .cedar-fab:hover {
    background: var(--navy2);
    transform: none;
  }
  body.cedar-popped .cedar-fab__dot,
  body.cedar-popped .cedar-fab__copy {
    display: none;
  }
  body.cedar-popped .cedar-fab__icon--close {
    display: inline-flex;
  }
  body.cedar-popped .cedar-fab__label--close {
    display: inline;
  }

  /* ---------- The self-contained chat panel ----------
     Docked, not floating: the open panel pins flush to the bottom of
     the viewport like a bottom sheet, top corners only. The FAB hides
     while the panel is open (the panel carries its own close button),
     and returns when it closes. */
  .cedar-fab-panel {
    position: fixed;
    bottom: env(safe-area-inset-bottom, 0px);
    right: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-right, 0px));
    width: min(380px, calc(100vw - 1.8rem));
    max-height: calc(100dvh - 5rem);
    z-index: 85;
    display: flex;
    flex-direction: column;
    animation: cedar-pop-in 0.25s var(--ease);
  }
  .cedar-fab-panel[hidden] {
    display: none;
  }
  :global(body.cedar-popped) .cedar-fab {
    display: none;
  }
  .cedar-fab-panel__close {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    z-index: 3;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
  }
  .cedar-fab-panel__close:hover {
    background: var(--accent-rgba-08);
    color: var(--navy);
  }
  .cedar-fab-panel__close svg {
    width: 14px;
    height: 14px;
  }
  /* Leave room for the close button so it never overlaps the Online
     status in the chat header. */
  .cedar-fab-panel :global(.cedar-chat__status) {
    margin-right: 3rem;
  }
  .cedar-fab-panel :global(.cedar-chat) {
    width: 100%;
    border-radius: 8px 8px 0 0;
    border-bottom: 0;
    max-height: calc(100dvh - 5rem);
    display: flex;
    flex-direction: column;
    box-shadow:
      0 24px 60px -16px rgba(10, 15, 38, 0.28),
      0 4px 16px rgba(10, 15, 38, 0.14);
  }
  .cedar-fab-panel :global(.cedar-chat__transcript) {
    flex: 1 1 auto;
    min-height: 180px;
  }
  @keyframes cedar-pop-in {
    from {
      transform: translateY(12px) scale(0.97);
      opacity: 0;
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cedar-fab-panel {
      animation: none;
    }
  }

  /* ---------- The helper nudge ---------- */
  .cedar-nudge {
    position: fixed;
    right: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-right, 0px));
    bottom: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-bottom, 0px) + 4.15rem);
    z-index: 79;
    width: min(280px, calc(100vw - 1.8rem));
    padding: 0.9rem 1rem 0.85rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: 0.5rem;
    box-shadow:
      0 12px 32px rgba(10, 15, 38, 0.14),
      0 4px 12px rgba(10, 15, 38, 0.08);
    animation: cedar-pop-in 0.25s var(--ease);
  }
  /* Speech-bubble tail: a rotated square hanging off the bottom edge,
     pointing down at the launcher pill. It shares the bubble's surface
     and border so the two read as one shape; the half that overlaps the
     bubble covers the border line behind it. */
  .cedar-nudge::after {
    content: '';
    position: absolute;
    bottom: -7px;
    right: 30px;
    width: 12px;
    height: 12px;
    background: var(--surface);
    border-right: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    transform: rotate(45deg);
  }
  .cedar-nudge[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .cedar-nudge {
      animation: none;
    }
  }
  .cedar-nudge__text {
    margin: 0 2.35rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .cedar-nudge__dismiss {
    position: absolute;
    top: 0.15rem;
    right: 0.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    color: var(--ink-3);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }
  .cedar-nudge__dismiss:hover {
    color: var(--ink);
    background: var(--cream);
  }
  .cedar-nudge__dismiss:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    :global(body.consent-pending) .cedar-fab,
    :global(body.consent-pending) .cedar-nudge {
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* Mobile: the docked panel becomes a full-width bottom sheet. */
  @media (max-width: 600px) {
    .cedar-fab-panel {
      left: 0;
      right: 0;
      width: 100%;
      bottom: 0;
      max-height: min(78dvh, 560px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: var(--surface);
