---
/**
 * Analytics consent banner.
 *
 * Shown only when the visitor hasn't chosen yet (consent === 'unset').
 * Until they Accept, analytics stays off (see src/lib/consent.ts and the
 * gated observability boot in BaseLayout). Anchored bottom-left so it
 * doesn't collide with the Cedar FAB on the bottom-right; on phones it is a
 * bar docked to the bottom edge (the FAB is hidden while it shows).
 */
---

<div
  class="consent"
  id="consentBanner"
  role="dialog"
  aria-label="Analytics consent"
  aria-live="polite"
  hidden
>
  <p class="consent__text">
    We use optional analytics to improve Lumecon. <a href="/privacy">Privacy Policy</a>
  </p>
  <div class="consent__actions">
    <button type="button" class="consent__btn consent__btn--ghost" data-consent="denied"
      >Decline</button
    >
    <button type="button" class="consent__btn consent__btn--accept" data-consent="granted"
      >Accept</button
    >
  </div>
</div>

<script>
  import { getConsent, setConsent } from '../lib/consent';

  /* While the banner shows, publish how much of the viewport's bottom edge it
     covers. The page reserves that much space (see the styles below), so a
     visitor can always scroll content, and keyboard focus, clear of it. */
  let footprint: ResizeObserver | null = null;
  function reserve(banner: HTMLElement): void {
    const root = document.documentElement;
    const measure = (): void => {
      // Layout box, not getBoundingClientRect: the entrance animation
      // translates the banner, and the reservation must not follow it.
      const covered = banner.hidden
        ? 0
        : banner.offsetHeight + (parseFloat(getComputedStyle(banner).bottom) || 0);
      root.style.setProperty('--consent-space', `${Math.max(0, Math.round(covered))}px`);
    };
    measure();
    footprint ??= new ResizeObserver(measure);
    footprint.observe(banner);
  }
  function release(): void {
    footprint?.disconnect();
    document.documentElement.style.removeProperty('--consent-space');
  }

  function setup(): void {
    const banner = document.getElementById('consentBanner');
    if (!banner) return;
    // Only surface the banner if the visitor hasn't decided yet.
    if (getConsent() !== 'unset') {
      banner.hidden = true;
      document.body.classList.remove('consent-pending');
      release();
      return;
    }
    if ((banner as HTMLElement & { __bound?: boolean }).__bound) {
      banner.hidden = false;
      document.body.classList.add('consent-pending');
      reserve(banner);
      return;
    }
    (banner as HTMLElement & { __bound?: boolean }).__bound = true;
    banner.hidden = false;
    document.body.classList.add('consent-pending');
    reserve(banner);
    banner.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest<HTMLElement>('[data-consent]');
      if (!btn) return;
      const choice = btn.dataset.consent;
      if (choice === 'granted' || choice === 'denied') {
        setConsent(choice);
        banner.hidden = true;
        document.body.classList.remove('consent-pending');
        release();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .consent {
    position: fixed;
    /* Inset by the safe area so the banner clears iPhone notches /
       home indicator when viewport-fit=cover lets the viewport
       extend under them. */
    left: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-left, 0px));
    bottom: calc(clamp(0.9rem, 2.2vw, 1.5rem) + env(safe-area-inset-bottom, 0px));
    z-index: 90;
    width: min(420px, calc(100vw - 1.8rem));
    background: #0a0f26;
    color: #fff;
    border-radius: 6px;
    padding: 1rem 1.1rem 1.05rem;
    /* The hairline keeps its edge where it sits over the footer's own navy
       bar at the end of a page. */
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      0 2px 8px -3px rgba(10, 15, 38, 0.14),
      0 20px 44px -22px rgba(10, 15, 38, 0.34);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    animation: consent-in 0.3s var(--ease) both;
  }
  .consent[hidden] {
    display: none;
  }
  .consent__text {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.86);
  }
  .consent__text a {
    color: var(--accent-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .consent__actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
  }
  .consent__btn {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    min-height: 44px;
    /* 6px, the site's button radius. These were full 999px pills, which is
       a shape that appears nowhere else here and made the first thing a
       visitor sees the thing that matched the design least. */
    border-radius: 6px;
    cursor: pointer;
    transition:
      background 0.15s var(--ease),
      border-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }
  .consent__btn--ghost {
    background: transparent;
    color: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.28);
  }
  .consent__btn--ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  .consent__btn--accept {
    background: var(--accent);
    color: #0a0f26;
    border: 1px solid var(--accent);
  }
  .consent__btn--accept:hover {
    background: var(--accent-light);
    border-color: var(--accent-light);
  }
  .consent__btn:focus-visible {
    outline: 2px solid var(--accent-light);
    outline-offset: 2px;
  }
  /* While the banner shows, the page ends that much later, so its last
     links can be scrolled clear of it, and scrolling to a focused control
     or an anchor stops short of it (WCAG 2.4.11, focus not obscured). The
     footer's closing bar grows on its own ground (0.55rem is its own
     padding, footer.css); pages without it pad the body. */
  :global(html:has(body.consent-pending)) {
    scroll-padding-bottom: var(--consent-space, 0px);
  }
  :global(body.consent-pending .footer-bar) {
    padding-bottom: calc(0.55rem + var(--consent-space, 0px));
  }
  :global(body.consent-pending:not(:has(.footer-bar))) {
    padding-bottom: var(--consent-space, 0px);
  }
  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* On phones the banner is a thin bar docked to the bottom edge rather than
     a card floating over the page: one row, text left and buttons right,
     clear of the home indicator and side notches. */
  @media (max-width: 640px) {
    .consent {
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      border-radius: 0;
      padding: 0.5rem calc(16px + env(safe-area-inset-right, 0px))
        calc(0.5rem + env(safe-area-inset-bottom, 0px)) calc(16px + env(safe-area-inset-left, 0px));
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.1),
        0 -14px 32px -22px rgba(10, 15, 38, 0.5);
    }
    .consent__text {
      font-size: 0.75rem;
      line-height: 1.35;
    }
    .consent__actions {
      flex-shrink: 0;
    }
    .consent__btn {
      font-size: 0.78rem;
      padding: 0 0.75rem;
      min-height: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .consent {
      animation: none;
    }
  }
</style>
