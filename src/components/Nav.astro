---
/**
 * Nav — brand on the left, a single Menu button on the right, on
 * every viewport (the pattern the refreshed IMPLAN site uses).
 * The menu opens a full-screen overlay with the destinations that
 * matter: How it works, Pricing, Methodology, Log in, Sign up.
 */
import { site } from '../config';
import BrandWordmark from './BrandWordmark.astro';
interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;
---

<nav id="nav" class={isHome ? 'nav--fixed' : 'nav--static'} aria-label="Main navigation">
  <div class="nav-w">
    <div class="nav-brand">
      <BrandWordmark size="sm" ariaLabel={`${site.legalName} home`} taglineHidden={true} />
      <span class="nav-brand__sep" aria-hidden="true">|</span>
      <span class="nav-brand__desc">Economic impact analysis software</span>
    </div>

    <button
      class="navm-btn"
      id="navMenuBtn"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="navMenu"
    >
      <span class="navm-btn__label">Menu</span>
      <span class="navm-btn__bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</nav>

<!-- The overlay must be a SIBLING of <nav>, not a child: the nav bar
     carries backdrop-filter (always on inner pages, on scroll on the
     homepage), and a filtered ancestor becomes the containing block
     for position: fixed descendants. Inside the nav, the "full
     screen" overlay was silently confined to the bar's own box. -->
<div class="navm" id="navMenu" hidden>
  <div class="navm-inner">
    <ul class="navm-list">
      <li><a href="/#product">How it works</a></li>
      <li><a href="/pricing">Pricing</a></li>
      <li><a href="/methodology">Methodology</a></li>
      <li><a href="/login">Log in</a></li>
      <li><a class="navm-list__cta" href="/signup">Sign up</a></li>
    </ul>
    <a class="navm-contact" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</div>

<script>
  (function () {
    const btn = document.getElementById('navMenuBtn');
    const menu = document.getElementById('navMenu');
    if (!btn || !menu) return;

    const open = () => {
      menu.hidden = false;
      btn.classList.add('on');
      btn.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('navm-open');
      const first = menu.querySelector('a');
      if (first) (first as HTMLElement).focus();
    };
    const close = (refocus = true) => {
      menu.hidden = true;
      btn.classList.remove('on');
      btn.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('navm-open');
      if (refocus) btn.focus();
    };

    btn.addEventListener('click', () => (menu.hidden ? open() : close()));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) close();
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || menu.hidden) return;
      const focusable = menu.querySelectorAll('a');
      const first = focusable[0] as HTMLElement;
      const last = focusable[focusable.length - 1] as HTMLElement;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>
