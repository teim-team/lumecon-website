---
/**
 * Nav — brand on the left, core destinations inline on desktop and a
 * full-screen menu below the point where that row stops fitting.
 *
 * The destinations are grouped. Six flat links had already reached the
 * width the bar can hold, which is why the gaps below are fluid and why
 * every new page had to argue for one of the slots. More than that, the
 * flat row said nothing about how the pages relate: Cedar, Cedar Impact
 * and Cedar Grove are one product family and read as three unrelated
 * destinations beside Pricing and Team.
 *
 * So: four top-level items, three of which open a short list. A group can
 * take a new page without the bar growing, which is the point. Each panel
 * is a disclosure button, open on click or keyboard and on hover as an
 * enhancement, closed by Escape or a click outside. On a phone the same
 * groups render as headed sections in the existing overlay, with no
 * toggles: a list that is already one per line gains nothing from being
 * folded again.
 */
import { site } from '../config';
import BrandWordmark from './BrandWordmark.astro';
interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

type NavLink = { href: string; text: string; desc?: string };
type NavItem = {
  id: string;
  label: string;
  href?: string;
  links?: NavLink[];
  /** One quiet link under a group's list, for a destination that belongs
      with the group without competing with its products. */
  foot?: NavLink;
};

const NAV: NavItem[] = [
  {
    id: 'product',
    label: 'Product',
    links: [
      { href: '/#product', text: 'Cedar Impact', desc: 'Where you run economic impact analysis.' },
      { href: '/cedar', text: 'Cedar', desc: 'The AI economic analyst, in every plan.' },
      {
        href: '/cedar-grove',
        text: 'Cedar Grove',
        desc: "The living evidence base for your organization's economy.",
      },
    ],
    foot: { href: '/start', text: 'Not sure where to start? Plan your first analysis' },
  },
  { id: 'pricing', label: 'Pricing', href: '/pricing' },
  {
    id: 'resources',
    label: 'Resources',
    links: [
      { href: '/start', text: 'Plan your first analysis', desc: 'Find a scope you can run, and what to bring.' },
      { href: '/methodology', text: 'Methodology', desc: 'The economics, with the equations.' },
      { href: '/glossary', text: 'Glossary', desc: 'The terms, defined plainly.' },
      { href: '/naics', text: 'Industry sectors', desc: 'What the classification covers.' },
    ],
  },
  {
    id: 'company',
    label: 'Company',
    links: [
      { href: '/team', text: 'Team' },
      { href: '/security', text: 'Security' },
      { href: `mailto:${site.email}`, text: 'Contact' },
    ],
  },
];

/** True when this group holds the page being viewed, so the parent marks it. */
const holdsCurrent = (item: NavItem) =>
  Boolean(item.links?.some((l) => l.href.replace(/\/$/, '') === currentPath));
---

<nav id="nav" class={isHome ? 'nav--fixed' : 'nav--static'} aria-label="Main navigation">
  <div class="nav-w">
    <div class="nav-brand">
      <BrandWordmark size="sm" teal ariaLabel={`${site.legalName} home`} taglineHidden={true} />
      <span class="nav-brand__sep" aria-hidden="true">
        |
      </span>
      <span class="nav-brand__desc">The Intelligent Economic Analysis Platform</span>
    </div>

    <div class="nav-right">
      <ul class="nav-links">
        {
          NAV.map((item) =>
            item.links ? (
              <li class="nav-item" data-nav-group>
                <button
                  type="button"
                  class="nav-toggle"
                  id={`navt-${item.id}`}
                  aria-expanded="false"
                  aria-controls={`navp-${item.id}`}
                  data-current={holdsCurrent(item) ? 'true' : undefined}
                >
                  {item.label}
                  <span class="nav-toggle__chev" aria-hidden="true"></span>
                </button>
                <div
                  class={`nav-panel${item.links.some((l) => l.desc) ? '' : ' nav-panel--plain'}`}
                  id={`navp-${item.id}`}
                  hidden
                >
                  <ul role="list">
                    {item.links.map((l) => (
                      <li>
                        <a
                          href={l.href}
                          aria-current={
                            l.href.replace(/\/$/, '') === currentPath ? 'page' : undefined
                          }
                        >
                          <span class="nav-panel__text">{l.text}</span>
                          {l.desc ? <span class="nav-panel__desc">{l.desc}</span> : null}
                        </a>
                      </li>
                    ))}
                  </ul>
                  {item.foot ? (
                    <p class="nav-panel__foot">
                      <a href={item.foot.href}>{item.foot.text}</a>
                    </p>
                  ) : null}
                </div>
              </li>
            ) : (
              <li class="nav-item">
                <a
                  href={item.href}
                  aria-current={item.href === currentPath ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <span class="nav-links__sep" aria-hidden="true"></span>
      <a
        class="nav-login"
        href="/login"
        aria-current={currentPath === '/login' ? 'page' : undefined}
      >
        Log in
      </a>
      <a
        class="nav-signup"
        href="/signup"
        aria-current={currentPath === '/signup' ? 'page' : undefined}
      >
        Request access
      </a>

      <button
        class="navm-btn"
        id="navMenuBtn"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="navMenu"
      >
        <span class="navm-btn__label">Menu</span>
        <span class="navm-btn__bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</nav>

{/* The overlay must be a SIBLING of <nav>, not a child: the nav bar
     carries backdrop-filter (always on inner pages, on scroll on the
     homepage), and a filtered ancestor becomes the containing block
     for position: fixed descendants. Inside the nav, the "full
     screen" overlay was silently confined to the bar's own box. */}
<div class="navm" id="navMenu" hidden>
  <div class="navm-inner">
    <ul class="navm-list">
      {
        NAV.map((item) =>
          item.links ? (
            <li class="navm-group">
              <p class="navm-group__label">{item.label}</p>
              <ul role="list">
                {item.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      aria-current={l.href.replace(/\/$/, '') === currentPath ? 'page' : undefined}
                    >
                      {l.text}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={item.href} aria-current={item.href === currentPath ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ),
        )
      }
      <li>
        <a href="/login" aria-current={currentPath === '/login' ? 'page' : undefined}>
          Log in
        </a>
      </li>
      <li>
        <a
          class="navm-list__cta"
          href="/signup"
          aria-current={currentPath === '/signup' ? 'page' : undefined}
        >
          Request access
        </a>
      </li>
    </ul>
    <a class="navm-contact" href={`mailto:${site.email}`}>
      {site.email}
    </a>
  </div>
</div>

<script>
  /* The grouped destinations. A disclosure button each: click or keyboard
     opens, Escape or a click outside closes, and a pointer opening one
     while another is open swaps them rather than stacking. Hover is an
     enhancement layered on top, so nothing here depends on a pointer. */
  (function () {
    const groups = Array.from(document.querySelectorAll('[data-nav-group]'));
    if (!groups.length) return;

    const parts = groups.map((group) => ({
      group,
      toggle: group.querySelector<HTMLButtonElement>('.nav-toggle'),
      panel: group.querySelector<HTMLElement>('.nav-panel'),
      /* A pointer opens a panel on the way to clicking its button. Without
         this the click would read the panel as already open and close the
         thing the person was reaching for. */
      openedByHover: false,
    }));

    let hoverTimer = 0;

    function setOpen(part: (typeof parts)[number], open: boolean) {
      if (!part.toggle || !part.panel) return;
      part.panel.hidden = !open;
      part.toggle.setAttribute('aria-expanded', String(open));
      part.group.classList.toggle('on', open);
    }

    function closeAll(except?: (typeof parts)[number]) {
      for (const part of parts) if (part !== except) setOpen(part, false);
    }

    for (const part of parts) {
      part.toggle?.addEventListener('click', () => {
        const open = part.toggle?.getAttribute('aria-expanded') === 'true' && !part.openedByHover;
        part.openedByHover = false;
        closeAll(part);
        setOpen(part, !open);
      });

      /* Hovering a sibling swaps panels immediately; leaving the group
         waits a moment, so crossing the gap between the button and its
         panel does not close it under the pointer. */
      part.group.addEventListener('pointerenter', (event) => {
        if ((event as PointerEvent).pointerType === 'touch') return;
        window.clearTimeout(hoverTimer);
        closeAll(part);
        part.openedByHover = part.toggle?.getAttribute('aria-expanded') !== 'true';
        setOpen(part, true);
      });
      part.group.addEventListener('pointerleave', (event) => {
        if ((event as PointerEvent).pointerType === 'touch') return;
        hoverTimer = window.setTimeout(() => {
          part.openedByHover = false;
          setOpen(part, false);
        }, 140);
      });

      /* Tabbing out of the last link in a panel should close it, the same
         way clicking elsewhere does. */
      part.group.addEventListener('focusout', (event) => {
        const next = (event as FocusEvent).relatedTarget as Node | null;
        if (next && part.group.contains(next)) return;
        setOpen(part, false);
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const open = parts.find((part) => part.toggle?.getAttribute('aria-expanded') === 'true');
      if (!open) return;
      setOpen(open, false);
      open.toggle?.focus();
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (parts.some((part) => part.group.contains(target))) return;
      closeAll();
    });
  })();

  (function () {
    const btn = document.getElementById('navMenuBtn');
    const menu = document.getElementById('navMenu');
    if (!btn || !menu) return;
    const label = btn.querySelector('.navm-btn__label');

    const open = () => {
      menu.hidden = false;
      btn.classList.add('on');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Close menu');
      if (label) label.textContent = 'Close';
      document.documentElement.classList.add('navm-open');
      const first = menu.querySelector('a');
      if (first) (first as HTMLElement).focus();
    };
    const close = (refocus = true) => {
      menu.hidden = true;
      btn.classList.remove('on');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Menu');
      if (label) label.textContent = 'Menu';
      document.documentElement.classList.remove('navm-open');
      if (refocus) btn.focus();
    };

    btn.addEventListener('click', () => (menu.hidden ? open() : close()));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close()));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) close();
      if (e.key !== 'Tab' || menu.hidden) return;
      const focusable = [btn, ...menu.querySelectorAll('a')];
      const first = focusable[0] as HTMLElement;
      const last = focusable[focusable.length - 1] as HTMLElement;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // A phone can cross the desktop breakpoint when it rotates, and a
    // browser window can be widened while the overlay is open. Once the
    // inline navigation takes over, close the now-unreachable overlay and
    // release the page scroll without trying to focus the hidden toggle.
    const desktop = window.matchMedia('(min-width: 1000px)');
    desktop.addEventListener('change', (event) => {
      if (!event.matches || menu.hidden) return;
      const hadOverlayFocus =
        document.activeElement === btn || menu.contains(document.activeElement);
      close(false);
      if (hadOverlayFocus) {
        /* The current page may live inside a closed panel, and focus cannot
           land on something hidden. The group's own button carries the same
           mark, so it is the right destination when there is one. */
        const destination =
          document.querySelector<HTMLElement>('.nav-toggle[data-current="true"]') ||
          document.querySelector<HTMLElement>('.nav-links > .nav-item > a[aria-current="page"]') ||
          document.querySelector<HTMLElement>('.nav-brand a');
        destination?.focus();
      }
    });
  })();
</script>
