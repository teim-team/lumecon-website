---
/**
 * Ask any AI about Lumecon — tiles that open the major assistants
 * with a Lumecon question prefilled where the platform supports it.
 * Each tile carries a simplified, hand-drawn nod to the assistant's
 * mark (monochrome, currentColor) rather than a text pill.
 */
import '../styles/home.css';

const QUESTION = 'What is Lumecon (lumecon.ai), the economic impact analysis software?';
const q = encodeURIComponent(QUESTION);

const ASSISTANTS = [
  { name: 'ChatGPT', href: `https://chatgpt.com/?q=${q}`, icon: 'openai' },
  { name: 'Claude', href: `https://claude.ai/new?q=${q}`, icon: 'claude' },
  { name: 'Gemini', href: 'https://gemini.google.com/app', icon: 'gemini' },
  { name: 'Copilot', href: `https://copilot.microsoft.com/?q=${q}`, icon: 'copilot' },
  { name: 'Grok', href: `https://grok.com/?q=${q}`, icon: 'grok' },
  { name: 'Perplexity', href: `https://www.perplexity.ai/search?q=${q}`, icon: 'perplexity' },
];
---

<section class="askai" aria-labelledby="askai-title">
  <div class="askai-inner">
    <p class="h-kicker" id="askai-title">Ask any AI about Lumecon</p>
    <p class="askai-note">
      Researching tools through an assistant? Ask yours about Lumecon and compare what it says with
      what you see here.
    </p>
    <ul class="askai-grid">
      {
        ASSISTANTS.map((a) => (
          <li>
            <a class="askai-tile" href={a.href} target="_blank" rel="noopener noreferrer">
              <span class="askai-tile__ic" aria-hidden="true">
                {a.icon === 'openai' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                    <g>
                      <path d="M12 4.6a4.1 4.1 0 0 1 4.1 4.1v.9" transform="rotate(0 12 12)" />
                      <path d="M12 4.6a4.1 4.1 0 0 1 4.1 4.1v.9" transform="rotate(60 12 12)" />
                      <path d="M12 4.6a4.1 4.1 0 0 1 4.1 4.1v.9" transform="rotate(120 12 12)" />
                      <path d="M12 4.6a4.1 4.1 0 0 1 4.1 4.1v.9" transform="rotate(180 12 12)" />
                      <path d="M12 4.6a4.1 4.1 0 0 1 4.1 4.1v.9" transform="rotate(240 12 12)" />
                      <path d="M12 4.6a4.1 4.1 0 0 1 4.1 4.1v.9" transform="rotate(300 12 12)" />
                    </g>
                  </svg>
                )}
                {a.icon === 'claude' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <g stroke-linecap="butt">
                      <path d="M12 3.2v4M12 16.8v4M3.2 12h4M16.8 12h4" />
                      <path d="M5.8 5.8l2.8 2.8M15.4 15.4l2.8 2.8M18.2 5.8l-2.8 2.8M8.6 15.4l-2.8 2.8" />
                      <path
                        d="M9 4l1 2.5M15 4l-1 2.5M4 9l2.5 1M4 15l2.5-1M20 9l-2.5 1M20 15l-2.5-1M9 20l1-2.5M15 20l-1-2.5"
                        stroke-width="1.1"
                      />
                    </g>
                  </svg>
                )}
                {a.icon === 'gemini' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.6c.5 5.3 4.1 8.9 9.4 9.4-5.3.5-8.9 4.1-9.4 9.4-.5-5.3-4.1-8.9-9.4-9.4 5.3-.5 8.9-4.1 9.4-9.4Z" />
                  </svg>
                )}
                {a.icon === 'copilot' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M7.2 6.5C8 4.9 9.2 4.2 10.9 4.2h3.4c2.6 0 4.3 1.3 5 3.9l1.1 4.1c.5 1.9-.2 3.2-2 3.9l-2.7 1.1" />
                    <path d="M16.8 17.5c-.8 1.6-2 2.3-3.7 2.3H9.7c-2.6 0-4.3-1.3-5-3.9l-1.1-4.1c-.5-1.9.2-3.2 2-3.9l2.7-1.1" />
                  </svg>
                )}
                {a.icon === 'grok' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <circle cx="12" cy="12" r="8.4" stroke-width="1.3" />
                    <path
                      d="M17.5 6.5 9 15M17.5 6.5l-4.3 1.1M17.5 6.5l-1.1 4.3"
                      stroke-width="1.4"
                    />
                    <path d="M6.6 17.4l3.4-3.4" />
                  </svg>
                )}
                {a.icon === 'perplexity' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                    <path d="M12 3v18" />
                    <path d="M12 8.2 6 3.6v6.2M12 8.2l6-4.6v6.2" />
                    <path d="M12 15.8 6 20.4v-6.2M12 15.8l6 4.6v-6.2" />
                    <path d="M5.2 9.8h13.6v4.4H5.2Z" />
                  </svg>
                )}
              </span>
              <span class="askai-tile__name">{a.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
