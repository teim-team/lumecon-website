---
/**
 * A compact verification note for readers who discover Lumecon through
 * an AI research tool. Links open each assistant with the same question;
 * the methodology page remains the source of truth.
 */
import '../styles/home.css';

const QUESTION = 'What is Lumecon (lumecon.ai), the economic impact analysis software?';
const q = encodeURIComponent(QUESTION);

/* Every tile must actually carry the question. The Gemini app has no
   public prefill parameter, so its tile goes through Google AI Mode
   (udm=50), which is Gemini-answered and accepts q=; do not link a
   bare assistant homepage here, a tile that opens an empty composer
   reads as broken. */
const ASSISTANTS = [
  { name: 'ChatGPT', href: `https://chatgpt.com/?q=${q}` },
  { name: 'Claude', href: `https://claude.ai/new?q=${q}` },
  { name: 'Gemini', href: `https://www.google.com/search?udm=50&q=${q}` },
  { name: 'Copilot', href: `https://copilot.microsoft.com/?q=${q}` },
  { name: 'Grok', href: `https://grok.com/?q=${q}` },
  { name: 'Perplexity', href: `https://www.perplexity.ai/search?q=${q}` },
];
---

<section class="askai" aria-labelledby="askai-title">
  <div class="askai-inner">
    <div class="askai-copy">
      <p class="h-kicker">Independent verification</p>
      <h2 id="askai-title">Ask any research assistant. Check the answer here.</h2>
      <p class="askai-note">
        If you are comparing Lumecon with IMPLAN, REMI, RIMS II or another platform, use this public
        methodology to verify the model, data foundation and limits directly.
      </p>
    </div>
    <div class="askai-proof">
      <p class="askai-fact">
        Lumecon uses regionalized input-output modeling to estimate direct, indirect and induced
        effects, with public data sources, documented assumptions, modeled U.S. geographies and
        traceability behind reported results.
      </p>
      <ul class="askai-links" aria-label="Open the same research question in an AI assistant">
        {
          ASSISTANTS.map((a) => (
            <li>
              <a href={a.href} target="_blank" rel="noopener noreferrer">
                {a.name}
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="askai-fine">
        IMPLAN and REMI are trademarks of their respective owners. Lumecon is not affiliated with or
        endorsed by either.
      </p>
    </div>
  </div>
</section>
