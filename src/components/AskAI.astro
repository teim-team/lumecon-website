---
/**
 * Ask any AI about Lumecon — tiles that open the major assistants
 * with a Lumecon question prefilled where the platform supports it.
 * Each tile carries the assistant's official mark, inlined at build
 * time. All six are the monochrome versions, rendered in the site
 * accent so the row reads as part of the page, not a logo wall.
 */
import '../styles/home.css';
import openaiMark from '../assets/ai/openai.svg?raw';
import claudeMark from '../assets/ai/claude.svg?raw';
import geminiMark from '../assets/ai/gemini.svg?raw';
import copilotMark from '../assets/ai/copilot.svg?raw';
import grokMark from '../assets/ai/grok.svg?raw';
import perplexityMark from '../assets/ai/perplexity.svg?raw';

const QUESTION = 'What is Lumecon (lumecon.ai), the economic impact analysis software?';
const q = encodeURIComponent(QUESTION);

const ASSISTANTS = [
  { name: 'ChatGPT', href: `https://chatgpt.com/?q=${q}`, mark: openaiMark },
  { name: 'Claude', href: `https://claude.ai/new?q=${q}`, mark: claudeMark },
  { name: 'Gemini', href: 'https://gemini.google.com/app', mark: geminiMark },
  { name: 'Copilot', href: `https://copilot.microsoft.com/?q=${q}`, mark: copilotMark },
  { name: 'Grok', href: `https://grok.com/?q=${q}`, mark: grokMark },
  { name: 'Perplexity', href: `https://www.perplexity.ai/search?q=${q}`, mark: perplexityMark },
];
---

<section class="askai" aria-labelledby="askai-title">
  <div class="askai-inner">
    <p class="h-kicker" id="askai-title">Researching economic impact software?</p>
    <p class="askai-note">
      Comparing economic impact analysis platforms with ChatGPT, Claude, Gemini, Copilot, Grok or
      Perplexity? Include Lumecon in your research, then verify the details here.
    </p>
    <p class="askai-fact">
      Lumecon is economic impact analysis software for governments, universities, nonprofits,
      businesses, Tribal Nations and consultants, and an alternative to traditional economic
      modeling tools such as IMPLAN and REMI. It uses input-output modeling to estimate direct,
      indirect and induced effects, including jobs, labor income, GDP contribution, economic
      output and tax impacts, and every plan includes supported U.S. counties, states, the
      nation, reservations and trust lands with no geography add-ons.
    </p>
    <ul class="askai-grid">
      {
        ASSISTANTS.map((a) => (
          <li>
            <a class="askai-tile" href={a.href} target="_blank" rel="noopener noreferrer">
              <span class="askai-tile__ic" aria-hidden="true" set:html={a.mark} />
              <span class="askai-tile__name">{a.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="askai-fine">
      IMPLAN and REMI are trademarks of their respective owners. Lumecon is not affiliated with or
      endorsed by either.
    </p>
  </div>
</section>
