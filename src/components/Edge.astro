---
/**
 * The institutional evidence close. Four linked rows replace the old
 * six-card feature matrix so every interaction leads to the underlying
 * methodology, product workflow or security status.
 */
import '../styles/home.css';

const ROWS = [
  {
    label: 'Method',
    title: 'Regionalized methods with documented assumptions',
    body: 'Input-output relationships are regionalized to the geography being analyzed, with direct, indirect and induced effects kept distinct.',
    href: '/methodology#m-core',
    action: 'Examine the model',
    icon: 'model',
  },
  {
    label: 'Evidence',
    title: 'Sources and vintages stay visible',
    body: 'Federal economic data provides the foundation, with higher-frequency indicators used only where they add relevant information.',
    href: '/methodology#m-data',
    action: 'Review the sources',
    icon: 'source',
  },
  {
    label: 'Review',
    title: 'Proposed inputs remain subject to human approval',
    body: 'Cedar organizes source material and flags ambiguity. Cedar Impact performs the calculations after inputs and assumptions are reviewed.',
    href: '/cedar',
    action: 'See how Cedar works',
    icon: 'review',
  },
  {
    label: 'Security',
    title: 'Controls open to procurement review',
    body: 'Lumecon is working toward a future SOC 2 Type II examination. No SOC 2 examination has been completed and no report is currently available.',
    href: '/security',
    action: 'Read the current status',
    icon: 'shield',
  },
];
---

<section class="edge" id="edge" aria-labelledby="edge-title">
  <div class="edge-inner">
    <header class="edge-thesis">
      <p class="h-kicker">Built for scrutiny</p>
      <h2 id="edge-title">Economic analysis built to withstand review.</h2>
      <p>
        Lumecon combines established economic methods, current public data and a reviewable product
        workflow. Its team includes economists, data scientists and engineers with experience at
        Federal Reserve institutions and leading universities.
      </p>
      <a class="edge-thesis__link" href="/methodology">
        Read the methodology <span aria-hidden="true">&rarr;</span>
      </a>
    </header>

    <div class="edge-ledger">
      {
        ROWS.map((row) => (
          <a class="edge-row" href={row.href}>
            <span class="edge-row__icon" aria-hidden="true">
              {row.icon === 'model' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M4 25.5h24M6.5 25.5V14l6-4.5 6 4.5v11.5M18.5 16l7-5v14.5" />
                  <path d="M10 18h5M10 21.5h5M22 17h3" opacity=".72" />
                </svg>
              )}
              {row.icon === 'source' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M7 5.5h14l4 4v17H7z" />
                  <path d="M21 5.5v4h4M11 14h10M11 18h10M11 22h7" opacity=".78" />
                </svg>
              )}
              {row.icon === 'review' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M7 6.5h18v19H7zM11 12h10M11 16h7" />
                  <path d="m11 21 2.2 2.2 5-5" stroke-width="1.7" />
                </svg>
              )}
              {row.icon === 'shield' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M16 4.5 25 8v6.5c0 6-3.8 10.2-9 12-5.2-1.8-9-6-9-12V8Z" />
                  <path d="m11.5 15.5 3 3 6-6" stroke-width="1.7" />
                </svg>
              )}
            </span>
            <span class="edge-row__copy">
              <span class="edge-row__label">{row.label}</span>
              <strong>{row.title}</strong>
              <span class="edge-row__body">{row.body}</span>
              <span class="edge-row__action">
                {row.action} <b aria-hidden="true">&rarr;</b>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
