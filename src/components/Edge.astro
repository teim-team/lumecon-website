---
/**
 * The Lumecon edge — the table-stakes capabilities buyers scan for
 * (cloud, security, AI native, authoritative data, data freshness,
 * methodology), each with a line icon drawn in the app's icon style
 * (thin strokes, sharp joins, teal chip). The header tells the
 * provenance story in evidence terms: who built it, on what
 * foundation, and what that makes possible.
 *
 * Six tiles that lead with the icon. At rest each shows its icon, label
 * and headline; the sentence underneath appears on hover. That is what
 * takes the density down: six paragraphs is most of the reading on this
 * part of the page, and a visitor scanning for "do they do security" only
 * needs the headline until they care.
 *
 * The sentence is always in the DOM (opacity, not display), so screen
 * readers and search engines get the full text either way. The tiles take
 * tabindex="0" so a keyboard can reach what a pointer can, and on touch,
 * where there is no hover, the sentences simply always show.
 */
import '../styles/home.css';

const CARDS = [
  {
    k: 'Cloud',
    t: 'Runs in your browser',
    b: 'Nothing to install or maintain.',
    icon: 'cloud',
  },
  {
    k: 'Security',
    t: 'Secure by design',
    b: 'Encrypted in transit and at rest with account-level data separation.',
    icon: 'shield',
  },
  {
    k: 'AI native',
    t: 'Cedar, from the beginning',
    b: 'Cedar was designed into the workflow from the beginning, so it participates at every step from intake to reporting.',
    icon: 'spark',
  },
  {
    k: 'Authoritative data',
    t: 'Census, BEA, BLS and more',
    b: 'Built on the public sources the field already relies on.',
    icon: 'bank',
  },
  {
    k: 'Current evidence',
    t: 'Data that keeps up',
    b: 'Higher-frequency indicators supplement slower-moving benchmarks where they add information.',
    icon: 'pulse',
  },
  {
    k: 'Built to evolve',
    t: 'Improving with the evidence',
    b: 'The model, the data behind it and the software improve as the evidence does.',
    icon: 'trend',
  },
];
---

<section class="edge" id="edge" aria-labelledby="edge-title">
  <div class="edge-inner">
    <header class="flowsec-head">
      <p class="h-kicker">The Lumecon edge</p>
      <h2 class="flowsec-title" id="edge-title">
        Decades of economic science, <span class="brand-em">kept current with the economy.</span>
      </h2>
      <p class="flowsec-lede">
        Built by economists, engineers and researchers with experience at the Federal Reserve and
        leading universities, Lumecon combines the established foundation of input-output analysis
        with current public data, modern estimation methods and software built for recurring
        analysis. <span class="brand-em"
          >We invest in the model itself, and in the software around it.</span
        >{' '}
        <a class="inline-link" href="/methodology">Read the methodology</a>.
      </p>
    </header>

    <div class="edge-grid">
      {
        CARDS.map((c) => (
          <article class="edge-card" tabindex="0">
            <span class="edge-ic" aria-hidden="true">
              {c.icon === 'cloud' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M7 17.5h10a4 4 0 0 0 .9-7.9 5.5 5.5 0 0 0-10.7-1A4.2 4.2 0 0 0 7 17.5Z" />
                  <path d="M12 13.5v-4M10 11l2-1.9 2 1.9" stroke-width="1.25" />
                </svg>
              )}
              {c.icon === 'shield' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 3 19 5.8v5.1c0 4.5-3 7.6-7 9.1-4-1.5-7-4.6-7-9.1V5.8Z" />
                  <path d="m8.8 11.8 2.2 2.2 4.2-4.2" stroke-width="1.4" />
                </svg>
              )}
              {c.icon === 'spark' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="6.5" y="6.5" width="11" height="11" />
                  <path
                    d="M9.5 3.5v3M14.5 3.5v3M9.5 17.5v3M14.5 17.5v3M3.5 9.5h3M3.5 14.5h3M17.5 9.5h3M17.5 14.5h3"
                    stroke-width="1.2"
                  />
                  <path
                    d="M12 9.4l.8 1.8 1.8.8-1.8.8-.8 1.8-.8-1.8-1.8-.8 1.8-.8Z"
                    stroke-width="1.2"
                  />
                </svg>
              )}
              {c.icon === 'bank' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 9.2 12 4l8 5.2" />
                  <path d="M5.5 9.5V17M9.8 9.5V17M14.2 9.5V17M18.5 9.5V17" stroke-width="1.25" />
                  <path d="M4 17.5h16M4 20h16" stroke-width="1.4" />
                </svg>
              )}
              {c.icon === 'pulse' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M3 12.5h3.6l2-5.4 3.8 9.8 2-5.4H21" />
                  <path d="M17.5 5.5v2.8M16.1 6.9h2.8" stroke-width="1.2" />
                </svg>
              )}
              {c.icon === 'trend' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 4v16h16" />
                  <circle cx="8.2" cy="14.6" r="0.9" fill="currentColor" stroke="none" />
                  <circle cx="12" cy="12.8" r="0.9" fill="currentColor" stroke="none" />
                  <circle cx="15.2" cy="10" r="0.9" fill="currentColor" stroke="none" />
                  <circle cx="18.6" cy="8.4" r="0.9" fill="currentColor" stroke="none" />
                  <path d="M6.5 16.5 20 6.5" stroke-width="1.2" stroke-dasharray="2.4 2" />
                </svg>
              )}
            </span>
            <p class="whyw-card__k">{c.k}</p>
            <h3 class="whyw-card__t">{c.t}</h3>
            <p class="whyw-card__b edge-card__reveal">{c.b}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
