---
/**
 * Why Lumecon — four cards on the white, hairline surface, each
 * headed by a piece of the supplied brand artwork (transparent
 * isometric icon set, served from /art). The geo illustration ships
 * two builds: light mode uses the original, whose soft translucent
 * fills look best on white; dark mode swaps in the solid-white build
 * via <picture>, since the original's translucency reads as noise on
 * a dark card. Both are framed identically so the swap never shifts.
 */
import '../styles/home.css';

const CARDS = [
  {
    k: 'Every geography',
    t: 'County to nation',
    b: 'Counties, states, the nation, reservations and trust lands. No geography add-ons.',
    art: 'geo',
    artDark: 'geo-dark',
  },
  {
    k: 'Unlimited analysis',
    t: 'No per-analysis fees',
    b: 'Run as many projects and analyses as you need with one annual subscription.',
    art: 'rerun',
  },
  {
    k: 'Cedar included',
    t: 'AI built into the workflow',
    b: 'Cedar helps turn source documents into model-ready inputs, supports analysis and helps communicate results.',
    art: 'cedar',
    link: { href: '/cedar', label: 'Meet Cedar' },
  },
  {
    k: 'Every kind of organization',
    t: 'Built to adapt',
    b: 'Workflows for governments, universities, nonprofits, businesses, Tribal Nations and consultants.',
    art: 'orgs',
  },
];
---

<section class="whyw" id="why" aria-labelledby="whyw-title">
  <div class="whyw-inner">
    <header class="whyw-head">
      <p class="h-kicker">Why Lumecon</p>
      <h2 class="whyw-title" id="whyw-title">Every plan gets the real platform.</h2>
      <p class="whyw-lede">
        The economics don&rsquo;t change with the price. Every customer runs the same model on the
        same data foundation; higher plans add collaboration, organizational memory and scale.{' '}
        <a class="inline-link" href="/pricing">Compare plans</a>{' '}or{' '}
        <a class="inline-link" href="/signup?tier=free">start free</a>.
      </p>
    </header>
    <div class="whyw-grid">
      {
        CARDS.map((c) => (
          <article class="whyw-card" data-art={c.art}>
            <span class="whyw-art" aria-hidden="true">
              <picture>
                {c.artDark && (
                  <source
                    srcset={`/art/why-${c.artDark}.png`}
                    media="(prefers-color-scheme: dark)"
                  />
                )}
                <img
                  src={`/art/why-${c.art}.png`}
                  alt=""
                  width="300"
                  height="300"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </span>
            <p class="whyw-card__k">{c.k}</p>
            <h3 class="whyw-card__t">{c.t}</h3>
            <p class="whyw-card__b">
              {c.b}
              {c.link && (
                <>
                  {' '}
                  <a class="inline-link" href={c.link.href}>
                    {c.link.label}
                  </a>
                  .
                </>
              )}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
