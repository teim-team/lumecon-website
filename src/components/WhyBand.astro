---
/**
 * Why Lumecon — four cards on the white, hairline surface, each
 * headed by a small illustrated SVG scene in the app's line-art
 * style (the pattern the refreshed IMPLAN cards use, drawn in
 * Lumecon's own grammar: thin strokes, mint field, teal accents,
 * the gold reserved for nothing here).
 */
import '../styles/home.css';

const CARDS = [
  {
    k: 'Every geography',
    t: 'County to nation',
    b: 'Counties, states, the nation and reservations are included in every plan. No geography licenses.',
    art: 'geo',
  },
  {
    k: 'Unlimited analysis',
    t: 'No per-analysis fees',
    b: 'Unlimited projects and analyses on the full Lumecon model, on one flat annual subscription.',
    art: 'rerun',
  },
  {
    k: 'Cedar included',
    t: 'An AI economic analyst',
    b: 'Cedar reads your PDFs, spreadsheets and CSVs, maps them into the model, helps interpret results and supports reporting, in every plan.',
    art: 'cedar',
  },
  {
    k: 'Every kind of organization',
    t: 'Built to adapt',
    b: 'Governments, universities, nonprofits, businesses, Tribal Nations and consulting firms all get workflows fit to how they work, in one application.',
    art: 'orgs',
  },
];
---

<section class="whyw" id="why" aria-labelledby="whyw-title">
  <div class="whyw-inner">
    <header class="whyw-head">
      <p class="h-kicker">Why Lumecon</p>
      <h2 class="whyw-title" id="whyw-title">Every plan gets the real platform.</h2>
      <p class="whyw-lede">
        Higher plans add collaboration, organizational memory and scale. The economics stay the
        same: every customer runs the same model on the same data foundation.{' '}
        <a class="inline-link" href="/pricing">Compare plans</a>{' '}or{' '}
        <a class="inline-link" href="/signup">start free</a>.
      </p>
    </header>
    <div class="whyw-grid">
      {
        CARDS.map((c) => (
          <article class="whyw-card">
            <span class="whyw-art" aria-hidden="true">
              {c.art === 'geo' && (
                <svg viewBox="0 0 220 120" fill="none">
                  <path
                    d="M108 14 C146 12 178 32 180 58 C182 86 150 108 110 106 C72 104 40 88 40 60 C40 34 70 16 108 14 Z"
                    stroke="var(--accent)"
                    stroke-width="1.5"
                    opacity="0.4"
                  />
                  <path
                    d="M108 30 C136 28 158 42 160 59 C162 78 138 92 110 91 C82 90 58 79 58 60 C58 43 80 32 108 30 Z"
                    stroke="var(--accent)"
                    stroke-width="1.6"
                    opacity="0.65"
                  />
                  <path
                    d="M108 45 C126 44 142 51 143 60 C144 70 128 77 110 76 C92 75 76 69 76 60 C76 52 90 46 108 45 Z"
                    fill="var(--accent-rgba-08)"
                    stroke="var(--accent-text)"
                    stroke-width="1.8"
                  />
                  <circle cx="122" cy="57" r="3.4" fill="var(--accent-text)" />
                </svg>
              )}
              {c.art === 'rerun' && (
                <svg viewBox="0 0 220 120" fill="none">
                  <path
                    d="M110 22 A40 40 0 1 1 74 44"
                    stroke="var(--accent-text)"
                    stroke-width="1.8"
                  />
                  <path d="M74 44 L63 42.5 L71.5 33.5 Z" fill="var(--accent-text)" />
                  <rect
                    x="93"
                    y="66"
                    width="9"
                    height="18"
                    stroke="var(--accent)"
                    stroke-width="1.5"
                    opacity="0.65"
                  />
                  <rect
                    x="106"
                    y="56"
                    width="9"
                    height="28"
                    stroke="var(--accent)"
                    stroke-width="1.5"
                    opacity="0.65"
                  />
                  <rect
                    x="119"
                    y="46"
                    width="9"
                    height="38"
                    fill="var(--accent-rgba-18)"
                    stroke="var(--accent-text)"
                    stroke-width="1.6"
                  />
                </svg>
              )}
              {c.art === 'cedar' && (
                <svg viewBox="0 0 220 120" fill="none">
                  <path
                    d="M110 16 C104 25 99 33 93 40 L127 40 C121 33 116 25 110 16 Z"
                    fill="var(--cedar-mist)"
                    stroke="var(--cedar-text)"
                    stroke-width="1.6"
                  />
                  <path
                    d="M110 32 C102 43 93 54 85 62 L135 62 C127 54 118 43 110 32 Z"
                    fill="var(--cedar-mist)"
                    stroke="var(--cedar-text)"
                    stroke-width="1.6"
                  />
                  <path
                    d="M110 50 C100 63 89 76 78 86 L142 86 C131 76 120 63 110 50 Z"
                    fill="var(--cedar-mist)"
                    stroke="var(--cedar-text)"
                    stroke-width="1.6"
                  />
                  <path d="M106 86 h8 v14 h-8 Z" stroke="var(--cedar-text)" stroke-width="1.6" />
                  <path d="M62 102 h96" stroke="var(--rule-strong)" stroke-width="1.3" />
                  <path
                    d="M152 28 l1.5 3.6 3.6 1.5 -3.6 1.5 -1.5 3.6 -1.5 -3.6 -3.6 -1.5 3.6 -1.5 Z"
                    fill="var(--accent)"
                  />
                </svg>
              )}
              {c.art === 'orgs' && (
                <svg viewBox="0 0 220 120" fill="none">
                  <rect
                    x="32"
                    y="45"
                    width="30"
                    height="30"
                    rx="2"
                    stroke="var(--accent-text)"
                    stroke-width="1.6"
                  />
                  <rect
                    x="74"
                    y="45"
                    width="30"
                    height="30"
                    rx="9"
                    fill="var(--accent-rgba-18)"
                    stroke="var(--accent-text)"
                    stroke-width="1.7"
                  />
                  <circle cx="131" cy="60" r="15" stroke="var(--accent-text)" stroke-width="1.6" />
                  <path
                    d="M173 44 l14 8 v16 l-14 8 -14 -8 v-16 Z"
                    stroke="var(--accent-text)"
                    stroke-width="1.6"
                  />
                </svg>
              )}
            </span>
            <p class="whyw-card__k">{c.k}</p>
            <h3 class="whyw-card__t">{c.t}</h3>
            <p class="whyw-card__b">{c.b}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
