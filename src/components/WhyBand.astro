---
/**
 * Why Lumecon — four cards on the white, hairline surface, each
 * headed by a small illustrated SVG scene in the app's line-art
 * style (the pattern the refreshed IMPLAN cards use, drawn in
 * Lumecon's own grammar: thin strokes, mint field, teal accents,
 * the gold reserved for nothing here).
 */
import '../styles/home.css';

const CARDS = [
  {
    k: 'Every geography',
    t: 'County to nation',
    b: 'County, state, national, reservation and tribal-government geographies are included in every plan. No geography licenses.',
    art: 'geo',
  },
  {
    k: 'Unlimited analysis',
    t: 'Run it again, free',
    b: 'Unlimited projects and analyses on the full Lumecon model. No per-project fees and no paying more to ask a second question.',
    art: 'rerun',
  },
  {
    k: 'Cedar included',
    t: 'An AI economic analyst',
    b: 'Cedar reads your PDFs, spreadsheets and CSVs, maps them into the model, helps interpret results and supports reporting, in every plan.',
    art: 'cedar',
  },
  {
    k: 'Every kind of organization',
    t: 'Built to adapt',
    b: 'Governments, universities, nonprofits, businesses and Tribal Nations all get workflows fit to how they work, in one application.',
    art: 'orgs',
  },
];
---

<section class="whyw" id="why" aria-labelledby="whyw-title">
  <div class="whyw-inner">
    <header class="whyw-head">
      <p class="h-kicker">Why Lumecon</p>
      <h2 class="whyw-title" id="whyw-title">Every plan gets the real platform.</h2>
      <p class="whyw-lede">
        Higher plans add collaboration, organizational memory and scale. The economics stay the
        same: every customer runs the same model on the same data foundation.
      </p>
    </header>
    <div class="whyw-grid">
      {
        CARDS.map((c) => (
          <article class="whyw-card">
            <span class="whyw-art" aria-hidden="true">
              {c.art === 'geo' && (
                <svg viewBox="0 0 220 120" fill="none">
                  <path
                    d="M18 62 C22 30 62 12 106 16 C158 20 202 38 200 68 C198 96 150 112 102 108 C54 104 14 92 18 62 Z"
                    stroke="var(--accent)"
                    stroke-width="1.6"
                    opacity="0.45"
                  />
                  <path
                    d="M46 62 C50 42 78 30 108 33 C144 36 174 48 172 68 C170 86 138 96 106 93 C72 90 42 82 46 62 Z"
                    stroke="var(--accent)"
                    stroke-width="1.8"
                    opacity="0.7"
                  />
                  <path
                    d="M76 62 C79 51 94 45 109 47 C127 49 143 55 141 66 C140 76 123 81 108 79 C90 77 74 73 76 62 Z"
                    fill="var(--accent-rgba-18)"
                    stroke="var(--accent-text)"
                    stroke-width="2"
                  />
                  <circle cx="108" cy="63" r="4.5" fill="var(--accent-text)" />
                  <path d="M108 63 V38" stroke="var(--accent-text)" stroke-width="2" />
                  <path
                    d="M108 38 h26 v14 h-26 Z"
                    fill="var(--white)"
                    stroke="var(--accent-text)"
                    stroke-width="1.6"
                  />
                  <path d="M113 45 h16" stroke="var(--accent-text)" stroke-width="1.6" />
                </svg>
              )}
              {c.art === 'rerun' && (
                <svg viewBox="0 0 220 120" fill="none">
                  <rect
                    x="38"
                    y="30"
                    width="86"
                    height="60"
                    rx="6"
                    fill="var(--white)"
                    stroke="var(--accent)"
                    stroke-width="1.6"
                    opacity="0.55"
                  />
                  <rect
                    x="54"
                    y="20"
                    width="86"
                    height="60"
                    rx="6"
                    fill="var(--white)"
                    stroke="var(--accent-text)"
                    stroke-width="1.8"
                  />
                  <path d="M64 36 h44" stroke="var(--accent-text)" stroke-width="2" />
                  <path
                    d="M64 48 h30 M64 58 h38 M64 68 h24"
                    stroke="var(--ink-4)"
                    stroke-width="1.6"
                  />
                  <path
                    d="M168 60 a26 26 0 1 1 -10 -30"
                    stroke="var(--accent-text)"
                    stroke-width="2.4"
                  />
                  <path d="M160 22 l2 10 -10 1 Z" fill="var(--accent-text)" />
                  <text
                    x="163"
                    y="66"
                    font-family="JetBrains Mono, monospace"
                    font-size="11"
                    fill="var(--accent-text)"
                  >
                    &#8734;
                  </text>
                </svg>
              )}
              {c.art === 'cedar' && (
                <svg viewBox="0 0 220 120" fill="none">
                  <path
                    d="M110 18 L92 44 L101 44 L86 66 L97 66 L78 92 L142 92 L123 66 L134 66 L119 44 L128 44 Z"
                    fill="var(--cedar-mist)"
                    stroke="var(--cedar-text)"
                    stroke-width="2"
                    stroke-linejoin="miter"
                  />
                  <path d="M110 92 v12" stroke="var(--cedar-text)" stroke-width="2.4" />
                  <path
                    d="M160 30 l1.6 3.8 3.8 1.6 -3.8 1.6 -1.6 3.8 -1.6 -3.8 -3.8 -1.6 3.8 -1.6 Z"
                    fill="var(--accent)"
                  />
                  <path
                    d="M58 52 l1.3 3 3 1.3 -3 1.3 -1.3 3 -1.3 -3 -3 -1.3 3 -1.3 Z"
                    fill="var(--accent)"
                    opacity="0.7"
                  />
                  <path d="M40 104 h140" stroke="var(--rule-strong)" stroke-width="1.4" />
                </svg>
              )}
              {c.art === 'orgs' && (
                <svg viewBox="0 0 220 120" fill="none">
                  <path d="M20 96 h180" stroke="var(--rule-strong)" stroke-width="1.6" />
                  <path
                    d="M36 96 V66 h34 v30"
                    fill="var(--white)"
                    stroke="var(--accent-text)"
                    stroke-width="1.8"
                  />
                  <path
                    d="M32 66 h42 M42 66 v-8 h22 v8"
                    stroke="var(--accent-text)"
                    stroke-width="1.8"
                  />
                  <path d="M53 50 a8 8 0 0 1 8 8" stroke="var(--accent-text)" stroke-width="1.8" />
                  <path
                    d="M42 74 h6 M52 74 h6 M62 74 h6 M42 84 h6 M52 84 h6 M62 84 h6"
                    stroke="var(--ink-4)"
                    stroke-width="1.5"
                  />
                  <rect
                    x="92"
                    y="42"
                    width="40"
                    height="54"
                    fill="var(--white)"
                    stroke="var(--accent)"
                    stroke-width="1.8"
                  />
                  <path
                    d="M99 52 h8 M113 52 h8 M99 64 h8 M113 64 h8 M99 76 h8 M113 76 h8"
                    stroke="var(--accent)"
                    stroke-width="1.6"
                  />
                  <path
                    d="M150 96 V60 l20 -12 20 12 v36"
                    fill="var(--accent-rgba-08)"
                    stroke="var(--accent-text)"
                    stroke-width="1.8"
                  />
                  <path
                    d="M170 48 v-12 M170 36 h12 v7 h-12"
                    stroke="var(--accent-text)"
                    stroke-width="1.8"
                  />
                  <path d="M162 72 h16 M162 82 h16" stroke="var(--ink-4)" stroke-width="1.5" />
                </svg>
              )}
            </span>
            <p class="whyw-card__k">{c.k}</p>
            <h3 class="whyw-card__t">{c.t}</h3>
            <p class="whyw-card__b">{c.b}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
