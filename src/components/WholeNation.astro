---
/**
 * Whole Nation — a signature capability alongside the general
 * platform: government + enterprises + other activity converging
 * into one integrated result, with the real scope-tab screenshot
 * (statewide and homelands side by side) underneath.
 */
import '../styles/home.css';
---

<section class="flowsec" id="whole-nation" aria-labelledby="wn-title">
  <div class="flowsec-inner">
    <header class="flowsec-head">
      <p class="h-kicker">For Tribal Nations</p>
      <h2 class="flowsec-title" id="wn-title">See the whole Nation, not just one enterprise.</h2>
      <p class="flowsec-lede">
        Model tribal government and enterprises together in one integrated analysis, with statewide
        and homelands results available side by side. Whole Nation analysis is part of
        Lumecon&rsquo;s core architecture and available across standard plans.{' '}
        <a class="inline-link" href="/methodology">Learn about Tribal analysis</a>.
      </p>
    </header>

    <figure class="wn-shot">
      <picture>
        <source srcset="/app/homelands-dark.webp" media="(prefers-color-scheme: dark)" />
        <img
          src="/app/homelands.webp"
          alt="Lumecon results page on the Homelands scope tab, estimating 1,928 jobs and $496,200,000 in economic output on homelands, with statewide and homelands tabs above four key figures."
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </figure>
  </div>
</section>
