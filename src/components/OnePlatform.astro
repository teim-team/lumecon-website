---
/**
 * One platform — Lumecon learns what kind of organization the
 * customer is and adapts geography, workflows, language and
 * analysis. One application, one account, one subscription.
 */
import '../styles/home.css';

const ORGS = [
  'City / county',
  'State agency',
  'Economic development org',
  'University',
  'Nonprofit',
  'Business',
  'Tribal Nation',
  'Tribal enterprise',
  'Consulting firm',
];
---

<section class="oneplat" id="platform" aria-labelledby="oneplat-title">
  <div class="oneplat-inner">
    <div class="flowsec-head">
      <p class="h-kicker">One platform</p>
      <h2 class="flowsec-title" id="oneplat-title">Lumecon knows who it&rsquo;s working for.</h2>
      <p class="flowsec-lede">
        Tell Lumecon what kind of organization you represent and the platform adapts: the right
        geographies, workflows, terminology and analysis types surface on their own. A county sees
        municipal workflows. A university sees institutional impact. A Tribal Nation sees homelands
        and Whole Nation analysis. A consultant sees client work. Underneath, it is one application,
        one account and one subscription.
      </p>
    </div>
    <ul class="oneplat-orgs" aria-label="Organization types Lumecon adapts to">
      {ORGS.map((o) => <li>{o}</li>)}
    </ul>
  </div>
</section>
