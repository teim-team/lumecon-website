---
/**
 * One platform, three doors — the consolidated architecture story.
 * Lumecon learns what kind of organization the customer is and
 * adapts geography, workflows, language and analysis. The three
 * domains stay as audience-specific entry points into the same
 * application.
 */
import '../styles/home.css';

const ORGS = [
  'Tribal Nation',
  'Tribal enterprise',
  'City / county',
  'State agency',
  'Economic development org',
  'University',
  'Nonprofit',
  'Business',
  'Consulting firm',
];

const DOORS = [
  {
    href: 'https://localeconomicimpact.com',
    domain: 'localeconomicimpact.com',
    sub: 'For cities, counties, regions and the organizations that serve them',
  },
  {
    href: 'https://tribaleconomicimpact.com',
    domain: 'tribaleconomicimpact.com',
    sub: 'For Tribal Nations, tribal governments and tribal enterprises',
  },
  {
    href: 'https://globaleconomicimpact.com',
    domain: 'globaleconomicimpact.com',
    sub: 'For cross-border analysis as those capabilities arrive',
  },
];
---

<section class="oneplat" id="platform" aria-labelledby="oneplat-title">
  <div class="oneplat-inner">
    <div class="flowsec-head">
      <p class="h-kicker">One platform</p>
      <h2 class="flowsec-title" id="oneplat-title">Lumecon knows who it&rsquo;s working for.</h2>
      <p class="flowsec-lede">
        Tell Lumecon what kind of organization you represent and the platform adapts: the right
        geographies, workflows, terminology and analysis types surface on their own. A Tribal Nation
        sees homelands and Whole Nation analysis. A county sees municipal workflows. A consultant
        sees client work. Underneath, it is one application, one account and one subscription.
      </p>
      <ul class="oneplat-orgs" aria-label="Organization types Lumecon adapts to">
        {ORGS.map((o) => <li>{o}</li>)}
      </ul>
    </div>
    <div class="oneplat-doors">
      <p class="oneplat-doors__label">Three doors, one Lumecon</p>
      {
        DOORS.map((d) => (
          <a class="oneplat-door" href={d.href} target="_blank" rel="noopener noreferrer">
            <span class="oneplat-door__d">{d.domain}</span>
            <span class="oneplat-door__s">{d.sub}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
