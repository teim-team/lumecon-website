---
/**
 * Backdrop for teal flow surfaces (choose-plan, checkout summary,
 * welcome): the same drifting glows and the asymmetric mark bleeding
 * off a corner as the auth brand panels, so every teal field in the
 * acquisition flow reads as one environment. (Founder rule 2026-08:
 * no decorative circles that aren't the Lumecon mark itself — the
 * old contour linework is deliberately gone.) Decorative only; the host element needs
 * position: relative and overflow: hidden. The host page positions
 * the mark via .tealfield--mark-left / default right.
 */
import MarkArt from './MarkArt.astro';
---

<span class="tealfield__glow tealfield__glow--a" aria-hidden="true"></span>
<span class="tealfield__glow tealfield__glow--b" aria-hidden="true"></span>
<MarkArt class="tealfield__mark" size={520} />
