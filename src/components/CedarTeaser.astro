---
/**
 * Cedar teaser — the homepage's compact pointer to /cedar, which now
 * owns the full AI story. One position statement, one CTA, one real
 * product capture. Keeps id="cedar" so existing anchors still land.
 */
import '../styles/home.css';
---

<section class="flowsec" id="cedar" aria-labelledby="cedar-title">
  <div class="flowsec-inner">
    <header class="flowsec-head">
      <p class="h-kicker">Cedar</p>
      <h2 class="flowsec-title" id="cedar-title">
        AI built for economic analysis <span class="brand-em">from the beginning.</span>
      </h2>
      <p class="flowsec-lede">
        Cedar works across intake, analysis, interpretation and reporting. It helps turn
        organizational knowledge into usable inputs and helps analysts understand and communicate
        what the model produces. <span class="brand-em"
          >It is part of how Lumecon works, present from intake through reporting.</span
        >
      </p>
      <div class="cedar-teaser__cta">
        <a class="btn2 btn2--primary" href="/cedar">
          Meet Cedar <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </header>

    <figure class="cedar-shot">
      <picture>
        <source srcset="/app/cedar-dark.webp" media="(prefers-color-scheme: dark)" />
        <img
          src="/app/cedar.webp"
          alt="The Cedar panel open over a Lumecon results page, writing a board-ready summary of jobs, output, GDP contribution, labor income and tax impacts."
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <figcaption>Cedar working inside a live analysis, shown with sample data.</figcaption>
    </figure>
  </div>
</section>
