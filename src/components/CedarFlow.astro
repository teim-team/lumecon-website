---
/**
 * Cedar — the workflow (source material in, reporting out) plus the
 * widget actually working: a board-ready summary written from live
 * analysis results. Dark mode swaps in the dark capture.
 */
import '../styles/home.css';

const STEPS = [
  { k: 'You bring', t: 'PDFs, spreadsheets, CSVs' },
  { k: 'Cedar', t: 'Reads and structures', hero: true },
  { k: 'Lumecon', t: 'Analysis-ready inputs' },
  { k: 'The model', t: 'Economic analysis' },
  { k: 'You get', t: 'Reporting and exports' },
];
---

<section class="flowsec" id="cedar" aria-labelledby="cedar-title">
  <div class="flowsec-inner">
    <header class="flowsec-head">
      <p class="h-kicker">Cedar</p>
      <h2 class="flowsec-title" id="cedar-title">Bring your data. Cedar makes it usable.</h2>
      <p class="flowsec-lede">
        Cedar is Lumecon&rsquo;s AI economic analyst, included in every plan. Upload the PDFs,
        spreadsheets and CSVs you already use; Cedar structures the information the model needs,
        assists with setup, helps interpret results and supports reporting. Assumptions are
        surfaced for human review before an analysis is finalized. Cedar automates the mechanical
        work while people remain responsible for the analytical decisions.
      </p>
    </header>

    <div class="cedar-flow" role="list" aria-label="Cedar workflow">
      {
        STEPS.map((s, i) => (
          <>
            <div class={`cedar-step${s.hero ? ' cedar-step--hero' : ''}`} role="listitem">
              <span class="cedar-step__k">{s.k}</span>
              <span class="cedar-step__t">{s.t}</span>
            </div>
            {i < STEPS.length - 1 && (
              <span class="cedar-arrow" aria-hidden="true">
                &rarr;
              </span>
            )}
          </>
        ))
      }
    </div>

    <figure class="cedar-shot">
      <picture>
        <source srcset="/app/cedar-dark.webp" media="(prefers-color-scheme: dark)" />
        <img
          src="/app/cedar.webp"
          alt="The Cedar panel open over a Lumecon results page, answering the request to explain results in plain language for a board with a summary of jobs, output, GDP, labor income and tax impacts."
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <figcaption>
        Cedar writing a board-ready summary straight from an analysis&rsquo;s results, shown with
        sample data.
      </figcaption>
    </figure>
  </div>
</section>
