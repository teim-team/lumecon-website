---
/**
 * Footer — a single closing band, not another section.
 *
 * No brand block. The mark already appears in the header on every page
 * and again in the hero on most of them, and the company pitch was a
 * third statement of what the site says at the top; between them they
 * took a third of the band's width and set its height.
 *
 * What is left is navigation, grouped. Fourteen links in one wrapping
 * row read as a run-on sentence: nothing signalled that Terms and
 * Cedar were different kinds of thing, so the eye had to scan all
 * fourteen to find one.
 *
 * Grouping costs height, because the deepest group sets the band, so
 * the groups are balanced to four: Contact lives under Account (the
 * most actionable link, accented), LinkedIn sits in the bottom bar
 * beside the email, and "Privacy choices" stays there too, which is
 * where a preference control belongs anyway. The bottom bar is navy —
 * the one dark strip that actually terminates the document.
 */
import { site } from '../config';

interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;

const GROUPS: {
  label: string;
  links: { href: string; text: string; ext?: boolean; contact?: boolean }[];
}[] = [
  {
    label: 'Product',
    links: [
      { href: '/#product', text: 'How it works' },
      { href: '/cedar', text: 'Cedar' },
      { href: '/pricing', text: 'Pricing' },
    ],
  },
  {
    label: 'Reference',
    links: [
      { href: '/methodology', text: 'Methodology' },
      { href: '/glossary', text: 'Glossary' },
    ],
  },
  {
    label: 'Account',
    links: [
      { href: '/signup', text: 'Sign up' },
      { href: '/login', text: 'Log in' },
      { href: `mailto:${site.email}`, text: 'Contact', contact: true },
    ],
  },
  {
    label: 'Legal',
    links: [
      { href: '/terms', text: 'Terms' },
      { href: '/privacy', text: 'Privacy' },
      { href: '/ai-and-data-use', text: 'AI and data use' },
      { href: '/accessibility', text: 'Accessibility' },
    ],
  },
];
---

<footer class={isHome ? 'footer footer--home' : 'footer'}>
  <div class="footer-w">
    <nav class="footer-groups" aria-label="Footer">
      {
        GROUPS.map((g) => (
          <div class="footer-group">
            <p class="footer-group__label">{g.label}</p>
            <ul class="footer-group__list" role="list">
              {g.links.map((l) => (
                <li>
                  {l.ext ? (
                    <a href={l.href} target="_blank" rel="noopener noreferrer me">
                      {l.text}
                    </a>
                  ) : (
                    <a class={l.contact ? 'footer-links__contact' : undefined} href={l.href}>
                      {l.text}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <!-- Compact navy strip for copyright + contact email so the
       dominant footer surface stays light and the navy footprint
       shrinks to a single thin bar. -->
  <div class="footer-bar">
    <div class="footer-w">
      <div class="footer-bottom">
        <div class="footer-legal">
          &copy; <span id="copyrightYear">{site.copyrightYear}</span>{' '}{site.legalEntity} &middot;
          All rights reserved &middot; Patent pending.
        </div>
        <div class="footer-bottom__right">
          <button type="button" class="footer-linkbtn" id="privacyChoices">Privacy choices</button>
          <a
            href="https://www.linkedin.com/company/lumecon-ai"
            class="footer-linkbtn footer-linkbtn--a"
            target="_blank"
            rel="noopener noreferrer me">LinkedIn</a
          >
          <a href={`mailto:${site.email}`} class="footer-email mono">{site.email}</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { clearConsent } from '../lib/consent';

  // Keep the copyright year current even between deploys. The build-time
  // value rendered above is the no-JS fallback and the initial paint;
  // this refreshes it to the visitor's current year on load.
  function setCopyrightYear(): void {
    const el = document.getElementById('copyrightYear');
    if (el) el.textContent = String(new Date().getFullYear());
  }
  setCopyrightYear();
  document.addEventListener('astro:page-load', setCopyrightYear);

  // "Privacy choices": forget the stored consent decision and reload so
  // the consent banner presents the choice again.
  function bindPrivacyChoices(): void {
    const btn = document.getElementById('privacyChoices');
    if (!btn || (btn as HTMLElement & { __bound?: boolean }).__bound) return;
    (btn as HTMLElement & { __bound?: boolean }).__bound = true;
    btn.addEventListener('click', () => {
      clearConsent();
      location.reload();
    });
  }
  bindPrivacyChoices();
  document.addEventListener('astro:page-load', bindPrivacyChoices);
</script>
