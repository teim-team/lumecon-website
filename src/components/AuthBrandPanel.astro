---
/**
 * The teal brand panel of the mirrored auth pages (/login, /signup).
 * Visual reference: the product's sign-in screen (teim-app AuthGate)
 * so the site's auth and the app's auth read as one system. The
 * panel carries the same drifting contour linework and the faint
 * white-filtered mark bleeding off a top corner; the page-level
 * .asplit--login / .asplit--signup classes decide which corner, so
 * the two pages mirror deliberately.
 *
 * Proof points are quiet icon + text rows with hairline separators,
 * not cards.
 */
import MarkArt from './MarkArt.astro';

interface Point {
  icon: keyof typeof ICONS;
  text: string;
}
interface Props {
  headline: string;
  lede: string;
  points: Point[];
}
const { headline, lede, points } = Astro.props;

/* White line icons, same stroke vocabulary as the product's auth
   screen (1.8, round caps). */
const ICONS = {
  archive:
    '<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>',
  rings:
    '<circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="10" opacity="0.45"/>',
  trace:
    '<path d="M4 18l6-6 4 3 6-9"/><circle cx="4" cy="18" r="1.5"/><circle cx="20" cy="6" r="1.5"/>',
  loop: '<path d="M20 12a8 8 0 1 1-2.35-5.65"/><path d="M20 4v4h-4"/>',
  sprout:
    '<path d="M12 21v-8"/><path d="M12 13C12 9.5 9.5 7 6 7c0 3.5 2.5 6 6 6z"/><path d="M12 13c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6z"/>',
} as const;
---

<aside class="asplit-brand">
  <span class="asplit-brand__glow asplit-brand__glow--a" aria-hidden="true"></span>
  <span class="asplit-brand__glow asplit-brand__glow--b" aria-hidden="true"></span>
  <svg
    class="asplit-brand__contours"
    viewBox="0 0 640 640"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <g fill="none" stroke="#ffffff" stroke-width="1.1">
      {
        [0.3, 0.46, 0.62, 0.78, 0.94, 1.1, 1.26, 1.42].map((s) => (
          <path
            transform={`translate(150 180) scale(${s})`}
            d="M0,-150 C74,-150 152,-64 150,4 C148,84 58,152 -6,150 C-86,147 -152,66 -150,-14 C-148,-86 -74,-150 0,-150 Z"
          />
        ))
      }
      {
        [0.3, 0.48, 0.66, 0.84, 1.02, 1.2, 1.38].map((s) => (
          <path
            transform={`translate(470 460) scale(${s})`}
            d="M0,-130 C66,-134 138,-58 132,10 C127,78 52,136 -12,130 C-84,123 -134,54 -130,-18 C-126,-84 -62,-126 0,-130 Z"
          />
        ))
      }
    </g>
  </svg>
  <MarkArt class="asplit-brand__mark" size={520} />
  <div class="asplit-brand__inner">
    <p class="asplit-brand__headline">{headline}</p>
    <p class="asplit-brand__lede">{lede}</p>
    <ul class="asplit-brand__points">
      {
        points.map((p) => (
          <li class="asplit-brand__point">
            <span class="asplit-brand__point-ic" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={ICONS[p.icon]}
              />
            </span>
            <span>{p.text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
