---
/**
 * Homepage hero: one clear promise, one real product view and one real place.
 *
 * The former three-screen carousel proved breadth, but it made the product
 * feel like a stack of floating panels. This composition gives the copy a
 * strong editorial axis and stages a single readable screen against imagery
 * from Lumecon's licensed sector library. The product tour below still shows
 * the broader workflow.
 */
import '../styles/home.css';
---

<section class="hero2">
  <div class="hero2-inner">
    <div class="hero2-copy">
      <p class="h-kicker reveal-soft">Intelligent economic analysis</p>

      <h1 class="hero2-title reveal-soft" data-stagger="1">
        <span class="hero2-em">Economic analysis</span> that holds up.
      </h1>

      <p class="hero2-sub reveal-soft" data-stagger="2">
        Lumecon brings your organization&rsquo;s records, authoritative public data and a regional
        economic model into one reviewable workflow. Cedar structures the inputs and flags
        uncertainty; you approve the assumptions, Cedar Impact calculates the results and every
        estimate keeps its source trail.
      </p>

      <div class="hero2-cta reveal-soft" data-stagger="3">
        <a class="btn2 btn2--primary" href="/pricing">
          See plans and pricing <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn2 btn2--card" href="/signup?tier=free">
          Request Seed access <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <figure class="hero2-stage reveal-soft" data-stagger="2">
      <div class="hero2-photo" aria-hidden="true">
        <img
          src="/naics/utilities-v2-wide.webp"
          alt=""
          width="1500"
          height="600"
          decoding="async"
        />
        <p class="hero2-photo__label">
          <span>Renewable energy</span>
          Iowa
        </p>
      </div>

      <div class="hero2-screen" data-zoom>
        <picture>
          <source
            srcset="/app/ex-wind-results-dark.webp"
            media="(prefers-color-scheme: dark)"
            width="1920"
            height="1120"
          />
          <img
            src="/app/ex-wind-results.webp"
            alt="Lumecon results page for a wind farm buildout in Iowa, showing an estimated 2,600 jobs and $830,000,000 in economic output with key figures and the county map. Shown with illustrative sample data."
            width="1920"
            height="1220"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>

      <figcaption>Wind farm buildout in Iowa. Illustrative sample data.</figcaption>
    </figure>
  </div>

  <aside class="proof reveal-soft" data-stagger="4" aria-label="Data provenance">
    <a class="proof__label" href="/methodology#m-data"
      >Each analysis cites the public data it uses</a
    >
    <ul class="proof__list">
      <li>U.S. Census Bureau</li>
      <li>Bureau of Economic Analysis</li>
      <li>Bureau of Labor Statistics</li>
      <li>Bureau of Indian Affairs</li>
      <li>USDA</li>
      <li>NOAA</li>
    </ul>
  </aside>
</section>
