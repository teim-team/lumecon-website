---
/**
 * Hero — economic-impact-analysis headline + the product itself.
 *
 * The redesign puts a real screenshot of the Lumecon workspace (the
 * results page of an impact study) where the workflow animation used
 * to be, in the pattern of the major analysis platforms: promise on
 * top, product right under it. The screenshot is captured from the
 * app with sample study data (see the figcaption disclosure).
 *
 * The interactive impact-study map workspace lives on /map; the
 * primary CTA routes there so visitors can run a study themselves.
 */
import '../styles/hero.css';
---

<section class="hero" id="top">
  <div class="hero-brand">
    <p class="hero-tagline">Economic impact analysis software</p>

    <h1 class="hero-statement hl-block hl-block--green">
      Measure the economic impact of any project, program or policy.
    </h1>

    <!-- Lede row: the product sub-paragraph, with a teal "New to this?"
         disclosure for first-timers beside it on desktop (stacked on
         mobile). The disclosure expands to a plain-language definition
         of economic impact analysis so newcomers aren't assumed to
         already know the term. -->
    <div class="hero-lede-row">
      <p class="hero-sub">
        Lumecon turns your budgets, payroll and program records into a credible economic impact
        study in minutes: jobs, labor income, GDP contribution and tax revenue for any U.S.
        geography, with every number traceable to its source.
      </p>
      <details class="hero-eia">
        <summary class="hero-eia__summary">
          <span>New to this?</span>
          <span class="hero-eia__chev" aria-hidden="true"></span>
        </summary>
        <p class="hero-eia__body">
          <strong>Economic impact analysis</strong> shows how one dollar spent can generate more than
          one dollar in return as it moves through wages, suppliers, tax revenue, and nearby businesses.
        </p>
      </details>
    </div>

    <div class="hero-cta">
      <a class="btn" href="/map">See a live study</a>
      <a class="btn btn--ghost" href="/pricing">See pricing</a>
    </div>

    <!-- The product, not a promise about the product: the results page
         of an impact study in the Lumecon workspace. -->
    <figure class="hero-shot">
      <div class="hero-shot__chrome" aria-hidden="true">
        <span class="hero-shot__dot"></span>
        <span class="hero-shot__dot"></span>
        <span class="hero-shot__dot"></span>
        <span class="hero-shot__url">app.lumecon.ai</span>
      </div>
      <img
        src="/app/results.webp"
        alt="Lumecon results page for a whole-nation impact study: a headline sentence estimating 4,820 jobs and $1,240,500,000 in economic output, four key figures with Trace this number buttons, and a three-year impact timeline."
        width="1600"
        height="1000"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="hero-shot__caption">
        The results page of a whole-nation impact study in the Lumecon workspace, shown with sample
        data.
      </figcaption>
    </figure>

    <!-- Credibility strip: the school list where it has room, the
         shorter role-based form on mobile (same claim, less weight). -->
    <ul class="hero-proof" aria-label="Proof points">
      <li class="hero-proof__long">
        Built by Cornell, Dartmouth, MIT, Yale, Brown, Duke and Oxford-trained researchers and
        engineers
      </li>
      <li class="hero-proof__short">
        Built by economists, engineers and public-policy researchers
      </li>
      <li>Patent pending</li>
    </ul>

    <!-- Trusted data sources strip (#22): names the authoritative
         public datasets behind every study and links to the agencies,
         so the credibility claim is checkable, not just asserted. -->
    <aside class="hero-sources" aria-label="Data sources">
      <span class="hero-sources__label"
        >Built on the same foundational data as every major economic impact platform</span
      >
      <span class="hero-sources__note"
        >The difference is what we do with it and what we add to it.</span
      >
      <ul class="hero-sources__list">
        <li>
          <a href="https://www.census.gov" target="_blank" rel="noopener noreferrer"
            >U.S. Census: ACS, LODES, QWI, CBP, TIGER/Line</a
          >
        </li>
        <li>
          <a
            href="https://www.bea.gov/industry/input-output-accounts-data"
            target="_blank"
            rel="noopener noreferrer">BEA Input-Output Accounts</a
          >
        </li>
        <li>
          <a href="https://www.bls.gov/cew/" target="_blank" rel="noopener noreferrer">BLS QCEW</a>
        </li>
        <li>
          <a href="https://www.nass.usda.gov" target="_blank" rel="noopener noreferrer">USDA NASS</a
          >
        </li>
        <li>
          <a href="https://www.usaspending.gov" target="_blank" rel="noopener noreferrer"
            >USAspending</a
          >
        </li>
        <li>
          <a href="https://fred.stlouisfed.org" target="_blank" rel="noopener noreferrer"
            >FRED (St. Louis Fed)</a
          >
        </li>
        <li><a href="https://www.noaa.gov" target="_blank" rel="noopener noreferrer">NOAA</a></li>
      </ul>
    </aside>
  </div>
</section>
