---
/**
 * Hero v3 — centered promise, gradient CTA, and the product itself
 * as one large framed screenshot with floating stat chips (the
 * pattern the major analysis platforms lead with). Emphasis inside
 * the headline is colored text; the marker-highlight slabs are gone
 * from the homepage. The concentric-ring mark appears as cropped
 * background art, echoing the app's card artwork.
 *
 * The screenshot is captured from the app with sample study data
 * (see the caption under the frame).
 */
import Rings from './Rings.astro';
import '../styles/home.css';
---

<section class="hero2" id="top">
  <Rings class="rings rings--tr" size={720} />
  <Rings class="rings rings--bl" size={640} />
  <div class="hero2-inner">
    <p class="h-kicker">Economic impact analysis software</p>

    <h1 class="hero2-title">
      Measure the <span class="hero2-em">economic impact</span> of any decision.
    </h1>

    <p class="hero2-sub">
      Lumecon turns budgets, payroll and program records into a credible economic impact study in
      minutes: jobs, labor income, GDP contribution and tax revenue for any U.S. geography,{' '}
      <strong>with every number traceable to its source</strong>.
    </p>

    <div class="hero2-cta">
      <a class="btn2 btn2--primary" href="/map">
        See a live study <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a class="btn2 btn2--card" href="/pricing">
        Plans from $500 a year <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <p class="hero2-proof">
      Built by Cornell, Dartmouth, MIT, Yale, Brown, Duke and Oxford-trained researchers and
      engineers &middot; Patent pending
    </p>

    <figure class="hero2-shot">
      <div class="hero2-frame">
        <div class="hero2-chrome" aria-hidden="true">
          <span class="hero2-dot"></span>
          <span class="hero2-dot"></span>
          <span class="hero2-dot"></span>
          <span class="hero2-url">app.lumecon.ai</span>
        </div>
        <img
          src="/app/hero-results.webp"
          alt="Lumecon results page for a whole-nation impact study: a headline sentence estimating 4,820 jobs and $1,240,500,000 in economic output, four key figures with Trace this number buttons, and a three-year impact timeline."
          width="1600"
          height="1000"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero2-chips-mobile">
        <div class="hero2-chip hero2-chip--a">
          <span class="hero2-chip__k">Impact over time</span>
          <span class="hero2-chip__v">+34% economic output across three years</span>
        </div>
        <div class="hero2-chip hero2-chip--b">
          <span class="hero2-chip__k">Tax impacts</span>
          <span class="hero2-chip__v">$148,860,000 across federal, state and tribal</span>
        </div>
      </div>
      <figcaption class="hero2-caption">
        The results page of a whole-nation impact study in the Lumecon workspace, shown with sample
        data.
      </figcaption>
    </figure>
  </div>
</section>
