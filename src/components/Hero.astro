---
/**
 * Hero v3 — centered promise, gradient CTA, and the trio money shot:
 * three real app screenshots stacked the way the refreshed IMPLAN
 * hero stacks its product panels. Results front and center (a
 * general-audience Connecticut study), dashboard and number-lineage
 * tucked behind. Every screenshot swaps to a dark capture of the
 * app's own dark mode via <picture>. The actual Lumecon mark sits
 * cropped at the section edges as background art.
 */
import MarkArt from './MarkArt.astro';
import Ripple from './Ripple.astro';
import '../styles/home.css';
---

<section class="hero2" id="top">
  <Ripple class="ripple ripple--hero" />
  <MarkArt class="markart markart--tr" size={640} />
  <div class="hero2-inner">
    <p class="h-kicker">Economic impact analysis software</p>

    <h1 class="hero2-title">
      Measure the <span class="hero2-em">economic impact</span> of any decision.
    </h1>

    <p class="hero2-sub">
      Lumecon turns budgets, financial statements, payroll and program records into a credible
      economic impact study in minutes: jobs, labor income, GDP contribution and tax revenue for any
      U.S. geography,{' '}
      <strong>with every number traceable to its source</strong>.
    </p>

    <div class="hero2-cta">
      <a class="btn2 btn2--primary" href="/map">
        See a live study <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a class="btn2 btn2--card" href="/signup">
        Still deciding? Try Lumecon for free <span class="btn2-arrow" aria-hidden="true"
          >&rarr;</span
        >
      </a>
    </div>

    <p class="hero2-proof">
      Built by Cornell, Dartmouth, MIT, Yale, Brown, Duke and Oxford-trained researchers and
      engineers &middot; Patent pending &middot; Plans from $500 a year
    </p>

    <figure class="trio">
      <div class="trio-frame trio-side trio-side--l" aria-hidden="true">
        <picture>
          <source srcset="/app/dashboard-dark.webp" media="(prefers-color-scheme: dark)" />
          <img src="/app/dashboard.webp" alt="" width="1600" height="1000" decoding="async" />
        </picture>
      </div>
      <div class="trio-frame trio-main" id="heroRotator">
        <picture>
          <source srcset="/app/hero-01-dark.webp" media="(prefers-color-scheme: dark)" />
          <img
            src="/app/hero-01.webp"
            alt="Lumecon results page for a community college expansion study in Connecticut: an estimated 1,140 jobs and $214,300,000 in economic output, with four key figures and a county map."
            width="1600"
            height="1000"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <script is:inline>
        /* Rotate the hero money shot: one of ten sample studies,
           picked at random per page load. It stays put while you
           read; a reload or another visitor gets a different one. */
        (function () {
          var STUDIES = [
            [
              'hero-01',
              'a community college expansion in Connecticut: an estimated 1,140 jobs and $214,300,000 in economic output',
            ],
            [
              'hero-02',
              'hyperscale data center construction in Georgia: an estimated 4,150 jobs and $1,420,000,000 in economic output',
            ],
            [
              'hero-03',
              'a tribal hospital construction study at Warm Springs, Oregon: an estimated 1,240 jobs and $186,400,000 in economic output, with statewide and homelands scopes',
            ],
            [
              'hero-04',
              'a semiconductor fab expansion in Texas: an estimated 7,800 jobs and $2,860,000,000 in economic output',
            ],
            [
              'hero-05',
              'a port modernization program in California: an estimated 5,200 jobs and $1,150,000,000 in economic output',
            ],
            [
              'hero-06',
              'a childcare subsidy expansion in Michigan: an estimated 6,800 jobs and $640,000,000 in economic output',
            ],
            [
              'hero-07',
              'a hurricane recovery and rebuild program in Florida: an estimated 6,100 jobs and $980,000,000 in economic output',
            ],
            [
              'hero-08',
              'a university research campus in Ohio: an estimated 3,050 jobs and $720,000,000 in economic output',
            ],
            [
              'hero-09',
              'a wind energy buildout in Iowa: an estimated 1,900 jobs and $830,000,000 in economic output',
            ],
            [
              'hero-10',
              'a whole-nation economic footprint for a Tribal Nation: an estimated 4,820 jobs and $1,240,500,000 in economic output',
            ],
          ];
          var i = Math.floor(Math.random() * STUDIES.length);
          if (i === 0) return;
          var pick = STUDIES[i];
          var root = document.getElementById('heroRotator');
          if (!root) return;
          var source = root.querySelector('source');
          var img = root.querySelector('img');
          if (source) source.srcset = '/app/' + pick[0] + '-dark.webp';
          if (img) {
            img.src = '/app/' + pick[0] + '.webp';
            img.alt = 'Lumecon results page for ' + pick[1] + ', shown with sample data.';
          }
        })();
      </script>
      <div class="trio-frame trio-side trio-side--r" aria-hidden="true">
        <picture>
          <source srcset="/app/trace-dark.webp" media="(prefers-color-scheme: dark)" />
          <img src="/app/trace.webp" alt="" width="1600" height="1000" decoding="async" />
        </picture>
      </div>
      <figcaption class="trio-caption">
        The Lumecon workspace: results, workspace home and number lineage, shown with sample study
        data.
      </figcaption>
    </figure>
  </div>
</section>
