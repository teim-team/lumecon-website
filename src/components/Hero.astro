---
/**
 * Hero v3 — centered promise, gradient CTA, and the trio money shot:
 * three real app screenshots stacked the way the refreshed IMPLAN
 * hero stacks its product panels. Results front and center (a
 * general-audience Connecticut study), dashboard and number-lineage
 * tucked behind. Every screenshot swaps to a dark capture of the
 * app's own dark mode via <picture>. The actual Lumecon mark sits
 * cropped at the section edges as background art.
 */
import MarkArt from './MarkArt.astro';
import Ripple from './Ripple.astro';
import '../styles/home.css';
---

<section class="hero2" id="top">
  <Ripple class="ripple ripple--hero" />
  <MarkArt class="markart markart--tr" size={640} />
  <div class="hero2-inner">
    <p class="h-kicker">Economic impact analysis software</p>

    <h1 class="hero2-title">
      Measure the <span class="hero2-em">economic impact</span> of any decision.
    </h1>

    <p class="hero2-sub">
      Lumecon turns budgets, financial statements, payroll and program records into a credible
      economic impact study in minutes: jobs, labor income, GDP contribution and tax revenue for any
      U.S. geography,{' '}
      <strong>with every number traceable to its source</strong>.
    </p>

    <div class="hero2-cta">
      <a class="btn2 btn2--primary" href="/map">
        See a live study <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a class="btn2 btn2--card" href="/signup">
        Still deciding? Try Lumecon for free <span class="btn2-arrow" aria-hidden="true"
          >&rarr;</span
        >
      </a>
    </div>

    <p class="hero2-proof">
      Built by Cornell, Dartmouth, MIT, Yale, Brown, Duke and Oxford-trained researchers and
      engineers &middot; Patent pending &middot; Plans from $500 a year
    </p>

    <figure class="trio">
      <div class="trio-frame trio-side trio-side--l" aria-hidden="true">
        <picture>
          <source srcset="/app/dashboard-dark.webp" media="(prefers-color-scheme: dark)" />
          <img src="/app/dashboard.webp" alt="" width="1600" height="1000" decoding="async" />
        </picture>
      </div>
      <div class="trio-frame trio-main">
        <picture>
          <source srcset="/app/college-dark.webp" media="(prefers-color-scheme: dark)" />
          <img
            src="/app/college.webp"
            alt="Lumecon results page for a community college expansion study in Connecticut: a headline sentence estimating 1,140 jobs and $214,300,000 in economic output, four key figures with Trace this number buttons, and a county map of the state."
            width="1600"
            height="1000"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <div class="trio-frame trio-side trio-side--r" aria-hidden="true">
        <picture>
          <source srcset="/app/trace-dark.webp" media="(prefers-color-scheme: dark)" />
          <img src="/app/trace.webp" alt="" width="1600" height="1000" decoding="async" />
        </picture>
      </div>
      <figcaption class="trio-caption">
        The Lumecon workspace: results, workspace home and number lineage, shown with sample study
        data.
      </figcaption>
    </figure>
  </div>
</section>
