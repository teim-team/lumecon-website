---
/**
 * /cedar-grove — Cedar Grove by Lumecon.
 *
 * The product page for the standalone license. The press hero is a
 * catalog because Press sells a shared catalog; Grove's hero is a place,
 * because what Grove sells is the connection between a claim and the
 * geography and records it rests on. The page shows Grove's actual objects
 * in order: the map for place, the graph for the claim, the evidence record
 * for trust, the collection marks for the infrastructure.
 *
 * Section rhythm: dark navy hero with the evidence map; deep teal band with
 * the finding workflow (question, figure, evidence record); pale proof strip
 * with staged product crops; deep ink registry of the twelve collections;
 * pale license panel with the late bridge to Cedar Impact.
 *
 * Everything staged here uses an invented organization, an invented place
 * and invented values, labelled as such on its face. No real Nation, no
 * real area and no real number appears, so the page cannot attach fabricated
 * figures to an actual community. The map distinguishes the organization's
 * geography, its self-declared service area and the statistical proxy
 * geography a source falls back to; it draws none of them from a real map.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import { CEDAR_GROVE } from '../data/pricing';
import { GROVE_COLLECTIONS } from '../data/groveCollections';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';
import '../styles/grove-page.css';
import GROVE_MAP from '../data/groveMap.generated.json';

/**
 * The map's subject, and the counties it is drawn with.
 *
 * The geometry is Census TIGER/Line 2018 for the reservation and its trust
 * land, and us-atlas counties-10m and states-10m for everything around it,
 * all projected once into the same albers space. It is generated by
 * `scripts/build-grove-map-geometry.mjs` in the app repository and committed
 * here, because the boundary of a real place is not something a product page
 * may draw by hand.
 *
 * The Navajo Nation is the subject because it states the resolution problem
 * better than any diagram could: one nation, nine counties, three states, and
 * three of those counties hold non-contiguous chapters far from the main
 * reservation. Every source below answers at a different one of those levels.
 */
const MAP_COUNTY_LABELS = GROVE_MAP.counties.filter((county) => county.labelInFrame);
const MAP_AREA_SQ_MI = GROVE_MAP.area.areaSqMi?.toLocaleString('en-US') ?? null;

const description =
  'Cedar Grove is the living evidence base for your organization’s economy: maintained public data, Lumecon collections and the records you govern, with every finding connected to its source, geography, method, vintage and limits.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Cedar Grove | Lumecon',
    url: 'https://lumecon.ai/cedar-grove',
    description,
    isPartOf: { '@id': `${site.url}#website` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Cedar Grove',
    brand: { '@type': 'Brand', name: 'Lumecon' },
    description,
    url: 'https://lumecon.ai/cedar-grove',
    offers: {
      '@type': 'Offer',
      price: 2500,
      priceCurrency: 'USD',
      description: 'Per organization, per year. Unlimited teammates.',
      url: 'https://lumecon.ai/cedar-grove#license',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Cedar Grove',
        item: 'https://lumecon.ai/cedar-grove',
      },
    ],
  },
];

/**
 * The evidence map's topics. Each names the layer of the map it is about and
 * carries the compact evidence panel: source, vintage, geography, status and
 * limitation. The sources are real programs; the place and the status are
 * staged for the invented Example Nation.
 */
const MAP_TOPICS = [
  {
    id: 'income',
    label: 'Income and population',
    status: 'direct',
    statusLabel: 'Direct',
    fields: [
      ['Source', 'U.S. Census Bureau, American Community Survey, 5-year'],
      ['Vintage', '2020–2024'],
      ['Geography', 'The reservation and its trust land, published as one AIANNH area'],
      ['Limitation', 'Survey estimates: a margin of error accompanies every cell'],
    ],
  },
  {
    id: 'employment',
    label: 'Employment and wages',
    status: 'proxy',
    statusLabel: 'County proxy',
    fields: [
      ['Source', 'Bureau of Labor Statistics, Quarterly Census of Employment and Wages'],
      ['Vintage', '2024 annual averages'],
      ['Geography', 'Nine counties in three states stand in for the reservation'],
      [
        'Limitation',
        'The county figures count employers across the whole county, most of which lies outside the reservation. State the assumption or add records.',
      ],
    ],
  },
  {
    id: 'outcomes',
    label: 'Program outcomes',
    status: 'missing',
    statusLabel: 'Missing',
    fields: [
      ['Source', 'None yet'],
      ['Vintage', 'Not covered'],
      ['Geography', 'The program’s service area, which no source publishes'],
      [
        'Limitation',
        'No public source links enrollment to later employment. The nation’s own enrollment history would.',
      ],
    ],
  },
];

/**
 * The staged findings. Invented organization, invented values. Each carries
 * the same fields the product's evidence record carries, so the frame
 * demonstrates the object rather than describing it.
 */
const FINDINGS = [
  {
    id: 'income',
    question: 'Are our people’s incomes rising faster than the national figure?',
    claim: 'Per capita income is estimated to have grown faster than the national AIAN figure.',
    status: 'direct',
    statusLabel: 'Direct',
    implication:
      'Published for the Nation’s area directly. Survey estimates carry margins of error.',
    figure: 'trend',
    identity: [
      ['Measure', 'Per capita income (USD, nominal)'],
      ['Universe', 'AIAN alone'],
      ['Geography', 'Example Nation'],
      ['Period', '1990–2024'],
      ['Source', 'ACS 5-year; decennial long-form for 1990 and 2000'],
    ],
    record: [
      ['Source', 'U.S. Census Bureau, American Community Survey, 5-year (2020–2024)'],
      ['Source (also)', 'U.S. Census Bureau, decennial long-form estimates (1990, 2000)'],
      ['Transformation', 'As published; nominal dollars; series joined across products at 2010'],
      ['Uncertainty', 'A 90 percent margin of error accompanies every ACS cell'],
      [
        'Limits',
        'Overlapping five-year periods; decennial and ACS points are not strictly comparable',
      ],
      ['Reproduce', 'Python, R and Stata scripts read the same rows the figure draws'],
    ],
    cite: 'U.S. Census Bureau, American Community Survey, 5-year, 2020–2024. Prepared with Lumecon Cedar Grove.',
  },
  {
    id: 'employer',
    question: 'Are we the largest employer in our region?',
    claim: 'The Nation would rank first among the benchmarked employers in its region.',
    status: 'proxy',
    statusLabel: 'County proxy',
    implication:
      'This comparison covers the three surrounding counties rather than the Nation’s area directly. State the assumption or add data.',
    figure: 'bars',
    identity: [
      ['Measure', 'Employment (headcount)'],
      ['Geography', 'Three surrounding counties'],
      ['Period', '2025'],
      ['Source', 'Lumecon Employer Benchmark; the Nation’s own row from its records'],
    ],
    record: [
      ['Source', 'Lumecon Employer Benchmark 2025, assembled from public records'],
      ['Organization data', 'Enterprise employment roster, 2019–2025, supplied by the Nation'],
      ['Transformation', 'Ranked by headcount; headcount is not comparable with FTE figures'],
      ['Geography', 'The benchmark publishes counties, so the county group stands in for the area'],
      ['Limits', 'Comparators are named where public records allow; a peer cohort otherwise'],
      ['Reproduce', 'Script, data file, provenance sidecar and manifest in one bundle'],
    ],
    cite: 'Lumecon Employer Benchmark, 2025, and organization-supplied employment. Prepared with Lumecon Cedar Grove.',
  },
  {
    id: 'outcomes',
    question: 'What happens to our citizens after they enroll in the workforce program?',
    claim: 'Not yet supportable. No source links program enrollment to later employment.',
    status: 'missing',
    statusLabel: 'Missing',
    implication:
      'Nothing answers this yet. An enrollment history with outcome fields from the Nation’s own records would; no public source can stand in.',
    figure: 'coverage',
    identity: [
      ['Measure', 'Post-enrollment employment'],
      ['Geography', 'Example Nation'],
      ['Period', 'Not covered'],
      ['Source', 'None yet'],
    ],
    record: [
      [
        'What Grove needs',
        'An enrollment history file: citizen id, program, enrollment year, outcome',
      ],
      ['Path', 'Local preview today; governed import with a named data steward when it lands'],
      ['Until then', 'The question stays listed as unanswered rather than answered with a proxy'],
    ],
    cite: null,
  },
];

/** The proof strip: the four things an organization can always see. */
const PROOF = [
  {
    title: 'Evidence supported',
    text: 'Findings you can defend today, each with its claim class, how well the evidence fits it and whether the geography measured is the geography named.',
  },
  {
    title: 'Direct or proxy',
    text: 'Where a source does not publish your area, Grove names the wider geography that stood in and what that means for the number you are about to cite.',
  },
  {
    title: 'Governed records',
    text: 'The roster, payroll or enrollment file that moves a topic from proxy to direct, named before you assemble it and kept under your governance when it arrives.',
  },
  {
    title: 'Reproducible',
    text: 'Every figure carries an evidence record and a script that rebuilds it from the same rows, in Python, R or Stata.',
  },
];

/** The staged coverage view: topic, status, and the source that answers it. */
const COVERAGE_ROWS = [
  ['Population', 'direct', 'Direct', 'ACS 5-year'],
  ['Income', 'direct', 'Direct', 'ACS 5-year'],
  ['Employment', 'proxy', 'County proxy', 'QCEW, three counties'],
  ['Tribal employment', 'org', 'Organization data', 'Enterprise roster'],
  ['Program outcomes', 'missing', 'Missing', 'No source'],
];

/** The staged evidence record, the rows the export carries. */
const RECORD_ROWS = [
  ['Measure', 'Per capita income (USD)'],
  ['Geography', 'Example Nation'],
  ['Universe', 'AIAN alone'],
  ['Source', 'U.S. Census Bureau, ACS 5-year'],
  ['Vintage', '2020–2024'],
  ['Transformation', 'As published; nominal dollars'],
  ['Uncertainty', '90 percent margin of error'],
  ['Limits', 'Overlapping five-year periods'],
];

/** The staged bundle: the files the app names, with its own naming scheme. */
const BUNDLE_FILES = [
  ['lumecon-income-trend-example-nation.py', 'Script'],
  ['lumecon-income-trend-example-nation.csv', 'Data'],
  ['lumecon-income-trend-example-nation-provenance.csv', 'Provenance'],
  ['lumecon-income-trend-example-nation-bundle.json', 'Manifest'],
];
---

<BaseLayout
  title="Cedar Grove, the living evidence base for your organization’s economy | Lumecon"
  description={description}
  canonical="https://lumecon.ai/cedar-grove"
  jsonLd={jsonLd}
  cedar={false}
>
  <Nav isHome={false} />
  <main class="meth grovepg" id="top" tabindex="-1">
    <header class="meth-hero grovepg-hero section--dark">
      <div class="meth-w">
        <p class="h-kicker reveal-soft">Cedar Grove by Lumecon</p>
        <h1 class="meth-hero__title reveal-soft" data-stagger="1">
          The living evidence base for your organization’s economy.
        </h1>
        <p class="meth-hero__lede reveal-soft" data-stagger="2">
          Cedar Grove connects maintained public data, Lumecon collections and the records your
          organization governs. Every finding stays connected to its source, geography, method,
          vintage and limits, so a number can be checked, cited and reproduced by the people who
          have to stand behind it.
        </p>
        <div class="grovepg-cta reveal-soft" data-stagger="3">
          <a class="btn2 btn2--primary" href="#license">
            Request Grove <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn2 btn2--card" href="#frame">
            See the evidence behind a finding <span class="btn2-arrow" aria-hidden="true"
              >&rarr;</span
            >
          </a>
        </div>
        {
          /* The evidence map: the place the evidence is about, and which
             geography each source can answer at. Census boundaries, drawn
             from the generated geometry above; no basemap, no pins, no
             choropleth, and nothing drawn by hand. The map carries no
             values at all, only place and coverage. */
        }
        <div class="gf gm reveal-soft" data-stagger="2" data-gm data-gm-topic="income">
          <div class="gf__bar">
            <span class="gf__brand">
              Cedar Grove <small>{GROVE_MAP.area.name.replace(' Reservation', '')}</small>
            </span>
            <span class="gf__note">Census TIGER/Line 2018 · Coverage, not values</span>
          </div>
          <div class="gm__body">
            <figure class="gm__map">
              <div class="gm__canvas">
                <svg viewBox={GROVE_MAP.viewBox} role="img" aria-labelledby="gm-title gm-desc">
                  <title id="gm-title">
                    {GROVE_MAP.area.name} and the counties its boundary crosses
                  </title>
                  <desc id="gm-desc">
                    Census boundaries. The reservation is filled in teal and its off-reservation
                    trust land is outlined beside it. The {GROVE_MAP.counties.length} counties whose
                    boundaries the reservation crosses are drawn around it, hatched where a source
                    can answer only at the county level, with the {GROVE_MAP.states.length} state
                    lines behind them.
                  </desc>
                  <defs>
                    <pattern
                      id="gm-hatch"
                      width="7"
                      height="7"
                      patternUnits="userSpaceOnUse"
                      patternTransform="rotate(45)"
                    >
                      <line
                        x1="0"
                        y1="0"
                        x2="0"
                        y2="7"
                        stroke="#18364a"
                        stroke-opacity="0.5"
                        stroke-width="1.1"></line>
                    </pattern>
                  </defs>
                  <rect x="0" y="0" width="560" height="420" fill="#f7f5f0"></rect>
                  <g transform={GROVE_MAP.transform}>
                    <g class="gm__states" fill="#efece5" stroke="#c9cccf" vector-effect="non-scaling-stroke">
                      {GROVE_MAP.states.map((state) => <path d={state.d}></path>)}
                    </g>
                    <g class="gm__proxy" fill="url(#gm-hatch)" stroke="none">
                      {GROVE_MAP.counties.map((county) => <path d={county.d}></path>)}
                    </g>
                    <g class="gm__counties" fill="none" stroke="#b9c1c6" vector-effect="non-scaling-stroke">
                      {GROVE_MAP.counties.map((county) => <path d={county.d}></path>)}
                    </g>
                    <g class="gm__neighbors" fill="#e6e2d8" stroke="#a9a294" vector-effect="non-scaling-stroke">
                      {GROVE_MAP.neighbors.map((land) => <path d={land.d}></path>)}
                    </g>
                    {
                      GROVE_MAP.trustLand ? (
                        <path
                          class="gm__trust"
                          d={GROVE_MAP.trustLand.d}
                          fill="rgba(10, 127, 116, 0.14)"
                          stroke="#0a7f74"
                          stroke-width="0.9"
                          vector-effect="non-scaling-stroke"
                        />
                      ) : null
                    }
                    <path
                      class="gm__org"
                      d={GROVE_MAP.area.d}
                      fill="rgba(10, 127, 116, 0.2)"
                      stroke="#0a7f74"
                      stroke-width="1.8"
                      vector-effect="non-scaling-stroke"></path>
                  </g>
                  <g class="gm__labels" font-family="var(--font-mono)" font-size="10">
                    {
                      MAP_COUNTY_LABELS.map((county) => (
                        <text
                          x={county.label[0]}
                          y={county.label[1]}
                          fill="#5b676d"
                          text-anchor="middle"
                        >
                          {`${county.name.toUpperCase()} CO, ${county.usps}`}
                        </text>
                      ))
                    }
                    {
                      GROVE_MAP.neighbors
                        .filter((land) => land.labelInFrame)
                        .map((land) => (
                          <text
                            x={land.label[0]}
                            y={land.label[1]}
                            fill="#6b6152"
                            font-size="9"
                            text-anchor="middle"
                          >
                            {land.name.replace(' Reservation', '').toUpperCase()}
                          </text>
                        ))
                    }
                    <text
                      class="gm__labels__area"
                      x={GROVE_MAP.area.label[0]}
                      y={GROVE_MAP.area.label[1]}
                      fill="#075f58"
                      font-size="15"
                      font-weight="700"
                      text-anchor="middle"
                    >
                      Navajo Nation
                    </text>
                    <text
                      x={GROVE_MAP.area.label[0]}
                      y={GROVE_MAP.area.label[1] + 15}
                      fill="#075f58"
                      font-size="9.5"
                      text-anchor="middle"
                    >
                      AIANNH 2430
                    </text>
                  </g>
                  <rect x="0.5" y="0.5" width="559" height="419" fill="none" stroke="#d9dcdf"></rect>
                </svg>
              </div>
              <figcaption class="gm__legend" aria-label="Map key">
                <span><i class="gm__sw gm__sw--org"></i>Reservation</span>
                <span><i class="gm__sw gm__sw--trust"></i>Off-reservation trust land</span>
                <span><i class="gm__sw gm__sw--proxy"></i>County a source falls back to</span>
                <span><i class="gm__sw gm__sw--state"></i>State line</span>
                <span><i class="gm__sw gm__sw--neighbor"></i>Another nation</span>
              </figcaption>
              <p class="gm__vintage">
                {GROVE_MAP.vintage}. {MAP_AREA_SQ_MI ? `${MAP_AREA_SQ_MI} square miles` : null}, {GROVE_MAP.counties.length}{' '}
                counties, {GROVE_MAP.states.length} states. {GROVE_MAP.simplification}
              </p>
            </figure>
            <aside class="gm__panel" aria-label="Evidence for the selected topic">
              <p class="gf__cap">What the evidence covers</p>
              <div class="gm__topics" role="group" aria-label="Topics">
                {
                  MAP_TOPICS.map((t, i) => (
                    <button
                      type="button"
                      class="gm__topic"
                      data-gm-pick={t.id}
                      aria-pressed={i === 0 ? 'true' : 'false'}
                    >
                      {t.label}
                      <small class={`gf__status gf__status--${t.status}`}>{t.statusLabel}</small>
                    </button>
                  ))
                }
              </div>
              {
                MAP_TOPICS.map((t, i) => (
                  <dl class="gm__fields" data-gm-fields={t.id} hidden={i !== 0}>
                    {t.fields.map(([k, v]) => (
                      <div>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                    <div>
                      <dt>Status</dt>
                      <dd class={`gf__status gf__status--${t.status}`}>{t.statusLabel}</dd>
                    </div>
                  </dl>
                ))
              }
              <p class="gm__foot">
                Jurisdiction, service area, organization geography and statistical geography are
                kept apart, never merged. The boundaries drawn here are Census geography at the
                vintage named under the map. The map carries coverage, never values.
              </p>
            </aside>
          </div>
        </div>
      </div>
    </header>

    {
      /* The frame. A staged Grove: the leadership question on the left,
         the claim and its figure in the middle, the coverage status and
         the implication beside them, the record underneath on request. */
    }
    <section class="grovepg-frameband section--dark" aria-labelledby="g-frame">
      <div class="meth-w">
        <p class="h-kicker reveal-soft">The evidence behind a finding</p>
        <h2 class="grovepg-frameband__title reveal-soft" id="g-frame" data-stagger="1">
          Pick a question. Read what the evidence supports, and what it rests on.
        </h2>
        <div class="gf reveal-soft" id="frame" data-stagger="2" data-gf>
          <div class="gf__bar">
            <span class="gf__brand">Cedar Grove <small>Example Nation</small></span>
            <span class="gf__note">Illustrative example. Names and values are invented.</span>
          </div>
          <div class="gf__body">
            <aside class="gf__side" aria-label="Leadership questions">
              <p class="gf__cap">A leadership question</p>
              {
                FINDINGS.map((f, i) => (
                  <button
                    type="button"
                    class="gf__q"
                    data-gf-pick={f.id}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                  >
                    {f.question}
                    <small class={`gf__status gf__status--${f.status}`}>{f.statusLabel}</small>
                  </button>
                ))
              }
            </aside>
            <div class="gf__main">
              {
                FINDINGS.map((f, i) => (
                  <section
                    class="gf__panel"
                    data-gf-panel={f.id}
                    hidden={i !== 0}
                    aria-label={f.question}
                  >
                    <dl class="gf__ident">
                      {f.identity.map(([k, v]) => (
                        <div>
                          <dt>{k}</dt>
                          <dd>{v}</dd>
                        </div>
                      ))}
                      <div>
                        <dt>Status</dt>
                        <dd class={`gf__status gf__status--${f.status}`}>{f.statusLabel}</dd>
                      </div>
                    </dl>
                    <div class="gf__stage">
                      <div class="gf__fig" aria-hidden="true">
                        {f.figure === 'trend' && (
                          <svg viewBox="0 0 640 300">
                            <text x="52" y="24" font-size="11" fill="#0a7f74" font-weight="700">
                              Example Nation
                            </text>
                            <text x="180" y="24" font-size="11" fill="#33434a">
                              US, AIAN alone
                            </text>
                            <text x="330" y="24" font-size="11" fill="#33434a">
                              US, all residents
                            </text>
                            <line x1="52" x2="580" y1="212" y2="212" stroke="#e4e9ec" />
                            <line x1="52" x2="580" y1="150" y2="150" stroke="#e4e9ec" />
                            <line x1="52" x2="580" y1="88" y2="88" stroke="#e4e9ec" />
                            <line
                              x1="363"
                              x2="363"
                              y1="46"
                              y2="266"
                              stroke="#93a0a5"
                              stroke-dasharray="3 4"
                            />
                            <text
                              x="357"
                              y="56"
                              font-size="8.5"
                              fill="#5b6970"
                              text-anchor="end"
                              letter-spacing="1"
                            >
                              DECENNIAL LONG-FORM
                            </text>
                            <text x="369" y="56" font-size="8.5" fill="#5b6970" letter-spacing="1">
                              ACS 5-YEAR
                            </text>
                            <path
                              d="M52 185 L207 149 L363 124 L518 91 L580 67"
                              fill="none"
                              stroke="#18364a"
                              stroke-width="1.9"
                              stroke-dasharray="5 4"
                            />
                            <path
                              d="M52 232 L207 212 L363 183 L518 153 L580 132"
                              fill="none"
                              stroke="#18364a"
                              stroke-width="1.9"
                            />
                            <path
                              d="M52 242 L207 216 L363 187 L518 150 L580 123"
                              fill="none"
                              stroke="#0a7f74"
                              stroke-width="2.6"
                            />
                            <g fill="#0a7f74">
                              <circle cx="52" cy="242" r="3.2" />
                              <circle cx="207" cy="216" r="3.2" />
                              <circle cx="363" cy="187" r="3.2" />
                              <circle cx="518" cy="150" r="3.2" />
                              <circle cx="580" cy="123" r="4" />
                            </g>
                            <text x="52" y="288" font-size="11" fill="#647279">
                              1990
                            </text>
                            <text x="580" y="288" font-size="11" fill="#647279" text-anchor="end">
                              2024
                            </text>
                          </svg>
                        )}
                        {f.figure === 'bars' && (
                          <svg viewBox="0 0 640 300">
                            <text
                              x="628"
                              y="24"
                              font-size="10"
                              fill="#647279"
                              text-anchor="end"
                              letter-spacing="1"
                            >
                              BENCHMARK 2025
                            </text>
                            <g font-size="11" fill="#33434a">
                              <text
                                x="150"
                                y="72"
                                text-anchor="end"
                                font-weight="700"
                                fill="#071824"
                              >
                                Example Nation
                              </text>
                              <text x="150" y="122" text-anchor="end">
                                Regional employer B
                              </text>
                              <text x="150" y="172" text-anchor="end">
                                Regional employer C
                              </text>
                              <text x="150" y="222" text-anchor="end">
                                Regional employer D
                              </text>
                              <text x="150" y="272" text-anchor="end">
                                Regional employer E
                              </text>
                            </g>
                            <rect x="166" y="56" width="420" height="24" fill="#0a7f74" />
                            <rect x="166" y="106" width="370" height="24" fill="#18364a" />
                            <rect x="166" y="156" width="335" height="24" fill="#18364a" />
                            <rect x="166" y="206" width="272" height="24" fill="#18364a" />
                            <rect x="166" y="256" width="234" height="24" fill="#18364a" />
                          </svg>
                        )}
                        {f.figure === 'coverage' && (
                          <svg viewBox="0 0 640 300">
                            <g font-size="12" fill="#071824">
                              <text x="40" y="60">
                                Population
                              </text>
                              <text x="40" y="104">
                                Income
                              </text>
                              <text x="40" y="148">
                                Employment
                              </text>
                              <text x="40" y="192">
                                Tribal employment
                              </text>
                              <text x="40" y="236">
                                Post-enrollment employment
                              </text>
                            </g>
                            <g font-size="9.5" letter-spacing="1" text-anchor="end">
                              <text x="600" y="60" fill="#0a7f74">
                                DIRECT
                              </text>
                              <text x="600" y="104" fill="#0a7f74">
                                DIRECT
                              </text>
                              <text x="600" y="148" fill="#c77a18">
                                COUNTY PROXY
                              </text>
                              <text x="600" y="192" fill="#0a7f74">
                                ORGANIZATION DATA
                              </text>
                              <text x="600" y="236" fill="#c77a18" font-weight="700">
                                MISSING
                              </text>
                            </g>
                            <g stroke="#e4e9ec">
                              <line x1="40" x2="600" y1="72" y2="72" />
                              <line x1="40" x2="600" y1="116" y2="116" />
                              <line x1="40" x2="600" y1="160" y2="160" />
                              <line x1="40" x2="600" y1="204" y2="204" />
                              <line x1="40" x2="600" y1="248" y2="248" />
                            </g>
                          </svg>
                        )}
                      </div>
                      <div>
                        <p class="gf__claim">{f.claim}</p>
                        <p
                          class={`gf__impl${f.status === 'direct' || f.status === 'org' ? ' gf__impl--ok' : ''}`}
                        >
                          {f.implication}
                        </p>
                      </div>
                    </div>
                    <div class="gf__acts">
                      <button
                        type="button"
                        class="gf__btn gf__btn--primary"
                        data-gf-record
                        aria-expanded="false"
                      >
                        Open evidence record
                      </button>
                      <span class="gf__note">
                        Evidence sheet (PDF) · Reproduce in Python, R or Stata
                      </span>
                    </div>
                    <div class="gf__record" data-gf-recordpanel hidden>
                      <p class="gf__cap">Evidence record</p>
                      <dl class="gf__rec">
                        {f.record.map(([k, v]) => (
                          <>
                            <dt>{k}</dt>
                            <dd>{v}</dd>
                          </>
                        ))}
                        {f.cite && (
                          <>
                            <dt>Cite as</dt>
                            <dd class="gf__cite">{f.cite}</dd>
