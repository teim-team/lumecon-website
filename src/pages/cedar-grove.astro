---
/**
 * /cedar-grove — Cedar Grove by Lumecon.
 *
 * The product page for the standalone license. Cedar Press's hero is a
 * catalog because Press sells a shared catalog; Grove's hero is a staged
 * organizational evidence view, because what Grove sells is the connection
 * between a claim and what it rests on. One interactive frame demonstrates
 * it: pick a finding, read its coverage status, open the evidence record.
 *
 * The frame uses an invented organization and invented values, labelled as
 * such on the frame. It never shows a real place or a real number, so the
 * page cannot attach fabricated figures to an actual community.
 *
 * The hero capture is different and says so in its caption: it is the app's
 * demonstration workspace, whose organization is invented but whose
 * geography is a real Census statistical area, because the app computes
 * coverage from real source geography rather than asserting it. Its
 * observations are demonstration values, labelled as such in the capture.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import { CEDAR_GROVE } from '../data/pricing';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';
import '../styles/grove-page.css';

const description =
  'Cedar Grove is the living evidence base for your organization’s economy: maintained public data, Lumecon collections and the records you govern, with every finding connected to its source, geography, method, vintage and limits.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Cedar Grove | Lumecon',
    url: 'https://lumecon.ai/cedar-grove',
    description,
    isPartOf: { '@id': `${site.url}#website` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Cedar Grove',
    brand: { '@type': 'Brand', name: 'Lumecon' },
    description,
    url: 'https://lumecon.ai/cedar-grove',
    offers: {
      '@type': 'Offer',
      price: 2500,
      priceCurrency: 'USD',
      description: 'Per organization, per year. Unlimited teammates.',
      url: 'https://lumecon.ai/cedar-grove#license',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Cedar Grove',
        item: 'https://lumecon.ai/cedar-grove',
      },
    ],
  },
];

/**
 * The staged findings. Invented organization, invented values. Each carries
 * the same fields the product's evidence record carries, so the frame
 * demonstrates the object rather than describing it.
 */
const FINDINGS = [
  {
    id: 'income',
    question: 'Are our people’s incomes rising faster than the national figure?',
    claim: 'Per capita income is estimated to have grown faster than the national AIAN figure.',
    status: 'direct',
    statusLabel: 'Direct',
    implication:
      'Published for the Nation’s area directly. Survey estimates carry margins of error.',
    figure: 'trend',
    identity: [
      ['Measure', 'Per capita income (USD, nominal)'],
      ['Universe', 'AIAN alone'],
      ['Geography', 'Example Nation'],
      ['Period', '1990–2024'],
      ['Source', 'ACS 5-year; decennial long-form for 1990 and 2000'],
    ],
    record: [
      ['Source', 'U.S. Census Bureau, American Community Survey, 5-year (2020–2024)'],
      ['Source (also)', 'U.S. Census Bureau, decennial long-form estimates (1990, 2000)'],
      ['Transformation', 'As published; nominal dollars; series joined across products at 2010'],
      ['Uncertainty', 'A 90 percent margin of error accompanies every ACS cell'],
      [
        'Limits',
        'Overlapping five-year periods; decennial and ACS points are not strictly comparable',
      ],
      ['Reproduce', 'Python, R and Stata scripts read the same rows the figure draws'],
    ],
    cite: 'U.S. Census Bureau, American Community Survey, 5-year, 2020–2024. Prepared with Lumecon Cedar Grove.',
  },
  {
    id: 'employer',
    question: 'Are we the largest employer in our region?',
    claim: 'The Nation would rank first among the benchmarked employers in its region.',
    status: 'proxy',
    statusLabel: 'County proxy',
    implication:
      'This comparison covers the three surrounding counties rather than the Nation’s area directly. State the assumption or add data.',
    figure: 'bars',
    identity: [
      ['Measure', 'Employment (headcount)'],
      ['Geography', 'Three surrounding counties'],
      ['Period', '2025'],
      ['Source', 'Lumecon Employer Benchmark; the Nation’s own row from its records'],
    ],
    record: [
      ['Source', 'Lumecon Employer Benchmark 2025, assembled from public records'],
      ['Organization data', 'Enterprise employment roster, 2019–2025, supplied by the Nation'],
      ['Transformation', 'Ranked by headcount; headcount is not comparable with FTE figures'],
      ['Geography', 'The benchmark publishes counties, so the county group stands in for the area'],
      ['Limits', 'Comparators are named where public records allow; a peer cohort otherwise'],
      ['Reproduce', 'Script, data file, provenance sidecar and manifest in one bundle'],
    ],
    cite: 'Lumecon Employer Benchmark, 2025, and organization-supplied employment. Prepared with Lumecon Cedar Grove.',
  },
  {
    id: 'outcomes',
    question: 'What happens to our citizens after they enroll in the workforce program?',
    claim: 'Not yet supportable. No source links program enrollment to later employment.',
    status: 'missing',
    statusLabel: 'Missing',
    implication:
      'Nothing answers this yet. An enrollment history with outcome fields from the Nation’s own records would; no public source can stand in.',
    figure: 'coverage',
    identity: [
      ['Measure', 'Post-enrollment employment'],
      ['Geography', 'Example Nation'],
      ['Period', 'Not covered'],
      ['Source', 'None yet'],
    ],
    record: [
      [
        'What Grove needs',
        'An enrollment history file: citizen id, program, enrollment year, outcome',
      ],
      ['Path', 'Local preview today; governed import with a named data steward when it lands'],
      ['Until then', 'The question stays listed as unanswered rather than answered with a proxy'],
    ],
    cite: null,
  },
];
---

<BaseLayout
  title="Cedar Grove, the living evidence base for your organization’s economy | Lumecon"
  description={description}
  canonical="https://lumecon.ai/cedar-grove"
  jsonLd={jsonLd}
  cedar={false}
>
  <Nav isHome={false} />
  <main class="meth grovepg" id="top" tabindex="-1">
    <header class="meth-hero grovepg-hero section--dark">
      <div class="meth-w">
        <p class="h-kicker reveal-soft">Cedar Grove by Lumecon</p>
        <h1 class="meth-hero__title reveal-soft" data-stagger="1">
          The living evidence base for your organization’s economy.
        </h1>
        <p class="meth-hero__lede reveal-soft" data-stagger="2">
          Cedar Grove connects maintained public data, Lumecon collections and the records your
          organization governs. Every finding stays connected to its source, geography, method,
          vintage and limits, so a number can be checked, cited and reproduced by the people who
          have to stand behind it.
        </p>
        <div class="grovepg-cta reveal-soft" data-stagger="3">
          <a class="btn2 btn2--primary" href="#license">
            Request a Grove <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn2 btn2--card" href="#frame">
            See how a finding is held <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        {
          /* The product itself, beside the copy: the Grove Overview, captured
             from the app in both themes. Fades and rises in with the copy
             (reveal-soft, staggered). Shown with the app's demonstration
             workspace. */
        }
        <figure class="grovepg-hero__screen reveal-soft" data-stagger="2" data-zoom>
          <picture>
            <source
              srcset="/app/grove-overview-dark.webp"
              media="(prefers-color-scheme: dark)"
              width="1920"
              height="1080"
            />
            <img
              src="/app/grove-overview.webp"
              alt="Cedar Grove overview for a demonstration organization: the lead figure with its identity line and claim, then the findings the evidence supports, the limits and next data needed, and the questions the evidence can answer."
              width="1920"
              height="1080"
              decoding="async"
            />
          </picture>
          <figcaption>
            The Grove Overview: one lead figure, one claim, one limit, then the findings. The
            organization and its observations are demonstration values; the area named is a Census
            statistical area, used so the coverage shown is computed, not asserted.
          </figcaption>
        </figure>
      </div>
    </header>

    {
      /* The frame. A staged Grove: the leadership question on the left,
         the claim and its figure in the middle, the coverage status and
         the implication beside them, the record underneath on request. */
    }
    <section class="grovepg-frameband section--dark" aria-labelledby="g-frame">
      <div class="meth-w">
        <p class="h-kicker reveal-soft">How a finding is held</p>
        <h2 class="grovepg-frameband__title reveal-soft" id="g-frame" data-stagger="1">
          Pick a question. Read what the evidence supports, and what it rests on.
        </h2>
        <div class="gf reveal-soft" id="frame" data-stagger="2" data-gf>
          <div class="gf__bar">
            <span class="gf__brand">Cedar Grove <small>Example Nation</small></span>
            <span class="gf__note">Illustrative example. Names and values are invented.</span>
          </div>
          <div class="gf__body">
            <aside class="gf__side" aria-label="Leadership questions">
              <p class="gf__cap">A leadership question</p>
              {
                FINDINGS.map((f, i) => (
                  <button
                    type="button"
                    class="gf__q"
                    data-gf-pick={f.id}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                  >
                    {f.question}
                    <small class={`gf__status gf__status--${f.status}`}>{f.statusLabel}</small>
                  </button>
                ))
              }
            </aside>
            <div class="gf__main">
              {
                FINDINGS.map((f, i) => (
                  <section
                    class="gf__panel"
                    data-gf-panel={f.id}
                    hidden={i !== 0}
                    aria-label={f.question}
                  >
                    <dl class="gf__ident">
                      {f.identity.map(([k, v]) => (
                        <div>
                          <dt>{k}</dt>
                          <dd>{v}</dd>
                        </div>
                      ))}
                      <div>
                        <dt>Status</dt>
                        <dd class={`gf__status gf__status--${f.status}`}>{f.statusLabel}</dd>
                      </div>
                    </dl>
                    <div class="gf__stage">
                      <div class="gf__fig" aria-hidden="true">
                        {f.figure === 'trend' && (
                          <svg viewBox="0 0 640 300">
                            <text x="52" y="24" font-size="11" fill="#0a7f74" font-weight="700">
                              Example Nation
                            </text>
                            <text x="180" y="24" font-size="11" fill="#33434a">
                              US, AIAN alone
                            </text>
                            <text x="330" y="24" font-size="11" fill="#33434a">
                              US, all residents
                            </text>
                            <line x1="52" x2="580" y1="212" y2="212" stroke="#e4e9ec" />
                            <line x1="52" x2="580" y1="150" y2="150" stroke="#e4e9ec" />
                            <line x1="52" x2="580" y1="88" y2="88" stroke="#e4e9ec" />
                            <line
                              x1="363"
                              x2="363"
                              y1="46"
                              y2="266"
                              stroke="#93a0a5"
                              stroke-dasharray="3 4"
                            />
                            <text
                              x="357"
                              y="56"
                              font-size="8.5"
                              fill="#5b6970"
                              text-anchor="end"
                              letter-spacing="1"
                            >
                              DECENNIAL LONG-FORM
                            </text>
                            <text x="369" y="56" font-size="8.5" fill="#5b6970" letter-spacing="1">
                              ACS 5-YEAR
                            </text>
                            <path
                              d="M52 185 L207 149 L363 124 L518 91 L580 67"
                              fill="none"
                              stroke="#18364a"
                              stroke-width="1.9"
                              stroke-dasharray="5 4"
                            />
                            <path
                              d="M52 232 L207 212 L363 183 L518 153 L580 132"
                              fill="none"
                              stroke="#18364a"
                              stroke-width="1.9"
                            />
                            <path
                              d="M52 242 L207 216 L363 187 L518 150 L580 123"
                              fill="none"
                              stroke="#0a7f74"
                              stroke-width="2.6"
                            />
                            <g fill="#0a7f74">
                              <circle cx="52" cy="242" r="3.2" />
                              <circle cx="207" cy="216" r="3.2" />
                              <circle cx="363" cy="187" r="3.2" />
                              <circle cx="518" cy="150" r="3.2" />
                              <circle cx="580" cy="123" r="4" />
                            </g>
                            <text x="52" y="288" font-size="11" fill="#647279">
                              1990
                            </text>
                            <text x="580" y="288" font-size="11" fill="#647279" text-anchor="end">
                              2024
                            </text>
                          </svg>
                        )}
                        {f.figure === 'bars' && (
                          <svg viewBox="0 0 640 300">
                            <text
                              x="628"
                              y="24"
                              font-size="10"
                              fill="#647279"
                              text-anchor="end"
                              letter-spacing="1"
                            >
                              BENCHMARK 2025
                            </text>
                            <g font-size="11" fill="#33434a">
                              <text
                                x="150"
                                y="72"
                                text-anchor="end"
                                font-weight="700"
                                fill="#071824"
                              >
                                Example Nation
                              </text>
                              <text x="150" y="122" text-anchor="end">
                                Regional employer B
                              </text>
                              <text x="150" y="172" text-anchor="end">
                                Regional employer C
                              </text>
                              <text x="150" y="222" text-anchor="end">
                                Regional employer D
                              </text>
                              <text x="150" y="272" text-anchor="end">
                                Regional employer E
                              </text>
                            </g>
                            <rect x="166" y="56" width="420" height="24" fill="#0a7f74" />
                            <rect x="166" y="106" width="370" height="24" fill="#18364a" />
                            <rect x="166" y="156" width="335" height="24" fill="#18364a" />
                            <rect x="166" y="206" width="272" height="24" fill="#18364a" />
                            <rect x="166" y="256" width="234" height="24" fill="#18364a" />
                          </svg>
                        )}
                        {f.figure === 'coverage' && (
                          <svg viewBox="0 0 640 300">
                            <g font-size="12" fill="#071824">
                              <text x="40" y="60">
                                Population
                              </text>
                              <text x="40" y="104">
                                Income
                              </text>
                              <text x="40" y="148">
                                Employment
                              </text>
                              <text x="40" y="192">
                                Tribal employment
                              </text>
                              <text x="40" y="236">
                                Post-enrollment employment
                              </text>
                            </g>
                            <g font-size="9.5" letter-spacing="1" text-anchor="end">
                              <text x="600" y="60" fill="#0a7f74">
                                DIRECT
                              </text>
                              <text x="600" y="104" fill="#0a7f74">
                                DIRECT
                              </text>
                              <text x="600" y="148" fill="#c77a18">
                                COUNTY PROXY
                              </text>
                              <text x="600" y="192" fill="#0a7f74">
                                ORGANIZATION DATA
                              </text>
                              <text x="600" y="236" fill="#c77a18" font-weight="700">
                                MISSING
                              </text>
                            </g>
                            <g stroke="#e4e9ec">
                              <line x1="40" x2="600" y1="72" y2="72" />
                              <line x1="40" x2="600" y1="116" y2="116" />
                              <line x1="40" x2="600" y1="160" y2="160" />
                              <line x1="40" x2="600" y1="204" y2="204" />
                              <line x1="40" x2="600" y1="248" y2="248" />
                            </g>
                          </svg>
                        )}
                      </div>
                      <div>
                        <p class="gf__claim">{f.claim}</p>
                        <p
                          class={`gf__impl${f.status === 'direct' || f.status === 'org' ? ' gf__impl--ok' : ''}`}
                        >
                          {f.implication}
                        </p>
                      </div>
                    </div>
                    <div class="gf__acts">
                      <button
                        type="button"
                        class="gf__btn gf__btn--primary"
                        data-gf-record
                        aria-expanded="false"
                      >
                        Open evidence record
                      </button>
                      <span class="gf__note">
                        Evidence sheet (PDF) · Reproduce in Python, R or Stata
                      </span>
                    </div>
                    <div class="gf__record" data-gf-recordpanel hidden>
                      <p class="gf__cap">Evidence record</p>
                      <dl class="gf__rec">
                        {f.record.map(([k, v]) => (
                          <>
                            <dt>{k}</dt>
                            <dd>{v}</dd>
                          </>
                        ))}
                        {f.cite && (
                          <>
                            <dt>Cite as</dt>
                            <dd class="gf__cite">{f.cite}</dd>
                          </>
                        )}
                      </dl>
                    </div>
                  </section>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    {
      /* The product contract, in the order a reader checks it. Not
         "an advanced data library": that invites comparison with a data
         portal. The four lines are what the frame above just showed. */
    }
    <section class="meth-sec" aria-labelledby="g-contract">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 class="reveal-soft" id="g-contract">
            A private, living evidence workspace for your organization and its place.
          </h2>
        </div>
        <p class="meth-sec__lede reveal-soft" data-stagger="1">
          Not charts, and not an assistant. The promise is that your organization can always see
          four things about the economy around it:
        </p>
        <ul class="grovepg-contract">
          <li class="reveal-soft" data-stagger="1">
            <h3>What the evidence supports</h3>
            <p>
              Findings you can defend today, each with its claim class, the confidence in the
              calculation and whether the geography measured is the geography named.
            </p>
          </li>
          <li class="reveal-soft" data-stagger="2">
            <h3>What relies on a proxy</h3>
            <p>
              Where a source does not publish your area, Grove says which wider geography stood in,
              and what that means for the number you are about to cite.
            </p>
          </li>
          <li class="reveal-soft" data-stagger="3">
            <h3>What you can add from your own records</h3>
            <p>
              The roster, payroll or enrollment file that would move a topic from proxy to direct,
              named before you assemble it, and kept under your governance when it arrives.
            </p>
          </li>
          <li class="reveal-soft" data-stagger="4">
            <h3>How a conclusion can be checked</h3>
            <p>
              Every figure carries an evidence record: source and table, vintage, universe,
              transformation, uncertainty, limits, a citation, and a script that rebuilds it.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section class="meth-sec" aria-labelledby="g-objects" style="padding-top:0">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 class="reveal-soft" id="g-objects">The objects you work with.</h2>
        </div>
        <div class="grovepg-objects">
          <article class="grovepg-object reveal-soft" data-stagger="1">
            <p class="h-kicker">Evidence coverage</p>
            <h3>Direct, proxy, organization data, missing.</h3>
            <p>
              The screen a council or board member should see after asking why a number is an
              estimate. Every topic shows which source answers it, whether it measures your area
              directly, what you have supplied and what is still missing.
            </p>
            <ul>
              <li>Filters: needs action, direct, proxy, organization data, missing</li>
              <li>The practical implication in one sentence, before the explanation</li>
            </ul>
          </article>
          <article class="grovepg-object reveal-soft" data-stagger="2">
            <p class="h-kicker">Evidence record</p>
            <h3>Every figure, accountable.</h3>
            <p>
              Measure and definition, geography and identifier, population universe, source and
              table, vintage, transformation, uncertainty, limits, where the evidence has been
              reused across your work, and a citation you can copy.
            </p>
            <ul>
              <li>Export: the evidence sheet, a printable page saved as PDF</li>
              <li>Overview, Method, Data and Reproduce in one record</li>
            </ul>
          </article>
          <article class="grovepg-object reveal-soft" data-stagger="3">
            <p class="h-kicker">Reproduce</p>
            <h3>Python, R or Stata, from the same rows.</h3>
            <p>
              The figure, the data file and the script come from one evidence definition, so they
              cannot drift apart. The bundle carries the script, the clean data, the provenance
              sidecar and a manifest naming sources, transformation and packages.
            </p>
            <ul>
              <li>No watermark on scripts; provenance travels in the file header</li>
              <li>Organization rows stay within the access scope they were shared under</li>
            </ul>
          </article>
          <article class="grovepg-object reveal-soft" data-stagger="4">
            <p class="h-kicker">Your records</p>
            <h3>Layered over the gaps, under your governance.</h3>
            <p>
              A roster, payroll summary or enrollment history closes a topic no public source can
              answer. Today Grove previews a file in your browser without retaining it; the governed
              import path adds a named data steward, permissions, retention and an audit trail.
            </p>
            <ul>
              <li>Local preview: browser only, nothing uploaded</li>
              <li>Governed import: in development, terms published with it</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section
      class="meth-sec"
      id="collections"
      aria-labelledby="g-collections"
      style="padding-top:0"
    >
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 class="reveal-soft" id="g-collections">
            Twelve Lumecon collections, in every Grove.
          </h2>
        </div>
        <p class="meth-sec__lede reveal-soft" data-stagger="1">
          Beside the public programs, a Grove carries the collections Lumecon builds and maintains
          for Indian Country: records resolved to the nation, corporation or organization behind
          them, versioned, documented and cited. Every collection available during your term is
          included, and each new one as it is released.
        </p>
        <ol class="grovepg-collections" data-reveal-group>
          {
            CEDAR_GROVE.proprietaryDatasets.map((d) => (
              <li>
                <h3>{d.name}</h3>
                <p>{d.blurb}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="meth-sec" id="license" aria-labelledby="g-license" style="padding-top:0">
      <div class="meth-w">
        <div class="grovepg-license reveal-soft">
          <div>
            <p class="h-kicker">One license per organization</p>
            <h2 id="g-license">Cedar Grove, for your whole organization.</h2>
            <p>
              A Grove belongs to the organization, not to a seat. Everyone who works from your
              evidence works from the same one: the same findings, the same coverage, the same
              records, the same history.
            </p>
            <p>
              Onboarding is done with you. We anchor the Grove to your area, connect the public
              programs that publish it, and set up the records you want layered over the gaps.
            </p>
            <p class="grovepg-license__note">
              Unlimited users either way. Cedar Grove on its own is the evidence base; the Tree plan
              is the same Grove with Cedar Impact and Cedar Commons beside it, and that is the whole
              difference in price. <a href="/pricing">Compare plans.</a>
            </p>
          </div>
          <div>
            <p class="grovepg-price">
              <span class="grovepg-price__amount">{CEDAR_GROVE.price}</span>
              <span class="grovepg-price__period">per organization, per year</span>
            </p>
            <ul>
              <li>Unlimited users in one organization</li>
              <li>Twelve Lumecon collections, and each new one</li>
              <li>Full history and evidence records</li>
              <li>Exports, evidence sheets and reproducibility bundles</li>
              <li>Cedar, the AI economic analyst, grounded in your evidence</li>
            </ul>
            <a class="btn2 btn2--primary" href={CEDAR_GROVE.ctaHref}>
              Request a Grove <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <p class="grovepg-license__note" style="margin-top:0.9rem">
              Prefer to talk first? <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </div>
        </div>

        <div class="grovepg-bridge reveal-soft" style="margin-top:2.4rem">
          <p>
            <strong>Also from Lumecon.</strong> Use this evidence base to model a project or policy in
            Cedar Impact, and to share the work in Cedar Commons. Grove stands on its own; the family
            is there when you need it.
          </p>
          <a class="btn2 btn2--card" href="/#product">
            See Cedar Impact <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    // The evidence frame: pick a question, show its panel; open the record.
    // No library, no state beyond the DOM.
    document.querySelectorAll('[data-gf]').forEach((frame) => {
      const picks = Array.from(frame.querySelectorAll<HTMLButtonElement>('[data-gf-pick]'));
      const panels = Array.from(frame.querySelectorAll<HTMLElement>('[data-gf-panel]'));
      picks.forEach((pick) => {
        pick.addEventListener('click', () => {
          const id = pick.getAttribute('data-gf-pick');
          picks.forEach((p) => p.setAttribute('aria-pressed', p === pick ? 'true' : 'false'));
          panels.forEach((panel) => {
            panel.hidden = panel.getAttribute('data-gf-panel') !== id;
          });
        });
      });
      frame.querySelectorAll<HTMLButtonElement>('[data-gf-record]').forEach((button) => {
        button.addEventListener('click', () => {
          const panel = button.closest<HTMLElement>('[data-gf-panel]');
          const record = panel && panel.querySelector<HTMLElement>('[data-gf-recordpanel]');
          if (!record) return;
          const open = record.hidden;
          record.hidden = !open;
          button.setAttribute('aria-expanded', open ? 'true' : 'false');
          button.textContent = open ? 'Close evidence record' : 'Open evidence record';
        });
      });
    });
  </script>
</BaseLayout>
