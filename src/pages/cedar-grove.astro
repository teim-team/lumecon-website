---
/**
 * /cedar-grove — Cedar Grove by Lumecon.
 *
 * Section rhythm: navy hero with the product's Home carousel; deep teal band
 * carrying two more compositions of the running application, all three in one
 * 1920x1080 frame; pale provenance strip; deep ink atlas of the collections;
 * pale licence panel with the bridge to Cedar Impact.
 *
 * THE SHOTS ARE CAPTURES, AND THE WORKSPACE IN THEM IS FICTIONAL
 * Every product shot here is a screenshot of the running app, on the same
 * footing as the captures on /cedar, because a page whose argument is that a
 * number should be traceable may not illustrate itself with a drawing.
 * The workspace in them is Grove's demonstration workspace, a place that does
 * not exist. That matters more than it sounds: an earlier pass captured the
 * Ponca OTSA and its three counties, which put the names of real places and
 * real nations under numbers that are fixtures. The capture script now refuses
 * to shoot a surface whose text names a real place.
 *
 * WHERE THE PIPELINE LIVES
 * In the app repository, at scripts/screenshots/capture-grove-marketing.mjs,
 * because it drives the running product and its guards have to read the
 * product's own data. It writes public/app/*.webp and the manifest below. It
 * was in this repository and could not see what it was photographing.
 *
 * THE MAP THAT IS NOT HERE
 * A dense evidence map of the Navajo Nation held the hero, drawn from Census
 * TIGER/Line geometry, correct in every particular, answering a question
 * nobody had asked yet. The Home carousel holds it now. The geometry was never
 * the problem, so it is kept rather than deleted: src/data/groveMap.generated.json
 * here, written by scripts/build-grove-map-geometry.mjs in the app repository,
 * unreferenced by any page until the map earns a place again.
 *
 * NO SCRIPT ON THIS PAGE
 * It carried one picker helper wired twice, for the map's topic selector and
 * the collection registry's detail panel. The map moved and the registry
 * became a static atlas, so both went, and with them the last reason this page
 * shipped JavaScript. Three compositions are captures; the atlas is marks.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import { CEDAR_GROVE } from '../data/pricing';
import { GROVE_COLLECTIONS } from '../data/groveCollections';
import GROVE_SHOTS from '../data/groveShots.generated.json';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';
import '../styles/tour.css';
import '../styles/grove-page.css';

/**
 * One frame for every product shot, read from the manifest rather than typed.
 *
 * The capture step writes `groveShots.generated.json` from the files it
 * actually produced and refuses to write at all if they are not one shape, so
 * the width and height below always describe the bytes. They were typed here
 * once; the first time the captures changed shape every one of them went stale
 * together, which is a layout shift on every row as the images land.
 *
 * The frame is 1920x1080, the frame every other product shot on this site
 * already uses; see the three acts on /cedar.
 */
const FRAME = GROVE_SHOTS.frame;
const shot = (name: string) => {
  if (!GROVE_SHOTS.shots.includes(name)) {
    throw new Error(
      `cedar-grove: no capture named ${name}; re-run capture-grove-marketing.mjs in the app repository`,
    );
  }
  return `/app/${name}.webp`;
};

const heroShot = {
  img: shot('grove-home'),
  imgDark: shot('grove-home-dark'),
  alt: 'Cedar Grove Home, asking what are you preparing, with five illustrated purpose plates on an arc. The plate at the front reads Grant case or application and names what it produces: a need statement, cited figures and an evidence appendix.',
};

const tour = [
  {
    id: 'workspace',
    kicker: 'Curated workspace',
    title: 'Choose the work. Grove changes with it.',
    body: 'A grant case, benefits report, feasibility analysis, economic impact analysis or evidence exploration starts with its own task menu, evidence lenses and save action, so the workspace stays focused on the work at hand.',
    img: shot('grove-workspace'),
    imgDark: shot('grove-workspace-dark'),
    alt: 'A Cedar Grove Grant project with a purpose-specific task menu, evidence source shelf, figure and actions to download, inspect or save evidence.',
  },
  {
    id: 'outputs',
    kicker: 'Evidence that travels',
    title: 'A figure should not leave its evidence behind.',
    body: 'Download the figure and the rows beneath it, open its evidence record or reproduce it in code. Source, vintage, geography and limitations stay attached.',
    img: shot('grove-outputs'),
    imgDark: shot('grove-outputs-dark'),
    alt: 'Cedar Grove Outputs showing an evidence figure, provenance and export actions.',
  },
];

const provenance = [
  ['Source', 'Which published product or governed record the value came from.'],
  ['Vintage', 'Which release or reporting period is being read.'],
  ['Geography', 'The place measured, or the wider place used as a proxy.'],
  ['Definition', 'The measure and population the number actually represents.'],
  ['Limitation', 'What the evidence cannot be asked to establish.'],
  ['Reproduce', 'The code and rows needed to rebuild the figure.'],
];

const description =
  'Cedar Grove connects maintained public data, Lumecon collections and governed records so every finding can be checked, cited and reproduced.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Cedar Grove | Lumecon',
    url: 'https://lumecon.ai/cedar-grove',
    description,
    isPartOf: { '@id': `${site.url}#website` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Cedar Grove',
    brand: { '@type': 'Brand', name: 'Lumecon' },
    description,
    url: 'https://lumecon.ai/cedar-grove',
    offers: {
      '@type': 'Offer',
      price: 2500,
      priceCurrency: 'USD',
      description: 'Per organization, per year. Unlimited teammates.',
      url: 'https://lumecon.ai/cedar-grove#license',
    },
  },
];
---

<BaseLayout
  title="Cedar Grove, the living evidence base for your organization’s economy | Lumecon"
  description={description}
  canonical="https://lumecon.ai/cedar-grove"
  jsonLd={jsonLd}
  cedar={false}
>
  <Nav isHome={false} />
  <main class="meth grovepg" id="top" tabindex="-1">
    <header class="meth-hero grovepg-hero section--dark">
      <div class="meth-w">
        {
          /* `data-reveal-group` rather than a `reveal-soft` and a hand-counted
            `data-stagger` on each line. The container gives every direct child
            the soft reveal and steps it by 90ms from :nth-child, so the order
            is the document's and a line can move without renumbering the ones
            below it. See global.css. The capture beside this block is a
            sibling rather than a child, so it keeps its explicit stagger in
            order to land with the buttons. */
        }
        <div class="grovepg-hero__copy" data-reveal-group>
          <p class="h-kicker">Cedar Grove</p>
          <h1 class="meth-hero__title">Turn a local question into a defensible case.</h1>
          <p class="meth-hero__lede">
            Cedar Grove connects maintained public data, Lumecon collections and the records your
            organization governs. Every finding stays connected to its source, geography, method,
            vintage and limits, so a number can be checked, cited and reproduced by the people who
            have to stand behind it.
          </p>
          <div class="grovepg-cta">
            <a class="btn2 btn2--primary" href="#license">
              Request Grove <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="btn2 btn2--card" href="#tour">
              See how it works <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        {
          /* Two captures of the same screen, one per theme.
            The capture step shoots every surface twice because the product has
            a dark theme and this page has dark sections; a 1920px sheet of
            white product on a page that has gone dark is the one thing on it
            that did not get the message. Lightbox resolves the enlarged file
            through the matching <source>, so the zoom follows the theme too.
            Left unwired, the dark halves ship in public/app and do nothing. */
        }
        <figure class="grovepg-hero__shot reveal-soft" data-stagger="3" data-zoom>
          <picture>
            <source
              srcset={heroShot.imgDark}
              media="(prefers-color-scheme: dark)"
              width={FRAME.width}
              height={FRAME.height}
            />
            <img
              src={heroShot.img}
              alt={heroShot.alt}
              width={FRAME.width}
              height={FRAME.height}
              sizes="(max-width: 980px) 100vw, 58vw"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </figure>
      </div>
    </header>

    <section class="grovetour section--dark" id="tour" aria-label="Cedar Grove in the product">
      <div class="meth-w">
        <div class="tour-rows">
          {
            tour.map((row, index) => (
              <article class={`tour-row${index % 2 === 1 ? ' tour-row--flip' : ''}`}>
                <div class={`tour-row__text ${index % 2 === 1 ? 'reveal-right' : 'reveal-left'}`}>
                  <p class="tour-row__kicker">{row.kicker}</p>
                  <h2 class="tour-row__title">{row.title}</h2>
                  <p class="tour-row__body">{row.body}</p>
                </div>
                <figure
                  class={`tour-row__shot ${index % 2 === 1 ? 'reveal-left' : 'reveal-right'}`}
                  data-zoom
                >
                  <picture>
                    <source
                      srcset={row.imgDark}
                      media="(prefers-color-scheme: dark)"
                      width={FRAME.width}
                      height={FRAME.height}
                    />
                    <img
                      src={row.img}
                      alt={row.alt}
                      width={FRAME.width}
                      height={FRAME.height}
                      sizes="(max-width: 900px) 100vw, 55vw"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </figure>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="grovepg-prov" aria-label="What travels with every number">
      <div class="meth-w">
        <ul class="grovepg-prov__list" data-reveal-group>
          {
            provenance.map(([term, gloss]) => (
              <li>
                <p class="grovepg-prov__term">{term}</p>
                <p class="grovepg-prov__gloss">{gloss}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="grovepg-atlas section--dark" id="collections" aria-labelledby="g-collections">
      <div class="meth-w">
        <div class="grovepg-atlas__head" data-reveal-group>
          <p class="h-kicker">Evidence infrastructure</p>
          <h2 class="grovepg-atlas__title" id="g-collections">
            The collections behind the evidence.
          </h2>
        </div>
        <ol class="grovepg-atlas__grid" data-reveal-group>
          {
            GROVE_COLLECTIONS.map((collection) => (
              <li class="grovepg-atlas__cell">
                <svg
                  class="grovepg-atlas__mark"
                  viewBox="0 0 28 28"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={collection.mark}
                />
                <span class="grovepg-atlas__name">{collection.short}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="meth-sec" id="license" aria-labelledby="g-license">
      <div class="meth-w">
        <div class="grovepg-license reveal-soft">
          <div>
            <p class="h-kicker">One license per organization</p>
            <h2 id="g-license">Cedar Grove, for your whole organization.</h2>
            <p>
              A Grove belongs to the organization, not to a seat. Everyone works from the same
              evidence record, with the same sources, coverage and history.
            </p>
            <p>
              Onboarding is done with you. We anchor Grove to the places that matter, connect the
              public programs that publish them and set up the records you want layered over the
              gaps.
            </p>
            <p class="grovepg-license__note">
              Grove stands on its own. Tree adds Cedar Impact and Cedar Commons beside the same
              evidence base. <a class="inline-link" href="/pricing">Compare plans.</a>
            </p>
          </div>
          <div>
            <p class="grovepg-price">
              <span class="grovepg-price__amount">{CEDAR_GROVE.price}</span>
              <span class="grovepg-price__period">per organization, per year</span>
            </p>
            <ul>
              <li>Unlimited users in one organization</li>
              <li>Maintained Lumecon collections and new releases</li>
              <li>Project evidence logs and coverage checks</li>
              <li>Figures, data exports and reproducibility bundles</li>
              <li>Cedar, grounded in the evidence you have selected</li>
            </ul>
            <a class="btn2 btn2--primary" href={CEDAR_GROVE.ctaHref}>
              {CEDAR_GROVE.ctaLabel}
              <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <p class="grovepg-license__note grovepg-license__note--contact">
              Prefer to talk first? <a class="inline-link" href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </div>
        </div>

        <div class="grovepg-bridge reveal-soft">
          <p>
            <strong>Also from Lumecon.</strong> Use Grove to prepare evidence for Cedar Impact, then carry
            the modeled result back with its assumptions and sources intact.
          </p>
          <a class="btn2 btn2--card" href="/#product">
            See Cedar Impact <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
