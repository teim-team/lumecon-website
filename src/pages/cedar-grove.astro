---
/**
 * /cedar-grove — Cedar Grove by Lumecon.
 *
 * SECTION RHYTHM, AND WHOSE IT IS
 * This page is built on /cedar-commons's skeleton on purpose: navy hero with
 * copy left and one capture right, then a definition beat with no picture,
 * then alternating acts, then a reference band, then the licence. A reader
 * moving between the product pages should recognise the furniture; the
 * differentiation is what each beat says, not that each page invents its own
 * shape. Commons defines who may see what. Grove defines which of three kinds
 * of evidence a sentence is resting on.
 *
 * THE HERO IS BRAND SURFACE, NOT A THEME
 * The navy field is the material /cedar and /cedar-commons open on, and it is
 * deliberately independent of OS colour preference. That is a different thing
 * from the page having a dark theme, and conflating the two cost a pass: the
 * hero was flattened to a pale field, which took the page out of the set it
 * belongs to. The bands below the hero are light and stay light. A smoke test
 * pins the hero to Commons' own gradient so this cannot drift back quietly.
 *
 * THE SHOTS ARE CAPTURES, AND THE WORKSPACE IN THEM IS FICTIONAL
 * Every product shot here is a screenshot of the running app, on the same
 * footing as the captures on /cedar, because a page whose argument is that a
 * number should be traceable may not illustrate itself with a drawing.
 * The workspace in them is Grove's demonstration workspace, a place that does
 * not exist. That matters more than it sounds: an earlier pass captured the
 * Ponca OTSA and its three counties, which put the names of real places and
 * real nations under numbers that are fixtures. The capture script now refuses
 * to shoot a surface whose text names a real place.
 *
 * FOUR FRAMES, FOUR SURFACES
 * The analysis worktable is taller than a landscape frame, and the page used
 * to show it through a 16:9 window that scrolled. That asked a reader to
 * operate a control before they could see the product, and printed as its
 * own top third. So it is cut at capture time, and its top, which poses the
 * case, is the hero. For a while the bottom of the same surface was the last
 * act too, which put the one per-capita-income chart on the page twice as
 * if it were two products. The last act is the evidence log now, a different
 * surface: the records a case has filed, with their source, limitation and
 * place in the report. Every frame here is an ordinary figure at its own
 * measured size, and every one carries its sample-data disclosure inside the
 * frame.
 *
 * THE LEDGER THAT IS NOT HERE
 * The data workspace is the surface that best shows the three evidence layers
 * in one table, and it cannot be photographed: its source column names an
 * unannounced product thirteen times, and the name ships in an image a crawler
 * reads. The definition beat tells that story in prose instead, which is also
 * why this page has a no-picture section where Commons has one. See the note
 * in the app repository's capture script for the two ways that frame becomes
 * publishable.
 *
 * WHERE THE PIPELINE LIVES
 * In the app repository, at scripts/screenshots/capture-grove-marketing.mjs,
 * because it drives the running product and its guards have to read the
 * product's own data. It writes public/app/*.webp and the manifest below. It
 * was in this repository and could not see what it was photographing.
 *
 * THE MAP GEOMETRY THAT IS NOT HERE
 * A dense evidence map of the Navajo Nation held the hero, drawn from Census
 * TIGER/Line geometry, correct in every particular, answering a question
 * nobody had asked yet. The product's own map workspace holds that beat now.
 * The geometry was never the problem, so it is kept rather than deleted:
 * src/data/groveMap.generated.json here, written by
 * scripts/build-grove-map-geometry.mjs in the app repository, unreferenced by
 * any page until it earns a place again.
 *
 * THE SCRIPT ON THIS PAGE
 * One picker, for the atlas. Progressive enhancement, the same shape as
 * /start's capability panels: every panel ships open and the script collapses
 * them into a picker. With no script the section is a long, complete, readable
 * list rather than twelve unlabelled icons.
 *
 * The earlier flattening of that section lost something real. Each collection
 * carries what it contributes, what Lumecon resolved in it, its coverage floor,
 * its sources and its terms, and the atlas showed a mark and six characters of
 * name. The detail is the argument the page is making, so it is readable again.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import { CEDAR_GROVE } from '../data/pricing';
import { GROVE_COLLECTIONS } from '../data/groveCollections';
import GROVE_SHOTS from '../data/groveShots.generated.json';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';
import '../styles/tour.css';
import '../styles/grove-page.css';

/**
 * One frame for every product shot, read from the manifest rather than typed.
 *
 * The capture step writes `groveShots.generated.json` from the files it
 * actually produced and refuses to write at all if they are not one shape, so
 * the width and height below always describe the bytes. They were typed here
 * once; the first time the captures changed shape every one of them went stale
 * together, which is a layout shift on every row as the images land.
 *
 * The frame is 1920x1080, the frame every other product shot on this site
 * already uses; see the three acts on /cedar.
 */

/**
 * One captured app frame, with the size it was actually photographed at.
 *
 * The manifest used to be a list of names and every frame was assumed to be
 * 16:9. Three of the four surfaces are not: a worktable holds a question, a
 * case structure, a figure and a brief, and the capture refuses to crop them.
 * So the manifest carries each frame's real pixel size and the page lays out
 * from that rather than from an assumption, which is also what lets a tall
 * frame be presented as something the reader scrolls.
 */
const shot = (name: string) => {
  const found = GROVE_SHOTS.shots.find((entry) => entry.name === name);
  if (!found) {
    throw new Error(
      `cedar-grove: no capture named ${name}; re-run capture-grove-marketing.mjs in the app repository`,
    );
  }
  return { src: `/app/${name}.webp`, width: found.width, height: found.height };
};

const heroShot = {
  img: shot('grove-analysis'),
  alt: 'A Cedar Grove analysis. The question reads: what evidence establishes the need for a community workforce program. A case structure lists need and baseline, who is underserved, funding and peer context, project readiness and local effects, each marked ready for evidence or needing a record. The figure beside it shows per capita income from 1990 to 2024 against the national line, labelled with its period, geography, universe and basis.',
  caption: 'One analysis, open on its question and the parts of the case that answer it. Shown with sample data.',
};

/* The definition beat, and the one section on this page with no picture.
   Cedar Commons earns its equivalent section by defining who may see what;
   Grove's question is different and so is the answer: not who, but which of
   three kinds of evidence a sentence is resting on, and what each kind is
   entitled to settle. This is also where the connected-data story is told,
   because the surface that shows it best cannot be photographed yet. See the
   note in the app repository's capture script. */
const LAYERS = [
  {
    k: 'Maintained public data',
    field: 'Published, harmonized',
    b: 'Baselines, denominators, trends and geography, read the same way across places and years so a comparison is a comparison. It establishes public conditions for a published geography, and nothing about your organization.',
  },
  {
    k: 'Cedar collections',
    field: 'Maintained context',
    b: 'Comparable organizations, awards, entities, policy and events that public tables do not carry on their own, each arriving with its own source and terms. It establishes what is true around you, not what is true inside you.',
  },
  {
    k: 'The records you govern',
    field: 'Yours, and only yours to release',
    b: 'Program, operating, budget and qualitative evidence your organization holds. It is the only layer that can settle a local fact about you, which is why Grove asks for it by name instead of letting a public average stand in.',
  },
];

const tour = [
  {
    id: 'home',
    kicker: 'Project workspace',
    title: 'Every case your organization has open.',
    body: 'Grove opens on the work in progress rather than on an empty page. Each analysis keeps its purpose, its place and the point it reached, so picking one up again does not start with working out what it was for.',
    img: shot('grove-home'),
    alt: 'Cedar Grove Home. A top bar names Home, Analyses, Data, Map and Cedar Impact. The open analyses list holds one feasibility study, and beside it a panel asks what you are preparing and offers five kinds of analysis: a grant case, an SBA 8(a) benefits report, a feasibility study, an economic-impact study, and evidence exploration.',
    caption: 'The work already under way, and the five kinds of case Grove can open. Shown with sample data.',
  },
  {
    id: 'map',
    kicker: 'Geography as evidence',
    title: 'Read a measure off the map, geography by geography.',
    body: 'Choose a measure and the map fills every geography the record names with its value, on one scale with real breakpoints, and leaves plain what the record does not cover. Point at any geography, or reach it from the keyboard, and it reads out its value with the population, period and source attached, so the number and its provenance arrive together.',
    img: shot('grove-map'),
    alt: 'The Cedar Grove map workspace with labor force participation selected. The map is filled by the measure, one state tinted on a teal scale and every other geography left plain, and a readout anchored to the national outline reads 60.1 percent for the nation, AIAN alone, ACS 2020 to 2024. The same reading sits in the context card at the lower left, and a legend at the lower right names the class with its breakpoint, counts one of 186 geographies with a value, and lists the national figure.',
    caption: 'One measure, filled and read out with its source and period. Shown with sample data.',
  },
  {
    id: 'record',
    kicker: 'Evidence that travels',
    title: 'Give reviewers the record behind the case.',
    body: 'Every figure filed into an analysis lands in its evidence log with the layer it came from, its source, the period observed, the geography, its role in the case and the limitation it carries. Pin a record and place it under the report requirement it supports, and a colleague, funder or board can read what the case rests on rather than rebuild it.',
    img: shot('grove-record'),
    alt: 'The evidence log of a Cedar Grove analysis. A table lists four filed records: per capita income against the national figure, labor force participation, employment over time, and where the people working here live. Each row names its layer, source, period observed, geography, role and claim class, carries its stated limitation under the record name, and offers Inspect data and Pin. Three are pinned and filed under report requirements, need and beneficiaries and measures, reporting and attachments, and one carries the report wording already written.',
    caption: 'The evidence log: each record with its source, limitation and place in the report. Shown with sample data.',
  },
];

const provenance = [
  ['Source', 'Which published product or governed record the value came from.'],
  ['Vintage', 'Which release or reporting period is being read.'],
  ['Geography', 'The place measured, or the wider place used as a proxy.'],
  ['Definition', 'The measure and population the number actually represents.'],
  ['Limitation', 'What the evidence cannot be asked to establish.'],
  ['Reproduce', 'The code and rows needed to rebuild the figure.'],
];

const description =
  'Cedar Grove connects maintained public data, Lumecon collections and governed records so every finding can be checked, cited and reproduced.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Cedar Grove | Lumecon',
    url: 'https://lumecon.ai/cedar-grove',
    description,
    isPartOf: { '@id': `${site.url}#website` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Cedar Grove',
    brand: { '@type': 'Brand', name: 'Lumecon' },
    description,
    url: 'https://lumecon.ai/cedar-grove',
    offers: {
      '@type': 'Offer',
      price: 2500,
      priceCurrency: 'USD',
      description: 'Per organization, per year. Unlimited teammates.',
      url: 'https://lumecon.ai/cedar-grove#license',
    },
  },
];
---

<BaseLayout
  title="Cedar Grove, the living evidence base for your organization’s economy | Lumecon"
  description={description}
  canonical="https://lumecon.ai/cedar-grove"
  jsonLd={jsonLd}
  cedar={false}
>
  <Nav isHome={false} />
  <main class="meth grovepg" id="top" tabindex="-1">
    <header class="meth-hero grovepg-hero section--dark">
      <div class="meth-w">
        {
          /* `data-reveal-group` rather than a `reveal-soft` and a hand-counted
            `data-stagger` on each line. The container gives every direct child
            the soft reveal and steps it by 90ms from :nth-child, so the order
            is the document's and a line can move without renumbering the ones
            below it. See global.css. The capture beside this block is a
            sibling rather than a child, so it keeps its explicit stagger in
            order to land with the buttons. */
        }
        <div class="grovepg-hero__copy" data-reveal-group>
          <p class="h-kicker">Cedar Grove</p>
          <h1 class="meth-hero__title">Turn a local question into a defensible case.</h1>
          <p class="meth-hero__lede">
            Cedar Grove brings maintained public data, Lumecon collections and the records your
            organization governs into one project workspace. Build the evidence a grant, benefits
            report, feasibility study or economic impact analysis needs, then keep the source,
            release, geography, definition and limits attached to every figure.
          </p>
          <div class="grovepg-cta">
            <a class="btn2 btn2--primary" href="#license">
              Request Grove <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="btn2 btn2--card" href="#tour">
              See the workspace <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        {
          /* The hero band is the house surface every product page opens on:
            navy, copy at the left, one substantial capture at the right. It
            is deliberately independent of OS color preference, which is a
            different thing from the page having a dark theme. The bands below
            are light and stay light; this one is brand material, and a light
            field here would take the page out of the set /cedar and
            /cedar-commons belong to. */
        }
        <figure class="grovepg-hero__shot reveal-soft" data-stagger="3" data-zoom>
          <img
            src={heroShot.img.src}
            alt={heroShot.alt}
            width={heroShot.img.width}
            height={heroShot.img.height}
            sizes="(max-width: 980px) 100vw, 58vw"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>{heroShot.caption}</figcaption>
        </figure>
      </div>
    </header>

    {
      /* The definition beat, the one section here with no picture, in the
        place /cedar-commons puts its own. Commons defines who may see what;
        Grove's question is which of three kinds of evidence a sentence is
        resting on, and what each kind is entitled to settle. Short enough to
        read before the page asks anyone to look at anything. */
    }
    <section class="meth-sec grovepg-layers" aria-labelledby="g-layers">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="g-layers">Three kinds of evidence, kept apart</h2>
          <p class="meth-sec__lede">
            A case fails review when a number is asked to prove something its source cannot
            support. Grove keeps the three layers distinct on the figure, in the evidence log and
            in every export, so what a sentence rests on travels with it.
          </p>
        </div>
        <ul class="grovepg-layers__list" data-reveal-group>
          {
            LAYERS.map((layer) => (
              <li class="grovepg-layers__item">
                <p class="grovepg-layers__field">{layer.field}</p>
                <p class="grovepg-layers__term">{layer.k}</p>
                <p class="grovepg-layers__gloss">{layer.b}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="grovetour" id="tour" aria-label="Cedar Grove in the product">
      <div class="meth-w">
        <div class="tour-rows">
          {
            tour.map((row, index) => (
              <article class={`tour-row${index % 2 === 1 ? ' tour-row--flip' : ''}`}>
                <div class={`tour-row__text ${index % 2 === 1 ? 'reveal-right' : 'reveal-left'}`}>
                  <p class="tour-row__kicker">{row.kicker}</p>
                  <h2 class="tour-row__title">{row.title}</h2>
                  <p class="tour-row__body">{row.body}</p>
                </div>
                {/* Every frame is a landscape capture now, so each one is
                    an ordinary figure: no scrollport, no instruction to
                    operate it, nothing clipped in print. The worktable used to
                    be one 1634px surface shown through a 16:9 window that
                    scrolled; it is cut into its two real halves at capture
                    time instead, and they are the hero and the last act here.
                    `data-zoom` still opens the full 1920px file, which is the
                    only route to readable application text on a phone. */}
                <figure
                  class={`tour-row__shot ${index % 2 === 1 ? 'reveal-left' : 'reveal-right'}`}
                  data-zoom
                >
                  <img
                    src={row.img.src}
                    alt={row.alt}
                    width={row.img.width}
                    height={row.img.height}
                    sizes="(max-width: 900px) 100vw, 55vw"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{row.caption}</figcaption>
                </figure>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="grovepg-prov" aria-label="What travels with every number">
      <div class="meth-w">
        <ul class="grovepg-prov__list" data-reveal-group>
          {
            provenance.map(([term, gloss]) => (
              <li>
                <p class="grovepg-prov__term">{term}</p>
                <p class="grovepg-prov__gloss">{gloss}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="grovepg-atlas" id="collections" aria-labelledby="g-collections">
      <div class="meth-w">
        <div class="grovepg-atlas__head" data-reveal-group>
          <p class="h-kicker">Evidence infrastructure</p>
          <h2 class="grovepg-atlas__title" id="g-collections">
            The collections behind the evidence.
          </h2>
        </div>
        <p class="grovepg-atlas__lede">
          Cedar collections add maintained context that public tables do not provide on their
          own. Open one to see what it contributes, how Lumecon has resolved it, its coverage and
          the terms that govern the records.
        </p>

        <div class="grovepg-atlas__reg" data-atlas>
          <ol class="grovepg-atlas__grid" data-reveal-group>
            {
              GROVE_COLLECTIONS.map((collection) => (
                /* `aria-expanded="true"` on every control: with no script
                   every panel is open, and saying otherwise tells a screen
                   reader that visible content is collapsed. The script sets
                   the real state as it enables them. */
                <li class="grovepg-atlas__cell">
                  <button
                    type="button"
                    class="grovepg-atlas__btn"
                    disabled
                    data-atlas-tab={collection.id}
                    aria-expanded="true"
                    aria-controls={`atlas-${collection.id}`}
                  >
                    <svg
                      class="grovepg-atlas__mark"
                      viewBox="0 0 28 28"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.9"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={collection.mark}
                    />
                    <span class="grovepg-atlas__name">{collection.short}</span>
                  </button>
                </li>
              ))
            }
          </ol>

          <div class="grovepg-atlas__panels">
            {
              GROVE_COLLECTIONS.map((collection) => (
                <article
                  class="grovepg-atlas__panel"
                  id={`atlas-${collection.id}`}
                  data-atlas-panel={collection.id}
                  aria-live="polite"
                >
                  <h3 class="grovepg-atlas__pname">{collection.name}</h3>
                  <p class="grovepg-atlas__contributes">{collection.contributes}</p>
                  <dl class="grovepg-atlas__facts">
                    <div>
                      <dt>What Lumecon resolved</dt>
                      <dd>{collection.resolved}</dd>
                    </div>
                    <div>
                      <dt>Coverage</dt>
                      <dd>{collection.coverage}</dd>
                    </div>
                    <div>
                      <dt>Sources</dt>
                      <dd>{collection.sources}</dd>
                    </div>
                    <div>
                      <dt>Terms</dt>
                      <dd>{collection.terms}</dd>
                    </div>
                  </dl>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="meth-sec" id="license" aria-labelledby="g-license">
      <div class="meth-w">
        <div class="grovepg-license reveal-soft">
          <div>
            <p class="h-kicker">One license per organization</p>
            <h2 id="g-license">Cedar Grove, for your whole organization.</h2>
            <p>
              A Grove belongs to the organization, not to a seat. Everyone works from the same
              evidence record, with the same sources, coverage and history.
            </p>
            <p>
              Onboarding is done with you. We anchor Grove to the places that matter, connect the
              public programs that publish them and set up the records you want layered over the
              gaps.
            </p>
            <p class="grovepg-license__note">
              Grove stands on its own. In a Tree account, Cedar Impact and Cedar Commons work
              beside the same evidence base. <a class="inline-link" href="/pricing">Compare plans.</a>
            </p>
          </div>
          <div>
            <p class="grovepg-price">
              <span class="grovepg-price__amount">{CEDAR_GROVE.price}</span>
              <span class="grovepg-price__period">per organization, per year</span>
            </p>
            <ul>
              <li>Unlimited users in one organization</li>
              <li>Maintained Lumecon collections and new releases</li>
              <li>Project evidence logs and coverage checks</li>
              <li>Figures, data exports and reproducibility bundles</li>
              <li>Cedar, grounded in the evidence you have selected</li>
            </ul>
            <a class="btn2 btn2--primary" href={CEDAR_GROVE.ctaHref}>
              {CEDAR_GROVE.ctaLabel}
              <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <p class="grovepg-license__note grovepg-license__note--contact">
              Prefer to talk first? <a class="inline-link" href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </div>
        </div>

        <div class="grovepg-bridge reveal-soft">
          <p>
            <strong>Also from Lumecon.</strong> Use Grove to prepare evidence for Cedar Impact, then
            attach a completed impact result to the same project with its approved assumptions and
            source trail intact.
          </p>
          <a class="btn2 btn2--card" href="/#product">
            See Cedar Impact <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    /* The atlas picker. Everything ships open, so with no script the section
       reads as a complete list rather than twelve unlabelled icons; the class
       added here is what collapses it into a picker. Same shape as /start's
       capability panels: a disclosure set, one open at a time, with
       `aria-expanded` maintained on the control. */
    const atlas = document.querySelector<HTMLElement>('[data-atlas]');
    if (atlas) {
      atlas.classList.add('grovepg-atlas__reg--js');
      const tabs = Array.from(atlas.querySelectorAll<HTMLButtonElement>('[data-atlas-tab]'));
      /* The tiles ship disabled. Without this script every panel is open and
         the tiles have nothing to do, so offering twelve focusable controls
         that answer nothing would just be twelve dead tab stops. */
      for (const tab of tabs) tab.removeAttribute('disabled');
      const panels = Array.from(atlas.querySelectorAll<HTMLElement>('[data-atlas-panel]'));

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      const show = (id: string) => {
        for (const tab of tabs) {
          tab.setAttribute('aria-expanded', String(tab.dataset.atlasTab === id));
        }
        for (const panel of panels) {
          panel.hidden = panel.dataset.atlasPanel !== id;
        }

        /* On a phone the grid is six rows tall, so the answer to a tap lands
           below the fold and the page looks like it did nothing. `nearest`
           only scrolls when the panel is actually out of view, so this is a
           no-op on a desktop where the panel is already on screen. */
        const open = panels.find((panel) => !panel.hidden);
        open?.scrollIntoView({
          block: 'nearest',
          behavior: reduced.matches ? 'auto' : 'smooth',
        });
      };

      for (const [i, tab] of tabs.entries()) {
        tab.addEventListener('click', () => show(tab.dataset.atlasTab as string));
        /* Arrow keys move along the row the way a reader expects of a strip of
           related controls, and wrap so neither end is a dead stop. */
        tab.addEventListener('keydown', (event: KeyboardEvent) => {
          const step =
            event.key === 'ArrowRight' || event.key === 'ArrowDown'
              ? 1
              : event.key === 'ArrowLeft' || event.key === 'ArrowUp'
                ? -1
                : 0;
          if (!step) return;
          event.preventDefault();
          const next = tabs[(i + step + tabs.length) % tabs.length];
          next.focus();
          show(next.dataset.atlasTab as string);
        });
      }

      /* The initial state is set directly rather than through `show`, which
         scrolls. Landing on the page should not move it. */
      if (tabs[0]) {
        const first = tabs[0].dataset.atlasTab;
        for (const tab of tabs) tab.setAttribute('aria-expanded', String(tab.dataset.atlasTab === first));
        for (const panel of panels) panel.hidden = panel.dataset.atlasPanel !== first;
      }
    }
  </script>
</BaseLayout>
