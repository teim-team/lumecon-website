---
/**
 * /cedar-grove — Cedar Grove by Lumecon.
 *
 * The product page for the standalone license. The press hero is a
 * catalog because Press sells a shared catalog; Grove's hero is a place,
 * because what Grove sells is the connection between a claim and the
 * geography and records it rests on.
 *
 * Section rhythm: dark navy hero with the evidence map; deep teal band with
 * the product itself, three acts as captures of the running application, all
 * in one 1920x1080 frame; pale proof strip; deep ink registry of the
 * collections; pale license panel with the late bridge to Cedar Impact.
 *
 * WHAT CHANGED, AND WHY IT MATTERED
 * The teal band used to be a drawing of Grove. A panel with a fake title bar,
 * a question list, a figure and three proof cards, all built here in Astro and
 * CSS, all captioned "illustrative example, names and values are invented".
 * Every other product page on this site shows captures of the running app, and
 * that difference showed. Two things go wrong with a replica: it is a picture
 * of a promise rather than evidence of a product, on a page whose whole
 * argument is that a number should be traceable to its source; and it drifts,
 * which it had, because Grove was rebuilt around a purpose carousel and five
 * surfaces while the drawing still showed the interface it left behind.
 * Those are real screenshots now, produced by
 * scripts/screenshots/capture-grove.mjs and refreshed with it, on the same
 * footing as every other product shot here. The workspace in them is Grove's
 * demonstration workspace and its figures label themselves as demonstration
 * data on their own faces, so no caption here has to promise it.
 *
 * THE MAP IS REAL AND IS THE ONE THING THAT ALWAYS WAS
 * The geometry is Census TIGER/Line for the Navajo Nation and its trust land,
 * generated and committed, because the boundary of a real place is not
 * something a product page may draw by hand. The nine counties across three
 * states include Bernalillo, Cibola and Socorro, which look wrong at a glance
 * and are right: the Nation's non-contiguous chapters, To'hajiilee, Ramah and
 * Alamo, sit in them, far from the main reservation. That is exactly why this
 * Nation is the subject: it states the resolution problem better than any
 * diagram could, because every source answers at a different level.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import { CEDAR_GROVE } from '../data/pricing';
import { GROVE_COLLECTIONS } from '../data/groveCollections';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';
import '../styles/tour.css';
import '../styles/grove-page.css';
import GROVE_MAP from '../data/groveMap.generated.json';
import GROVE_SHOTS from '../data/groveShots.generated.json';

/**
 * The map's subject, and the counties it is drawn with.
 *
 * The geometry is Census TIGER/Line 2018 for the reservation and its trust
 * land, and us-atlas counties-10m and states-10m for everything around it,
 * all projected once into the same albers space. It is generated by
 * `scripts/build-grove-map-geometry.mjs` in the app repository and committed
 * here, because the boundary of a real place is not something a product page
 * may draw by hand.
 *
 * The Navajo Nation is the subject because it states the resolution problem
 * better than any diagram could: one nation, nine counties, three states, and
 * three of those counties hold non-contiguous chapters far from the main
 * reservation. Every source below answers at a different one of those levels.
 */
const MAP_COUNTY_LABELS = GROVE_MAP.counties.filter((county) => county.labelInFrame);
/**
 * The two areas, named separately.
 *
 * The map draws the reservation and its off-reservation trust land, and they
 * are different legal categories with different published figures. One total
 * would have to say which, and a caption that showed only the reservation's
 * 22,241 under a map of both understated the subject by the trust land.
 */
const MAP_AREA_SQ_MI = GROVE_MAP.area.areaSqMi?.toLocaleString('en-US') ?? null;
const MAP_TRUST_SQ_MI = GROVE_MAP.trustLand?.areaSqMi?.toLocaleString('en-US') ?? null;

// What the map leaves out, as a sentence.
//
// `simplification` used to be a string and the caption printed it directly.
// Regenerating the geometry turned it into a record, and the template kept
// interpolating it, so the provenance line under the map read
// "[object Object]" on the live page. That is the worst possible place for it:
// the sentence exists to tell a reader which parcels were dropped, on a page
// whose whole claim is that a figure can be traced.
//
// The share is read out rather than left as "the share below", because the
// rule's own wording promises a number the caption never showed. The string
// branch stays so an older generated file still renders its own sentence.
const SHARE_PCT = (share: number) =>
  `${(share * 100).toLocaleString('en-US', { maximumFractionDigits: 2 })} percent`;
const MAP_MIN_SHARE = GROVE_MAP.simplification?.minParcelShare ?? null;
const MAP_SIMPLIFICATION =
  typeof GROVE_MAP.simplification === 'string'
    ? GROVE_MAP.simplification
    : (GROVE_MAP.simplification?.rule ?? '').replace(
        'less than the share below of',
        MAP_MIN_SHARE
          ? `less than ${SHARE_PCT(MAP_MIN_SHARE.area)} (reservation), ${SHARE_PCT(MAP_MIN_SHARE.trustLand)} (trust land) or ${SHARE_PCT(MAP_MIN_SHARE.neighbors)} (another nation) of`
          : 'a small share of',
      );

/**
 * One frame for every product shot, as captured from the running product.
 *
 * The size comes from `groveShots.generated.json`, which the optimize step
 * writes from the files it actually produced and refuses to write at all if
 * they are not one shape. It was typed here, and the first time the captures
 * changed shape (the rail collapsed for every shot but Home) all five went
 * stale together, which is a layout shift on every row as the images land. A
 * number that describes a file belongs with the file.
 *
 * The frame is 1920x1080, which is the frame every other product shot on this
 * site already uses; see the three acts on /cedar. It was five aspect ratios
 * down one page before, because each surface was captured at whatever height
 * it happened to run to, and the page read as a scrapbook.
 *
 * Re-capture with:
 *   node scripts/screenshots/capture-grove.mjs && node scripts/screenshots/optimize-grove.mjs
 */
const FRAME = GROVE_SHOTS.frame;
const shot = (name: string) => {
  if (!GROVE_SHOTS.shots.includes(name)) {
    throw new Error(`cedar-grove: no capture named ${name}; re-run optimize-grove.mjs`);
  }
  return `/app/${name}.webp`;
};
/**
 * The collection count, spelled, from the list rather than from memory.
 *
 * "Twelve" was typed into the kicker, the heading and the licence list. It is
 * true of the current registry and it is not a fact about this page: the grid
 * below maps every entry in GROVE_COLLECTIONS, so a thirteenth would have
 * drawn thirteen marks under a heading saying twelve, with nothing failing.
 */
const SPELLED = [
  'zero',
  'one',
  'two',
  'three',
  'four',
  'five',
  'six',
  'seven',
  'eight',
  'nine',
  'ten',
  'eleven',
  'twelve',
  'thirteen',
  'fourteen',
  'fifteen',
  'sixteen',
  'seventeen',
  'eighteen',
  'nineteen',
  'twenty',
];
const spelledCount = (n: number, capital = false) => {
  const word = SPELLED[n] ?? String(n);
  return capital ? word.charAt(0).toUpperCase() + word.slice(1) : word;
};
const COLLECTION_COUNT = GROVE_COLLECTIONS.length;

/**
 * Three acts, not five surfaces.
 *
 * It was one row per surface: Home, Projects, Explore, Library, Outputs. Five
 * rows is a product tour written from the navigation, and two of them made the
 * same point twice. Projects showed the five purpose covers, which are the same
 * five purposes the carousel on Home is made of; Library showed sources shelved
 * by question, and the registry section below this one already lists every
 * collection with what it answers and how far it reaches.
 *
 * So: what you start from, what you work in, what you leave with. That is the
 * shape /cedar uses for Cedar, three acts and three identical frames, and it is
 * the shape a reader can hold. Projects and Library are in the product and in
 * the walkthrough; they are not each worth a row here.
 */
const GROVE_TOUR = [
  {
    id: 'home',
    kicker: 'Start',
    title: 'Open on what you are making, not on a blank workspace',
    body: 'Five purposes, one carousel. Picking one sets the deliverable, the evidence it needs and the questions Grove asks next, and every project keeps the purpose it was started for.',
    img: shot('grove-home'),
    imgDark: shot('grove-home-dark'),
    alt: 'Cedar Grove home, asking what are you preparing, with five illustrated purpose plates on an arc. The selected plate reads Grant case or application, one of five, and names what you end up with: a need statement, cited figures and an evidence appendix.',
  },
  {
    id: 'explore',
    kicker: 'Work',
    title: 'The map and the figure are one instrument',
    body: 'The ground stands beside the work. Changing the lens moves the coverage, the records and the figure together, and where a source does not publish your area Grove names the counties standing in for it rather than quietly widening the geography.',
    img: shot('grove-explore'),
    imgDark: shot('grove-explore-dark'),
    alt: 'Cedar Grove explore, with a map of the Ponca OTSA outlined against Noble, Kay and Osage counties and a coverage breakdown reading four direct, two organization data, two county proxy, one partial and one missing, beside a per capita income figure and the organization records it is drawn from.',
  },
  {
    id: 'outputs',
    kicker: 'Leave with',
    title: 'A briefing that carries its own evidence',
    body: 'One figure, one claim, the provenance line under it and the export beside it. Each figure states its measure, universe, geography, period and source on its own face, so it stays readable once it has left the product.',
    img: shot('grove-outputs'),
    imgDark: shot('grove-outputs-dark'),
    alt: 'Cedar Grove outputs, with a population figure beside the claim that the resident AIAN population is estimated to have grown 6 percent since 2010, its provenance line, and export controls.',
  },
];

const description =
  'Cedar Grove is the living evidence base for your organization’s economy: maintained public data, Lumecon collections and the records you govern, with every finding connected to its source, geography, method, vintage and limits.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Cedar Grove | Lumecon',
    url: 'https://lumecon.ai/cedar-grove',
    description,
    isPartOf: { '@id': `${site.url}#website` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Cedar Grove',
    brand: { '@type': 'Brand', name: 'Lumecon' },
    description,
    url: 'https://lumecon.ai/cedar-grove',
    offers: {
      '@type': 'Offer',
      price: 2500,
      priceCurrency: 'USD',
      description: 'Per organization, per year. Unlimited teammates.',
      url: 'https://lumecon.ai/cedar-grove#license',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Cedar Grove',
        item: 'https://lumecon.ai/cedar-grove',
      },
    ],
  },
];

/**
 * The evidence map's topics. Each names the layer of the map it is about and
 * carries the compact evidence panel: source, vintage, geography, status and
 * limitation. The sources are real programs; the place and the status are
 * staged for the invented Example Nation.
 */
const MAP_TOPICS = [
  {
    id: 'income',
    label: 'Income and population',
    status: 'direct',
    statusLabel: 'Direct',
    fields: [
      ['Source', 'U.S. Census Bureau, American Community Survey, 5-year'],
      ['Vintage', '2020–2024'],
      ['Geography', 'The reservation and its trust land, published as one AIANNH area'],
      ['Limitation', 'Survey estimates: a margin of error accompanies every cell'],
    ],
  },
  {
    id: 'employment',
    label: 'Employment and wages',
    status: 'proxy',
    statusLabel: 'County proxy',
    fields: [
      ['Source', 'Bureau of Labor Statistics, Quarterly Census of Employment and Wages'],
      ['Vintage', '2024 annual averages'],
      ['Geography', 'Nine counties in three states stand in for the reservation'],
      [
        'Limitation',
        'The county figures count employers across the whole county, most of which lies outside the reservation. State the assumption or add records.',
      ],
    ],
  },
  {
    id: 'outcomes',
    label: 'Program outcomes',
    status: 'missing',
    statusLabel: 'No public source',
    fields: [
      ['Source', 'None yet'],
      ['Vintage', 'Not covered'],
      ['Geography', 'A program service area, which no federal product publishes'],
      [
        'Limitation',
        'No federal product links a training program’s enrollment to later employment. That link needs the records of whoever runs the program.',
      ],
    ],
  },
];

/** The proof strip: the four things an organization can always see. */
const PROOF = [
  {
    title: 'Evidence supported',
    text: 'Findings you can defend today, each with its claim class, how well the evidence fits it and whether the geography measured is the geography named.',
  },
  {
    title: 'Direct or proxy',
    text: 'Where a source does not publish your area, Grove names the wider geography that stood in and what that means for the number you are about to cite.',
  },
  {
    title: 'Governed records',
    text: 'The roster, payroll or enrollment file that moves a topic from proxy to direct, named before you assemble it and kept under your governance when it arrives.',
  },
  {
    title: 'Reproducible',
    text: 'Every figure carries an evidence record and a script that rebuilds it from the same rows, in Python, R or Stata.',
  },
];
---

<BaseLayout
  title="Cedar Grove, the living evidence base for your organization’s economy | Lumecon"
  description={description}
  canonical="https://lumecon.ai/cedar-grove"
  jsonLd={jsonLd}
  cedar={false}
>
  <Nav isHome={false} />
  <main class="meth grovepg" id="top" tabindex="-1">
    <header class="meth-hero grovepg-hero section--dark">
      <div class="meth-w">
        <p class="h-kicker reveal-soft">Cedar Grove by Lumecon</p>
        <h1 class="meth-hero__title reveal-soft" data-stagger="1">
          The living evidence base for your organization’s economy.
        </h1>
        <p class="meth-hero__lede reveal-soft" data-stagger="2">
          Cedar Grove connects maintained public data, Lumecon collections and the records your
          organization governs. Every finding stays connected to its source, geography, method,
          vintage and limits, so a number can be checked, cited and reproduced by the people who
          have to stand behind it.
        </p>
        <div class="grovepg-cta reveal-soft" data-stagger="3">
          <a class="btn2 btn2--primary" href="#license">
            Request Grove <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn2 btn2--card" href="#tour">
            See the evidence behind a finding <span class="btn2-arrow" aria-hidden="true"
              >&rarr;</span
            >
          </a>
        </div>
        {
          /* The evidence map: the place the evidence is about, and which
             geography each source can answer at. Census boundaries, drawn
             from the generated geometry above; no basemap, no pins, no
             choropleth, and nothing drawn by hand. The map carries no
             values at all, only place and coverage. */
        }
        <div class="gf gm reveal-soft" data-stagger="2" data-gm data-gm-topic="income">
          <div class="gf__bar">
            <span class="gf__brand">
              Cedar Grove <small>{GROVE_MAP.area.name.replace(' Reservation', '')}</small>
            </span>
            <span class="gf__note">Census TIGER/Line 2018 · Coverage, not values</span>
          </div>
          <div class="gm__body">
            <figure class="gm__map">
              <div class="gm__canvas">
                <svg viewBox={GROVE_MAP.viewBox} role="img" aria-labelledby="gm-title gm-desc">
                  <title id="gm-title">
                    {GROVE_MAP.area.name} and the counties its boundary crosses
                  </title>
                  <desc id="gm-desc">
                    Census boundaries. The reservation is filled in teal and its off-reservation
                    trust land is outlined beside it. The {GROVE_MAP.counties.length} counties whose boundaries
                    the reservation crosses are drawn around it, hatched where a source can answer only
                    at the county level, with the {GROVE_MAP.states.length} state lines behind them.
                  </desc>
                  <defs>
                    {
                      /* The hatched counties sit inside the geometry's scale
                        group, so the tile is measured in generated units: at
                        this scale a 7-unit tile printed about 34 pixels wide
                        and the fine hatch in the key became three fat bands.
                        `strokeScale` is the inverse of that scale, which is
                        what puts the tile back into screen space. */
                    }
                    <pattern
                      id="gm-hatch"
                      width={7 * GROVE_MAP.strokeScale}
                      height={7 * GROVE_MAP.strokeScale}
                      patternUnits="userSpaceOnUse"
                      patternTransform="rotate(45)"
                    >
                      <line
                        x1="0"
                        y1="0"
                        x2="0"
                        y2={7 * GROVE_MAP.strokeScale}
                        stroke="#18364a"
                        stroke-opacity="0.5"
                        stroke-width={1.1 * GROVE_MAP.strokeScale}></line>
                    </pattern>
                  </defs>
                  <rect x="0" y="0" width="560" height="420" fill="#f7f5f0"></rect>
                  <g transform={GROVE_MAP.transform}>
                    {
                      /* vector-effect is a property of a shape, not something
                        a group hands down, so these have to carry it
                        themselves. On the group it did nothing and the scale
                        multiplied every surrounding boundary to about five
                        times the weight of the subject's own outline. */
                    }
                    <g class="gm__states" fill="#efece5" stroke="#c9cccf">
                      {
                        GROVE_MAP.states.map((state) => (
                          <path d={state.d} vector-effect="non-scaling-stroke" />
                        ))
                      }
                    </g>
                    <g class="gm__proxy" fill="url(#gm-hatch)" stroke="none">
                      {GROVE_MAP.counties.map((county) => <path d={county.d} />)}
                    </g>
                    <g class="gm__counties" fill="none" stroke="#b9c1c6">
                      {
                        GROVE_MAP.counties.map((county) => (
                          <path d={county.d} vector-effect="non-scaling-stroke" />
                        ))
                      }
                    </g>
                    <g class="gm__neighbors" fill="#e6e2d8" stroke="#a9a294">
                      {
                        GROVE_MAP.neighbors.map((land) => (
                          <path d={land.d} vector-effect="non-scaling-stroke" />
                        ))
                      }
                    </g>
                    {
                      GROVE_MAP.trustLand ? (
                        <path
                          class="gm__trust"
                          d={GROVE_MAP.trustLand.d}
                          fill="rgba(10, 127, 116, 0.14)"
                          stroke="#0a7f74"
                          stroke-width="0.9"
                          vector-effect="non-scaling-stroke"
                        />
                      ) : null
                    }
                    <path
                      class="gm__org"
                      d={GROVE_MAP.area.d}
                      fill="rgba(10, 127, 116, 0.2)"
                      stroke="#0a7f74"
                      stroke-width="1.8"
                      vector-effect="non-scaling-stroke"></path>
                  </g>
                  <g class="gm__labels" font-family="var(--font-mono)" font-size="10">
                    {
                      MAP_COUNTY_LABELS.map((county) => (
                        <text
                          x={county.label[0]}
                          y={county.label[1]}
                          fill="#5b676d"
                          text-anchor="middle"
                        >
                          {`${county.name.toUpperCase()} CO, ${county.usps}`}
                        </text>
                      ))
                    }
                    {
                      GROVE_MAP.neighbors
                        .filter((land) => land.labelInFrame)
                        .map((land) => (
                          <text
                            x={land.label[0]}
                            y={land.label[1]}
                            fill="#6b6152"
                            font-size="9"
                            text-anchor="middle"
                          >
                            {land.name.replace(' Reservation', '').toUpperCase()}
                          </text>
                        ))
                    }
                    <text
                      class="gm__labels__area"
                      x={GROVE_MAP.area.label[0]}
                      y={GROVE_MAP.area.label[1]}
                      fill="#075f58"
                      font-size="15"
                      font-weight="700"
                      text-anchor="middle"
                    >
                      Navajo Nation
                    </text>
                    <text
                      x={GROVE_MAP.area.label[0]}
                      y={GROVE_MAP.area.label[1] + 15}
                      fill="#075f58"
                      font-size="9.5"
                      text-anchor="middle"
                    >
                      AIANNH 2430
                    </text>
                  </g>
                  <rect x="0.5" y="0.5" width="559" height="419" fill="none" stroke="#d9dcdf"
                  ></rect>
                </svg>
              </div>
              <figcaption class="gm__legend" aria-label="Map key">
                <span><i class="gm__sw gm__sw--org"></i>Reservation</span>
                <span><i class="gm__sw gm__sw--trust"></i>Off-reservation trust land</span>
                <span><i class="gm__sw gm__sw--proxy"></i>County a source falls back to</span>
                <span><i class="gm__sw gm__sw--state"></i>State line</span>
                <span><i class="gm__sw gm__sw--neighbor"></i>Another nation</span>
              </figcaption>
              <p class="gm__vintage">
                {GROVE_MAP.vintage}. {
                  MAP_AREA_SQ_MI ? `${MAP_AREA_SQ_MI} square miles of reservation` : null
                }
                {MAP_TRUST_SQ_MI ? ` and ${MAP_TRUST_SQ_MI} of off-reservation trust land` : null},
                across {GROVE_MAP.counties.length} counties in {GROVE_MAP.states.length} states.{
                  ' '
                }
                {MAP_SIMPLIFICATION}
              </p>
            </figure>
            <aside class="gm__panel" aria-label="Evidence for the selected topic">
              <p class="gf__cap">What the evidence covers</p>
              <div class="gm__topics" role="group" aria-label="Topics">
                {
                  MAP_TOPICS.map((t, i) => (
                    <button
                      type="button"
                      class="gm__topic"
                      data-gm-pick={t.id}
                      aria-pressed={i === 0 ? 'true' : 'false'}
                    >
                      {t.label}
                      <small class={`gf__status gf__status--${t.status}`}>{t.statusLabel}</small>
                    </button>
                  ))
                }
              </div>
              {
                MAP_TOPICS.map((t, i) => (
                  <dl class="gm__fields" data-gm-fields={t.id} hidden={i !== 0}>
                    {t.fields.map(([k, v]) => (
                      <div>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                    <div>
                      <dt>Status</dt>
                      <dd class={`gf__status gf__status--${t.status}`}>{t.statusLabel}</dd>
                    </div>
                  </dl>
                ))
              }
              <p class="gm__foot">
                These are the federal products and the levels they publish at, for an area of this
                kind. They are not an account of what the Navajo Nation holds: a nation&rsquo;s own
                records answer questions no federal product reaches, and Cedar Grove reads those
                too. Jurisdiction, service area, organization geography and statistical geography
                are kept apart, never merged. The boundaries are Census geography at the vintage
                named under the map, and the map carries coverage, never values.
              </p>
            </aside>
          </div>
        </div>
      </div>
    </header>

    {
      /* The frame. A staged Grove: the leadership question on the left,
         the claim and its figure in the middle, the coverage status and
         the implication beside them, the record underneath on request. */
    }
    {
      /* The product, captured from the product.
         This band used to be a drawing of Grove: a panel with a fake title
         bar, a question list and a figure, all built in Astro and CSS and
         captioned "illustrative example, names and values are invented". It
         had two problems. A drawing is a picture of a promise rather than
         evidence of a product, on a page whose whole argument is that a
         number should be traceable. And it drifted: Grove was rebuilt around
         a purpose carousel and five surfaces, and the drawing still showed an
         interface the product had left behind.
         These are real captures of the running application, on the same
         footing as every other product shot on this site, produced by
         scripts/screenshots/capture-grove.mjs and refreshed with it. The
         workspace in them is Grove's demonstration workspace, and the figures
         in it label themselves as demonstration data on their own faces, so
         nothing here needs a caption promising that it is honest. */
    }
    <section class="grovetour section--dark" id="tour" aria-labelledby="g-frame">
      <div class="meth-w">
        <p class="h-kicker reveal-soft">Inside Cedar Grove</p>
        <h2 class="grovetour__title reveal-soft" id="g-frame" data-stagger="1">
          What you start from, what you work in, what you leave with.
        </h2>
        <p class="grovetour__lede reveal-soft" data-stagger="2">
          Grove opens on what you are preparing and stays on that until it is finished. The three
          screens below are the running product, in a demonstration workspace whose figures say so
          on their own faces.
        </p>

        <div class="tour-rows">
          {
            GROVE_TOUR.map((row, i) => (
              <article class={`tour-row${i % 2 === 1 ? ' tour-row--flip' : ''}`}>
                <div class={`tour-row__text ${i % 2 === 1 ? 'reveal-right' : 'reveal-left'}`}>
                  <p class="tour-row__kicker">{row.kicker}</p>
                  <h3 class="tour-row__title">{row.title}</h3>
                  <p class="tour-row__body">{row.body}</p>
                </div>
                {/* data-zoom: 1920px renders shown at a fraction of that, so a
                    click opens the full size. See Lightbox.astro. */}
                <figure
                  class={`tour-row__shot ${i % 2 === 1 ? 'reveal-left' : 'reveal-right'}`}
                  data-zoom
                >
                  <picture>
                    <source
                      srcset={row.imgDark}
                      media="(prefers-color-scheme: dark)"
                      width={FRAME.width}
                      height={FRAME.height}
                    />
                    {/* width/height carry the intrinsic ratio so the browser
                        reserves the box before the file arrives; the rendered
                        size is CSS-driven. One frame for every row, so the
                        boxes are identical and the page composes against them
                        instead of against whatever height each surface ran
                        to. */}
                    <img
                      src={row.img}
                      alt={row.alt}
                      width={FRAME.width}
                      height={FRAME.height}
                      sizes="(max-width: 900px) 100vw, 55vw"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </figure>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {
      /* The proof strip: the four things an organization can always see.
         It used to be followed by three staged crops, hand-built panels
         showing a coverage view, an evidence record and a reproducibility
         bundle for an invented Nation. The tour above shows all three in the
         running product now, so the crops were saying the same thing twice
         and saying it in a drawing. The four sentences stay, because they are
         the claim the screenshots are evidence for. */
    }
    <section class="meth-sec grovepg-proof" aria-labelledby="g-proof">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 class="reveal-soft" id="g-proof">
            A private, living evidence workspace for your organization and its place.
          </h2>
        </div>
        <ul class="grovepg-strip" data-reveal-group>
          {
            PROOF.map((p) => (
              <li>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      /* The registry: the twelve collections as a contiguous grid of the
         collection marks, with one persistent detail panel. Hover
         or click selects on a wide screen; on a phone a tap selects and the
         panel follows beneath the grid. Every line in the panel is read
         from the Lumecon collection catalog and its dataset documentation. */
    }
    <section
      class="grovepg-registry section--dark"
      id="collections"
      aria-labelledby="g-collections"
    >
      <div class="meth-w">
        <p class="h-kicker reveal-soft">
          {spelledCount(COLLECTION_COUNT, true)} maintained collections
        </p>
        <h2 class="grovepg-registry__title reveal-soft" id="g-collections" data-stagger="1">
          {spelledCount(COLLECTION_COUNT, true)} maintained collections, resolved to your place.
        </h2>
        <p class="grovepg-registry__lede reveal-soft" data-stagger="2">
          Beside the public programs, a Grove carries the collections Lumecon builds and maintains
          for Indian Country, each resolved to the nation, corporation or organization behind its
          records. Every collection available during your term is included, and each new one as it
          is released.
        </p>
        <div class="creg reveal-soft" data-stagger="3" data-creg>
          <ol class="creg__grid">
            {
              GROVE_COLLECTIONS.map((c, i) => (
                <li>
                  <button
                    type="button"
                    class="creg__cell"
                    data-creg-pick={c.id}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-controls="creg-panel"
                  >
                    <span class="creg__num">{String(i + 1).padStart(2, '0')}</span>
                    <svg
                      class="creg__mark"
                      viewBox="0 0 28 28"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.9"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={c.mark}
                    />
                    <span class="creg__name">{c.short}</span>
                  </button>
                </li>
              ))
            }
          </ol>
          <div class="creg__panel" id="creg-panel" aria-live="polite">
            {
              GROVE_COLLECTIONS.map((c, i) => (
                <section
                  class="creg__detail"
                  data-creg-detail={c.id}
                  hidden={i !== 0}
                  aria-label={c.name}
                >
                  <p class="creg__cap">Collection {String(i + 1).padStart(2, '0')}</p>
                  <h3>{c.name}</h3>
                  <dl>
                    <dt>Contributes</dt>
                    <dd>{c.contributes}</dd>
                    <dt>Resolved to</dt>
                    <dd>{c.resolved}</dd>
                    <dt>Coverage</dt>
                    <dd>{c.coverage}</dd>
                    <dt>Sources</dt>
                    <dd>{c.sources}</dd>
                    <dt>Terms</dt>
                    <dd>{c.terms}</dd>
                  </dl>
                </section>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="meth-sec" id="license" aria-labelledby="g-license">
      <div class="meth-w">
        <div class="grovepg-license reveal-soft">
          <div>
            <p class="h-kicker">One license per organization</p>
            <h2 id="g-license">Cedar Grove, for your whole organization.</h2>
            <p>
              A Grove belongs to the organization, not to a seat. Everyone who works from your
              evidence works from the same one: the same findings, the same coverage, the same
              records, the same history.
            </p>
            <p>
              Onboarding is done with you. We anchor the Grove to your area, connect the public
              programs that publish it, and set up the records you want layered over the gaps.
            </p>
            <p class="grovepg-license__note">
              Unlimited users either way. Cedar Grove on its own is the evidence base; the Tree plan
              is the same Grove with Cedar Impact and Cedar Commons beside it, and that is the whole
              difference in price. <a href="/pricing">Compare plans.</a>
            </p>
          </div>
          <div>
            <p class="grovepg-price">
              <span class="grovepg-price__amount">{CEDAR_GROVE.price}</span>
              <span class="grovepg-price__period">per organization, per year</span>
            </p>
            <ul>
              <li>Unlimited users in one organization</li>
              <li>{spelledCount(COLLECTION_COUNT, true)} Lumecon collections, and each new one</li>
              <li>Full history and evidence records</li>
              <li>Exports, evidence sheets and reproducibility bundles</li>
              <li>Cedar, the AI economic analyst, grounded in your evidence</li>
            </ul>
            <a class="btn2 btn2--primary" href={CEDAR_GROVE.ctaHref}>
              {CEDAR_GROVE.ctaLabel}
              <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <p class="grovepg-license__note" style="margin-top:0.9rem">
              Prefer to talk first? <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </div>
        </div>

        <div class="grovepg-bridge reveal-soft" style="margin-top:2.4rem">
          <p>
            <strong>Also from Lumecon.</strong> Use this evidence base to model a project or policy in
            Cedar Impact, and to share the work in Cedar Commons. Grove stands on its own; the family
            is there when you need it.
          </p>
          <a class="btn2 btn2--card" href="/#product">
            See Cedar Impact <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    // One pattern, three times: a set of buttons picks which sibling panel
    // shows. No library, no state beyond the DOM.
    function wirePicker(root: Element, pickAttr: string, panelAttr: string, onPick?: () => void) {
      const picks = Array.from(root.querySelectorAll<HTMLButtonElement>(`[${pickAttr}]`));
      const panels = Array.from(root.querySelectorAll<HTMLElement>(`[${panelAttr}]`));
      const select = (pick: HTMLButtonElement) => {
        const id = pick.getAttribute(pickAttr);
        picks.forEach((p) => p.setAttribute('aria-pressed', p === pick ? 'true' : 'false'));
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute(panelAttr) !== id;
        });
        if (id) root.setAttribute(`${pickAttr}ed`, id);
        if (onPick) onPick();
      };
      return { picks, select };
    }

    // The evidence map: a topic selects its fields and the map emphasizes
    // the geography that topic's evidence is about.
    document.querySelectorAll<HTMLElement>('[data-gm]').forEach((map) => {
      const { picks, select } = wirePicker(map, 'data-gm-pick', 'data-gm-fields', () => {
        map.setAttribute('data-gm-topic', map.getAttribute('data-gm-picked') || 'income');
      });
      picks.forEach((pick) => pick.addEventListener('click', () => select(pick)));
    });

    // The registry: hover or focus previews on a wide screen, a click or tap
    // selects everywhere; on a phone the panel sits under the grid, so a tap
    // also brings it into view.
    document.querySelectorAll<HTMLElement>('[data-creg]').forEach((reg) => {
      const { picks, select } = wirePicker(reg, 'data-creg-pick', 'data-creg-detail');
      const panel = reg.querySelector<HTMLElement>('.creg__panel');
      const wide = () => window.matchMedia('(min-width: 901px)').matches;
      const stillness = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      picks.forEach((pick) => {
        pick.addEventListener('click', () => {
          select(pick);
          // On a phone the panel sits under the grid, so a tap brings it into
          // view. A reader who asked for stillness gets the same jump without
          // the animation rather than a forced glide.
          if (!wide() && panel) {
            panel.scrollIntoView({ block: 'nearest', behavior: stillness() ? 'auto' : 'smooth' });
          }
        });
        // Hovering previews, because a pointer can leave again. Focus does
        // not: tabbing across the grid would otherwise re-announce a whole
        // record at every stop, for a selection the reader never made. The
        // keyboard selects the way the control says it does, by activating.
        pick.addEventListener('mouseenter', () => {
          if (wide()) select(pick);
        });
      });
    });
  </script>
</BaseLayout>
