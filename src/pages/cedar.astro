---
/**
 * /cedar — the Cedar product page. This page owns the AI story so
 * the homepage, pricing and methodology stop re-explaining it. One
 * argument: Cedar was designed into the economic-analysis workflow
 * from the beginning, and Lumecon's implementation is different
 * because the model, data, software and AI are developed together.
 *
 * Visuals: real product captures (the Cedar panel over live results)
 * plus three thin-line SVG diagrams in the site's linework style.
 * No vendor logos, no chat-bubble clichés.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MarkArt from '../components/MarkArt.astro';
import { site } from '../config';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';
import '../styles/cedar-page.css';

const description =
  'Cedar is Lumecon&rsquo;s AI economic analyst, designed into the workflow from the beginning: reading source documents, structuring model-ready inputs, surfacing gaps, supporting interpretation and helping communicate findings. AI in the workflow, economists in the loop.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Cedar | Lumecon',
    url: 'https://lumecon.ai/cedar',
    description,
    isPartOf: { '@id': `${site.url}#website` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Cedar', item: 'https://lumecon.ai/cedar' },
    ],
  },
];
---

<BaseLayout
  title="Cedar, the AI economic analyst | Lumecon"
  description={description}
  canonical="https://lumecon.ai/cedar"
  keywords="Cedar AI, AI economic analyst, AI economic impact analysis, AI for economic modeling, document ingestion economic analysis, AI assisted input-output modeling, economic analysis AI assistant, Lumecon Cedar"
  jsonLd={jsonLd}
>
  <Nav isHome={false} />
  <main class="meth cedarpg" id="top" tabindex="-1">
    <!-- Shared thin-line icon symbols for the three diagrams below. -->
    <svg aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0">
      <defs>
        <symbol id="dg2-data" viewBox="0 0 24 24">
          <ellipse cx="12" cy="6" rx="7" ry="3" fill="none" stroke="currentColor" stroke-width="1.5"
          ></ellipse>
          <path
            d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"></path>
        </symbol>
        <symbol id="dg2-model" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.5"
          ></circle>
          <circle
            cx="12"
            cy="12"
            r="5.8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            opacity="0.65"></circle>
          <circle
            cx="12"
            cy="12"
            r="9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            opacity="0.35"></circle>
        </symbol>
        <symbol id="dg2-results" viewBox="0 0 24 24">
          <path
            d="M4 20h16M6 16v-5M11 16V4M16 16V9M21 16v-3"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </symbol>
        <symbol id="dg2-report" viewBox="0 0 24 24">
          <path
            d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </symbol>
        <symbol id="dg2-chat" viewBox="0 0 24 24">
          <path
            d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8l-4 4v-4H6a2 2 0 0 1-2-2z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </symbol>
        <symbol id="dg2-sprout" viewBox="0 0 24 24">
          <path
            d="M12 21v-8M12 13c0-3.3 2.4-6 6-6 0 3.3-2.4 6-6 6zM12 13c0-3.3-2.4-6-6-6 0 3.3 2.4 6 6 6z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </symbol>
        <symbol id="dg2-org" viewBox="0 0 24 24">
          <path
            d="M3 21h18M5 21V10M9.5 21V10M14.5 21V10M19 21V10M3 10l9-6 9 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </symbol>
        <symbol id="dg2-folder" viewBox="0 0 24 24">
          <path
            d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </symbol>
        <symbol id="dg2-tools" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.5"
          ></circle>
          <path
            d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </symbol>
      </defs>
    </svg>
    <!-- Hero -->
    <header class="meth-hero">
      <MarkArt class="markart markart--tr" size={620} />
      <div class="meth-w">
        <p class="h-kicker">Cedar</p>
        <h1 class="meth-hero__title">
          AI built for economic analysis, <span class="brand-em">from the beginning.</span>
        </h1>
        <p class="meth-hero__lede">
          Cedar is Lumecon&rsquo;s AI economic analyst. It works across intake, analysis,
          interpretation and reporting, helping turn organizational knowledge and source documents
          into usable economic analysis. <span class="brand-em"
            >Not a chatbot added to old software. Part of how Lumecon works.</span
          >
        </p>
        <div class="cedarpg-cta">
          <a class="btn2 btn2--primary" href="/signup?tier=free">
            Try Lumecon <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </header>

    <!-- The page's three screenshots are one story, told in order below:
         source documents uploading, the operations Cedar set up from them
         with its ask on the open panel, and the board notes it drafts from
         the finished results. No screenshot appears twice. -->

    <!-- 01 · Not a chatbot -->
    <section class="meth-sec" aria-labelledby="c-arch">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="c-arch">AI shouldn&rsquo;t sit on top of the model.</h2>
        </div>
        <div class="meth-cols">
          <div class="meth-prose">
            <p>
              The common pattern bolts an assistant onto finished software: the data goes in, the
              model runs, the results come out, and a chatbot answers questions about them
              afterward. Cedar participates throughout the workflow instead: reading source
              material, structuring inputs, surfacing gaps, supporting interpretation and helping
              communicate findings.
            </p>
          </div>
          <div class="cedarpg-fig">
            <figure
              class="cedarpg-diagram"
              data-diagram
              aria-label="Two architectures compared. The legacy pattern: data flows to model to results, with a chatbot attached only to results as a dead end. Lumecon: Cedar connects to every stage, from data to model to results to reporting."
            >
              <p class="cedarpg-diagram__k" aria-hidden="true">The legacy pattern</p>
              <svg viewBox="0 0 520 150" aria-hidden="true">
                <g class="dg-box">
                  <g class="dg2-node" style="--d:0s">
                    <rect x="8" y="8" width="120" height="60" rx="7"></rect>
                    <use href="#dg2-data" class="dg2-ic" width="22" height="22" x="57" y="16"></use>
                  </g>
                  <g class="dg2-node" style="--d:0.08s">
                    <rect x="200" y="8" width="120" height="60" rx="7"></rect>
                    <use href="#dg2-model" class="dg2-ic" width="22" height="22" x="249" y="16"
                    ></use>
                  </g>
                  <g class="dg2-node" style="--d:0.16s">
                    <rect x="392" y="8" width="120" height="60" rx="7"></rect>
                    <use href="#dg2-results" class="dg2-ic" width="22" height="22" x="441" y="16"
                    ></use>
                  </g>
                  <g class="dg2-node" style="--d:0.32s">
                    <rect x="392" y="112" width="120" height="30" rx="7" class="dg-box--dash"
                    ></rect>
                    <use
                      href="#dg2-chat"
                      class="dg2-ic dg2-ic--muted"
                      width="14"
                      height="14"
                      x="410"
                      y="120"></use>
                  </g>
                </g>
                <g class="dg-label">
                  <text x="68" y="59" class="dg2-node" style="--d:0s">DATA</text>
                  <text x="260" y="59" class="dg2-node" style="--d:0.08s">MODEL</text>
                  <text x="452" y="59" class="dg2-node" style="--d:0.16s">RESULTS</text>
                  <text x="460" y="131" class="dg-label--muted dg2-node" style="--d:0.32s"
                    >CHATBOT</text
                  >
                </g>
                <g class="dg-line">
                  <path d="M128 38h64m-8-4 8 4-8 4" class="dg2-draw" pathLength="1" style="--d:0.2s"
                  ></path>
                  <path d="M320 38h64m-8-4 8 4-8 4" class="dg2-draw" pathLength="1" style="--d:0.3s"
                  ></path>
                  <path
                    d="M452 68v44"
                    class="dg-line--dash dg2-draw"
                    pathLength="1"
                    style="--d:0.45s"></path>
                </g>
                <g class="dg-flow">
                  <path d="M128 38h64" class="dg-flow--quiet"></path>
                  <path d="M320 38h64" class="dg-flow--quiet"></path>
                </g>
              </svg>
              <p class="cedarpg-diagram__k" aria-hidden="true">Lumecon</p>
              <svg viewBox="0 0 520 218" aria-hidden="true">
                <g class="dg2-ripples">
                  <circle cx="260" cy="50" r="38" class="dg2-ripple" style="--rd:0s"></circle>
                  <circle cx="260" cy="50" r="50" class="dg2-ripple" style="--rd:0.9s"></circle>
                  <circle cx="260" cy="50" r="62" class="dg2-ripple" style="--rd:1.8s"></circle>
                </g>
                <g class="dg-box">
                  <g class="dg2-node" style="--d:0s">
                    <rect x="200" y="20" width="120" height="60" rx="7" class="dg-box--cedar"
                    ></rect>
                    <use
                      href="#dg2-sprout"
                      class="dg2-ic dg2-ic--cedar"
                      width="22"
                      height="22"
                      x="249"
                      y="28"></use>
                  </g>
                  <g class="dg2-node" style="--d:0.12s">
                    <rect x="8" y="150" width="116" height="60" rx="7"></rect>
                    <use href="#dg2-data" class="dg2-ic" width="22" height="22" x="55" y="158"
                    ></use>
                  </g>
                  <g class="dg2-node" style="--d:0.2s">
                    <rect x="140" y="150" width="116" height="60" rx="7"></rect>
                    <use href="#dg2-model" class="dg2-ic" width="22" height="22" x="187" y="158"
                    ></use>
                  </g>
                  <g class="dg2-node" style="--d:0.28s">
                    <rect x="272" y="150" width="116" height="60" rx="7"></rect>
                    <use href="#dg2-results" class="dg2-ic" width="22" height="22" x="319" y="158"
                    ></use>
                  </g>
                  <g class="dg2-node" style="--d:0.36s">
                    <rect x="404" y="150" width="116" height="60" rx="7"></rect>
                    <use href="#dg2-report" class="dg2-ic" width="22" height="22" x="451" y="158"
                    ></use>
                  </g>
                </g>
                <g class="dg-label">
                  <text x="260" y="71" class="dg-label--cedar dg2-node" style="--d:0s">CEDAR</text>
                  <text x="66" y="201" class="dg2-node" style="--d:0.12s">DATA</text>
                  <text x="198" y="201" class="dg2-node" style="--d:0.2s">MODEL</text>
                  <text x="330" y="201" class="dg2-node" style="--d:0.28s">RESULTS</text>
                  <text x="462" y="201" class="dg2-node" style="--d:0.36s">REPORTING</text>
                </g>
                <g class="dg-line">
                  <path
                    d="M124 180h14m-6-4 6 4-6 4"
                    class="dg-line--quiet dg2-draw"
                    pathLength="1"
                    style="--d:0.4s"></path>
                  <path
                    d="M256 180h14m-6-4 6 4-6 4"
                    class="dg-line--quiet dg2-draw"
                    pathLength="1"
                    style="--d:0.45s"></path>
                  <path
                    d="M388 180h14m-6-4 6 4-6 4"
                    class="dg-line--quiet dg2-draw"
                    pathLength="1"
                    style="--d:0.5s"></path>
                  <path d="M228 80 70 148" class="dg-line--cedar dg2-draw" pathLength="1"></path>
                  <path d="M249 80l-49 68" class="dg-line--cedar dg2-draw" pathLength="1"></path>
                  <path d="M271 80l49 68" class="dg-line--cedar dg2-draw" pathLength="1"></path>
                  <path d="M292 80l158 68" class="dg-line--cedar dg2-draw" pathLength="1"></path>
                </g>
                <g class="dg-flow">
                  <path d="M228 80 70 148"></path>
                  <path d="M249 80l-49 68"></path>
                  <path d="M271 80l49 68"></path>
                  <path d="M292 80l158 68"></path>
                </g>
              </svg>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 · Document ingestion -->
    <section class="meth-sec" aria-labelledby="c-ingest">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="c-ingest">Bring the work you already have.</h2>
        </div>
        <div class="meth-twoprose">
          <div class="meth-prose">
            <p>
              <span class="brand-em">Your existing work becomes context, not baggage.</span> Upload supported
              PDFs, spreadsheets, CSVs, prior studies and recurring organizational materials. Cedar helps
              identify the relevant information and map it into the analysis workflow, and it flags the
              gaps it cannot resolve rather than papering over them.
            </p>
          </div>
          <div class="meth-prose">
            <p>
              Moving from another platform? Prior studies and reporting examples help Cedar
              understand how your organization already works: the terminology you use, the
              geographies you care about and the format your reporting takes.
            </p>
          </div>
        </div>
        <figure class="cedar-shot cedarpg-shot cedarpg-shot--full">
          <picture>
            <source
              srcset="/app/cedar-wind-upload-dark.webp"
              media="(prefers-color-scheme: dark)"
            />
            <img
              src="/app/cedar-wind-upload.webp"
              alt="The first step of a new analysis: two PDFs, a capital plan and county road-use agreements, uploading to Cedar with live per-file status, alongside a note telling Cedar to watch for the substation electrical line item."
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <figcaption>
            Where every analysis starts: the wind study&rsquo;s source documents uploading to Cedar,
            with a note about what to watch for. Shown with sample data.
          </figcaption>
        </figure>
        <figure class="cedar-shot cedarpg-shot cedarpg-shot--full">
          <picture>
            <source
              srcset="/app/cedar-wind-entities-dark.webp"
              media="(prefers-color-scheme: dark)"
            />
            <img
              src="/app/cedar-wind-entities.webp"
              alt="The operations step of the wind analysis: three entity cards with their sector icons, turbine and storage installation, grid interconnection and operations and maintenance, beside the open Cedar panel reporting that two operations are model ready and asking to fill the missing sales figure from the procurement workbook."
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <figcaption>
            The same documents turned into operations, each carded with its industry. Cedar reports
            what is model ready and asks about the one figure still missing. Shown with sample data.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- 03 · Organizational context -->
    <section class="meth-sec" aria-labelledby="c-org">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="c-org">One Cedar. Your organization.</h2>
        </div>
        <div class="meth-cols">
          <div class="meth-prose">
            <p>
              Cedar can carry approved organizational context across projects, helping teams build
              on prior work rather than starting from zero each time. For larger organizations,
              Cedar can be calibrated around terminology, recurring workflows, analytical
              conventions and reporting preferences, and Cedar Grove on the Tree plan gives that
              context a durable home.
            </p>
          </div>
          <div class="cedarpg-fig">
            <figure
              class="cedarpg-diagram"
              data-diagram
              aria-label="Diagram: the organization informs Cedar, and Cedar carries that context into project A, project B and project C."
            >
              <svg viewBox="0 0 520 236" aria-hidden="true">
                <g class="dg2-ripples">
                  <circle cx="260" cy="126" r="38" class="dg2-ripple" style="--rd:0s"></circle>
                  <circle cx="260" cy="126" r="50" class="dg2-ripple" style="--rd:0.9s"></circle>
                  <circle cx="260" cy="126" r="62" class="dg2-ripple" style="--rd:1.8s"></circle>
                </g>
                <g class="dg-box">
                  <g class="dg2-node" style="--d:0s">
                    <rect x="180" y="8" width="160" height="60" rx="7"></rect>
                    <use href="#dg2-org" class="dg2-ic" width="22" height="22" x="249" y="16"></use>
                  </g>
                  <g class="dg2-node" style="--d:0.14s">
                    <rect x="200" y="96" width="120" height="60" rx="7" class="dg-box--cedar"
                    ></rect>
                    <use
                      href="#dg2-sprout"
                      class="dg2-ic dg2-ic--cedar"
                      width="22"
                      height="22"
                      x="249"
                      y="104"></use>
                  </g>
                  <g class="dg2-node" style="--d:0.28s">
                    <rect x="10" y="196" width="140" height="32" rx="7"></rect>
                    <use href="#dg2-folder" class="dg2-ic" width="14" height="14" x="28" y="205"
                    ></use>
                  </g>
                  <g class="dg2-node" style="--d:0.36s">
                    <rect x="190" y="196" width="140" height="32" rx="7"></rect>
                    <use href="#dg2-folder" class="dg2-ic" width="14" height="14" x="208" y="205"
                    ></use>
                  </g>
                  <g class="dg2-node" style="--d:0.44s">
                    <rect x="370" y="196" width="140" height="32" rx="7"></rect>
                    <use href="#dg2-folder" class="dg2-ic" width="14" height="14" x="388" y="205"
                    ></use>
                  </g>
                </g>
                <g class="dg-label">
                  <text x="260" y="59" class="dg2-node" style="--d:0s">ORGANIZATION</text>
                  <text x="260" y="147" class="dg-label--cedar dg2-node" style="--d:0.14s"
                    >CEDAR</text
                  >
                  <text x="88" y="217" class="dg2-node" style="--d:0.28s">PROJECT A</text>
                  <text x="268" y="217" class="dg2-node" style="--d:0.36s">PROJECT B</text>
                  <text x="448" y="217" class="dg2-node" style="--d:0.44s">PROJECT C</text>
                </g>
                <g class="dg-line">
                  <path d="M260 68v24m-4-8 4 8 4-8" class="dg2-draw" pathLength="1" style="--d:0.1s"
                  ></path>
                  <path d="M234 156 90 194" class="dg-line--cedar dg2-draw" pathLength="1"></path>
                  <path d="M260 156v38" class="dg-line--cedar dg2-draw" pathLength="1"></path>
                  <path d="M286 156l144 38" class="dg-line--cedar dg2-draw" pathLength="1"></path>
                </g>
                <g class="dg-flow">
                  <path d="M234 156 90 194"></path>
                  <path d="M260 156v38"></path>
                  <path d="M286 156l144 38"></path>
                </g>
              </svg>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 · Thought partner -->
    <section class="meth-sec" aria-labelledby="c-partner">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="c-partner">Thought partner, not autopilot.</h2>
        </div>
        <div class="meth-cols">
          <div class="meth-prose">
            <p>
              Cedar can suggest, question, organize, explain and draft. It can help an analyst
              explain the same finding differently for a board, a policymaker, a tribal council, a
              grantmaker or an executive. It does not remove the analyst from the work: Cedar
              surfaces the assumptions it makes, and the person running the analysis confirms them
              before results are finalized. <span class="brand-em"
                >AI in the workflow. Economists in the loop.</span
              >
            </p>
          </div>
          <figure class="cedar-shot cedarpg-shot">
            <picture>
              <source
                srcset="/app/cedar-wind-partner-dark.webp"
                media="(prefers-color-scheme: dark)"
              />
              <img
                src="/app/cedar-wind-partner.webp"
                alt="The same wind energy analysis, with Cedar drafting a county-board summary that draws on the results and the three documents uploaded earlier: the capital plan, the turbine procurement workbook and the road-use agreements."
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption>
              The same analysis, later in the work: Cedar drafts the board notes from the results
              and the documents it read at intake. Shown with sample data.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 05 · Built differently -->
    <section class="meth-sec" aria-labelledby="c-built">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="c-built">Economics isn&rsquo;t handed to engineering after the fact.</h2>
        </div>
        <div class="meth-twoprose">
          <div class="meth-prose">
            <p>
              Lumecon is developed collaboratively across economics, social science, data science
              and software engineering. Modeling decisions shape the software. New data changes what
              can be estimated. Software and AI make new analytical workflows possible.
            </p>
          </div>
          <div class="meth-prose">
            <p>
              That is why Cedar behaves like part of the analysis rather than a layer over it:
              <span class="brand-em"
                >the model, data infrastructure, software and AI evolve together.</span
              >
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 06 · Better models, not just easier software -->
    <section class="meth-sec" aria-labelledby="c-better">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="c-better">
            AI shouldn&rsquo;t just make the software easier. It should help us build better models.
          </h2>
        </div>
        <div class="meth-cols">
          <div class="meth-prose">
            <p>
              Modern AI makes larger and more varied datasets practical to process, harmonize,
