---
/**
 * /cedar — the Cedar product page. This page owns the AI story so
 * the homepage, pricing and methodology stop re-explaining it. One
 * argument: Cedar was designed into the economic-analysis workflow
 * from the beginning, and Lumecon's implementation is different
 * because the model, data, software and AI are developed together.
 *
 * Visuals: three real product captures telling one story in order
 * (upload, operations with Cedar's ask, board notes). No diagrams,
 * no vendor logos, no chat-bubble clichés.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';
import '../styles/tour.css';
import '../styles/cedar-page.css';

const description =
  'Cedar is Lumecon’s AI economic analyst, helping teams organize source material, structure reviewable inputs and explain results alongside Cedar Impact.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Cedar | Lumecon',
    url: 'https://lumecon.ai/cedar',
    description,
    isPartOf: { '@id': `${site.url}#website` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Cedar', item: 'https://lumecon.ai/cedar' },
    ],
  },
];
---

<BaseLayout
  title="Cedar, the AI economic analyst | Lumecon"
  description={description}
  canonical="https://lumecon.ai/cedar"
  jsonLd={jsonLd}
  cedar={false}
>
  <Nav isHome={false} />
  <main class="meth cedarpg" id="top" tabindex="-1">
    {/* Hero */}
    <header class="meth-hero cedarpg-hero section--dark">
      <div class="meth-w">
        <p class="h-kicker reveal-soft">Cedar</p>
        <h1 class="meth-hero__title reveal-soft" data-stagger="1">
          Cedar turns source material into <span class="brand-em">reviewable economic inputs.</span>
        </h1>
        <p class="meth-hero__lede reveal-soft" data-stagger="2">
          Cedar is Lumecon&rsquo;s AI economic analyst. It reads documents you select, proposes
          structured inputs, flags unresolved questions and helps explain results. Cedar Impact
          performs the economic calculations with approved inputs, while the person running the
          analysis reviews assumptions and approves the final result.
        </p>
        <div class="cedarpg-cta reveal-soft" data-stagger="3">
          <a class="btn2 btn2--primary" href="/signup?tier=free">
            Request beta access <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <figure class="cedarpg-hero__screen reveal-soft" data-stagger="3" data-zoom>
          <img
            src="/app/cedar-wind-entities.webp"
            alt="Cedar reviewing proposed economic inputs from sample wind-project source documents."
            width="1920"
            height="1080"
            decoding="async"
          />
          <figcaption>Cedar turns source material into reviewable economic inputs.</figcaption>
        </figure>
      </div>
    </header>

    {
      /* Three acts, one screenshot each, in the order the work happens:
         Cedar reads what you already have, it does the analysis with you,
         and your organization's work stays organized in one place.

         Built on the homepage tour's own row: text one side, screenshot the
         other, alternating, sliding in from opposite edges. Stacking a
         full-width screenshot under a paragraph, which is what this was,
         gives the reveal nothing to play against and puts the picture a
         scroll away from the words it illustrates.

         This replaced nine sections that argued the same three points from
         different angles: "AI shouldn't sit on top of the model" and
         "economics and engineering are developed together" were one claim
         told twice, and "built to use the best tools available" was a
         34-word section with its own heading. The how-it-is-built material
         is a three-item band at the end rather than three more sections. */
    }

    <section class="tour cedarpg-acts" aria-label="How Cedar works">
      <div class="tour-inner tour-rows">
        <article class="tour-row" aria-labelledby="c-analyst">
          <div class="tour-row__text reveal-left">
            <h2 class="tour-row__title" id="c-analyst">
              Cedar prepares source material for review.
            </h2>
            <p class="tour-row__body">
              Upload PDFs, spreadsheets and prior analyses. Cedar extracts candidate inputs, flags
              unresolved questions and keeps source references attached so a person can approve each
              value before it enters the model.
            </p>
          </div>
          <figure class="tour-row__shot reveal-right" data-zoom>
            <img
              src="/app/cedar-wind-upload.webp"
              alt="Cedar reviewing uploaded wind-project documents and flagging one unresolved contract value."
              width="1920"
              height="1080"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="cedarpg-cap">
              The wind project&rsquo;s source documents uploading to Cedar, with a note about what
              to watch for. Shown with sample data.
            </figcaption>
          </figure>
        </article>
        <article class="tour-row tour-row--flip" aria-labelledby="c-work">
          <div class="tour-row__text reveal-right">
            <h2 class="tour-row__title" id="c-work">
              Review mappings and assumptions before the model runs.
            </h2>
            <p class="tour-row__body">
              Cedar proposes industry mappings and organizes inputs; Cedar Impact calculates results
              only after review. The same workspace then helps explain findings for a council,
              grantmaker or board without hiding the assumptions behind them.
            </p>
          </div>
          <figure class="tour-row__shot cedarpg-shot--dark reveal-left" data-zoom>
            <img
              src="/app/cedar-wind-entities-dark.webp"
              alt="Cedar showing three proposed wind-project operations and flagging an unresolved grid-interconnection value."
              width="1920"
              height="1080"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="cedarpg-cap">
              The same documents turned into operations. Cedar reports what is model ready and asks
              about the one figure still missing. Shown with sample data.
            </figcaption>
          </figure>
        </article>
        <article class="tour-row" aria-labelledby="c-org">
          <div class="tour-row__text reveal-left">
            <h2 class="tour-row__title" id="c-org">
              Keep organizational context with the project.
            </h2>
            <p class="tour-row__body">
              Cedar works from the source material and notes available within a project. Cedar
              Commons keeps projects, notes and collaborators together, while project permissions
              define who can open and change each analysis. Larger organizations can calibrate Cedar
              around their terminology and reporting needs.
            </p>
          </div>
          <figure class="tour-row__shot reveal-right" data-zoom>
            <img
              src="/app/cedar-context.webp"
              alt="Cedar Commons showing project updates, revised results and an external reviewer note."
              width="1920"
              height="1080"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="cedarpg-cap">
              Cedar answers from inside any project on the board: who re-ran what, how the figures
              moved, what a reviewer flagged. Shown with sample data.
            </figcaption>
          </figure>
        </article>
      </div>
    </section>

    {
      /* How it is built. Three short answers to the questions the three acts
         raise, as a band rather than three more sections with headings. Each
         answer stays visible and carries its own product-style line icon. */
    }
    <section class="meth-sec cedarpg-band" aria-labelledby="c-built">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 class="reveal-soft" id="c-built">Built for review, privacy and accountability.</h2>
        </div>
        <div class="cedarpg-facts">
          <div class="cedarpg-fact reveal-soft" data-stagger="1">
            <span class="cedarpg-fact__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.45">
                <path d="M4.5 8h6.2L16 16l5.3-8h6.2"></path>
                <path d="M4.5 24h6.2l5.3-8 5.3 8h6.2"></path>
                <path d="M8 5v6M24 5v6M8 21v6M24 21v6" stroke-width="1.2"></path>
              </svg>
            </span>
            <p class="h-kicker">Economic model</p>
            <h3 class="cedarpg-fact__t">AI does not calculate impact figures</h3>
            <p>
              Cedar organizes inputs and explains outputs. Cedar Impact performs the calculations
              with a deterministic input-output model and approved assumptions.
            </p>
          </div>
          <div class="cedarpg-fact reveal-soft" data-stagger="2">
            <span class="cedarpg-fact__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.45">
                <path d="M16 3.5 26 7.4v7.2c0 6.2-4.2 10.7-10 13-5.8-2.3-10-6.8-10-13V7.4Z"></path>
                <rect x="11.3" y="14.1" width="9.4" height="7.2" rx="1"></rect>
                <path d="M13.4 14.1v-2.3a2.6 2.6 0 0 1 5.2 0v2.3" stroke-width="1.2"></path>
              </svg>
            </span>
            <p class="h-kicker">Customer data</p>
            <h3 class="cedarpg-fact__t">Terms are documented before sensitive records move</h3>
            <p>
              During private beta, access, retention, deletion, AI-provider use and subprocessors
              are documented during procurement. Read the <a class="inline-link" href="/security"
                >current security status</a
              >.
            </p>
          </div>
          <div class="cedarpg-fact reveal-soft" data-stagger="3">
            <span class="cedarpg-fact__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.45">
                <path d="m5 9 11-5 11 5-11 5Z"></path>
                <path d="m5 14.5 11 5 11-5M5 20l11 5 11-5"></path>
                <path d="M10.5 10.8v8.4M16 13.8v8.4M21.5 10.8v8.4" stroke-width="1.1"></path>
              </svg>
            </span>
            <p class="h-kicker">Human review</p>
            <h3 class="cedarpg-fact__t">People approve inputs and assumptions</h3>
            <p>
              Cedar helps extract, organize and classify candidate inputs from source material.
              Those inputs remain reviewable before they enter an analysis; once approved, Cedar
              Impact applies the <a class="inline-link" href="/methodology"
                >documented methodology</a
              >.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="meth-mission" aria-labelledby="c-close">
      <div class="meth-w">
        <h2 class="meth-mission__title" id="c-close">
          Cedar supports each analysis while <span class="brand-em"
            >approval stays with the person running it</span
          >.
        </h2>
        <p class="meth-mission__lede">
          Source material, proposed inputs, assumptions and final calculations remain available for
          human review throughout the workflow.
        </p>
        <div class="meth-mission__cta">
          <a class="btn2 btn2--primary" href="/signup?tier=free">
            Request beta access <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn2 btn2--card" href="/ai-and-data-use">
            Read AI and data use <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer isHome={false} />
</BaseLayout>
