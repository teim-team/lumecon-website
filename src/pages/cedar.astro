    <script is:inline>
      /* Diagrams draw in when they enter the viewport: nodes rise, lines
         draw, then the ripples and connector flow start. Decorative only;
         under reduced motion the CSS shows the finished diagram and this
         class changes nothing. */
      (function () {
        var figs = document.querySelectorAll('[data-diagram]');
        if (!('IntersectionObserver' in window)) {
          figs.forEach(function (f) {
            f.classList.add('dg2-in');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('dg2-in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.3 },
        );
        figs.forEach(function (f) {
          io.observe(f);
        });
      })();
    </script>
