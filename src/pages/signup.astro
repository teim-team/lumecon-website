---
/**
 * /signup — account creation, mirroring the product's registration
 * flow (AuthGate in teim-app) so this page can become the one place
 * accounts are created while the app moves toward login-only:
 *
 *   Step 1 "Who you are"  — name, organization or nation, role chips
 *   Step 2 "Your account" — email + password (12+ chars, 3 of 4
 *                            character classes, live strength meter)
 *
 * The role list and password rules are copied from the app verbatim
 * so an account created here is exactly what the product expects.
 * Submission posts through lib/api.ts to `POST /v1/auth/signup` when
 * PUBLIC_API_URL is set; otherwise the fallback captures the details
 * through the contact endpoint so early-access requests still reach
 * the team.
 *
 * Layout: mirrored split-screen auth, the product's sign-in screen
 * as the reference. Signup puts the form on the LEFT and the teal
 * brand panel on the RIGHT, the deliberate mirror of /login. Keep
 * the two pages visual counterparts when editing either.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AuthBrandPanel from '../components/AuthBrandPanel.astro';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/auth.css';
import '../styles/auth-split.css';

// Kept in sync with ROLE_OPTIONS in the product (src/pages/accountModel.js).
const ROLE_OPTIONS = [
  'Tribal Council Member or Elected Leader',
  'Tribal Administrator',
  'Tribal Treasurer or Finance Officer',
  'Economic Development Director',
  'Consultant',
  'Government Analyst',
  'Researcher/Academic',
  'Other',
];
---

<BaseLayout
  title="Sign up | Lumecon"
  description="Create a free Lumecon account and build an economic impact analysis end to end. For governments, universities, nonprofits, businesses and Tribal Nations; full results unlock on any plan."
  canonical="https://lumecon.ai/signup"
  keywords="Lumecon signup, Lumecon sign up, Lumecon create account, economic impact analysis account, IMPLAN alternative signup"
  cedar={false}
>
  <Nav />
  <main class="asplit asplit--signup" id="top" tabindex="-1">
    <div class="asplit-formcol">
      <div class="asplit-forminner">
        <span class="asplit-ic" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="10" cy="8" r="4"></circle>
            <path d="M3 21c0-3.9 3.1-7 7-7 1.2 0 2.4 0.3 3.4 0.9"></path>
            <path d="M18 14v6"></path>
            <path d="M15 17h6"></path>
          </svg>
        </span>
        <h1 class="asplit-title">Create your Lumecon account</h1>
        <p class="asplit-tagline">Two quick steps: who you are, then your account credentials.</p>
        <!-- If /signup arrived from a pricing tier CTA, the URL query
             carries tier= and this badge reflects the chosen plan back
             at the visitor. Hidden by default; the inline script below
             reveals it if the query is present. -->
        <p class="auth-plan" data-auth-plan hidden>
          <span class="auth-plan__label">Plan</span>
          <span class="auth-plan__value" data-auth-plan-value></span>
          <a class="auth-plan__change" href="/pricing">Change plan</a>
        </p>

        <ol class="auth-steps" aria-label="Registration progress">
          <li class="auth-steps__item auth-steps__item--on" data-step-marker="1">
            <span class="auth-steps__num">1</span> Who you are
          </li>
          <li class="auth-steps__item" data-step-marker="2">
            <span class="auth-steps__num">2</span> Your account
          </li>
        </ol>

        <form class="auth-form" data-auth-form data-auth-kind="signup" novalidate>
          <input type="hidden" name="tier" data-auth-tier />
          <input type="hidden" name="role" data-auth-role />

          <fieldset class="auth-step" data-step-panel="1">
            <legend class="sr-only">Who you are</legend>
            <label class="auth-field">
              <span>Name</span>
              <input type="text" name="name" required autocomplete="name" maxlength="200" />
            </label>
            <label class="auth-field">
              <span>Organization or nation</span>
              <input
                type="text"
                name="organization"
                required
                autocomplete="organization"
                maxlength="200"
              />
            </label>
            <div class="auth-field">
              <span>Your role</span>
              <div class="auth-chips" role="group" aria-label="Your role">
                {
                  ROLE_OPTIONS.map((role) => (
                    <button type="button" class="auth-chip" data-role-chip aria-pressed="false">
                      {role}
                    </button>
                  ))
                }
              </div>
            </div>
          </fieldset>

          <fieldset class="auth-step" data-step-panel="2" hidden>
            <legend class="sr-only">Your account</legend>
            <label class="auth-field">
              <span>Work email</span>
              <input type="email" name="email" autocomplete="email" />
            </label>
            <label class="auth-field">
              <span>Password</span>
              <input
                type="password"
                name="password"
                autocomplete="new-password"
                minlength="12"
                aria-describedby="pwRules"
              />
            </label>
            <div class="pwmeter" data-pwmeter hidden>
              <div class="pwmeter__bars" data-pwmeter-bars data-level="0">
                <span></span><span></span><span></span><span></span>
              </div>
              <span class="pwmeter__label" data-pwmeter-label></span>
            </div>
            <ul class="pwrules" id="pwRules">
              <li data-pwrule="length">12 characters or more</li>
              <li data-pwrule="case">Upper and lower case</li>
              <li data-pwrule="number">A number</li>
              <li data-pwrule="symbol">A symbol</li>
            </ul>
          </fieldset>

          <label class="auth-attest" data-auth-attest-row hidden>
            <input type="checkbox" name="attest" data-auth-attest />
            <span>
              I am at least 18 years old and have authority to act for the organization identified
              above.
            </span>
          </label>

          <p class="auth-meta" data-auth-status role="status" aria-live="polite" hidden></p>

          <div class="auth-actions">
            <button type="submit" class="btn" data-auth-submit>Continue</button>
            <button type="button" class="auth-back" data-auth-back hidden>Back</button>
          </div>
        </form>

        <!-- Acceptance language is deliberately absent until counsel
             delivers the final documents: a signup flow must never
             claim agreement to Terms whose page says they are being
             prepared. When the documents ship, this line becomes the
             agree/acknowledge clause inside the attestation checkbox
             (with terms/privacy version stamping); see
             docs/legal/legal-framework-review.md, Part 5 items 1-2. -->
        <p class="auth-legal">
          Our <a href="/terms">Terms of Service</a>{' '}and{' '}
          <a href="/privacy">Privacy Policy</a> are being finalized with counsel; you will be asked to
          accept them before they take effect.
        </p>
        <p class="asplit-foot">
          Already have an account? <a href="/login">Log in</a>{' '}&middot;{' '}
          <a href="/pricing">Compare plans</a>
        </p>
      </div>
    </div>
    <AuthBrandPanel
      headline="Start with the full platform."
      lede="Every plan runs the same economic model. Bring your documents, build an analysis end to end and choose a plan when you are ready to unlock full results."
      points={[
        { icon: 'rings', text: 'Every supported geography' },
        { icon: 'loop', text: 'Unlimited analysis on paid plans' },
        { icon: 'sprout', text: 'Cedar included from the beginning' },
      ]}
    />
  </main>

  <script is:inline>
    /* Pricing -> Signup handoff. The pricing tier CTA links to
       /signup?tier=X (checkout's free path also carries email=).
       Read the query, fill the hidden field, and surface the plan
       badge so the choice visibly carries over. */
    (function () {
      var qs = new URLSearchParams(window.location.search);
      var tier = qs.get('tier');
      if (!tier) return;
      var tierName = { starter: 'Sprout', standard: 'Sapling', leader: 'Tree', free: 'Free trial' };
      // hasOwnProperty, not truthiness: a bare `tierName[tier]` resolves
      // inherited members like `constructor`/`__proto__` and would render
      // them into the badge. Only the four real tiers pass.
      if (!Object.prototype.hasOwnProperty.call(tierName, tier)) return;
      var badge = document.querySelector('[data-auth-plan]');
      var value = document.querySelector('[data-auth-plan-value]');
      var tierInput = document.querySelector('[data-auth-tier]');
      if (badge && value) {
        value.textContent = tierName[tier] + ' tier';
        badge.hidden = false;
      }
      if (tierInput) tierInput.value = tier;
    })();
  </script>

  <Footer />
</BaseLayout>

<script>
  import { submitSignup, submitContact, apiConfigured } from '../lib/api';
  import { trackEvent, trackError } from '../lib/observability';
  import { PASSWORD_RULES, evaluatePassword } from '../lib/passwordRules';
  import { getFlowEmail, rememberFlowEmail } from '../lib/flowState';

  function setStatus(el: HTMLElement | null, variant: 'ok' | 'err' | 'info', text: string): void {
    if (!el) return;
    el.textContent = text;
    el.hidden = false;
    el.classList.remove('auth-meta--ok', 'auth-meta--err');
    if (variant === 'ok') el.classList.add('auth-meta--ok');
    if (variant === 'err') el.classList.add('auth-meta--err');
  }

  function setup(): void {
    const form = document.querySelector<HTMLFormElement>('[data-auth-form]');
    if (!form) return;
    const status = form.querySelector<HTMLElement>('[data-auth-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-auth-submit]');
    const backBtn = form.querySelector<HTMLButtonElement>('[data-auth-back]');
    const roleInput = form.querySelector<HTMLInputElement>('[data-auth-role]');
    const panels = {
      1: form.querySelector<HTMLElement>('[data-step-panel="1"]'),
      2: form.querySelector<HTMLElement>('[data-step-panel="2"]'),
    };
    const markers = document.querySelectorAll<HTMLElement>('[data-step-marker]');
    // Email carried between flow steps lives in sessionStorage, never
    // in the URL (PII leaks into history, logs and analytics there).
    const flowEmail = getFlowEmail();
    const emailField = form.querySelector<HTMLInputElement>('input[name="email"]');
    if (emailField && flowEmail && !emailField.value) emailField.value = flowEmail;
    let step: 1 | 2 = 1;

    function showStep(next: 1 | 2): void {
      step = next;
      if (panels[1]) panels[1].hidden = next !== 1;
      if (panels[2]) panels[2].hidden = next !== 2;
      markers.forEach((m) => {
        const n = Number(m.dataset.stepMarker);
        m.classList.toggle('auth-steps__item--on', n === next);
        m.classList.toggle('auth-steps__item--done', n < next);
      });
      if (submitBtn) submitBtn.textContent = next === 1 ? 'Continue' : 'Create account';
      const attestRow = form?.querySelector<HTMLElement>('[data-auth-attest-row]');
      if (attestRow) attestRow.hidden = next !== 2;
      if (backBtn) backBtn.hidden = next === 1;
      if (status) status.hidden = true;
    }

    // Role chips: one selected at a time, mirrored into the hidden field.
    form.querySelectorAll<HTMLButtonElement>('[data-role-chip]').forEach((chip) => {
      chip.addEventListener('click', () => {
        form.querySelectorAll('[data-role-chip]').forEach((c) => {
          c.classList.remove('auth-chip--on');
          c.setAttribute('aria-pressed', 'false');
        });
        chip.classList.add('auth-chip--on');
        chip.setAttribute('aria-pressed', 'true');
        if (roleInput) roleInput.value = chip.textContent?.trim() ?? '';
      });
    });

    // Live strength meter + rule checklist, same tiers as the product.
    const pwInput = form.querySelector<HTMLInputElement>('input[name="password"]');
    const meter = form.querySelector<HTMLElement>('[data-pwmeter]');
    const meterBars = form.querySelector<HTMLElement>('[data-pwmeter-bars]');
    const meterLabel = form.querySelector<HTMLElement>('[data-pwmeter-label]');
    pwInput?.addEventListener('input', () => {
      const pw = pwInput.value;
      const { level, label } = evaluatePassword(pw);
      if (meter) meter.hidden = !pw;
      if (meterBars) meterBars.dataset.level = String(level);
      if (meterLabel) meterLabel.textContent = label;
      PASSWORD_RULES.forEach((rule) => {
        const li = form.querySelector(`[data-pwrule="${rule.key}"]`);
        li?.classList.toggle('pwrules--met', rule.test(pw));
      });
    });

    backBtn?.addEventListener('click', () => showStep(1));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const organization = String(data.get('organization') ?? '').trim();
      const role = String(data.get('role') ?? '').trim();

      if (step === 1) {
        // Step 1 collects the profile; advance rather than submit.
        if (!name) return setStatus(status, 'err', 'Enter your name.');
        if (!organization) return setStatus(status, 'err', 'Enter an organization.');
        if (!role) return setStatus(status, 'err', 'Choose your role.');
        showStep(2);
        return;
      }

      const email = String(data.get('email') ?? '').trim();
      const password = String(data.get('password') ?? '');
      if (!email) return setStatus(status, 'err', 'Enter your email.');
      if (!evaluatePassword(password).acceptable) {
        return setStatus(
          status,
          'err',
          'Strengthen your password to at least 12 characters with a mix of upper case, lower case, numbers or symbols.',
        );
      }
      const attest = form.querySelector<HTMLInputElement>('[data-auth-attest]');
      if (attest && !attest.checked) {
        return setStatus(
          status,
          'err',
          'Confirm that you are at least 18 and authorized to act for your organization.',
        );
      }

      submitBtn?.setAttribute('disabled', 'true');
      setStatus(status, 'info', 'One moment...');

      try {
        if (apiConfigured()) {
          const result = await submitSignup({ name, email, password, organization, role });
          if (result.ok) {
            trackEvent('auth.success', { kind: 'signup', role });
            const tier = String(data.get('tier') ?? '').trim();
            if (tier === 'free') {
              // Free trial: no payment step, no $0 checkout. Straight
              // to the success state and into the product.
              setStatus(status, 'ok', 'Account created. Taking you in...');
              setTimeout(() => {
                window.location.href = '/welcome?plan=free';
              }, 900);
              return;
            }
            rememberFlowEmail(email);
            if (tier) {
              // Plan already chosen on /pricing: go straight to the
              // payment step, which knows the plan.
              setStatus(status, 'ok', 'Account created. One step left: payment.');
              setTimeout(() => {
                window.location.href = `/checkout?tier=${tier}`;
              }, 900);
              return;
            }
            // No plan yet: the dedicated selection step, not checkout.
            setStatus(status, 'ok', 'Account created. Pick the plan that fits...');
            setTimeout(() => {
              window.location.href = '/choose-plan';
            }, 900);
            return;
          }
          if (result.reason !== 'api-unconfigured') {
            trackEvent('auth.fail', { kind: 'signup', reason: result.reason });
            setStatus(
              status,
              'err',
              'We could not complete that. Try again, or email contact@lumecon.ai.',
            );
            return;
          }
        }

        const contactRes = await submitContact({
          name: name || 'Lumecon early-access request',
          email,
          organization,
          message: `Early-access request via the signup page. Role: ${role || '(not provided)'}`,
          source: 'signup-page',
        });
        if (contactRes.ok) {
          setStatus(
            status,
            'ok',
            "Thanks, we've got your details. Someone from the team will set you up with access shortly.",
          );
          return;
        }
        const subject = encodeURIComponent('Lumecon early access');
        const body = encodeURIComponent(
          `Hi Lumecon team,\n\nI'd like to request access to Lumecon. Could you set me up?\n\nEmail: ${email}\n${organization ? 'Organization: ' + organization + '\n' : ''}`,
        );
        window.location.href = `mailto:contact@lumecon.ai?subject=${subject}&body=${body}`;
        setStatus(status, 'info', 'Opening your email client so you can reach us directly...');
      } catch (err: unknown) {
        trackError(err, { where: 'auth.submit', kind: 'signup' });
        setStatus(
          status,
          'err',
          'Something went wrong on our end. Try again in a moment, or email contact@lumecon.ai.',
        );
      } finally {
        submitBtn?.removeAttribute('disabled');
      }
    });

    showStep(1);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
</script>
