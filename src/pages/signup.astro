---
/**
 * /signup — the private-beta request page.
 *
 * Lumecon is in closed beta, so this page deliberately creates no
 * account and sets no password: a visitor cannot enter the app from
 * here yet. What it does is capture who is asking and what they want
 * to measure, so the team can reach out with access. The fields
 * mirror the product's registration profile (name, organization,
 * organization type, role) so the interest we capture converts into
 * a real account with nothing re-asked.
 *
 * Submission posts through lib/api.ts to `POST /v1/contact` when
 * PUBLIC_API_URL is set; otherwise it opens a prefilled email to
 * contact@lumecon.ai so the request still reaches the team.
 *
 * RECONCILIATION (queued): this page and /login are the site's own
 * stand-ins while the beta is closed. When the product connects, both
 * should hand off to (or embed) teim-app's AuthGate so there is one
 * account surface, one password policy and one session, and testing
 * flows from the marketing site straight into the app. The fields here
 * already mirror the product's registration profile to make that
 * reconciliation a swap rather than a rewrite.
 *
 * Layout: mirrored split-screen auth, the product's sign-in screen
 * as the reference. Signup puts the form on the LEFT and the teal
 * brand panel on the RIGHT, the deliberate mirror of /login. Keep
 * the two pages visual counterparts when editing either.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import AuthBrandPanel from '../components/AuthBrandPanel.astro';

const authYear = new Date().getFullYear();
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/auth.css';
import '../styles/auth-split.css';

// Kept in sync with ROLE_OPTIONS in the product (src/pages/accountModel.js).
// One shared role taxonomy for every organization type; the Tribal
// governance roles join it only when the organization identifies as a
// Tribal Nation (see the orgtype handler below), so other audiences are
// not led through another audience's org chart.
const TRIBAL_ROLE_OPTIONS = [
  'Tribal Council Member or Elected Leader',
  'Tribal Administrator',
  'Tribal Treasurer or Finance Officer',
];
const SHARED_ROLE_OPTIONS = [
  'Executive or Elected Leader',
  'Economic Development Director',
  'Finance or Budget Officer',
  'Consultant',
  'Government Analyst',
  'Researcher/Academic',
  'Other',
];

// Kept in sync with ORGANIZATION_TYPE_OPTIONS (src/pages/accountModel.js) and
// ORGANIZATION_TYPE_ENUM (server/index.js), so a captured request carries the
// same profile the product will ask for when the account is created.
const ORGANIZATION_TYPE_OPTIONS = [
  { value: 'tribal_nation', label: 'Tribal Nation or tribal government entity' },
  { value: 'alaska_native_corporation', label: 'Alaska Native Corporation' },
  { value: 'native_hawaiian_organization', label: 'Native Hawaiian Organization' },
  { value: 'government', label: 'City, county, state or federal government' },
  { value: 'university_research', label: 'University or research institution' },
  { value: 'nonprofit', label: 'Nonprofit or foundation' },
  { value: 'business', label: 'Business' },
  { value: 'consulting_firm', label: 'Consulting firm' },
  { value: 'other', label: 'Other' },
];
---

<BaseLayout
  title="Request beta access | Lumecon"
  description="Lumecon is in private beta. Tell us who you are and what you want to measure, and the team will reach out with access."
  canonical="https://lumecon.ai/signup"
  keywords="Lumecon signup, Lumecon beta, Lumecon early access, economic impact analysis account, IMPLAN alternative signup"
  cedar={false}
  bodyClass="auth-body"
>
  <Nav />
  <main class="asplit asplit--signup" id="top" tabindex="-1">
    <div class="asplit-formcol">
      <div class="asplit-forminner">
        <span class="asplit-ic" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="10" cy="8" r="4"></circle>
            <path d="M3 21c0-3.9 3.1-7 7-7 1.2 0 2.4 0.3 3.4 0.9"></path>
            <path d="M18 14v6"></path>
            <path d="M15 17h6"></path>
          </svg>
        </span>
        <h1 class="asplit-title">Lumecon is in private beta</h1>
        <p class="asplit-tagline">
          We are opening access in waves while we finish the work. Tell us who you are and what you
          want to measure, and the team will reach out with your access.
        </p>
        <!-- If /signup arrived from a pricing tier CTA, the URL query
             carries tier= and this badge reflects the chosen plan back
             at the visitor. Hidden by default; the inline script below
             reveals it if the query is present. -->
        <p class="auth-plan" data-auth-plan hidden>
          <span class="auth-plan__label">Plan</span>
          <span class="auth-plan__value" data-auth-plan-value></span>
          <a class="auth-plan__change" href="/pricing">Change plan</a>
        </p>

        <p class="auth-reqnote">
          Fields marked <span class="auth-req" aria-hidden="true">*</span> are required.
        </p>
        <form class="auth-form" data-auth-form data-auth-kind="beta-request" novalidate>
          <input type="hidden" name="tier" data-auth-tier />
          <input type="hidden" name="role" data-auth-role />

          <fieldset class="auth-step" data-step-panel="1">
            <legend class="sr-only">Who you are</legend>
            <label class="auth-field">
              <span>Name <span class="auth-req" aria-hidden="true">*</span></span>
              <input type="text" name="name" required autocomplete="name" maxlength="200" />
            </label>
            <label class="auth-field">
              <span>Work email <span class="auth-req" aria-hidden="true">*</span></span>
              <input type="email" name="email" required autocomplete="email" maxlength="200" />
            </label>
            <label class="auth-field">
              <span>Organization or nation <span class="auth-req" aria-hidden="true">*</span></span>
              <input
                type="text"
                name="organization"
                required
                autocomplete="organization"
                maxlength="200"
              />
            </label>
            <label class="auth-field">
              <span>Organization type <span class="auth-req" aria-hidden="true">*</span></span>
              <select name="organizationType" required data-auth-orgtype>
                <option value="">Select an organization type</option>
                {
                  ORGANIZATION_TYPE_OPTIONS.map((opt) => (
                    <option value={opt.value}>{opt.label}</option>
                  ))
                }
              </select>
            </label>
            <label class="auth-field" data-auth-tribal-row hidden>
              <span
                >Do you provide services for tribal clients? <span
                  class="auth-req"
                  aria-hidden="true">*</span
                ></span
              >
              <select name="servesTribalClients" data-auth-tribal>
                <option value="">Select one</option>
                <option value="yes">Yes, we serve tribal clients</option>
                <option value="no">No</option>
              </select>
            </label>
            <div class="auth-field">
              <span>Your role <span class="auth-req" aria-hidden="true">*</span></span>
              <div class="auth-chips" role="group" aria-label="Your role">
                {
                  TRIBAL_ROLE_OPTIONS.map((role) => (
                    <button
                      type="button"
                      class="auth-chip"
                      data-role-chip
                      data-tribal-role
                      aria-pressed="false"
                      hidden
                    >
                      {role}
                    </button>
                  ))
                }
                {
                  SHARED_ROLE_OPTIONS.map((role) => (
                    <button type="button" class="auth-chip" data-role-chip aria-pressed="false">
                      {role}
                    </button>
                  ))
                }
              </div>
            </div>
            <label class="auth-field">
              <span>What would you measure first?</span>
              <textarea
                name="interest"
                rows="3"
                maxlength="1000"
                placeholder="A project, a program, an enterprise, a budget cycle. A sentence is plenty."
              ></textarea>
            </label>
          </fieldset>

          <p class="auth-meta" data-auth-status role="status" aria-live="polite" hidden></p>

          <div class="auth-actions">
            <button type="submit" class="btn" data-auth-submit>Request access</button>
          </div>
        </form>

        <!-- Acceptance language is deliberately absent until counsel
             delivers the final documents: no agreement is claimed to
             Terms whose page says they are being prepared. See
             docs/legal/legal-framework-review.md, Part 5 items 1-2. -->
        <p class="auth-legal">
          Our <a href="/terms">Terms of Service</a>{' '}and{' '}
          <a href="/privacy">Privacy Policy</a> are being finalized with counsel; you will be asked to
          accept them before they take effect.
        </p>
        <p class="asplit-foot">
          Already have beta access? <a href="/login">Log in</a>{' '}&middot;{' '}
          <a href="/pricing">Compare plans</a>
        </p>
      </div>
    </div>
    <AuthBrandPanel
      headline="Access is opening in waves."
      lede="Every request goes to a person, not a queue. When your access is ready you get the full platform: bring your documents, build an analysis end to end and choose a plan when you are ready."
      points={[
        { icon: 'rings', text: 'Every supported geography' },
        { icon: 'loop', text: 'Unlimited analysis on paid plans' },
        { icon: 'sprout', text: 'Cedar included from the beginning' },
      ]}
    />
  </main>

  <script is:inline>
    /* Pricing -> Signup handoff. A pricing tier CTA links to /signup?tier=X
       and a standalone product CTA links to /signup?product=Y. Read
       whichever the query carries, fill the hidden field, and surface the
       badge so the choice visibly carries over into the access request
       instead of being silently dropped. Only announced products belong in
       this map; it ships in the page source. */
    (function () {
      var qs = new URLSearchParams(window.location.search);
      var tier = qs.get('tier');
      var product = qs.get('product');
      var tierName = { sprout: 'Sprout', sapling: 'Sapling', tree: 'Tree', free: 'Seed (free)' };
      var productName = { 'cedar-grove': 'Cedar Grove' };
      // hasOwnProperty, not truthiness: a bare `tierName[tier]` resolves
      // inherited members like `constructor`/`__proto__` and would render
      // them into the badge. Only the known tiers and products pass.
      var badgeText = null;
      var fieldValue = null;
      var changeHref = null;
      var isProduct = false;
      if (tier && Object.prototype.hasOwnProperty.call(tierName, tier)) {
        badgeText = tierName[tier] + ' tier';
        fieldValue = tier;
        changeHref = '/pricing';
      } else if (product && Object.prototype.hasOwnProperty.call(productName, product)) {
        badgeText = productName[product];
        fieldValue = product;
        isProduct = true;
        changeHref = product === 'cedar-grove' ? '/pricing#cedar-grove' : '/pricing';
      }
      if (!badgeText) return;
      var badge = document.querySelector('[data-auth-plan]');
      var value = document.querySelector('[data-auth-plan-value]');
      var tierInput = document.querySelector('[data-auth-tier]');
      var change = document.querySelector('.auth-plan__change');
      var label = document.querySelector('.auth-plan__label');
      if (badge && value) {
        value.textContent = badgeText;
        badge.hidden = false;
      }
      /* Cedar Grove is a standalone product, not a plan: the badge must not
         read "Plan Cedar Grove", and the change link should not promise a
         plan change. */
      if (isProduct) {
        if (label) label.textContent = 'Product';
        if (change) change.textContent = 'Change selection';
      }
      if (change && changeHref) change.setAttribute('href', changeHref);
      if (tierInput) tierInput.value = fieldValue;
    })();
  </script>

  <footer class="auth-foot">
    <span>© {authYear} Lumecon Inc.</span>
    <a href="/terms">Terms</a>
    <a href="/privacy">Privacy</a>
    <a href="mailto:contact@lumecon.ai">Contact</a>
  </footer>
</BaseLayout>

<script>
  import { submitContact, apiConfigured } from '../lib/api';
  import { trackEvent, trackError } from '../lib/observability';
  import { getFlowEmail } from '../lib/flowState';

  function setStatus(el: HTMLElement | null, variant: 'ok' | 'err' | 'info', text: string): void {
    if (!el) return;
    el.textContent = text;
    el.hidden = false;
    el.classList.remove('auth-meta--ok', 'auth-meta--err');
    if (variant === 'ok') el.classList.add('auth-meta--ok');
    if (variant === 'err') el.classList.add('auth-meta--err');
  }

  function setup(): void {
    const form = document.querySelector<HTMLFormElement>('[data-auth-form]');
    if (!form) return;
    // `data-auth-ready` is stamped on this form once setup returns (see the
    // bottom of this script). The smoke test waits on it rather than sleeping:
    // before it appears, step 2's fields are in the document and merely
    // unstyled, so asserting on them races the script.
    const status = form.querySelector<HTMLElement>('[data-auth-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-auth-submit]');
    const roleInput = form.querySelector<HTMLInputElement>('[data-auth-role]');

    // Email carried from an earlier flow step lives in sessionStorage,
    // never in the URL (PII leaks into history, logs and analytics there).
    const flowEmail = getFlowEmail();
    const emailField = form.querySelector<HTMLInputElement>('input[name="email"]');
    if (emailField && flowEmail && !emailField.value) emailField.value = flowEmail;

    // Role chips: one selected at a time, mirrored into the hidden field.
    form.querySelectorAll<HTMLButtonElement>('[data-role-chip]').forEach((chip) => {
      chip.addEventListener('click', () => {
        form.querySelectorAll('[data-role-chip]').forEach((c) => {
          c.classList.remove('auth-chip--on');
          c.setAttribute('aria-pressed', 'false');
        });
        chip.classList.add('auth-chip--on');
        chip.setAttribute('aria-pressed', 'true');
        if (roleInput) roleInput.value = chip.textContent?.trim() ?? '';
      });
    });

    // Organization type drives two conditionals. Consulting firms are asked
    // whether they serve tribal clients (it gates Whole Nation analysis and
    // is the affiliation signal); the row is hidden for every other type.
    // Tribal Nations get the Tribal governance roles added to the shared
    // role list; if one was selected and the org type changes away, the
    // selection clears so a hidden chip can't stay silently chosen.
    const orgTypeSelect = form.querySelector<HTMLSelectElement>('[data-auth-orgtype]');
    const tribalRow = form.querySelector<HTMLElement>('[data-auth-tribal-row]');
    const tribalSelect = form.querySelector<HTMLSelectElement>('[data-auth-tribal]');
    const syncOrgTypeConditionals = () => {
      const isConsulting = orgTypeSelect?.value === 'consulting_firm';
      if (tribalRow) tribalRow.hidden = !isConsulting;
      if (!isConsulting && tribalSelect) tribalSelect.value = '';

      const isTribalNation = orgTypeSelect?.value === 'tribal_nation';
      form.querySelectorAll<HTMLButtonElement>('[data-tribal-role]').forEach((chip) => {
        chip.hidden = !isTribalNation;
        if (!isTribalNation && chip.classList.contains('auth-chip--on')) {
          chip.classList.remove('auth-chip--on');
          chip.setAttribute('aria-pressed', 'false');
          if (roleInput) roleInput.value = '';
        }
      });
    };
    orgTypeSelect?.addEventListener('change', syncOrgTypeConditionals);
    // form.reset() restores the select and hidden inputs without firing
    // change (and a programmatic reset() dispatches no reset event), so the
    // Tribal-only chips and their pressed state would survive a successful
    // submission; the submit handler calls this right after resetting.
    const resetConditionalUi = () => {
      form.querySelectorAll('[data-role-chip]').forEach((c) => {
        c.classList.remove('auth-chip--on');
        c.setAttribute('aria-pressed', 'false');
      });
      syncOrgTypeConditionals();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const organization = String(data.get('organization') ?? '').trim();
      const organizationType = String(data.get('organizationType') ?? '').trim();
      const role = String(data.get('role') ?? '').trim();
      const interest = String(data.get('interest') ?? '').trim();
      const tier = String(data.get('tier') ?? '').trim();
      const tribalRaw = String(data.get('servesTribalClients') ?? '').trim();

      if (!name) return setStatus(status, 'err', 'Enter your name.');
      if (!email) return setStatus(status, 'err', 'Enter your work email.');
      if (!organization) return setStatus(status, 'err', 'Enter an organization.');
      if (!organizationType) return setStatus(status, 'err', 'Select an organization type.');
      if (organizationType === 'consulting_firm' && !tribalRaw)
        return setStatus(status, 'err', 'Let us know whether you serve tribal clients.');
      if (!role) return setStatus(status, 'err', 'Choose your role.');

      submitBtn?.setAttribute('disabled', 'true');
      setStatus(status, 'info', 'One moment...');

      // The whole profile rides in the message body so the request is
      // actionable from the inbox alone, whichever transport carries it.
      const lines = [
        'Beta access request via the signup page.',
        `Role: ${role}`,
        `Organization type: ${organizationType}`,
        tribalRaw ? `Serves tribal clients: ${tribalRaw}` : '',
        tier ? `${tier === 'cedar-grove' ? 'Product interest' : 'Plan interest'}: ${tier}` : '',
        interest ? `Wants to measure: ${interest}` : '',
      ].filter(Boolean);

      try {
        if (apiConfigured()) {
          const res = await submitContact({
            name,
            email,
            organization,
            message: lines.join('\n'),
            source: 'signup-page',
          });
          if (res.ok) {
            trackEvent('beta.request', { role, organizationType, tier: tier || '(none)' });
            setStatus(
              status,
              'ok',
              'Thanks, you are on the list. Someone from the team will reach out with your access.',
            );
            form.reset();
            resetConditionalUi();
            return;
          }
        }
        // No backend (or it failed): a prefilled email keeps the request
        // moving instead of dead-ending the visitor.
        const subject = encodeURIComponent('Lumecon beta access');
        const body = encodeURIComponent(
          `Hi Lumecon team,\n\nI would like access to the Lumecon beta.\n\nName: ${name}\nEmail: ${email}\nOrganization: ${organization}\n${lines.slice(1).join('\n')}\n`,
        );
        window.location.href = `mailto:contact@lumecon.ai?subject=${subject}&body=${body}`;
        setStatus(status, 'info', 'Opening your email client so you can reach us directly...');
      } catch (err: unknown) {
        trackError(err, { where: 'beta.request' });
        setStatus(
          status,
          'err',
          'Something went wrong on our end. Try again in a moment, or email contact@lumecon.ai.',
        );
      } finally {
        submitBtn?.removeAttribute('disabled');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setup();
      document.querySelector('[data-auth-form]')?.setAttribute('data-auth-ready', 'true');
    });
  } else {
    setup();
    document.querySelector('[data-auth-form]')?.setAttribute('data-auth-ready', 'true');
  }
</script>
