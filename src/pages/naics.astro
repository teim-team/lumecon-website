---
/**
 * /naics — every two-digit NAICS sector Lumecon classifies against, plus
 * the platform's tribal government category, each as a brand-washed tile
 * whose plain-language description reveals on hover or focus.
 *
 * Data comes from scripts/naics/sectors.mjs, the same file the duotone
 * thumbnail pipeline reads, so tile colors and copy cannot drift from the
 * generated study thumbnails. Until a sector has a processed photograph
 * in public/naics/<slug>-sm.webp, its tile renders as a duotone field in
 * the sector's wash; the build picks up each photo automatically once the
 * pipeline has produced it.
 */
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site as siteConfig } from '../config';
import { SECTORS, TRIBAL_GOVERNMENT, WASHES } from '../../scripts/naics/sectors.mjs';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';

const site = siteConfig.url;
const description =
  'The 20 NAICS sectors and the Tribal Government category Lumecon classifies economic activity into, and why the model works at the two-digit level.';

// process.cwd() is the project root under both `astro dev` and `astro
// build`; import.meta.url points at the compiled chunk during build and
// would miss public/ entirely.
const publicDir = `${process.cwd()}/public`;
const tiles = [...SECTORS, TRIBAL_GOVERNMENT].map((s) => ({
  ...s,
  colors: WASHES[s.wash as keyof typeof WASHES],
  photo: existsSync(`${publicDir}/naics/${s.slug}-sm.webp`) ? `/naics/${s.slug}-sm.webp` : null,
}));

const rgb = (c: number[]) => `rgb(${c[0]}, ${c[1]}, ${c[2]})`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Industry sectors', item: `${site}/naics` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    '@id': `${site}/naics`,
    name: 'Two-digit NAICS sectors',
    url: `${site}/naics`,
    hasDefinedTerm: tiles.map((t) => ({
      '@type': 'DefinedTerm',
      termCode: t.code,
      name: t.title,
      description: t.description,
      inDefinedTermSet: `${site}/naics`,
    })),
  },
];
---

<BaseLayout
  title="Industry sectors | Lumecon"
  description={description}
  canonical="https://lumecon.ai/naics"
  jsonLd={jsonLd}
>
  <Nav isHome={false} />
  <main class="meth" id="top" tabindex="-1">
    <header class="meth-hero">
      <div class="meth-w" data-reveal-group>
        <p class="h-kicker">Reference</p>
        <h1 class="meth-hero__title">
          The sectors behind <span class="brand-em">every number</span>.
        </h1>
        <p class="meth-hero__lede">
          Lumecon classifies economic activity at the two-digit NAICS sector level, because county
          and state employment and wage data are more complete there. That reduces, but does not
          eliminate, the estimation standing in for suppressed and missing values. Open a sector to
          see what belongs to it, and read{' '}
          <a class="gloss-link" href="/methodology#m-naics">why two digits</a> in the methodology.
        </p>
      </div>
    </header>

    <section class="meth-sec" aria-label="Sectors">
      <div class="meth-w" data-reveal-group>
        <ul class="naics-grid" role="list">
          {
            tiles.map((t) => (
              <li
                class="naics-tile"
                id={`naics-${t.slug}`}
                tabindex="0"
                style={`--wash-shadow: ${rgb(t.colors.shadow)}; --wash-mid: ${rgb(t.colors.mid)}; --wash-hi: ${rgb(t.colors.highlight)};`}
              >
                <div class="naics-tile__media" aria-hidden="true">
                  {t.photo ? (
                    <img src={t.photo} alt="" width="600" height="400" loading="lazy" />
                  ) : (
                    <div class="naics-tile__field" />
                  )}
                  <span class="naics-tile__code">{t.code}</span>
                </div>
                <div class="naics-tile__bar">
                  <h2 class="naics-tile__title">{t.title}</h2>
                </div>
                <p class="naics-tile__desc">{t.description}</p>
              </li>
            ))
          }
        </ul>
        <p class="gloss-foot">
          Tribal Government is a Lumecon category rather than a NAICS sector. NAICS files tribal
          governments under local government within Public Administration (92); we track them as
          their own category because a nation operates as a government, an employer and an
          enterprise owner at once. For definitions of the terms used in results, see the{' '}
          <a class="gloss-link" href="/glossary">glossary</a>.
        </p>
      </div>
    </section>
  </main>
  <Footer isHome={false} />
</BaseLayout>

<style>
  .meth {
    background: transparent;
  }
  .meth-hero {
    padding-bottom: clamp(2.8rem, 5vw, 4.5rem);
    background: linear-gradient(145deg, #ffffff 0%, #f8fafb 56%, #edf3f4 100%);
    border-bottom: 1px solid var(--rule);
  }
  .meth-hero .meth-w {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(28rem, 1.18fr);
    column-gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }
  .meth-hero .h-kicker,
  .meth-hero__title,
  .meth-hero__lede {
    grid-column: 1;
  }
  .meth-hero__title {
    max-width: 14ch;
    font-size: clamp(3rem, 4.8vw, 4.7rem);
    line-height: 0.99;
  }
  .meth-hero__lede {
    margin-bottom: 0;
  }
  .meth-hero .meth-w::after {
    content: '';
    grid-column: 2;
    grid-row: 1 / 4;
    min-height: clamp(22rem, 31vw, 29rem);
    background: url('/naics/manufacturing-v2-wide.webp') center / cover no-repeat;
    border: 1px solid var(--rule);
    border-radius: var(--radius-frame);
    box-shadow: var(--shadow-surface-high);
  }
  .naics-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: clamp(0.8rem, 1.3vw, 1.15rem);
  }
  .naics-tile {
    position: relative;
    border: 1px solid var(--rule, rgba(10, 15, 38, 0.12));
    grid-column: span 3;
    border-radius: var(--radius-frame);
    overflow: hidden;
    background: #09132b;
    outline: none;
    box-shadow: var(--shadow-surface);
  }
  .naics-tile:nth-child(1),
  .naics-tile:nth-child(8),
  .naics-tile:nth-child(15) {
    grid-column: span 6;
  }
  .naics-tile:nth-child(1) .naics-tile__media,
  .naics-tile:nth-child(8) .naics-tile__media,
  .naics-tile:nth-child(15) .naics-tile__media {
    aspect-ratio: 3 / 1;
  }
  .naics-tile:focus-visible {
    box-shadow: 0 0 0 3px rgba(15, 181, 165, 0.35);
  }
  .naics-tile__media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  .naics-tile__media img,
  .naics-tile__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .naics-tile__media img {
    transform: scale(1.01);
    transition: transform 0.65s var(--ease);
  }
  .naics-tile:hover .naics-tile__media img,
  .naics-tile:focus-within .naics-tile__media img {
    transform: scale(1.045);
  }
  /* Placeholder until the sector's processed photograph exists: the same
     duotone ramp the pipeline applies, as a quiet field. */
  .naics-tile__field {
    background:
      radial-gradient(120% 150% at 18% 0%, var(--wash-hi) 0%, transparent 42%),
      linear-gradient(158deg, var(--wash-mid) 0%, var(--wash-shadow) 96%);
  }
  .naics-tile__code {
    position: absolute;
    left: 0.85rem;
    bottom: 0.55rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.7rem;
    letter-spacing: 0.04em;
    color: var(--wash-hi);
    text-shadow: 0 1px 8px rgba(7, 10, 26, 0.35);
  }
  .naics-tile__bar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    padding: 0.8rem 0.95rem 0.85rem;
    /* Stays above the hover overlay so the sector name never dims. */
    z-index: 1;
    background: rgba(6, 18, 40, 0.76);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
  }
  .naics-tile__title {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: #fff;
    /* Two lines' worth of room whether the name needs one or two. Sector
       names run from "Utilities" to "Mining, Quarrying, and Oil and Gas
       Extraction", so without this the white bar was 44px under the short
       ones and 62px under the long ones, and a row of tiles ended on a
       ragged bottom edge. */
    min-height: calc(2 * 1.35em);
  }
  /* The description slides over the media on hover or keyboard focus. */
  .naics-tile__desc {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 1rem 1.05rem 4.8rem;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--wash-hi);
    background: color-mix(in srgb, var(--wash-shadow) 88%, transparent);
    backdrop-filter: blur(12px) saturate(118%);
    -webkit-backdrop-filter: blur(12px) saturate(118%);
    opacity: 0;
    transition: opacity 0.22s ease;
    display: flex;
    align-items: flex-start;
    overflow-y: auto;
    pointer-events: none;
  }
  .naics-tile:hover .naics-tile__desc,
  .naics-tile:focus-visible .naics-tile__desc,
  .naics-tile:focus-within .naics-tile__desc {
    opacity: 1;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .naics-tile__desc,
    .naics-tile__media img {
      transition: none;
    }
    .naics-tile:hover .naics-tile__media img,
    .naics-tile:focus-within .naics-tile__media img {
      transform: none;
    }
  }
  /* Touch screens have no hover: show the description under the tile. */
  @media (hover: none) {
    .naics-tile {
      background: var(--surface);
    }
    .naics-tile__bar {
      position: relative;
    }
    .naics-tile__desc {
      position: static;
      opacity: 1;
      pointer-events: auto;
      background: none;
      color: var(--ink-2, #353b5c);
      padding: 0 0.85rem 0.9rem;
    }
  }
  @media (max-width: 1050px) {
    .meth-hero .meth-w {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 1fr);
    }
    .naics-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .naics-tile {
      grid-column: span 3;
    }
    .naics-tile:nth-child(1),
    .naics-tile:nth-child(8),
    .naics-tile:nth-child(15) {
      grid-column: span 6;
    }
  }
  @media (max-width: 760px) {
    .meth-hero .meth-w {
      grid-template-columns: 1fr;
    }
    .meth-hero .meth-w::after {
      grid-column: 1;
      grid-row: 4;
      min-height: clamp(15rem, 65vw, 22rem);
      margin-top: 1.8rem;
    }
  }
  @media (max-width: 640px) {
    .naics-grid {
      grid-template-columns: 1fr;
    }
    .naics-tile,
    .naics-tile:nth-child(1),
    .naics-tile:nth-child(8),
    .naics-tile:nth-child(15) {
      grid-column: auto;
    }
    .naics-tile:nth-child(1) .naics-tile__media,
    .naics-tile:nth-child(8) .naics-tile__media,
    .naics-tile:nth-child(15) .naics-tile__media {
      aspect-ratio: 3 / 2;
    }
  }
  @media (prefers-color-scheme: dark) {
    .meth-hero {
      background: linear-gradient(145deg, #171d3e 0%, #111833 56%, #0c2a31 100%);
    }
  }
  .gloss-foot {
    margin: 2.2rem 0 0;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--ink-2);
    max-width: 46rem;
  }
  .gloss-link {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }
</style>
