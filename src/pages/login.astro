---
/**
 * RECONCILIATION (queued): this page is the site's stand-in while the
 * beta is closed. When the product connects, it should hand off to
 * teim-app's AuthGate (see the matching note in signup.astro) so there
 * is one account surface and one session across site and app.
 */
/**
 * /login — sign in, wired the way the product's AuthGate works:
 *
 *   login  — email + password, posting to the app's POST /auth/login
 *   forgot — "Forgot password?" swaps the form to an email-only
 *            request that posts to POST /auth/password-reset-request
 *   reset  — arriving with ?reset_token=... opens straight onto the
 *            new-password form (product password rules + strength
 *            meter) and posts to POST /auth/password-reset
 *
 * All three post through lib/api.ts when PUBLIC_API_URL is set;
 * while it is unset the handlers fall back to the same friendly
 * early-access capture as /signup.
 *
 * Layout: mirrored split-screen auth, the product's sign-in screen
 * as the reference. Login puts the teal brand panel on the LEFT
 * (continuity, returning to work); /signup mirrors it. Keep the two
 * pages visual counterparts when editing either.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import AuthBrandPanel from '../components/AuthBrandPanel.astro';

const authYear = new Date().getFullYear();
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/auth.css';
import '../styles/auth-split.css';
---

<BaseLayout
  title="Log in | Lumecon"
  description="Log in to your Lumecon account."
  canonical="https://lumecon.ai/login"
  keywords="Lumecon login, Lumecon sign in, economic impact analysis login"
  bodyClass="auth-body"
>
  <Nav />
  <main class="asplit asplit--login" id="top" tabindex="-1">
    <AuthBrandPanel
      headline="Pick up where you left off."
      lede="Your analyses, organizational context, Cedar and reporting tools stay together in Lumecon."
      points={[
        { icon: 'archive', text: 'Your analyses and prior work stay with your organization' },
        { icon: 'rings', text: 'Cedar carries approved context across projects' },
        { icon: 'trace', text: 'Every result remains traceable through the model' },
      ]}
    />
    <div class="asplit-formcol">
      <div class="asplit-forminner">
        <span class="asplit-ic" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3"></path>
            <path d="M4 12h11"></path>
            <path d="M9 8l4 4-4 4"></path>
          </svg>
        </span>
        <h1 class="asplit-title" data-login-title>Log in to Lumecon</h1>
        <p class="asplit-tagline" data-login-sub>
          Welcome back. Enter your work email to continue.
        </p>

        <form class="auth-form" data-login-form novalidate>
          <label class="auth-field" data-login-field="email">
            <span>Work email</span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              placeholder="you@organization.gov"
            />
          </label>
          <label class="auth-field" data-login-field="password">
            <span data-login-pw-label>Password</span>
            <input type="password" name="password" autocomplete="current-password" />
          </label>
          <div class="pwmeter" data-pwmeter hidden>
            <div class="pwmeter__bars" data-pwmeter-bars data-level="0">
              <span></span><span></span><span></span><span></span>
            </div>
            <span class="pwmeter__label" data-pwmeter-label></span>
          </div>
          <ul class="pwrules" id="pwRules" data-login-pwrules hidden>
            <li data-pwrule="length">12 characters or more</li>
            <li data-pwrule="case">Upper and lower case</li>
            <li data-pwrule="number">A number</li>
            <li data-pwrule="symbol">A symbol</li>
          </ul>
          <div class="auth-row" data-login-row>
            <a href="#" data-login-forgot>Forgot password?</a>
          </div>
          <p class="auth-meta" data-auth-status role="status" aria-live="polite" hidden></p>
          <div class="auth-actions">
            <button type="submit" class="btn" data-login-submit>Log in</button>
            <button type="button" class="auth-back" data-login-back hidden>Back to sign in</button>
          </div>
        </form>

        <!-- Google sign-in stays secondary, and stays hidden until
             PUBLIC_API_URL is configured (the OAuth origin decision
             is founder-owned; see README). -->
        <div class="asplit-sso" data-google-wrap hidden>
          <div class="asplit-or" aria-hidden="true"><span>or</span></div>
          <a class="asplit-google" data-google-btn href="#">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path
                d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.716v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"
                fill="#4285F4"></path>
              <path
                d="M9 18c2.43 0 4.467-.806 5.956-2.185l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"
                fill="#34A853"></path>
              <path
                d="M3.964 10.706A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.706V4.962H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.038l3.007-2.332z"
                fill="#FBBC05"></path>
              <path
                d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.962L3.964 7.294C4.672 5.163 6.656 3.58 9 3.58z"
                fill="#EA4335"></path>
            </svg>
            Continue with Google
          </a>
        </div>

        <p class="asplit-foot">
          New to Lumecon? <a href="/signup">Create an account</a>
        </p>
      </div>
    </div>
  </main>
  <footer class="auth-foot">
    <span>© {authYear} Lumecon Inc.</span>
    <a href="/terms">Terms</a>
    <a href="/privacy">Privacy</a>
    <a href="mailto:contact@lumecon.ai">Contact</a>
  </footer>
</BaseLayout>

<script>
  import {
    submitLogin,
    requestPasswordReset,
    resetPassword,
    submitContact,
    apiConfigured,
  } from '../lib/api';
  import { trackEvent, trackError } from '../lib/observability';
  import { PASSWORD_RULES, evaluatePassword } from '../lib/passwordRules';

  type Mode = 'login' | 'forgot' | 'reset';

  function setStatus(el: HTMLElement | null, variant: 'ok' | 'err' | 'info', text: string): void {
    if (!el) return;
    el.textContent = text;
    el.hidden = false;
    el.classList.remove('auth-meta--ok', 'auth-meta--err');
    if (variant === 'ok') el.classList.add('auth-meta--ok');
    if (variant === 'err') el.classList.add('auth-meta--err');
  }

  function setup(): void {
    const form = document.querySelector<HTMLFormElement>('[data-login-form]');
    if (!form) return;
    const resetToken = new URLSearchParams(window.location.search).get('reset_token') || '';
    let mode: Mode = resetToken ? 'reset' : 'login';

    const status = form.querySelector<HTMLElement>('[data-auth-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-login-submit]');
    const backBtn = form.querySelector<HTMLButtonElement>('[data-login-back]');
    const emailField = form.querySelector<HTMLElement>('[data-login-field="email"]');
    const pwField = form.querySelector<HTMLElement>('[data-login-field="password"]');
    const pwLabel = form.querySelector<HTMLElement>('[data-login-pw-label]');
    const pwInput = form.querySelector<HTMLInputElement>('input[name="password"]');
    const row = form.querySelector<HTMLElement>('[data-login-row]');
    const rules = form.querySelector<HTMLElement>('[data-login-pwrules]');
    const meter = form.querySelector<HTMLElement>('[data-pwmeter]');
    const meterBars = form.querySelector<HTMLElement>('[data-pwmeter-bars]');
    const meterLabel = form.querySelector<HTMLElement>('[data-pwmeter-label]');
    const title = document.querySelector<HTMLElement>('[data-login-title]');
    const sub = document.querySelector<HTMLElement>('[data-login-sub]');

    /* Google SSO points at the product API's OAuth entry. Until
       PUBLIC_API_URL is set for production the button stays hidden
       so the page never offers a dead sign-in path. */
    const ssoWrap = document.querySelector<HTMLElement>('[data-google-wrap]');
    const googleBtn = document.querySelector<HTMLAnchorElement>('[data-google-btn]');
    const apiBase = (import.meta.env.PUBLIC_API_URL || '').replace(/\/+$/, '');
    const ssoAvailable = Boolean(apiBase && googleBtn);
    if (ssoAvailable && googleBtn) googleBtn.href = `${apiBase}/auth/google`;

    function apply(next: Mode): void {
      mode = next;
      const isLogin = next === 'login';
      const isForgot = next === 'forgot';
      const isReset = next === 'reset';
      if (emailField) emailField.hidden = isReset;
      if (pwField) pwField.hidden = isForgot;
      if (pwLabel) pwLabel.textContent = isReset ? 'New password' : 'Password';
      if (pwInput) pwInput.autocomplete = isLogin ? 'current-password' : 'new-password';
      if (row) row.hidden = !isLogin;
      if (rules) rules.hidden = !isReset;
      if (meter) meter.hidden = true;
      if (backBtn) backBtn.hidden = isLogin;
      if (ssoWrap) ssoWrap.hidden = !isLogin || !ssoAvailable;
      if (submitBtn)
        submitBtn.textContent = isLogin
          ? 'Log in'
          : isForgot
            ? 'Send reset link'
            : 'Set new password';
      if (title)
        title.textContent = isLogin
          ? 'Log in to Lumecon'
          : isForgot
            ? 'Reset your password'
            : 'Choose a new password';
      if (sub)
        sub.textContent = isLogin
          ? 'Welcome back. Enter your work email to continue.'
          : isForgot
            ? 'We will email you a link to reset your password.'
            : 'Choose a new password for your account.';
      if (status) status.hidden = true;
    }

    form.querySelector('[data-login-forgot]')?.addEventListener('click', (e) => {
      e.preventDefault();
      apply('forgot');
    });
    backBtn?.addEventListener('click', () => apply('login'));

    pwInput?.addEventListener('input', () => {
      if (mode !== 'reset') return;
      const pw = pwInput.value;
      const { level, label } = evaluatePassword(pw);
      if (meter) meter.hidden = !pw;
      if (meterBars) meterBars.dataset.level = String(level);
      if (meterLabel) meterLabel.textContent = label;
      PASSWORD_RULES.forEach((rule) => {
        form
          .querySelector(`[data-pwrule="${rule.key}"]`)
          ?.classList.toggle('pwrules--met', rule.test(pw));
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const password = String(data.get('password') ?? '');

      if (mode !== 'reset' && !email) return setStatus(status, 'err', 'Enter your email.');
      if (mode === 'login' && !password) return setStatus(status, 'err', 'Enter your password.');
      if (mode === 'reset' && !evaluatePassword(password).acceptable) {
        return setStatus(
          status,
          'err',
          'Use at least 12 characters with a mix of upper case, lower case, numbers or symbols.',
        );
      }

      submitBtn?.setAttribute('disabled', 'true');
      setStatus(status, 'info', 'One moment...');

      try {
        if (apiConfigured()) {
          if (mode === 'forgot') {
            const res = await requestPasswordReset(email);
            if (res.ok) {
              setStatus(status, 'ok', 'If that email has an account, a reset link is on its way.');
              return;
            }
          } else if (mode === 'reset') {
            const res = await resetPassword(resetToken, password);
            if (res.ok) {
              apply('login');
              setStatus(status, 'ok', 'Password updated. Sign in with your new password.');
              return;
            }
            if (res.reason !== 'api-unconfigured') {
              setStatus(
                status,
                'err',
                'That reset link is no longer valid. Request a new one from "Forgot password?".',
              );
              return;
            }
          } else {
            const result = await submitLogin({ email, password });
            if (result.ok) {
              trackEvent('auth.success', { kind: 'login' });
              /* The product origin. Only promise a redirect we can
                 actually perform; PUBLIC_APP_URL is set alongside
                 PUBLIC_API_URL when the app goes to production. */
              const appUrl = (import.meta.env.PUBLIC_APP_URL || '').replace(/\/+$/, '');
              if (appUrl) {
                setStatus(status, 'ok', 'Logged in. Taking you to your workspace...');
                window.location.href = appUrl;
              } else {
                setStatus(status, 'ok', 'Logged in.');
              }
              return;
            }
            if (result.reason !== 'api-unconfigured') {
              trackEvent('auth.fail', { kind: 'login', reason: result.reason });
              setStatus(
                status,
                'err',
                'We could not sign you in. Check your email and password, or reset your password.',
              );
              return;
            }
          }
        }

        /* api-unconfigured: capture the request so the team can help. */
        const contactRes = await submitContact({
          name: 'Lumecon early-access request',
          email: email || 'unknown',
          message:
            mode === 'forgot' || mode === 'reset'
              ? 'Password help requested via the login page.'
              : 'Early-access request via the login page.',
          source: 'login-page',
        });
        if (contactRes.ok) {
          setStatus(
            status,
            'ok',
            "Thanks, we've got your details. Someone from the team will help you shortly.",
          );
          return;
        }
        const subject = encodeURIComponent('Lumecon account help');
        const body = encodeURIComponent(
          `Hi Lumecon team,\n\nI need help with my account.\n\nEmail: ${email}\n`,
        );
        window.location.href = `mailto:contact@lumecon.ai?subject=${subject}&body=${body}`;
        setStatus(status, 'info', 'Opening your email client so you can reach us directly...');
      } catch (err: unknown) {
        trackError(err, { where: 'auth.submit', kind: mode });
        setStatus(
          status,
          'err',
          'Something went wrong on our end. Try again in a moment, or email contact@lumecon.ai.',
        );
      } finally {
        submitBtn?.removeAttribute('disabled');
      }
    });

    apply(mode);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
</script>
