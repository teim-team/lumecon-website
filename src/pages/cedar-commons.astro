---
/**
 * /cedar-commons — Cedar Commons, the shared project workspace.
 *
 * WHAT THIS PAGE MAY CLAIM
 * Every capability described here was read off the branch that is being
 * incorporated (`claude/landing-page-collections-redesign-07dx8v` in the app
 * repository), not off a design or a conversation. The routes behind each
 * claim:
 *
 *   - a project has participants beyond its owner, added by email with a
 *     role, listed and removed  ->  GET/POST /projects/:projectId/participants,
 *     DELETE /projects/:projectId/participants/:userId
 *   - the role is `collaborator` or `viewer`, from that route's own body
 *     schema. (Workspace roles are a separate set: admin, member, viewer.)
 *   - notes on a project, append-only  ->  GET/POST /projects/:projectId/notes,
 *     and migration 024, "a note is not edited or deleted"
 *   - Cedar answers inside a project  ->  /projects/:projectId/cedar/messages
 *   - documents belong to the project's intake draft, which is what Cedar
 *     reads  ->  migration 005, `draft_project_id`
 *   - the board's participant avatars, note counts, status tabs and search
 *     ->  src/pages/workspaceProjectsModel.js
 *   - a project you do not own names the organization sponsoring it
 *     ->  `sponsorName` in that same model
 *
 * WHAT THIS PAGE MAY NOT CLAIM, AND WHY
 * Assigning data requests and tracking approvals are proposals. They exist
 * in no route on that branch, checked directly. They are the natural next
 * step and they are discussed in `docs/analysis-readiness.md`, but a
 * product page is not where a proposal goes. Nothing here says a request
 * can be assigned, an approval tracked, or a decision recorded as its own
 * object: what exists is an append-only note thread, and that is what the
 * page describes.
 *
 * THE HERO SHOT
 * `/app/cedar-context.webp` is a real capture of the running board, driven
 * by a mocked API from `scripts/screenshots/capture-cedar-page.mjs`, the
 * same convention as every other app shot on this site. It shows an owner's
 * own board. It should be re-shot from the incorporating branch with
 * participants and notes in the fixtures, so the hero shows collaborators
 * rather than implying them; the capture script already drives
 * `/app/workspace` and only needs participants in its PROJECTS fixture.
 *
 * RELATIONSHIP TO /start
 * The starting guide helps an organization prepare. This page shows where
 * the work happens once they have. Each links to the other once. The
 * readiness checklist is not repeated here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';
import '../styles/tour.css';
import '../styles/cedar-page.css';
import '../styles/commons-page.css';

const description =
  'Cedar Commons is the shared project workspace in Lumecon. Bring the people who hold the records into the analysis that needs them, each with access suited to their part, and keep the documents, questions and notes with the project.';

/* What a person can actually do, each line answerable by a route. */
const CONTRIBUTIONS = [
  {
    who: 'The project lead',
    what: 'Opens the project, brings people in by email and keeps track of what is still unanswered.',
    access: 'Owner',
  },
  {
    who: 'Finance, payroll and operations',
    what: 'Supply the records the analysis is built from, and answer questions about how a figure was produced.',
    access: 'Collaborator',
  },
  {
    who: 'Leadership',
    what: 'Reads the analysis and the thread behind it without needing to change anything.',
    access: 'Viewer',
  },
  {
    who: 'An outside economist or consultant',
    what: 'Works in the project with the organization, on the same records and the same assumptions.',
    access: 'Collaborator',
  },
];

/* Every item here is a real surface. Nothing aspirational. */
const CONNECTED = [
  {
    k: 'The people on it',
    b: 'A project carries its own participants rather than every person in the organization. You add someone by email, give them a collaborator or viewer role, and remove them when their part is done.',
  },
  {
    k: 'The documents',
    b: 'What was uploaded during intake belongs to that project, so the source material and the figures drawn from it do not drift apart or end up in two different places.',
  },
  {
    k: 'The questions',
    b: 'A question about a figure is asked where the figure lives, against that project’s own material, rather than in a separate thread nobody can find later.',
  },
  {
    k: 'The notes',
    b: 'A project has a note thread, and it is append-only: a note is not edited or deleted. What was said about an assumption stays readable next to the analysis it shaped.',
  },
];

const CASES = [
  {
    kicker: 'An organization coordinating its own analysis',
    title: 'Finance holds one set of records, the enterprises hold others.',
    body: 'The project lead opens the analysis and brings in the people who can reach each set. Leadership joins as a viewer to follow it without being asked to operate anything. The records, the questions and the notes stay in one project, so nobody is reconstructing from an inbox when a figure is questioned six months later.',
  },
  {
    kicker: 'A consultant working with a client',
    title: 'The consultant runs the project. The client owns the records.',
    body: 'The consultant opens the project and invites the client’s finance and operations people to it, and only to it. A project the client does not own names the organization sponsoring it, so nobody is confused about whose subscription is paying or whose work they are looking at.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Cedar Commons, the shared project workspace | Lumecon',
    url: `${site.url}/cedar-commons`,
    description,
    isPartOf: { '@id': `${site.url}#website` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Cedar Commons', item: `${site.url}/cedar-commons` },
    ],
  },
];
---

<BaseLayout
  title="Cedar Commons, the shared project workspace | Lumecon"
  description={description}
  canonical="https://lumecon.ai/cedar-commons"
  jsonLd={jsonLd}
>
  <Nav isHome={false} />
  <main class="meth cedarpg" id="top" tabindex="-1">
    <header class="meth-hero cedarpg-hero section--dark">
      <div class="meth-w">
        <p class="h-kicker reveal-soft">Cedar Commons</p>
        <h1 class="meth-hero__title reveal-soft" data-stagger="1">
          An analysis is finished by more than one person.
        </h1>
        <p class="meth-hero__lede reveal-soft" data-stagger="2">
          Finance holds one set of records, the enterprises hold others, and someone has to keep it
          moving. Cedar Commons is the shared project workspace: bring those people into the
          analysis that needs them, each with access suited to their part, and keep the documents,
          the questions and the notes with the project rather than scattered across inboxes.
        </p>
        <div class="cedarpg-cta reveal-soft" data-stagger="3">
          <a class="btn2 btn2--primary" href="/signup?tier=free">
            Request free access <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <figure class="cedarpg-hero__screen reveal-soft" data-stagger="3" data-zoom>
          <img
            src="/app/cedar-context.webp"
            alt="The Cedar Commons board, showing the shared projects an organization has access to, each card carrying its status and the comment activity on it. Shown with sample data."
            width="1920"
            height="1200"
            decoding="async"
          />
          <figcaption>
            The projects an organization is working on, in one place. Shown with sample data.
          </figcaption>
        </figure>
      </div>
    </header>

    <section class="meth-sec" aria-labelledby="cm-team">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="cm-team">How the team contributes</h2>
          <p class="meth-sec__lede">
            A project carries its own people rather than everyone in the organization, so nobody is
            handed access to work that is not theirs.
          </p>
        </div>
        <ul class="cm-roles" role="list">
          {
            CONTRIBUTIONS.map((c) => (
              <li class="cm-roles__row">
                <p class="cm-roles__who">
                  {c.who} <span class="cm-roles__access">{c.access}</span>
                </p>
                <p class="cm-roles__what">{c.what}</p>
              </li>
            ))
          }
        </ul>
        <p class="cm-note">
          A role is set when you add someone and can be changed or removed later. Collaborators
          contribute to the analysis; viewers read it. Cedar works inside a project for whoever is
          on it, within what their role allows:{' '}
          <a class="inline-link" href="/cedar">how Cedar works</a>.
        </p>
      </div>
    </section>

    <section class="meth-sec cm-sec--surface" aria-labelledby="cm-connected">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="cm-connected">How the work stays connected</h2>
          <p class="meth-sec__lede">
            The reason a figure can still be defended a year later is that the material behind it
            never left the project.
          </p>
        </div>
        <dl class="cm-connected">
          {
            CONNECTED.map((c) => (
              <div>
                <dt>{c.k}</dt>
                <dd>{c.b}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="meth-sec" aria-labelledby="cm-cases">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="cm-cases">Two ways it is used</h2>
        </div>
        <div class="cm-cases">
          {
            CASES.map((c) => (
              <article class="cm-case">
                <p class="h-kicker">{c.kicker}</p>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="meth-sec cm-sec--surface" aria-labelledby="cm-plans">
      <div class="meth-w">
        <div class="cm-plans">
          <div>
            <p class="h-kicker">Included, not sold separately</p>
            <h2 id="cm-plans">Cedar Commons comes with Sapling and Tree.</h2>
            <p>
              Sapling includes it for up to ten people in one organization. Tree includes it across
              the organization, with no seat limit. There is no separate Commons purchase, and
              nothing here is an add-on.
            </p>
            <p class="cm-plans__links">
              <a class="inline-link" href="/pricing">Compare plans</a>
              <span aria-hidden="true">&middot;</span>
              <a class="inline-link" href="/start">Plan your first analysis</a>
            </p>
            <p class="cm-plans__note">
              The starting guide helps you prepare: the first question, the records, and who can
              approve sharing them. This is where that work happens once you have.
            </p>
          </div>
          <ul class="cm-plans__tiers" role="list">
            <li class="cm-plans__tier">
              <b>Seed and Sprout</b>
              <span>One person. Cedar Impact and Cedar, without shared projects.</span>
            </li>
            <li class="cm-plans__tier">
              <b>Sapling</b>
              <span>Cedar Commons for up to ten people in one organization.</span>
            </li>
            <li class="cm-plans__tier">
              <b>Tree</b>
              <span>Cedar Commons across the organization, with no seat limit, beside Cedar Grove.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
