---
/**
 * /cedar-commons — Cedar Commons, the shared project workspace.
 *
 * WHAT THIS PAGE IS FOR, AND WHY IT IS NOT THE OTHER THREE
 * Cedar Impact, Cedar and Cedar Grove are all things one person operates.
 * Between them they already argue that records, assumptions and evidence
 * stay attached to the work ("Keep records, assumptions and results in one
 * reviewable workflow", "Keep organizational context with the project", "A
 * figure should not leave its evidence behind"). An earlier version of this
 * page made a fourth version of that argument and was, correctly, called
 * undifferentiated.
 *
 * Commons is the only surface in Lumecon about PEOPLE WHO ARE NOT YOU: the
 * ones holding records you cannot reach, and the authority to release them.
 * So the page argues access and contribution, and leaves "the material stays
 * with the analysis" to the pages that own it. Cedar gets one sentence and a
 * link; the model gets none.
 *
 * WHAT THIS PAGE MAY CLAIM
 * Every capability here was read off the branch being incorporated
 * (`claude/landing-page-collections-redesign-07dx8v`, open as teim-app#163),
 * not off a design or a conversation. The routes behind each claim:
 *
 *   - participants beyond the owner, added by email with BOTH a role and a
 *     kind, listed and removed  ->  GET/POST /projects/:projectId/participants,
 *     DELETE /projects/:projectId/participants/:userId
 *   - the two axes: `kind` internal|external and `role` collaborator|viewer
 *     beside the owner, from that route's own body schema and from migration
 *     027, which states what each means. Organization membership is a
 *     separate set (admin, member, viewer).
 *   - the Collaborators view splits the two rosters and reports a role per
 *     project, "Varies by project" when they differ  ->  src/pages/Workspace.jsx
 *   - a seat is one person, counted across memberships, non-owner project
 *     participants and pending invites  ->  server/lib/organizationSeats.js
 *     countOrganizationSeats. This is why the page says an outside
 *     collaborator occupies a seat: the server enforces exactly that.
 *   - records belong to the project rather than to whoever uploaded them
 *     ->  GET/POST /projects/:projectId/documents and migration 030
 *     (teim-app#172). Before that change a document was reachable only
 *     through its uploader, so this page could not have described it.
 *   - Cedar answers inside a project  ->  /projects/:projectId/cedar/messages
 *   - a note thread  ->  GET/POST /projects/:projectId/notes, and migration
 *     024, "a note is not edited or deleted"
 *   - a project you do not own names the organization sponsoring it
 *     ->  `sponsorName` in src/pages/workspaceProjectsModel.js
 *
 * WHAT THIS PAGE MAY NOT CLAIM, AND WHY
 * Assigning data requests and tracking approvals are proposals. They exist
 * in no route, checked directly. They are the natural next step and they are
 * discussed in `docs/analysis-readiness.md`, but a product page is not where
 * a proposal goes. Nothing here says a request can be assigned, an approval
 * tracked, or a decision recorded as its own object. Implementation words
 * stay out of the selling copy too: the note thread's append-only guarantee
 * is real and is stated in plain words, because "append-only" is the
 * implementation's name for it and belongs in detailed help.
 *
 * FOUR CAPTURES, NOT NINE
 * An earlier pass carried nine. Each was real, but most of them showed a
 * drawer that made a point the prose already made, and the page read as an
 * inventory. These four each do a job no other frame does:
 *   commons-board-org             several analyses, several people on each
 *   commons-collaborators         an organization's two rosters, and its seats
 *   commons-collaborators-consultant  the same screen, a consultancy's shape
 *   commons-documents             records contributed by three different people
 * The middle two are the two states of one control, which is the comparison
 * only this page can make.
 *
 * THE SCREENSHOTS THEMSELVES
 * Every frame is the running application, driven by a mocked API from
 * `scripts/screenshots/capture-commons.mjs` and cut by
 * `optimize-commons.mjs`. That script refuses to write a frame whose board
 * failed to load, that contains a broken image, or whose seat meter fell
 * back to counting members alone — so a retry state, a missing brand mark
 * or a wrong seat count cannot reach this page.
 *
 * RELATIONSHIP TO /start
 * The starting guide helps an organization prepare. This page shows where
 * the work happens once they have. Each links to the other once.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import { SEED, PLANS, PLAN_TABLE_ROWS } from '../data/pricing';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';
import '../styles/tour.css';
import '../styles/cedar-page.css';
import '../styles/commons-page.css';

const description =
  'Cedar Commons is the shared project workspace in Lumecon. Bring the people who hold the records into the analysis that needs them, each with access suited to their part, and keep the records, the questions and the notes with the project.';

/* The two axes, which the product really has and which a single list of
   "roles" hides. `kind` answers whose organization someone belongs to;
   `role` answers what they can do on one project. */
const AXES = [
  {
    k: 'Whose organization they belong to',
    field: 'Internal or external',
    b: 'Internal is someone working for or on behalf of the organization sponsoring the analysis. External is a client, a partner or an outside advisor. An external collaborator reaches the one project they were invited to and nothing else in the organization.',
  },
  {
    k: 'What they can do on that project',
    field: 'Owner, collaborator or viewer',
    b: 'The owner adds someone by email and decides what they may do. A collaborator contributes. A viewer reads and changes nothing. The same person can be a collaborator on one project and a viewer on another, and the roster reports it per project rather than averaging it into one label.',
  },
];

/* The same surface, two shapes of team. This is the one comparison only
   Cedar Commons can make: every other product page shows a thing you
   operate alone. Two states, one control, two real captures. */
const SHAPES = [
  {
    id: 'organization',
    tab: 'Our organization',
    title: 'The records are spread across your own offices.',
    body: 'Finance holds one set, the enterprises hold others, and a board member or outside counsel may need to read the result without touching it. Four staff here, two outside people, and each outside person is bound to the single project they were brought in for.',
    shot: '/app/commons-collaborators.webp',
    alt: 'An organization’s collaborator view: four internal people with their permissions, and two external people, each listed with the one project they can reach. Shown with sample data.',
    cap: 'Prairie Wind, on Tree. The external roster names the project beside each person, so the boundary is readable rather than assumed.',
  },
  {
    id: 'consultancy',
    tab: 'A consultancy and its clients',
    title: 'The records belong to someone who is not you at all.',
    body: 'A consultant opens a project per engagement and brings that client’s finance and operations people into it, and only into it. One client’s contacts never see another client’s work, and a project the client does not own names the organization sponsoring it, so nobody is unsure whose subscription is paying.',
    shot: '/app/commons-collaborators-consultant.webp',
    alt: 'A consultancy’s collaborator view: one internal person and three client contacts across two different clients, each listed with the single project they can reach. Shown with sample data.',
    cap: 'Ferreira, on Sapling. Three client contacts from two clients, four of ten seats in use — an outside collaborator occupies a seat, the same as a colleague.',
  },
];

/* What a person who is not you actually does once they are in. Three of
   these are one line each on purpose: Cedar has its own page and the
   analysis has its own page, and re-arguing either here would be borrowing
   their argument. Only the first carries a capture, because contributing a
   record is the thing no other surface in Lumecon does. */
const CONTRIBUTIONS = [
  {
    k: 'They add the records you do not hold',
    b: 'A record lands on the project, not in one person’s library, with the contributor and the date on it. Everyone on the project sees what is already there, so nobody sends the payroll summary twice.',
  },
  {
    k: 'They answer questions about them',
    b: 'Cedar works inside the project, for whoever is on it and within what their access allows, so a question about a figure is asked where the figure is.',
  },
  {
    k: 'They settle what the figure means',
    b: 'Which payroll summary is the audited one, what the scope actually is, why a contract was held back. The thread keeps it, rather than letting it be edited into something tidier later.',
  },
];

/* Plan inclusion, read from the pricing source rather than restated here, so
   a price or a seat count can never drift from /pricing. */
const ALL_PLANS = [SEED, ...PLANS];
const COMMONS_ROW = PLAN_TABLE_ROWS.find((r) => r.label === 'Cedar Commons');
const PLAN_LINES = ALL_PLANS.map((plan, i) => ({
  name: plan.name,
  price: plan.price,
  /* `plan.users` rather than the comparison table's Users row: that row is
     written for a table cell ("1"), and reads as a stray numeral in prose. */
  users: plan.users,
  commons: COMMONS_ROW?.values[i] ?? '',
  included: !(COMMONS_ROW?.values[i] ?? '').startsWith('Not included'),
}));
const FIRST_INCLUDED = PLAN_LINES.find((p) => p.included);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Cedar Commons, the shared project workspace | Lumecon',
    url: `${site.url}/cedar-commons`,
    description,
    isPartOf: { '@id': `${site.url}#website` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Cedar Commons', item: `${site.url}/cedar-commons` },
    ],
  },
];
---

<BaseLayout
  title="Cedar Commons, the shared project workspace | Lumecon"
  description={description}
  canonical="https://lumecon.ai/cedar-commons"
  jsonLd={jsonLd}
>
  <Nav isHome={false} />
  <main class="meth cedarpg" id="top" tabindex="-1">
    <header class="meth-hero cedarpg-hero section--dark">
      <div class="meth-w">
        <p class="h-kicker reveal-soft">Cedar Commons</p>
        <h1 class="meth-hero__title reveal-soft" data-stagger="1">
          An analysis is finished by more than one person.
        </h1>
        <p class="meth-hero__lede reveal-soft" data-stagger="2">
          The payroll figures sit with finance. The headcounts sit with operations. Whether either
          can leave the building at all sits with somebody else again. Cedar Commons is where those
          people join the analysis that needs them, each reaching the one project they were invited
          to and nothing else.
        </p>
        <div class="cedarpg-cta reveal-soft" data-stagger="3">
          <a class="btn2 btn2--primary" href="/signup?tier=free">
            Request free access <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <figure class="cedarpg-hero__screen reveal-soft" data-stagger="3" data-zoom>
          <img
            src="/app/commons-board-org.webp"
            alt="The Cedar Commons board: three shared analyses, each carrying its status, the people on it and the records and notes it holds. Shown with sample data."
            width="1920"
            height="1200"
            decoding="async"
          />
          <figcaption>
            The analyses an organization is working on, in one place. Shown with sample data.
          </figcaption>
        </figure>
      </div>
    </header>

    <section class="meth-sec" aria-labelledby="cm-team">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="cm-team">Who can see what</h2>
          <p class="meth-sec__lede">
            Access is granted project by project, never organization-wide. Two things decide it,
            and they are independent of each other.
          </p>
        </div>

        <dl class="cm-axes__list">
          {
            AXES.map((a) => (
              <div class="cm-axes__row">
                <dt>
                  {a.k}
                  <span class="cm-axes__field">{a.field}</span>
                </dt>
                <dd>{a.b}</dd>
              </div>
            ))
          }
        </dl>

        {/* Two states of one surface. Every other product page shows
            something you operate alone, so this comparison — the same
            screen, two shapes of team — is the one only this page can
            make. Ships expanded with the controls disabled; the script
            collapses and enables them. */}
        <div class="cm-surf" data-surf>
          <div class="cm-surf__tabs" role="list">
            {
              SHAPES.map((x, i) => (
                <button
                  type="button"
                  class="cm-surf__tab"
                  disabled
                  data-surf-tab={x.id}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`surf-${x.id}`}
                >
                  {x.tab}
                </button>
              ))
            }
          </div>

          <div class="cm-surf__panels">
            {
              SHAPES.map((x) => (
                <article class="cm-surf__panel" id={`surf-${x.id}`} data-surf-panel={x.id}>
                  <div class="cm-surf__copy">
                    <h3>{x.title}</h3>
                    <p>{x.body}</p>
                  </div>
                  <figure class="cm-figure" data-zoom>
                    <img src={x.shot} alt={x.alt} width="1920" height="1200" loading="lazy" decoding="async" />
                    <figcaption>{x.cap} Shown with sample data.</figcaption>
                  </figure>
                </article>
              ))
            }
          </div>
        </div>

        <p class="cm-note">
          An outside collaborator occupies a seat on your plan, the same as a colleague, and the
          seat is released when you remove them. Sapling is ten people in one organization however
          they are split between staff and outside contributors; Tree has no limit.{' '}
          <a class="inline-link" href="/pricing">Compare plans</a>.
        </p>
      </div>
    </section>

    <section class="meth-sec cm-sec--surface" aria-labelledby="cm-connected">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="cm-connected">What they do once they are in</h2>
          <p class="meth-sec__lede">
            You are asking people for things you do not have. What they hand over arrives on the
            project rather than in your inbox.
          </p>
        </div>

        <div class="cm-give">
          <dl class="cm-give__list">
            {
              CONTRIBUTIONS.map((c) => (
                <div class="cm-give__row">
                  <dt>{c.k}</dt>
                  <dd>{c.b}</dd>
                </div>
              ))
            }
          </dl>
          <figure class="cm-figure" data-zoom>
            <img
              src="/app/commons-documents.webp"
              alt="The records panel on a shared analysis, listing four spreadsheets contributed by three different people, each with the contributor, the date, the size and its state. Shown with sample data."
              width="1920"
              height="1200"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              Four records on one analysis, from three people. A viewer reads them and adds none.
              Shown with sample data.
            </figcaption>
          </figure>
        </div>

        <p class="cm-note">
          Working with a consultant?{' '}
          <a class="inline-link" href="/start">Share the starting guide with them</a>, or begin a
          project together in Lumecon.
        </p>
      </div>
    </section>

    <section class="meth-sec cm-sec--surface" aria-labelledby="cm-plans">
      <div class="meth-w">
        <div class="cm-plans">
          <div>
            <p class="h-kicker">Included, not sold separately</p>
            <h2 id="cm-plans">
              Cedar Commons comes with {FIRST_INCLUDED?.name} and above.
            </h2>
            <p>
              There is no separate Commons purchase and nothing here is an add-on. The difference
              between the plans that include it is how many people can be in your organization, not
              how much of the workspace you get.
            </p>
            <p class="cm-plans__links">
              <a class="inline-link" href="/pricing">Compare plans</a>
            </p>
            {/* One link to the starting guide on this page, and it is the
                consultant line in the section above: the guide prepares an
                organization, this page shows where the work happens once
                they have, and each page points at the other once. */}
            <p class="cm-plans__note">
              The starting guide helps you prepare: the first question, the records, and who can
              approve sharing them. This is where that work happens once you have.
            </p>
          </div>
          <ul class="cm-plans__tiers" role="list">
            {
              PLAN_LINES.map((p) => (
                <li class={`cm-plans__tier${p.included ? '' : ' cm-plans__tier--out'}`}>
                  <b>
                    {p.name} <span class="cm-plans__price">{p.price}</span>
                  </b>
                  <span>{p.commons}</span>
                  <span class="cm-plans__users">{p.users}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    /* The four surfaces. Everything ships open, so with no script the section
       reads as four described capabilities rather than four unlabelled words;
       the class added here is what collapses it into a picker. Same shape as
       /start's capability panels and Cedar Grove's atlas: a disclosure set,
       one open at a time, with `aria-expanded` maintained on the control.

       Pointer, touch and keyboard all reach it. The controls are real
       buttons, so a tap is a click and Enter and Space already activate
       them; the arrow-key handler below adds the movement a reader expects
       of a strip of related controls. */
    const surf = document.querySelector<HTMLElement>('[data-surf]');
    if (surf) {
      surf.classList.add('cm-surf--js');
      const tabs = Array.from(surf.querySelectorAll<HTMLButtonElement>('[data-surf-tab]'));
      /* The tabs ship disabled. Without this script every panel is open and
         the tabs have nothing to do, so offering four focusable controls
         that answer nothing would just be four dead tab stops. */
      for (const tab of tabs) tab.removeAttribute('disabled');
      const panels = Array.from(surf.querySelectorAll<HTMLElement>('[data-surf-panel]'));
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      const show = (id: string) => {
        for (const tab of tabs) {
          tab.setAttribute('aria-expanded', String(tab.dataset.surfTab === id));
        }
        for (const panel of panels) {
          panel.hidden = panel.dataset.surfPanel !== id;
        }
        /* On a phone the tab strip and the panel do not fit together, so the
           answer to a tap can land below the fold and the page looks like it
           did nothing. `nearest` only scrolls when the panel is actually out
           of view, so this is a no-op on a desktop. */
        const open = panels.find((panel) => !panel.hidden);
        open?.scrollIntoView({
          block: 'nearest',
          behavior: reduced.matches ? 'auto' : 'smooth',
        });
      };

      for (const [i, tab] of tabs.entries()) {
        tab.addEventListener('click', () => show(tab.dataset.surfTab as string));
        tab.addEventListener('keydown', (event: KeyboardEvent) => {
          const step =
            event.key === 'ArrowRight' || event.key === 'ArrowDown'
              ? 1
              : event.key === 'ArrowLeft' || event.key === 'ArrowUp'
                ? -1
                : 0;
          if (!step) return;
          event.preventDefault();
          const next = tabs[(i + step + tabs.length) % tabs.length];
          next.focus();
          show(next.dataset.surfTab as string);
        });
      }

      /* The initial state is set directly rather than through `show`, which
         scrolls. Landing on the page should not move it. */
      if (tabs[0]) {
        const first = tabs[0].dataset.surfTab;
        for (const tab of tabs) tab.setAttribute('aria-expanded', String(tab.dataset.surfTab === first));
        for (const panel of panels) panel.hidden = panel.dataset.surfPanel !== first;
      }
    }
  </script>
</BaseLayout>
