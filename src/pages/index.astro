---
import { site } from '../config';
import { FOUNDERS } from '../data/team';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import EconomicPlaces from '../components/EconomicPlaces.astro';
import WhyBand from '../components/WhyBand.astro';
import ProductTour from '../components/ProductTour.astro';
import Edge from '../components/Edge.astro';
import FinalCta from '../components/FinalCta.astro';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';

// The audiences the retired per-domain entry points used to describe,
// kept as a plain list for the Service JSON-LD. One platform, one
// audience string; the Cedar products adapt to the organization type.
const AUDIENCES = [
  'Municipalities, state agencies and public institutions',
  'Tribal governments and departments, federally and state-recognized tribes, intertribal organizations, tribal colleges, Native nonprofits, ANCs, NHOs, tribal enterprises, Native CDFIs, Native-entity federal contractors',
  'Universities, foundations and nonprofits',
  'Businesses and developers',
  'Consulting firms and independent professionals running economic impact analyses on behalf of outside clients',
];

// The homepage carried an 11-question FAQPage node, 681 words of answers,
// emitted only as JSON-LD with nothing rendered on the page. It is gone.
//
// Google's structured data guidelines require marked-up content to be
// visible to the user, and invisible markup is listed under its spam
// policies, where the documented consequence is a manual action that
// makes a site ineligible for rich results. Against that risk there was
// no upside left to weigh: since August 2023 Google shows FAQ rich
// results only for well-known government and health sites, which this is
// not. Zero available benefit against a live guideline violation on the
// most important page is a bad trade in both directions.
//
// The questions themselves are not lost. /pricing and /methodology both
// carry FAQPage markup whose answers ARE rendered on the page, which is
// the pattern done correctly, and llms.txt states the same facts for
// retrieval systems.

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': ['Organization', 'SoftwareApplication'],
    '@id': `${site.url}#org`,
    name: site.legalName,
    legalName: site.legalName,
    alternateName: ['Lumecon', 'Lumecon.ai', site.name],
    disambiguatingDescription:
      'Lumecon Inc. builds the intelligent economic analysis platform, headquartered online at lumecon.ai. Not affiliated with any unrelated trademark-similar businesses in other industries.',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Economic Impact Analysis Software',
    operatingSystem: 'Web',
    url: site.url,
    logo: `${site.url}/brand/lumecon-logo-mark-transparent.png`,
    image: `${site.url}/lumecon-og-image-1200x630.png`,
    description:
      'Lumecon Inc. builds the intelligent economic analysis platform. Cedar Impact turns budgets, financial statements, payroll and program records into traceable economic impact analyses, with Cedar, the AI economic analyst, in every plan. Built by economists, engineers and researchers with experience at the Federal Reserve and leading universities. Private beta access is opening in waves.',
    email: site.email,
    slogan: site.tagline,
    naics: '541512',
    industry: 'Economic Impact Analysis Software',
    mainEntityOfPage: site.url,
    contactPoint: {
      '@type': 'ContactPoint',
      email: site.email,
      contactType: 'sales and support',
      availableLanguage: 'English',
    },
    sameAs: ['https://www.linkedin.com/company/lumecon-ai'],
    foundingLocation: { '@type': 'Place', name: site.builtAt },
    founder: FOUNDERS.map((p) => ({
      '@type': 'Person',
      name: p.name,
      jobTitle: p.title,
    })),
    knowsAbout: [
      'Economic Impact Analysis',
      'Policy Analysis',
      'Input-Output Modeling',
      'IMPLAN',
      'RIMS II',
      'BEA RIMS II',
      'REMI',
      'Lightcast',
      'EMSI',
      'Bureau of Economic Analysis multipliers',
      'Fiscal Multiplier',
      'Economic Multipliers',
      'Tribal Economics',
      'Indigenous Economic Development',
      'Reservation Economics',
      'Alaska Native Corporations',
      'Native Hawaiian Organizations',
      'AIANNH geography',
      'Direct, Indirect and Induced Effects',
      'Jobs, Output and Earnings',
      'Economic Development Organizations',
      'Municipal Finance',
      'State and Local Government Software',
      'Public Sector Analytics',
      'Mission-Driven Organizations',
      'CDFIs',
      'Foundation Reporting',
      'Cornell University',
      'Cornell Brooks School of Public Policy',
      'Cornell Law Entrepreneurship Law Clinic',
      'Dartmouth College',
    ],
    keywords:
      'economic impact analysis, IMPLAN, RIMS II, REMI, Lightcast, BEA multipliers, input-output modeling, tribal economic impact, policy analysis software, government analytics, Cornell',
    potentialAction: {
      '@type': 'ContactAction',
      target: `mailto:${site.email}`,
    },
  },
  // One platform, one Service, one product family. The audiences the old
  // per-domain entry points described are served by the same Cedar
  // products, which adapt to the organization type.
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Economic Analysis Software',
    name: 'Lumecon',
    description:
      'The intelligent economic analysis platform. Lumecon offers the Cedar product family: Cedar Impact, where you run economic impact analysis; Cedar Commons, the shared project workspace; Cedar Grove, the advanced data library; and Cedar, the AI economic analyst, in every plan.',
    url: site.url,
    provider: { '@type': 'Organization', name: site.legalName },
    areaServed: { '@type': 'Country', name: 'United States' },
    audience: {
      '@type': 'Audience',
      audienceType: AUDIENCES.join('; '),
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'The Cedar family',
      itemListElement: [
        { '@type': 'Offer', name: 'Cedar Impact', description: 'Economic impact analysis' },
        { '@type': 'Offer', name: 'Cedar Commons', description: 'Shared project workspace' },
        { '@type': 'Offer', name: 'Cedar Grove', description: 'Advanced data library' },
        { '@type': 'Offer', name: 'Cedar', description: 'AI economic analyst, in every plan' },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Why Lumecon', item: `${site.url}/#why` },
      { '@type': 'ListItem', position: 3, name: 'The Lumecon edge', item: `${site.url}/#edge` },
      { '@type': 'ListItem', position: 4, name: 'Methodology', item: `${site.url}/methodology` },
      { '@type': 'ListItem', position: 5, name: 'Cedar', item: `${site.url}/#cedar` },
      { '@type': 'ListItem', position: 6, name: 'Pricing', item: `${site.url}/pricing` },
      { '@type': 'ListItem', position: 7, name: 'Get started', item: `${site.url}/signup` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}#website`,
    url: site.url,
    name: 'Lumecon Inc.',
    alternateName: 'Lumecon',
    description:
      'The official website of Lumecon Inc. and the authoritative source of information about the Lumecon platform, Cedar, pricing and methodology.',
    about: { '@id': `${site.url}#org` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
];
---

<BaseLayout
  title="Lumecon | Economic Analysis That Holds Up"
  description="Turn organizational records and public economic data into traceable economic impact analyses with Cedar and Cedar Impact."
  canonical={site.url}
  ogTitle="Economic Analysis That Holds Up"
  ogDescription="Turn organizational records and public economic data into traceable economic impact analyses with Cedar and Cedar Impact."
  ogImageAlt="Lumecon economic impact analysis software, with Cedar in every plan."
  bodyClass="home-page"
  jsonLd={jsonLd}
>
  <div class="scroll-progress" id="scrollProgress"></div>
  <Nav isHome={true} />
  <main id="top" tabindex="-1">
    <Hero />
    <EconomicPlaces />
    <WhyBand />
    <ProductTour />
    <Edge />
    <FinalCta />
  </main>
  <Footer isHome={true} />
</BaseLayout>

<script>
  // Scroll progress and nav state. Reveal behavior is shared by every
  // page in BaseLayout so its fallback and reduced-motion handling stay
  // consistent here too.
  const NAV_SCROLL_THRESHOLD = 40; // px before nav gets 'scrolled' class

  (function () {
    const nav = document.getElementById('nav');
    const progressBar = document.getElementById('scrollProgress');
    if (!nav || !progressBar) return;
    let ticking = false;

    const onScroll = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
      nav.classList.toggle('scrolled', scrollTop > NAV_SCROLL_THRESHOLD);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(onScroll);
          ticking = true;
        }
      },
      { passive: true },
    );
    onScroll();
  })();
</script>
