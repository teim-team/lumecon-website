---
import { site } from '../config';
import { FOUNDERS } from '../data/team';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import WhyBand from '../components/WhyBand.astro';
import ProductTour from '../components/ProductTour.astro';
import Edge from '../components/Edge.astro';
import FinalCta from '../components/FinalCta.astro';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';

// The audiences the retired per-domain entry points used to describe,
// kept as a plain list for the Service JSON-LD. One platform, one
// audience string; the Cedar products adapt to the organization type.
const AUDIENCES = [
  'Municipalities, state agencies and public institutions',
  'Tribal governments and departments, federally and state-recognized tribes, intertribal organizations, tribal colleges, Native nonprofits, ANCs, NHOs, tribal enterprises, Native CDFIs, Native-entity federal contractors',
  'Universities, foundations and nonprofits',
  'Businesses and developers',
  'Consulting firms and independent professionals running economic impact analyses on behalf of outside clients',
];

// Curated FAQ subset that powers the FAQPage JSON-LD on the
// homepage (visible to search crawlers, not rendered as on-page
// markup). The visible Cedar Q&A is the FAB on every page; this
// array exists only for structured-data discoverability.
const FAQ_ITEMS = [
  {
    q: 'What is Lumecon?',
    a: 'Lumecon is the intelligent economic analysis platform. Cedar Impact, where you run economic impact analysis, turns budgets, financial statements, payroll and program records into credible analyses in minutes. Every analysis shows jobs, labor income, GDP contribution, economic output and tax impacts, separates direct, indirect and induced effects, and carries a lineage behind every number. Cedar, the AI economic analyst, is included in every plan.',
  },
  {
    q: 'Is Lumecon an alternative to IMPLAN or REMI?',
    a: 'Cedar Impact, where you run economic impact analysis on Lumecon, is in the same field as IMPLAN, RIMS II and REMI, and organizations evaluate it as an alternative to traditional economic modeling tools. It uses input-output modeling to estimate direct, indirect and induced effects, prices by flat annual subscription with no geography add-ons and no per-analysis fees, and every plan includes Cedar, the AI economic analyst. Lumecon is not affiliated with or endorsed by IMPLAN or REMI.',
  },
  {
    q: 'Who uses Lumecon?',
    a: 'Lumecon is built for organizations that need to explain their economic impact clearly and credibly. That can include tribal governments, local governments, universities, foundations, developers, nonprofits and other institutions making investments in communities. The common thread: if your work affects jobs, spending, income, tax revenue or local development, Lumecon can help make that impact easier to understand.',
  },
  {
    q: 'How does Lumecon support Tribal Nations?',
    a: 'Tribal government, tribal enterprise and Whole Nation analysis are part of Lumecon itself, included in every plan. Whole Nation analysis brings a tribal government and its enterprises together in one integrated analysis, with statewide and homelands results side by side, so a Nation can show its combined economic footprint with clear, data-backed reports.',
  },
  {
    q: 'Can cities, counties and other organizations use Lumecon?',
    a: 'Lumecon is not only for tribal governments. We also support local economic impact analysis for cities, counties, public agencies, nonprofits, universities, developers and other organizations. The platform can help explain how a project, institution, investment or program affects a local or regional economy.',
  },
  {
    q: 'What are economic multipliers?',
    a: 'Economic multipliers estimate how one dollar of activity can ripple through a local economy. If an organization hires workers, buys supplies or funds construction, that activity directly supports jobs and spending. Then suppliers, workers and local businesses spend money again, creating additional effects. Economic impact analysis measures those layers in a clear and disciplined way.',
  },
  {
    q: 'What geographies does Lumecon cover?',
    a: 'Lumecon covers all federally recognized Tribal Nations and reservations, Alaska Native Corporation regions, Native Hawaiian Home Lands, every U.S. county, every U.S. state and the entire country. All of it is included in one annual subscription, not priced per geography.',
  },
  {
    q: 'How much does Lumecon cost?',
    a: 'Lumecon has four public plans. Seed is free: build a full analysis and see your direct effects, with full results unlocking on any paid plan. Sprout is $1,000 a year for one user, Sapling is $2,500 a year for up to 10 users with Cedar Commons, the shared project workspace, and Tree is $7,500 a year with unlimited organizational users, Cedar Grove, the advanced data library, and hands-on Cedar calibration. Every paid plan includes Cedar Impact in full, Cedar, unlimited analysis and every supported U.S. geography.',
  },
  {
    q: 'Can I try Lumecon for free?',
    a: 'Yes. Seed, the free account, is the real platform: create an account, bring your documents and build an analysis end to end, then see your direct effects on the results page. Indirect, induced and total impact unlock when you choose a paid plan.',
  },
  {
    q: 'What is Cedar?',
    a: "Cedar is Lumecon's AI economic analyst, included in every plan, and the name of the product family around it: Cedar Impact, where you run economic impact analysis; Cedar Commons, the shared project workspace; and Cedar Grove, the advanced data library. See lumecon.ai/cedar for how the analyst works. The chat on this site is a lightweight Cedar that answers questions about Lumecon.",
  },
  {
    q: 'Where was Lumecon built?',
    a: 'Lumecon Inc. was built by Cornell, Dartmouth, MIT, Yale, Brown, Duke and Oxford-trained researchers and engineers, with counsel from the Cornell Law Entrepreneurship Law Clinic. Prior professional experience includes the Federal Reserve Banks of Minneapolis and Philadelphia and the Federal Reserve Board of Governors in Washington, DC.',
  },
];

const jsonLd = [
