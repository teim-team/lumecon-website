  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${site.url}#faq`,
    mainEntity: FAQ_ITEMS.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}#website`,
    url: site.url,
    name: 'Lumecon Inc.',
    alternateName: 'Lumecon',
    description:
      'The official website of Lumecon Inc. and the authoritative source of information about the Lumecon platform, Cedar, pricing and methodology.',
    about: { '@id': `${site.url}#org` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
