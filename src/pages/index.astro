    '@type': ['Organization', 'SoftwareApplication'],
    '@id': `${site.url}#org`,
    name: site.legalName,
    legalName: site.legalName,
    alternateName: ['Lumecon', 'Lumecon.ai', site.name],
    disambiguatingDescription:
      'Lumecon Inc. builds the intelligent economic analysis platform, headquartered online at lumecon.ai. Not affiliated with any unrelated trademark-similar businesses in other industries.',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Economic Impact Analysis Software',
    operatingSystem: 'Web',
    url: site.url,
    logo: `${site.url}/brand/lumecon-logo-mark-transparent.png`,
    image: `${site.url}/lumecon-og-image-1200x630.png`,
    description:
      'Lumecon Inc. builds the intelligent economic analysis platform. Cedar Impact turns budgets, financial statements, payroll and program records into credible economic impact analyses in minutes, with Cedar, the AI economic analyst, in every plan. Built by economists, engineers and researchers with experience at the Federal Reserve and leading universities. Plans from $1,000 a year, free to try.',
    email: site.email,
    slogan: site.tagline,
    naics: '541512',
    industry: 'Economic Impact Analysis Software',
    mainEntityOfPage: site.url,
    contactPoint: {
      '@type': 'ContactPoint',
      email: site.email,
      contactType: 'sales and support',
      availableLanguage: 'English',
    },
    sameAs: ['https://www.linkedin.com/company/lumecon-ai'],
    foundingLocation: { '@type': 'Place', name: site.builtAt },
    founder: FOUNDERS.map((p) => ({
      '@type': 'Person',
      name: p.name,
      jobTitle: p.title,
    })),
    knowsAbout: [
      'Economic Impact Analysis',
      'Policy Analysis',
      'Input-Output Modeling',
      'IMPLAN',
      'RIMS II',
      'BEA RIMS II',
      'REMI',
      'Lightcast',
      'EMSI',
      'Bureau of Economic Analysis multipliers',
      'Fiscal Multiplier',
      'Economic Multipliers',
      'Tribal Economics',
      'Indigenous Economic Development',
      'Reservation Economics',
      'Alaska Native Corporations',
      'Native Hawaiian Organizations',
      'AIANNH geography',
      'Direct, Indirect and Induced Effects',
      'Jobs, Output and Earnings',
      'Economic Development Organizations',
      'Municipal Finance',
      'State and Local Government Software',
      'Public Sector Analytics',
      'Mission-Driven Organizations',
      'CDFIs',
      'Foundation Reporting',
      'Cornell University',
      'Cornell Brooks School of Public Policy',
      'Cornell Law Entrepreneurship Law Clinic',
      'Dartmouth College',
    ],
    keywords:
      'economic impact analysis, IMPLAN, RIMS II, REMI, Lightcast, BEA multipliers, input-output modeling, alternative data, high-frequency data, tribal economic impact, policy analysis software, government analytics, Cornell',
    potentialAction: {
      '@type': 'ContactAction',
      target: `mailto:${site.email}`,
    },
  },
  // One platform, one Service, one product family. The audiences the old
  // per-domain entry points described are served by the same Cedar
  // products, which adapt to the organization type.
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Economic Analysis Software',
    name: 'Lumecon',
    description:
      'The intelligent economic analysis platform. Lumecon offers the Cedar product family: Cedar Impact, where you run economic impact analysis; Cedar Commons, the shared project workspace; Cedar Grove, the advanced data library; and Cedar, the AI economic analyst, in every plan.',
    url: site.url,
    provider: { '@type': 'Organization', name: site.legalName },
    areaServed: { '@type': 'Country', name: 'United States' },
    audience: {
      '@type': 'Audience',
      audienceType: AUDIENCES.join('; '),
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'The Cedar family',
      itemListElement: [
        { '@type': 'Offer', name: 'Cedar Impact', description: 'Economic impact analysis' },
        { '@type': 'Offer', name: 'Cedar Commons', description: 'Shared project workspace' },
        { '@type': 'Offer', name: 'Cedar Grove', description: 'Advanced data library' },
        { '@type': 'Offer', name: 'Cedar', description: 'AI economic analyst, in every plan' },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Why Lumecon', item: `${site.url}/#why` },
      { '@type': 'ListItem', position: 3, name: 'The Lumecon edge', item: `${site.url}/#edge` },
