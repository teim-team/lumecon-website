---
import { site } from '../config';
import { REGIONAL_PLATFORMS } from '../data/platforms';
import { FOUNDERS } from '../data/team';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import WhyBand from '../components/WhyBand.astro';
import ProductTour from '../components/ProductTour.astro';
import Edge from '../components/Edge.astro';
import CedarTeaser from '../components/CedarTeaser.astro';
import FinalCta from '../components/FinalCta.astro';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';

// Curated FAQ subset that powers the FAQPage JSON-LD on the
// homepage (visible to search crawlers, not rendered as on-page
// markup). The visible Cedar Q&A is the FAB on every page; this
// array exists only for structured-data discoverability.
const FAQ_ITEMS = [
  {
    q: 'What is Lumecon?',
    a: 'Lumecon is economic impact analysis software: one platform that turns budgets, financial statements, payroll and program records into credible analyses in minutes. Every analysis shows jobs, labor income, GDP contribution, economic output and tax impacts, separates direct, indirect and induced effects, and carries a lineage behind every number. Cedar, the AI economic analyst, is included in every plan.',
  },
  {
    q: 'Is Lumecon an alternative to IMPLAN or REMI?',
    a: 'Lumecon is economic impact analysis software in the same field as IMPLAN, RIMS II and REMI, and organizations evaluate it as an alternative to traditional economic modeling tools. Lumecon uses input-output modeling to estimate direct, indirect and induced effects, prices by flat annual subscription with no geography add-ons and no per-analysis fees, and includes Cedar, an AI economic analyst, in every plan. Eligible organizations switching from qualifying software can ask about the competitive transition offer. Lumecon is not affiliated with or endorsed by IMPLAN or REMI.',
  },
  {
    q: 'Who uses Lumecon?',
    a: 'Lumecon is built for organizations that need to explain their economic impact clearly and credibly. That can include tribal governments, local governments, universities, foundations, developers, nonprofits and other institutions making investments in communities. The common thread: if your work affects jobs, spending, income, tax revenue or local development, Lumecon can help make that impact easier to understand.',
  },
  {
    q: 'How does Lumecon support Tribal Nations?',
    a: 'Tribal government, tribal enterprise and Whole Nation analysis are part of Lumecon itself, included in every plan. Whole Nation analysis brings a tribal government and its enterprises together in one integrated analysis, with statewide and homelands results side by side, so a Nation can show its combined economic footprint with clear, data-backed reports.',
  },
  {
    q: 'Can cities, counties and other organizations use Lumecon?',
    a: 'Lumecon is not only for tribal governments. We also support local economic impact analysis for cities, counties, public agencies, nonprofits, universities, developers and other organizations. The platform can help explain how a project, institution, investment or program affects a local or regional economy.',
  },
  {
    q: 'What are economic multipliers?',
    a: 'Economic multipliers estimate how one dollar of activity can ripple through a local economy. If an organization hires workers, buys supplies or funds construction, that activity directly supports jobs and spending. Then suppliers, workers and local businesses spend money again, creating additional effects. Economic impact analysis measures those layers in a clear and disciplined way.',
  },
  {
    q: 'What geographies does Lumecon cover?',
    a: 'Lumecon covers all federally recognized Tribal Nations and reservations, Alaska Native Corporation regions, Native Hawaiian Home Lands, every U.S. county, every U.S. state and the entire country. All of it is included in one annual subscription, not priced per geography.',
  },
  {
    q: 'How much does Lumecon cost?',
    a: 'Lumecon has three public plans: Sprout at $500 a year for one user, Sapling at $2,500 a year for up to 10 users with Cedar Commons, and Tree at $7,500 a year with unlimited organizational users, Cedar Grove and hands-on Cedar calibration. Every plan includes the full model, Cedar, unlimited analysis and every supported U.S. geography. Organizations already paying for qualifying economic impact analysis software can ask about the competitive transition offer: the first annual license for 50% of their documented prior-year spend.',
  },
  {
    q: 'Can I try Lumecon for free?',
    a: 'Yes. You can create an account, bring your documents and build an analysis end to end for free. Full results unlock when you choose a plan.',
  },
  {
    q: 'What is Cedar?',
    a: "Cedar is Lumecon's AI economic analyst, included in every plan. See lumecon.ai/cedar for how it works. The chat on this site is a lightweight Cedar that answers questions about Lumecon.",
  },
  {
    q: 'Where was Lumecon built?',
    a: 'Lumecon Inc. was built by Cornell, Dartmouth, MIT, Yale, Brown, Duke and Oxford-trained researchers and engineers, with counsel from the Cornell Law Entrepreneurship Law Clinic. Prior professional experience includes the Federal Reserve Banks of Minneapolis and Philadelphia and the Federal Reserve Board of Governors in Washington, DC.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': ['Organization', 'SoftwareApplication'],
    '@id': `${site.url}#org`,
    name: site.legalName,
    legalName: site.legalName,
    alternateName: ['Lumecon', 'Lumecon.ai', site.name],
    disambiguatingDescription:
      'Lumecon Inc. is an AI-assisted economic impact analysis software company, headquartered online at lumecon.ai. Not affiliated with any unrelated trademark-similar businesses in other industries.',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Economic Impact Analysis Software',
    operatingSystem: 'Web',
    url: site.url,
    logo: `${site.url}/brand/lumecon-logo-mark-transparent.png`,
    image: `${site.url}/lumecon-og-image-1200x630.png`,
    description:
      'Lumecon Inc. builds economic impact analysis software: one platform that turns budgets, financial statements, payroll and program records into credible analyses in minutes, with Cedar AI in every plan. Built by economists, engineers and researchers with experience at the Federal Reserve and leading universities. Plans from $500 a year, free to try.',
    email: site.email,
    slogan: site.tagline,
    naics: '541512',
    industry: 'Economic Impact Analysis Software',
    sameAs: [
      'https://www.linkedin.com/company/lumecon-ai',
      'https://lumecon.ai',
      'https://localeconomicimpact.com',
      'https://tribaleconomicimpact.com',
      'https://globaleconomicimpact.com',
    ],
    foundingLocation: { '@type': 'Place', name: site.builtAt },
    founder: FOUNDERS.map((p) => ({
      '@type': 'Person',
      name: p.name,
      jobTitle: p.title,
    })),
    knowsAbout: [
      'Economic Impact Analysis',
      'Policy Analysis',
      'Input-Output Modeling',
      'IMPLAN',
      'RIMS II',
      'BEA RIMS II',
      'REMI',
      'Lightcast',
      'EMSI',
      'Bureau of Economic Analysis multipliers',
      'Fiscal Multiplier',
      'Economic Multipliers',
      'Tribal Economics',
      'Indigenous Economic Development',
      'Reservation Economics',
      'Alaska Native Corporations',
      'Native Hawaiian Organizations',
      'AIANNH geography',
      'Direct, Indirect and Induced Effects',
      'Jobs, Output and Earnings',
      'Economic Development Organizations',
      'Municipal Finance',
      'State and Local Government Software',
      'Public Sector Analytics',
      'Mission-Driven Organizations',
      'CDFIs',
      'Foundation Reporting',
      'Cornell University',
      'Cornell Brooks School of Public Policy',
      'Cornell Law Entrepreneurship Law Clinic',
      'Dartmouth College',
    ],
    keywords:
      'economic impact analysis, IMPLAN, RIMS II, REMI, Lightcast, BEA multipliers, input-output modeling, alternative data, high-frequency data, tribal economic impact, policy analysis software, government analytics, Cornell',
    potentialAction: {
      '@type': 'ContactAction',
      target: `mailto:${site.email}`,
    },
  },
  ...REGIONAL_PLATFORMS.map((p) => ({
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Economic Impact Analysis Software',
    name: p.name,
    url: p.url,
    provider: { '@type': 'Organization', name: site.legalName },
    ...(p.slug === 'global' ? {} : { areaServed: { '@type': 'Country', name: 'United States' } }),
    audience: { '@type': 'Audience', audienceType: p.audience },
  })),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Why Lumecon', item: `${site.url}/#why` },
      { '@type': 'ListItem', position: 3, name: 'The Lumecon edge', item: `${site.url}/#edge` },
      { '@type': 'ListItem', position: 4, name: 'Methodology', item: `${site.url}/methodology` },
      { '@type': 'ListItem', position: 5, name: 'Cedar', item: `${site.url}/#cedar` },
      { '@type': 'ListItem', position: 6, name: 'Pricing', item: `${site.url}/pricing` },
      { '@type': 'ListItem', position: 7, name: 'Get started', item: `${site.url}/signup` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${site.url}#faq`,
    mainEntity: FAQ_ITEMS.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}#website`,
    url: site.url,
    name: 'Lumecon Inc.',
    alternateName: 'Lumecon',
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
];
---

<BaseLayout
  title="Lumecon | Economic Impact Analysis Software"
  description="Economic impact analysis software. Lumecon turns budgets, financial statements, payroll and program records into credible analyses in minutes: jobs, labor income, GDP contribution, economic output and tax impacts across counties, states, the nation, reservations and trust lands, with Cedar AI in every plan. Plans from $500 a year, free to try."
  canonical="https://lumecon.ai/"
  keywords="economic impact analysis, economic impact analysis software, economic impact analysis software, how to measure economic impact, IMPLAN, IMPLAN alternative, Implan, Implan alternative, RIMS II, RIMS 2, RIMS II alternative, BEA RIMS, REMI, Remi, REMI alternative, Lightcast, EMSI, Emsi, input-output modeling, fiscal multiplier, economic multipliers, alternative data, AI for government, AI for local government, AI for tribes, AI for tribal governments, AI for economic development, government AI software, tribal economic impact, tribal economic development software, reservation economics, ANCSA regions, Alaska Native Corporations, Native Hawaiian Organizations, AIANNH, Cedar AI, economic impact for grants, grant economic impact report, policy analysis software, government software, public-sector analytics, mission-driven organizations, CDFI, economic development organizations, Bureau of Economic Analysis, direct indirect induced effects, jobs output earnings, Cornell University, Cornell Brooks School, Cornell Law, Dartmouth, Federal Reserve, Center for Indian Country Development"
  ogTitle="Economic Impact Analysis Software"
  ogDescription="Credible economic impact analyses in minutes: jobs, labor income, GDP contribution, economic output and tax impacts across supported U.S. geographies, with Cedar AI in every plan. Plans from $500 a year, free to try."
  ogImageAlt="Lumecon. Economic impact analysis software with Cedar AI in every plan. Plans from $500 a year, free to try."
  bodyClass="home-page"
  jsonLd={jsonLd}
>
  <div class="scroll-progress" id="scrollProgress"></div>
  <Nav isHome={true} />
  <main>
    <Hero />
    <WhyBand />
    <ProductTour />
    <Edge />
    <CedarTeaser />
    <FinalCta />
  </main>
  <Footer isHome={true} />
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  // Scroll & reveal constants
  const NAV_SCROLL_THRESHOLD = 40; // px before nav gets 'scrolled' class
  const STAGGER_DELAY_PER_ITEM = 150; // ms between staggered reveals
  const REVEAL_THRESHOLD = 0.08;
  const REVEAL_ROOT_MARGIN = '0px 0px -30px 0px';

  // Scroll progress indicator + nav scroll state
  (function () {
    const nav = document.getElementById('nav');
    const progressBar = document.getElementById('scrollProgress');
    if (!nav || !progressBar) return;
    let ticking = false;

    const onScroll = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = progress + '%';
      nav.classList.toggle('scrolled', scrollTop > NAV_SCROLL_THRESHOLD);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(onScroll);
          ticking = true;
        }
      },
      { passive: true },
    );
  })();

  // Intersection observer for reveal animations (staggered product blocks)
  const obs = new IntersectionObserver(
    (es) => {
      es.forEach((e) => {
        if (e.isIntersecting) {
          const el = e.target as HTMLElement;
          const stagger = el.dataset.stagger;
          if (stagger) {
            setTimeout(() => el.classList.add('seen'), parseInt(stagger) * STAGGER_DELAY_PER_ITEM);
          } else {
            el.classList.add('seen');
          }
          obs.unobserve(e.target);
        }
      });
    },
    { threshold: REVEAL_THRESHOLD, rootMargin: REVEAL_ROOT_MARGIN },
  );
  document
    .querySelectorAll('.reveal,.reveal-soft,.reveal-left,.reveal-right,.reveal-diagonal')
    .forEach((el) => obs.observe(el));

</script>
