---
/**
 * /glossary — plain-language definitions of the economic-impact terms
 * that show up across the site and in Cedar's answers (multipliers,
 * RPC, direct/indirect/induced, etc.). Gives first-timers a reference
 * and gives Cedar a stable page to point people to.
 *
 * Presented in the methodology page's design language: wide hero,
 * hairline definition rows with the term on the left and the
 * definition on the right, mono tags, no tinted panels or highlight
 * smears. The term list is a semantic <dl> so it reads well to both
 * people and crawlers, and each row keeps its anchor id.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MarkArt from '../components/MarkArt.astro';
import { site as siteConfig } from '../config';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';

const TERMS: Array<{ term: string; abbr?: string; def: string }> = [
  {
    term: 'Economic impact analysis',
    def: 'A method for estimating the economic footprint of an organization, project or program: its own spending plus the additional activity that spending sets off across a region.',
  },
  {
    term: 'Direct effect',
    def: 'The activity of the project itself: its own spending, wages and jobs.',
  },
  {
    term: 'Indirect effect',
    def: 'The activity at the suppliers a project buys from: the vendors, contractors and businesses in its supply chain.',
  },
  {
    term: 'Induced effect',
    def: 'The activity created when workers from the direct and indirect activity spend their wages locally: groceries, rent, healthcare and the rest of household spending.',
  },
  {
    term: 'Total impact',
    def: 'Direct, indirect and induced effects added together, the headline number, with each layer shown separately so a reviewer can see where it comes from.',
  },
  {
    term: 'Multiplier',
    def: 'A factor estimating how each dollar of direct activity ripples into additional activity. Multipliers differ by industry and geography, which is why a casino in Connecticut has a different ripple than a wind farm in Nebraska.',
  },
  {
    term: 'Regional purchase coefficient',
    abbr: 'RPC',
    def: 'The share of a good or service a region actually buys locally rather than importing. RPCs estimate how much of each dollar stays in-region versus leaking out to suppliers elsewhere.',
  },
  {
    term: 'Input-output model',
    abbr: 'I-O',
    def: 'The economic framework behind impact analysis: a matrix of how industries buy from and sell to one another, used to trace how spending flows through an economy. Lumecon builds its model from national economic accounts and regionalizes those relationships to the geography being analyzed.',
  },
  {
    term: 'Base year',
    def: 'The reference year whose price levels and industry structure the analysis data is anchored to.',
  },
  {
    term: 'Labor income',
    def: 'Wages, salaries and benefits paid to workers, reported alongside jobs and output as one of the headline figures.',
  },
  {
    term: 'Output',
    def: 'The total value of production (sales or revenue) generated by the activity.',
  },
  {
    term: 'Jobs supported',
    def: 'The count of jobs supported by the activity across the direct, indirect and induced layers over the analysis period. It is a job count; where a conversion basis matters, the analysis states it.',
  },
  {
    term: 'GDP contribution',
    def: 'The value added by the analyzed activity: the measure that corresponds to a region’s contribution to GDP. Lumecon uses GDP contribution as the plain-language label for value added.',
  },
];

const site = 'https://lumecon.ai';
const description =
  'Plain-language definitions of economic impact analysis terms: direct, indirect and induced effects, multipliers, regional purchase coefficients (RPC), input-output models, base year, labor income, economic output, jobs supported and GDP contribution.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Glossary | Lumecon',
    url: `${site}/glossary`,
    description,
    isPartOf: { '@id': `${siteConfig.url}#website` },
    publisher: { '@id': `${siteConfig.url}#org` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
      { '@type': 'ListItem', position: 2, name: 'Glossary', item: `${site}/glossary` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    '@id': `${site}/glossary`,
    name: 'Economic impact analysis glossary',
    url: `${site}/glossary`,
    hasDefinedTerm: TERMS.map((t) => ({
      '@type': 'DefinedTerm',
      name: t.abbr ? `${t.term} (${t.abbr})` : t.term,
      description: t.def,
      inDefinedTermSet: `${site}/glossary`,
    })),
  },
];
---

<BaseLayout
  title="Glossary | Lumecon"
  description={description}
  canonical="https://lumecon.ai/glossary"
  keywords="economic impact glossary, what is a multiplier, regional purchase coefficient, RPC, direct indirect induced effects, input-output model, economic impact analysis terms, labor income, jobs supported, GDP contribution, value added"
  jsonLd={jsonLd}
>
  <Nav isHome={false} />
  <main class="meth" id="top" tabindex="-1">
    <header class="meth-hero">
      <MarkArt class="markart markart--tr" size={620} />
      <div class="meth-w">
        <p class="h-kicker">Reference</p>
        <h1 class="meth-hero__title">
          The language of <span class="brand-em">economic impact</span>.
        </h1>
        <p class="meth-hero__lede">
          The terms that come up most in economic impact analysis, defined in plain language. For
          the mathematics behind them, read the{' '}
          <a class="gloss-link" href="/methodology">methodology</a>.
        </p>
      </div>
    </header>

    <section class="meth-sec" aria-label="Definitions">
      <div class="meth-w">
        <dl class="meth-defs gloss-defs">
          {
            TERMS.map((t) => (
              <div
                class="meth-defs__row"
                id={t.term
                  .toLowerCase()
                  .replace(/[^a-z]+/g, '-')
                  .replace(/^-|-$/g, '')}
              >
                <dt>
                  {t.term}
                  {t.abbr && <span class="gloss-abbr">{t.abbr}</span>}
                </dt>
                <dd>{t.def}</dd>
              </div>
            ))
          }
        </dl>
        <p class="gloss-foot">
          Read <a class="gloss-link" href="/methodology">how an analysis is built</a>, or ask Cedar
          (the assistant in the corner) to explain any of these in plain language.
        </p>
      </div>
    </section>
  </main>
  <Footer isHome={false} />
</BaseLayout>

<style>
  /* Glossary-specific refinements on the methodology vocabulary. */
  .gloss-defs .meth-defs__row {
    scroll-margin-top: 6rem;
  }
  .gloss-abbr {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-left: 0.6rem;
  }
  /* .gloss-link is global (methodology.css), shared with /cedar. */
  .gloss-foot {
    margin: 2rem 0 0;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--ink-2);
    max-width: 44rem;
  }
  .gloss-link {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }
</style>
