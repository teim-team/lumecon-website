---
/* Unlisted film page. Hosts the product films referenced from reports,
   decks and updates, so a reader can click straight through and watch.
   Deliberately kept out of the sitemap (see astro.config.mjs), out of the
   nav, and marked noindex; share the link directly. */
import { site } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';

const FILMS = [
  {
    id: 'tallgrass',
    title: 'Lumecon · the product film',
    meta: '1:01 · July 2026',
    src: '/films/tallgrass-demo-v11.mp4',
    poster: '/films/tallgrass-demo-poster.jpg',
    caption:
      'Three documents go in, Cedar drafts and cites the intake, and a completed analysis lands with every number traceable. The demonstration uses the fictional Tallgrass River Nation; all figures are invented.',
    downloadLabel: 'Download the film (MP4, 7.6 MB)',
  },
];
---

<BaseLayout
  title="Product films | Lumecon Inc."
  description="Short demonstrations of the real Lumecon product."
  canonical={`${site.url}/film`}
  noindex={true}
  cedar={false}
>
  <Nav />
  <main class="films" id="top" tabindex="-1">
    <div class="films__inner" data-reveal-group>
      <p class="h-kicker">Product films</p>
      <h1>The product, in motion</h1>
      <p class="films__intro">
        Short demonstrations of the real Lumecon product. This page is unlisted; share the link
        directly.
      </p>
      {
        FILMS.map((f) => (
          <section class="film" id={f.id}>
            <h2 class="film__title">{f.title}</h2>
            <p class="film__meta mono">{f.meta}</p>
            <video class="film__player" controls playsinline preload="metadata" poster={f.poster}>
              <source src={f.src} type="video/mp4" />
              Your browser does not support embedded video.
              <a href={f.src}>Download the film instead.</a>
            </video>
            <p class="film__caption">{f.caption}</p>
            <p class="film__download">
              <a href={f.src} download>
                {f.downloadLabel}
              </a>
            </p>
          </section>
        ))
      }
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .films {
    background: transparent;
  }
  .films__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: clamp(6rem, 10vh, 8rem) var(--container-pad) clamp(4rem, 8vw, 6rem);
  }
  .films h1 {
    max-width: 14ch;
    font-size: clamp(3.2rem, 6vw, 5.4rem);
    font-weight: var(--weight-hero);
    letter-spacing: -0.05em;
    line-height: 0.98;
    color: var(--ink);
    margin: 0.75rem 0 0.9rem;
  }
  .films__intro {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 62ch;
    margin: 0 0 clamp(3rem, 6vw, 5rem);
  }
  .film {
    display: grid;
    grid-template-columns: minmax(15rem, 3fr) minmax(0, 9fr);
    grid-template-rows: auto auto 1fr auto;
    gap: 0.45rem clamp(2rem, 4vw, 4.5rem);
    align-items: start;
    border-top: 1px solid rgba(10, 15, 38, 0.12);
    padding-top: clamp(2rem, 4vw, 3rem);
    margin-top: 0;
  }
  .film__title {
    grid-column: 1;
    grid-row: 1;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
  }
  .film__meta {
    grid-column: 1;
    grid-row: 2;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0.4rem 0 1.1rem;
  }
  .film__player {
    grid-column: 2;
    grid-row: 1 / 5;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    background: var(--navy);
    border: 1px solid rgba(10, 15, 38, 0.12);
    border-radius: var(--radius-frame);
    box-shadow: var(--shadow-surface-high);
  }
  .film__caption {
    grid-column: 1;
    grid-row: 3;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-3);
    margin: 0.9rem 0 0.4rem;
  }
  .film__download {
    grid-column: 1;
    grid-row: 4;
    margin: 0.2rem 0 0;
    font-size: 0.92rem;
  }
  @media (max-width: 900px) {
    .film {
      grid-template-columns: 1fr;
    }
    .film__title,
    .film__meta,
    .film__player,
    .film__caption,
    .film__download {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
