---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/legal.css';
---

<BaseLayout
  title="Page Not Found | Lumecon"
  description="That page doesn't exist. Return to Lumecon's economic impact analysis software for governments, enterprises and mission-driven organizations."
  canonical="https://lumecon.ai/404"
  keywords="Lumecon, page not found"
  bodyClass="legal-page"
  noindex={true}
>
  <Nav isHome={false} />
  <script>
    // GitHub Pages serves no dynamic routes, so referral links use the
    // pretty lumecon.ai/r/<code> shape and land on this page. Forward them
    // into the signup flow with the code preserved.
    const referral = window.location.pathname.match(/^\/r\/([A-Za-z0-9_-]{1,64})\/?$/);
    if (referral) window.location.replace(`/signup?ref=${referral[1]}`);
  </script>
  <main
    id="top"
    tabindex="-1"
    style="text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center;"
  >
    <h1 style="font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: .5rem;">404</h1>
    <p style="margin-bottom: 2rem;">The page you're looking for doesn't exist.</p>
    <a href="/" class="btn">Back to Home</a>
  </main>
  <Footer isHome={false} />
</BaseLayout>
