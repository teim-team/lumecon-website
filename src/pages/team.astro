---
/**
 * /team — who builds Lumecon, and what they trained in.
 *
 * A credibility page, sitting beside /methodology and /security: those
 * two argue that the economics and the handling of data hold up, and
 * this one says who is doing them. It makes that argument the cheapest
 * way available — a degree list and a couple of checkable prior posts
 * per person — and stops there. No manifesto, no values, no culture
 * copy; the other pages already carry the argument about the product.
 *
 * Content comes from src/data/team.ts, which stays the single record
 * for the team. The page renders `education` and `experience`, never
 * the long `bio` paragraphs, and it renders only people who have a
 * headshot: see the note on TEAM_ROSTER for why Michael Moreno is in
 * the data and not on the page.
 *
 * Portraits are the duotone circles cut from the pitch deck's team
 * slide by scripts/team/headshots.mjs, washed through the same teal
 * ramp as the licensed sector photography.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site as siteConfig } from '../config';
import { TEAM_ROSTER, ADVISOR_ROSTER, type Person } from '../data/team';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';
import '../styles/team.css';

const site = 'https://lumecon.ai';
const description =
  'The economists, engineers and advisors who build Lumecon, with the degrees and the prior posts behind the model, the data systems and the platform.';

/** Display names carry a credential suffix; schema.org `name` should not. */
const plainName = (p: Person) => p.name.replace(/,\s*(PhD|MPP)$/, '');

const personLd = (p: Person) => ({
  '@type': 'Person',
  '@id': `${site}/team#${p.slug}`,
  name: plainName(p),
  jobTitle: p.title,
  description: p.summary,
  ...(p.photo ? { image: `${site}${p.photo}` } : {}),
  ...(p.email ? { email: p.email } : {}),
  ...(p.alumniOf?.length
    ? { alumniOf: p.alumniOf.map((n) => ({ '@type': 'CollegeOrUniversity', name: n })) }
    : {}),
  ...(p.prevAffiliations?.length
    ? { affiliation: p.prevAffiliations.map((n) => ({ '@type': 'Organization', name: n })) }
    : {}),
  ...(p.group === 'team' ? { worksFor: { '@id': `${siteConfig.url}#org` } } : {}),
  ...([p.linkedin, p.scholar].filter(Boolean).length
    ? { sameAs: [p.linkedin, p.scholar].filter(Boolean) }
    : {}),
});

const everyone = [...TEAM_ROSTER, ...ADVISOR_ROSTER];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Team | Lumecon',
    url: `${site}/team`,
    description,
    isPartOf: { '@id': `${siteConfig.url}#website` },
    publisher: { '@id': `${siteConfig.url}#org` },
    inLanguage: 'en-US',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: everyone.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: personLd(p),
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
      { '@type': 'ListItem', position: 2, name: 'Team', item: `${site}/team` },
    ],
  },
];
---

<BaseLayout
  title="Team | Lumecon"
  description={description}
  canonical="https://lumecon.ai/team"
  jsonLd={jsonLd}
>
  <Nav isHome={false} />
  <main class="meth" id="top" tabindex="-1">
    <header class="meth-hero team-hero">
      <div class="meth-w" data-reveal-group>
        <p class="h-kicker">Team</p>
        <h1 class="meth-hero__title team-hero__title">
          Economic modeling, data systems, platform engineering and Indian Country expertise in one
          team.
        </h1>
        <p class="meth-hero__lede">
          These are the people who build the model, the data systems and the platform, and the
          advisors who review the methodology, the data governance and the engineering behind them.
          Each entry gives the degrees and a couple of prior posts, so the work can be weighed
          against the people who did it.
        </p>
      </div>
    </header>

    {/* No section heading here. The hero says what this list is, and a
         second "Team" under a "Team" kicker would only restate it; the
         advisors below get a heading because they are a different kind
         of entry. The section keeps an accessible name instead. */}
    <section class="meth-sec team-sec" aria-label="Team">
      <div class="meth-w">
        <ol class="roster" role="list">
          {TEAM_ROSTER.map((p, i) => (
            <li class="roster__row" id={p.slug}>
              {/* Alt is empty on purpose: the name sits beside the
                    portrait, so alt text would announce it twice. */}
              <img
                class="roster__photo"
                src={p.photo}
                width={p.photoSize}
                height={p.photoSize}
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="roster__id">
                <h2 class="roster__name">{p.name}</h2>
                <p class="roster__role">{p.discipline ?? p.title}</p>
              </div>
              <div class="roster__col">
                <p class="roster__label">Education</p>
                <ul class="roster__list roster__list--edu" role="list">
                  {p.education?.map((e) => (
                    <li>{e}</li>
                  ))}
                </ul>
              </div>
              <div class="roster__col">
                <p class="roster__label">Experience</p>
                <ul class="roster__list" role="list">
                  {p.experience?.map((e) => (
                    <li>{e}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="meth-sec team-sec" aria-labelledby="advisors">
      <div class="meth-w">
        <div class="team-sec__head">
          <h2 id="advisors">Advisors</h2>
          <p>
            Three people outside the day-to-day work who review what the day-to-day work produces:
            the empirical methodology, the handling of sensitive data and the engineering the
            platform is built on.
          </p>
        </div>
        <ol class="roster roster--advisors" role="list">
          {ADVISOR_ROSTER.map((p) => (
            <li class="roster__row" id={p.slug}>
              <img
                class="roster__photo"
                src={p.photo}
                width={p.photoSize}
                height={p.photoSize}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <div class="roster__id">
                <h3 class="roster__name">{p.name}</h3>
                <p class="roster__role">{p.discipline ?? p.title}</p>
              </div>
              <div class="roster__col">
                <p class="roster__label">Education</p>
                <ul class="roster__list roster__list--edu" role="list">
                  {p.education?.map((e) => (
                    <li>{e}</li>
                  ))}
                </ul>
              </div>
              <div class="roster__col">
                <p class="roster__label">Experience</p>
                <ul class="roster__list" role="list">
                  {p.experience?.map((e) => (
                    <li>{e}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="team-close" aria-label="Further reading">
      <div class="meth-w">
        <p>
          For the economics these people are responsible for, read the{' '}
          <a href="/methodology">methodology</a>. For how Lumecon handles the data organizations
          bring to it, read <a href="/security">security</a>.
        </p>
      </div>
    </section>
  </main>
  <Footer isHome={false} />
</BaseLayout>
