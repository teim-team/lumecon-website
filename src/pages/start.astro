---
/**
 * /start - Plan your first analysis.
 *
 * The site's answer to the question an interested organization actually
 * has, which is not "what does the model do" but "what can we start with".
 * Six questions, a proposed starting scope, and a checklist of records the
 * organization already owns.
 *
 * Everything on this page comes from src/data/planFirstAnalysis.js, which
 * the onboarding call outline and the internal coordinator brief read as
 * well (npm run docs:plan). One edit changes every surface.
 *
 * Progressive by design. The six questions, the capability matrix, the
 * full record catalog and the call outline all render as static HTML, so
 * the page is useful with no JavaScript at all. The script adds the
 * tailored plan: it imports the same module, evaluates it in the browser
 * and renders the result. No request is made and nothing is stored.
 *
 * Nothing sensitive is collected here. Records move through the
 * authenticated product, which is what the checklist says.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site as siteConfig } from '../config';
import {
  STEP_GROUPS,
  FOLLOW_UPS,
  CAPABILITY_MATRIX,
  COVERAGE_INDICATORS,
  RECORDS,
  CALL_OUTCOMES,
  CALL_OUTLINE,
} from '../data/planFirstAnalysis.js';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/methodology.css';
import '../styles/start.css';

const site = siteConfig.url;
const description =
  'Six questions that turn an interest in economic impact analysis into a first analysis you can actually run: a bounded scope, the records to start with and who needs to help.';

/* A literal tuple, so each id indexes RECORDS as a known key. A plain
   string[] infers `string`, which has no index signature on that object,
   and `astro check` rejects it: that is what broke the build on main. */
const CORE_RECORD_IDS = ['financials', 'payroll', 'headcount'] as const;

const STATUS_LABEL: Record<string, string> = {
  available: 'Available today',
  proposed: 'Proposed',
  research: 'In research',
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Plan your first analysis', item: `${site}/start` },
    ],
  },
];
---

<BaseLayout
  title="Plan your first analysis | Lumecon"
  description={description}
  canonical="https://lumecon.ai/start"
  jsonLd={jsonLd}
>
  <Nav isHome={false} />
  <main class="meth start" id="top" tabindex="-1">
    <header class="meth-hero meth-hero--cover start-hero section--dark">
      <div class="meth-w">
        <div class="start-hero__copy">
          <p class="h-kicker reveal-soft">Getting started</p>
          <h1 class="meth-hero__title reveal-soft" data-stagger="1">
            Plan your <span class="brand-em">first analysis</span>.
          </h1>
          <p class="meth-hero__lede reveal-soft" data-stagger="2">
            Most organizations do not need everything to begin. They need one question worth
            answering, a boundary around it and the records they already have. Six questions
            propose a starting scope and the short list of records it needs.
          </p>
        </div>

        {/* The flow is this page's product, so it is staged the way a
            product screen is staged on the other pages: a working surface
            on the dark ground, with a caption under it. */}
        <div class="start-stage reveal-soft" data-stagger="3">
          <div class="start-stage__inner">
          <form class="pf" id="pf-form" novalidate>
            <div class="pf-rail" data-pf-rail hidden>
              <p class="pf-rail__label" data-pf-label></p>
              <div class="pf-rail__bar"><span data-pf-bar></span></div>
            </div>

            {
              STEP_GROUPS.map((group, i) => (
                <>
                  <fieldset
                    class="pf-q"
                    data-step={group.id}
                    data-advance={group.selfAdvancing ? 'self' : 'manual'}
                    tabindex="-1"
                  >
                    <legend class="pf-q__legend">
                      <span class="pf-q__num" aria-hidden="true">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      <span class="pf-q__label">{group.label}</span>
                    </legend>
                    {group.questions.map((q) => (
                      <div class="pf-part">
                        {group.questions.length > 1 ? (
                          <p class="pf-part__label">{q.label}</p>
                        ) : null}
                        {q.help ? <p class="pf-q__help">{q.help}</p> : null}
                        <div class={`pf-opts${q.options.some((o) => o.note) ? '' : ' pf-opts--tight'}`}>
                          {q.options.map((o) => (
                            <label class="pf-opt">
                              <input
                                type={q.kind === 'multi' ? 'checkbox' : 'radio'}
                                name={q.id}
                                value={o.value}
                              />
                              <span class="pf-opt__body">
                                <span class="pf-opt__label">{o.label}</span>
                                {o.note ? <span class="pf-opt__note">{o.note}</span> : null}
                              </span>
                            </label>
                          ))}
                      </div>
                    </div>
                    ))}
                  </fieldset>
                  {FOLLOW_UPS.filter((f) => group.questions.some((q) => q.id === f.after)).map((f) => (
                    <fieldset
                      class="pf-q pf-q--follow"
                      data-step={f.id}
                      data-follow={f.id}
                      data-advance="self"
                      tabindex="-1"
                    >
                      <legend class="pf-q__legend">
                        <span class="pf-q__num" aria-hidden="true">
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <span class="pf-q__label">{f.label}</span>
                      </legend>
                      <div class="pf-opts pf-opts--tight">
                        {f.options.map((o) => (
                          <label class="pf-opt">
                            <input type="radio" name={f.id} value={o.value} />
                            <span class="pf-opt__body">
                              <span class="pf-opt__label">{o.label}</span>
                            </span>
                          </label>
                        ))}
                    </div>
                    </fieldset>
                  ))}
                </>
              ))
            }

            <p class="pf-done" data-pf-done hidden>
              Your plan is below. Change an answer and it rebuilds.
            </p>

            <div class="pf-actions" hidden data-pf-actions>
              <button class="btn2 btn2--primary" type="submit" data-pf-next>
                <span data-pf-next-label>Continue</span>
                <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
              </button>
              <button class="pf-back" type="button" data-pf-back hidden>Back</button>
              <button class="pf-back" type="button" data-pf-reset hidden>Start over</button>
            </div>
            <p class="pf-noscript">
              The tailored plan needs JavaScript. Everything it draws on is on this page: the records
              we ask for and why, what more information makes possible and how the first call runs.
              Or write to <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> and an
              economist will work through it with you.
            </p>
          </form>
          </div>
          <p class="start-stage__foot">
            Nothing is uploaded here and no answer is stored. Not sure is a real answer.
          </p>
        </div>

        <ol class="start-promise" aria-label="What this gives you">
          <li class="reveal-soft" data-stagger="1">
            <p class="start-promise__k">What you can learn now</p>
            <p class="start-promise__b">
              What the records you already hold support, before anyone gathers anything new.
            </p>
          </li>
          <li class="reveal-soft" data-stagger="2">
            <p class="start-promise__k">The minimum for your question</p>
            <p class="start-promise__b">
              A short list, tied to the scope you chose rather than to everything we can read.
            </p>
          </li>
          <li class="reveal-soft" data-stagger="3">
            <p class="start-promise__k">What more would make possible</p>
            <p class="start-promise__b">
              What each further record changes about the method, and what it does not.
            </p>
          </li>
          <li class="reveal-soft" data-stagger="4">
            <p class="start-promise__k">Who has to help</p>
            <p class="start-promise__b">
              The two or three people the scope needs, and who approves sharing records.
            </p>
          </li>
        </ol>
      </div>
    </header>

    <section class="meth-sec start-sec start-sec--plan" aria-labelledby="s-plan" hidden data-plan-sec>
      <div class="meth-w">
        <h2 id="s-plan" class="visually-hidden">Your starting plan</h2>
        <div class="pf-plan" id="pf-plan" tabindex="-1" aria-live="polite"></div>
      </div>
    </section>

    <section class="meth-sec start-sec start-sec--surface" aria-labelledby="s-output">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="s-output">What a first analysis returns</h2>
          <p class="meth-sec__lede">
            The same four measures whatever the scope, separated into the activity itself, the
            suppliers it buys from and the household spending its wages support. Every figure
            stays connected to the record it came from.
          </p>
        </div>
        <div class="start-output">
          <ol class="start-output__list" role="list">
            <li>
              <p class="start-output__k">Jobs supported</p>
              <p class="start-output__b">
                Reported as jobs supported, never as jobs created. A contribution analysis has no
                counterfactual to claim one.
              </p>
            </li>
            <li>
              <p class="start-output__k">Labor income</p>
              <p class="start-output__b">
                Wages, salaries and proprietor income, which is what drives the household spending
                in the third layer.
              </p>
            </li>
            <li>
              <p class="start-output__k">Value added</p>
              <p class="start-output__b">
                The contribution to regional GDP. Labor income is a component of it, never a figure
                to add alongside.
              </p>
            </li>
            <li>
              <p class="start-output__k">Economic output</p>
              <p class="start-output__b">
                Total production supported in the region, with the direct, indirect and induced
                shares shown separately.
              </p>
            </li>
          </ol>
          <figure class="start-output__shot" data-zoom>
            <picture>
              <img
                src="/app/ex-nation-results.webp"
                alt="A completed Lumecon analysis showing jobs supported, GDP contribution, labor income and economic output, with the direct, indirect and induced split beneath. Shown with illustrative sample data."
                width="1920"
                height="1312"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption>A completed analysis. Illustrative sample data, not a customer.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="meth-sec start-sec" aria-labelledby="s-more">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="s-more">What more information makes possible</h2>
          <p class="meth-sec__lede">
            These describe what becomes possible analytically, not a ranking of quality and not a
            price list. Which of them matters depends entirely on the question being asked.
            More information can move an estimate in either direction, narrow what the analysis
            can support, or surface double counting.
          </p>
        </div>
        <ul class="start-matrix" role="list">
          {
            CAPABILITY_MATRIX.map((row) => (
              <li class="start-matrix__row">
                <p class="start-matrix__info">{row.information}</p>
                <div class="start-matrix__body">
                  <p class="start-matrix__benefit">{row.benefit}</p>
                  {row.note ? <p class="start-matrix__note">{row.note}</p> : null}
                </div>
                <p
                  class={`start-matrix__status start-matrix__status--${row.status}`}
                  title={row.review ? 'Provisional, awaiting economist review' : undefined}
                >
                  {STATUS_LABEL[row.status]}
                  {row.review ? <span class="start-matrix__review">Under review</span> : null}
                </p>
              </li>
            ))
          }
        </ul>
        <p class="start-foot">
          Available means the product accepts the input and reports the result today. Proposed means
          the behavior is specified and not yet wired through the product. In research means the
          treatment itself is still open. Rows marked under review are provisional until the
          economics team signs them off.
        </p>
      </div>
    </section>

    <section class="meth-sec start-sec" aria-labelledby="s-records">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="s-records">Every record we might ask for</h2>
          <p class="meth-sec__lede">
            Bring what exists. We would rather read the report you already produce than have you
            build a spreadsheet for us, and we will tell you what it supports before you spend time
            reformatting anything.
          </p>
        </div>
        <ul class="start-core" role="list">
          {
            CORE_RECORD_IDS.map((id, i) => (
              <li>
                <p class="start-core__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
                <div>
                  <p class="start-core__what">{RECORDS[id].what}</p>
                  <p class="start-core__why">{RECORDS[id].why}</p>
                  {RECORDS[id].alternative ? (
                    <p class="start-core__alt">
                      <span class="start-records__altk">Also works</span>{' '}
                      {RECORDS[id].alternative}
                    </p>
                  ) : null}
                </div>
                <p class="start-core__holder">{RECORDS[id].holder}</p>
              </li>
            ))
          }
        </ul>
        <p class="start-core__note">
          Almost every analysis begins with these three, for one year. What else is needed depends
          on the scope, which is what the questions above work out.
        </p>

        <details class="start-fold">
          <summary class="start-fold__sum">
            The full list, with who usually holds each one
          </summary>
          <ul class="start-records" role="list">
            {
              Object.entries(RECORDS).map(([id, r]) => (
                <li class="start-records__row" id={`rec-${id}`}>
                  <div>
                    <p class="start-records__what">{r.what}</p>
                    <p class="start-records__why">{r.why}</p>
                    {r.alternative ? (
                      <p class="start-records__alt">
                        <span class="start-records__altk">Also works</span> {r.alternative}
                      </p>
                    ) : null}
                  </div>
                  <p class="start-records__holder">{r.holder}</p>
                </li>
              ))
            }
          </ul>
        </details>
        <p class="start-foot">
          Nothing is uploaded here. Records are shared inside the product, where access is
          controlled and every file stays connected to the analysis it supports.
        </p>
      </div>
    </section>

    <section class="meth-sec start-sec" aria-labelledby="s-call">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="s-call">The first call</h2>
          <p class="meth-sec__lede">
            Thirty minutes with an economist. We invite the people the open questions need, not
            every department, and it ends with four things settled.
          </p>
        </div>
        <div class="start-call">
          <ol class="start-call__outline" role="list">
            {
              CALL_OUTLINE.map((slot) => (
                <li>
                  <p class="start-call__min">{slot.minutes} min</p>
                  <p class="start-call__title">{slot.title}</p>
                  <p class="start-call__detail">{slot.detail}</p>
                </li>
              ))
            }
          </ol>
          <div class="start-call__out">
            <p class="h-kicker">You leave with</p>
            <ul role="list">
              {
                CALL_OUTCOMES.map((o) => (
                  <li>
                    <span class="start-call__outk">{o.label}.</span> {o.detail}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="meth-sec start-sec" aria-labelledby="s-coverage">
      <div class="meth-w">
        <div class="meth-sec__head">
          <h2 id="s-coverage">How we report coverage</h2>
          <p class="meth-sec__lede">
            An analysis reports what it observed and what it assumed. These are counts and shares
            with a stated denominator, shown only where that denominator is known. None of them is
            a statement about the accuracy of the model, and none of them is a confidence score.
          </p>
        </div>
        <ul class="start-cov" role="list">
          {
            COVERAGE_INDICATORS.map((c) => (
              <li>
                <p class="start-cov__label">{c.label}</p>
                <p class="start-cov__measures">{c.measures}</p>
                <p class="start-cov__denom">
                  <span class="start-cov__denomk">Out of</span> {c.denominator}
                </p>
              </li>
            ))
          }
        </ul>
        <p class="start-foot">
          Where a total is unknown, the share is not shown. A figure such as "82 percent of payroll
          carries a work location" says what it says, and nothing about whether the multipliers are
          right.
        </p>
      </div>
    </section>

    <section class="fcta start-cta" aria-labelledby="start-cta-title">
      <div class="fcta-inner">
        <p class="h-kicker">Next step</p>
        <h2 class="fcta-title" id="start-cta-title">
          Start with one question, <span class="brand-em">not everything at once</span>.
        </h2>
        <p class="fcta-lede">
          Send one report you already have. An economist will tell you what it supports, which gaps
          matter for your question and which do not.
        </p>
        <div class="hero2-cta">
          <a class="btn2 btn2--primary" href="/signup?intent=scoping">
            Ask for a scoping conversation <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn2 btn2--card" href="/methodology">
            Read the methodology <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="fcta-contact">
          Or write to <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
        </p>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    import { QUESTIONS, STEP_GROUPS, FOLLOW_UPS, derivePlan } from '../data/planFirstAnalysis.js';

    const form = document.getElementById('pf-form') as HTMLFormElement | null;
    const panel = document.getElementById('pf-plan') as HTMLElement | null;

    if (form && panel) {
      /* Progressive enhancement. The markup ships every question visible and
         stacked, which is the version that works with no JavaScript. From
         here it becomes one question at a time: six short screens instead of
         forty options in a column. */
      const rail = form.querySelector<HTMLElement>('[data-pf-rail]');
      const label = form.querySelector<HTMLElement>('[data-pf-label]');
      const bar = form.querySelector<HTMLElement>('[data-pf-bar]');
      const actions = form.querySelector<HTMLElement>('[data-pf-actions]');
      const nextBtn = form.querySelector<HTMLButtonElement>('[data-pf-next]');
      const nextLabel = form.querySelector<HTMLElement>('[data-pf-next-label]');
      const backBtn = form.querySelector<HTMLButtonElement>('[data-pf-back]');
      const resetBtn = form.querySelector<HTMLButtonElement>('[data-pf-reset]');
      const doneNote = form.querySelector<HTMLElement>('[data-pf-done]');
      const planSec = document.querySelector<HTMLElement>('[data-plan-sec]');
      const noscript = form.querySelector<HTMLElement>('.pf-noscript');
      if (rail) rail.hidden = false;
      if (actions) actions.hidden = false;
      if (noscript) noscript.remove();
      form.classList.add('pf--stepped');

      const MULTI = new Set(QUESTIONS.filter((q) => q.kind === 'multi').map((q) => q.id));
      const FOLLOW = new Map(FOLLOW_UPS.map((f) => [f.id, f]));

      /* A screen is answered when every question on it has an answer, which
         is why the names it carries are tracked rather than the inputs. */
      const NAMES = new Map<string, string[]>();
      for (const group of STEP_GROUPS) NAMES.set(group.id, group.questions.map((q) => q.id));
      for (const follow of FOLLOW_UPS) NAMES.set(follow.id, [follow.id]);

      type Step = { id: string; el: HTMLElement; selfAdvancing: boolean; names: string[] };
      const steps: Step[] = Array.from(
        form.querySelectorAll<HTMLElement>('[data-step]'),
      ).map((el) => ({
        id: el.dataset.step as string,
        el,
        selfAdvancing: el.dataset.advance === 'self',
        names: NAMES.get(el.dataset.step as string) || [],
      }));

      let cursor = 0;
      let done = false;

      /** Current answers, read straight off the form. */
      function readAnswers(): Record<string, string | string[]> {
        const data = new FormData(form as HTMLFormElement);
        const out: Record<string, string | string[]> = {};
        for (const key of new Set(Array.from(data.keys()))) {
          const values = data.getAll(key).map(String);
          out[key] = MULTI.has(key) ? values : values[0];
        }
        return out;
      }

      /* A follow-up is a step only where its answer would change the proposed
         scope or the records requested. Anything that drops out of the path
         has its answer cleared, so a question the person never saw cannot
         reach the plan. */
      function livePath(): Step[] {
        const answers = readAnswers();
        return steps.filter((step) => {
          const follow = FOLLOW.get(step.id);
          if (!follow) return true;
          if (follow.showWhen(answers)) return true;
          for (const input of step.el.querySelectorAll<HTMLInputElement>('input')) {
            input.checked = false;
          }
          return false;
        });
      }

      function render(focus = false) {
        const path = livePath();
        if (cursor >= path.length) cursor = path.length - 1;
        if (cursor < 0) cursor = 0;
        for (const step of steps) step.el.hidden = true;
        const step = path[cursor];
        step.el.hidden = false;
        if (label) label.textContent = `Question ${cursor + 1} of ${path.length}`;
        if (bar) bar.style.setProperty('--pf-progress', `${((cursor + 1) / path.length) * 100}%`);
        const last = cursor === path.length - 1;
        if (nextLabel) nextLabel.textContent = last ? 'Show my starting plan' : 'Continue';
        /* A one-answer question moves itself on, so a Continue button beside
           it would be a control with nothing to do. It appears where it has
           work: a question that takes several answers, and the last step. */
        if (nextBtn) {
          nextBtn.hidden = !(!step.selfAdvancing || last);
          nextBtn.disabled = !answered(step);
        }
        if (backBtn) backBtn.hidden = cursor === 0;
        /* An actions row holding no actions is a rule across the page for
           nothing, so it goes with its last control. */
        if (actions) {
          actions.hidden =
            Boolean(nextBtn?.hidden) && Boolean(backBtn?.hidden) && Boolean(resetBtn?.hidden);
        }
        /* Focus the screen, not its first option: a fieldset announces its
           legend, so somebody using a screen reader hears the question that
           just replaced the one they answered. */
        if (focus) step.el.focus({ preventScroll: true });
      }

      function answered(step: Step) {
        return step.names.every((name) =>
          Boolean(step.el.querySelector(`input[name="${CSS.escape(name)}"]:checked`)),
        );
      }

      function advance() {
        const path = livePath();
        if (cursor >= path.length - 1) return false;
        cursor += 1;
        render(true);
        return true;
      }

      /** The answers live in the address bar, so a plan can be shared. */
      function writeHash() {
        const qs = new URLSearchParams();
        for (const [k, v] of Object.entries(readAnswers())) {
          if (Array.isArray(v)) {
            if (v.length) qs.set(k, v.join(','));
          } else if (v) {
            qs.set(k, String(v));
          }
        }
        const hash = qs.toString();
        history.replaceState(null, '', hash ? `#${hash}` : window.location.pathname);
      }

      const esc = (s: unknown) =>
        String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
        );

      const TIERS = [
        { key: 'begin', label: 'Needed to begin', note: 'The analysis cannot start without these.' },
        {
          key: 'refine',
          label: 'Useful for refining or extending',
          note: 'Each one replaces an assumption with something observed.',
        },
        {
          key: 'later',
          label: 'Optional, for later questions',
          note: 'Not needed now. Worth knowing they exist.',
        },
      ];

      function renderPlan(answers: Record<string, unknown>) {
        const plan = derivePlan(answers);
        const parts: string[] = [];

        parts.push('<p class="h-kicker">Your starting plan</p>');

        if (!plan.confidence.sufficient) {
          parts.push(`<div class="pf-callout"><p>${esc(plan.confidence.reason)}</p></div>`);
        } else {
          parts.push(`<p class="pf-scope">${esc(plan.scope.sentence)}</p>`);
          if (plan.scope.bounds.length) {
            parts.push(
              `<ul class="pf-bounds" role="list">${plan.scope.bounds
                .map((b) => `<li>${esc(b)}</li>`)
                .join('')}</ul>`,
            );
          }
          if (plan.confidence.caveat) {
            parts.push(`<p class="pf-caveat">${esc(plan.confidence.caveat)}</p>`);
          }
        }

        /* Two readings, never one score. The line beneath them says why. */
        parts.push(
          `<div class="pf-reads">
            <div class="pf-read">
              <p class="pf-read__k">Structure</p>
              <p class="pf-read__v">${esc(plan.structure.label)}</p>
              ${
                plan.structure.signals.length
                  ? `<ul role="list">${plan.structure.signals
                      .map((s) => `<li>${esc(s)}</li>`)
                      .join('')}</ul>`
                  : ''
              }
              <p class="pf-read__d">${esc(plan.structure.detail)}</p>
            </div>
            <div class="pf-read">
              <p class="pf-read__k">Records</p>
              <p class="pf-read__v">${esc(plan.records.label)}</p>
              ${
                plan.records.notes.length
                  ? `<ul role="list">${plan.records.notes
                      .map((n) => `<li>${esc(n)}</li>`)
                      .join('')}</ul>`
                  : ''
              }
            </div>
          </div>
          <p class="pf-reads__note">These are read separately. A complex organization often has
          excellent records, and a single operation often cannot reach its own.</p>`,
        );

        if (plan.firstOutput.can.length) {
          parts.push(
            `<section class="pf-block"><h3>What a first analysis reports</h3>
             <ul class="pf-list" role="list">${plan.firstOutput.can
               .map((c) => `<li>${esc(c)}</li>`)
               .join('')}</ul></section>`,
          );
        }
        if (plan.firstOutput.notYet.length) {
          parts.push(
            `<section class="pf-block"><h3>What it will not show yet</h3>
             <ul class="pf-list pf-list--not" role="list">${plan.firstOutput.notYet
               .map((c) => `<li>${esc(c)}</li>`)
               .join('')}</ul></section>`,
          );
        }

        for (const tier of TIERS) {
          const rows = plan.checklist.filter((r) => r.tier === tier.key);
          if (!rows.length) continue;
          parts.push(
            `<section class="pf-block"><h3>${esc(tier.label)}</h3>
             <p class="pf-block__note">${esc(tier.note)}</p>
             <ul class="pf-checks" role="list">${rows
               .map(
                 (r) => `<li class="pf-check">
                   <p class="pf-check__what">${esc(r.what)}</p>
                   <p class="pf-check__why">${esc(r.why)}</p>
                   ${
                     r.alternative
                       ? `<p class="pf-check__alt"><span>Also works</span> ${esc(r.alternative)}</p>`
                       : ''
                   }
                   <p class="pf-check__holder"><span>Usually held by</span> ${esc(r.holder)}</p>
                 </li>`,
               )
               .join('')}</ul></section>`,
          );
        }

        parts.push(
          `<section class="pf-block"><h3>Who needs to help</h3>
           <ul class="pf-people" role="list">${plan.participants
             .map((p) => `<li><span class="pf-people__role">${esc(p.role)}.</span> ${esc(p.why)}</li>`)
             .join('')}</ul></section>`,
        );

        if (plan.openQuestions.length) {
          parts.push(
            `<section class="pf-block"><h3>To settle on the call</h3>
             <p class="pf-block__note">These change the scope, so they are worth an economist&#39;s
             half hour rather than a guess.</p>
             <ul class="pf-list" role="list">${plan.openQuestions
               .map((q) => `<li>${esc(q)}</li>`)
               .join('')}</ul></section>`,
          );
        }

        const scopeLine = plan.scope.settled
          ? plan.scope.sentence
          : 'We would like help scoping a first analysis.';
        parts.push(
          `<div class="pf-plan__actions">
            <a class="btn2 btn2--primary" href="/signup?intent=scoping&interest=${encodeURIComponent(
              scopeLine,
            )}">Bring this to a scoping call <span class="btn2-arrow" aria-hidden="true">&rarr;</span></a>
            <button class="btn2 btn2--card" type="button" data-pf-print>Print this checklist</button>
            <button class="btn2 btn2--card" type="button" data-pf-copy>Copy a link to this plan</button>
          </div>
          <p class="pf-plan__foot">Provisional, and the point of the call is to correct it. The
          records above are the ones this scope needs, not everything Lumecon can read.</p>`,
        );

        panel!.innerHTML = parts.join('');
        if (planSec) planSec.hidden = false;
        if (doneNote) doneNote.hidden = false;
        done = true;
        form!.classList.add('pf--done');
        for (const step of steps) step.el.hidden = true;
        if (rail) rail.hidden = true;
        if (nextBtn) nextBtn.hidden = true;
        if (backBtn) backBtn.hidden = false;
        if (backBtn) backBtn.textContent = 'Change an answer';
        if (resetBtn) resetBtn.hidden = false;

        panel!
          .querySelector<HTMLButtonElement>('[data-pf-print]')
          ?.addEventListener('click', () => window.print());
        const copyBtn = panel!.querySelector<HTMLButtonElement>('[data-pf-copy]');
        copyBtn?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            copyBtn.textContent = 'Link copied';
          } catch {
            copyBtn.textContent = 'Copy the address bar';
          }
        });
      }

      function backToQuestions() {
        done = false;
        form!.classList.remove('pf--done');
        if (planSec) planSec.hidden = true;
        if (doneNote) doneNote.hidden = true;
        panel!.innerHTML = '';
        if (rail) rail.hidden = false;
        if (nextBtn) nextBtn.hidden = false;
        if (backBtn) backBtn.textContent = 'Back';
        render(true);
        form!.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      form.addEventListener('change', (event) => {
        writeHash();
        const step = livePath()[cursor];
        if (!step) return;
        if (nextBtn) nextBtn.disabled = !answered(step);
        /* One choice, one move. A single-answer question advances itself, so
           the common path is six taps and no Continue button at all. */
        const input = event.target as HTMLInputElement;
        if (step.selfAdvancing && input?.type === 'radio' && step.el.contains(input)) {
          window.setTimeout(() => {
            if (!done && !advance()) render();
          }, 140);
        }
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (advance()) return;
        renderPlan(readAnswers());
        panel.focus({ preventScroll: true });
        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      backBtn?.addEventListener('click', () => {
        if (done) {
          backToQuestions();
          return;
        }
        cursor = Math.max(0, cursor - 1);
        render(true);
      });

      resetBtn?.addEventListener('click', () => {
        form.reset();
        cursor = 0;
        done = false;
        form.classList.remove('pf--done');
        if (planSec) planSec.hidden = true;
        if (doneNote) doneNote.hidden = true;
        panel.innerHTML = '';
        if (rail) rail.hidden = false;
        if (nextBtn) nextBtn.hidden = false;
        if (backBtn) backBtn.textContent = 'Back';
        resetBtn.hidden = true;
        history.replaceState(null, '', window.location.pathname);
        render(true);
        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      /* A shared link carries the answers, so it opens on the plan itself. */
      function readHash() {
        const raw = window.location.hash.replace(/^#/, '');
        if (!raw) return false;
        const qs = new URLSearchParams(raw);
        let matched = false;
        for (const [key, value] of qs.entries()) {
          for (const part of value.split(',')) {
            const input = form!.querySelector<HTMLInputElement>(
              `input[name="${CSS.escape(key)}"][value="${CSS.escape(part)}"]`,
            );
            if (input) {
              input.checked = true;
              matched = true;
            }
          }
        }
        return matched;
      }

      if (readHash()) {
        cursor = Math.max(0, livePath().length - 1);
        renderPlan(readAnswers());
      } else {
        render();
      }
    }
  </script>
</BaseLayout>
