---
/**
 * /pricing — one platform, three plans.
 *
 * The old flow (pick a platform, then see per-platform tier prices)
 * is gone: there is one Lumecon application and the platform learns
 * what kind of organization the customer is. This page follows the
 * hierarchy from the pricing note:
 *
 *   1. Hero: we tailor the modeling, not the price.
 *   2. Plan cards + the detail table, then the pricing creed and the
 *      commitment policies (multi-year, lowest applicable price).
 *   3. The competitive transition offer.
 *   4. Whole Nation (differentiated capability), Workspace + Grove
 *      under one philosophy, consultant licensing.
 *
 * Cedar is explained on /cedar, not here; this page only states
 * that it is included.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MarkArt from '../components/MarkArt.astro';
import WholeNation from '../components/WholeNation.astro';
import { site } from '../config';
import { PLANS, PLAN_TABLE_ROWS, COMPETITIVE_OFFER, CONSULTANT } from '../data/pricing';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/pricing.css';

const description =
  'One platform for economic impact analysis, organizational data and reporting. Every plan includes the Lumecon model, Cedar, unlimited analysis and every supported U.S. geography. Plans from $500 a year.';

const offerMailto = `mailto:${site.email}?subject=${encodeURIComponent(COMPETITIVE_OFFER.ctaSubject)}`;
const consultantMailto = `mailto:${site.email}?subject=${encodeURIComponent(CONSULTANT.ctaSubject)}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Lumecon',
    description,
    brand: { '@type': 'Brand', name: 'Lumecon' },
    offers: [
      ...PLANS.map((p) => ({
        '@type': 'Offer',
        name: `${p.name} plan`,
        price: p.priceAnnual,
        priceCurrency: 'USD',
        url: `https://lumecon.ai/pricing#plans`,
      })),
      {
        '@type': 'Offer',
        name: 'Free trial',
        price: 0,
        priceCurrency: 'USD',
        description:
          'Create an account, bring your documents and build an analysis end to end. Full results unlock on any paid plan.',
        url: 'https://lumecon.ai/signup',
      },
    ],
  },
];
---

<BaseLayout
  title="Pricing | Lumecon"
  description={description}
  canonical="https://lumecon.ai/pricing"
  keywords="Lumecon pricing, economic impact analysis pricing, economic impact software cost, IMPLAN alternative pricing, REMI alternative pricing, economic modeling software price, Cedar AI pricing, tribal economic impact pricing, annual subscription"
  ogTitle="Lumecon pricing: one platform, plans from $500 a year"
  ogDescription={description}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="pr" id="top" tabindex="-1">
    <!-- 1. Hero -->
    <section class="pr-hero">
      <MarkArt class="markart markart--tr" size={620} />
      <div class="pr-hero__inner">
        <p class="h-kicker">Pricing</p>
        <h1 class="pr-hero__title">
          We tailor the modeling, <span class="hero2-em">not the price.</span>
        </h1>
        <p class="pr-hero__lede">
          Your organization, geography and use case shape the analysis, not what we decide to charge
          you. Every plan includes the full Lumecon model, Cedar, unlimited analysis and every
          supported U.S. geography.
        </p>
        <p class="pr-hero__callout">Starting at $500 a year. Taxes and fees included.</p>
      </div>
    </section>

    <!-- 2. Plan cards -->
    <section class="pr-plans" id="plans" aria-label="Plans">
      <div class="pr-plans__grid">
        {
          PLANS.map((p) => (
            <article
              class={`pr-plan${p.featured ? ' pr-plan--featured' : ''}`}
              id={`plan-${p.id}`}
              data-plan-card={p.ctaHref}
            >
              {p.featured && <p class="pr-plan__flag">Most popular</p>}
              <h2 class="pr-plan__name">{p.name}</h2>
              <p class="pr-plan__audience">&ldquo;{p.audience}&rdquo;</p>
              <p class="pr-plan__price">
                <span class="pr-plan__amount">{p.price}</span>
                <span class="pr-plan__period">{p.period}</span>
              </p>
              <p class="pr-plan__users">{p.users}</p>
              <p class="pr-plan__tag">{p.tagline}</p>
              <a
                class={`btn2 ${p.featured ? 'btn2--primary' : 'btn2--card'} pr-plan__cta`}
                href={p.ctaHref}
              >
                {p.ctaLabel}{' '}
                <span class="btn2-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
              <a class="pr-plan__buy" href={`/checkout?tier=${p.id}`}>
                or go straight to checkout
              </a>
            </article>
          ))
        }
      </div>

      <!-- Detail table: nine rows, readable. -->
      <div class="pr-table-wrap" role="region" aria-label="Plan comparison" tabindex="0">
        <table class="pr-table" data-plan-table>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Capability</span></th>
              {PLANS.map((p) => <th scope="col">{p.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              PLAN_TABLE_ROWS.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.values.map((v) => (
                    <td class={v === 'Same' || v === 'Not included' ? 'pr-table__quiet' : ''}>
                      {v}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="pr-plans__note">
        Every plan runs the same model on the same data foundation. Prices include taxes and fees.{
          ' '
        }
        <a class="inline-link" href="/cedar">Learn what Cedar does</a>.
      </p>
      <div class="pr-creed">
        <p class="pr-plans__creed">
          Complexity belongs in the model. <span class="brand-em">Not the pricing.</span>
        </p>
        <p class="pr-creed__trio">
          No geography-by-geography pricing. No per-analysis fees. No quote that changes because
          your organization sounds complicated.
        </p>
      </div>

      <!-- Free trial: the app is free to try; results unlock on a plan. -->
      <aside class="pr-trial" aria-label="Free trial">
        <div class="pr-trial__text">
          <p class="pr-trial__t">Still deciding? Try Lumecon for free.</p>
          <p class="pr-trial__b">
            Create an account, bring your documents and build an analysis end to end. Full results
            unlock the moment you pick a plan.
          </p>
        </div>
        <a class="btn2 btn2--primary" href="/signup?tier=free">
          Try Lumecon for free <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </section>

    <script is:inline>
      /* The whole plan card is a click target for its primary CTA; the
     links inside keep working as themselves. */
      document.querySelectorAll('[data-plan-card]').forEach(function (card) {
        card.addEventListener('click', function (e) {
          if (e.target.closest('a')) return;
          var href = card.getAttribute('data-plan-card');
          if (href) window.location.href = href;
        });
      });
    </script>

    <!-- 2b. Commitment policies: published ways to pay less, so the
         page stays "here is the price" rather than "contact us for a
         quote". -->
    <section class="pr-commit" aria-labelledby="commit-title">
      <div class="pr-commit__inner">
        <h2 class="pr-commit__title" id="commit-title">Commit longer. Pay less.</h2>
        <div class="pr-commit__cols">
          <p>
            Multi-year agreements qualify for preferred pricing, with additional savings available
            for prepaid commitments.
          </p>
          <p>
            If you qualify for multiple discounts or preferred rates, you receive the{' '}
            <span class="brand-em">lowest applicable price</span>.
          </p>
        </div>
        <p class="pr-commit__notes">
          Subscriptions renew automatically, and we email you 90 days and 30 days before the renewal
          date; auto-renew can be turned off any time from Settings inside Lumecon, and renewing for
          more than one year earns preferred pricing. Customers can also earn subscription time by
          referral: when an organization you refer becomes a Lumecon customer, we add a month to
          your subscription, up to a full year. Referrals are managed inside Lumecon.
        </p>
      </div>
    </section>

    <!-- 3. Competitive transition offer: a major program, framed as a
         large bordered panel on the white surface (no colored slab). -->
    <section class="pr-offer" id="switch" aria-labelledby="offer-title">
      <div class="pr-offer__panel">
        <MarkArt class="markart markart--offer" size={520} />
        <header class="pr-offer__head">
          <p class="h-kicker">Competitive transition offer</p>
          <h2 class="pr-offer__title" id="offer-title">{COMPETITIVE_OFFER.headline}</h2>
          <p class="pr-offer__big">{COMPETITIVE_OFFER.subhead}</p>
          <p class="pr-offer__lede">{COMPETITIVE_OFFER.body}</p>
          <p class="pr-offer__guarantee">{COMPETITIVE_OFFER.guarantee}</p>
        </header>
        <div class="pr-offer__cta">
          <a class="btn2 btn2--primary" href={offerMailto}>
            {COMPETITIVE_OFFER.ctaLabel}
            <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="pr-offer__fine">{COMPETITIVE_OFFER.finePrint}</p>
      </div>
    </section>

    <!-- 4. Whole Nation: a genuinely differentiated capability. -->
    <WholeNation />

    <!-- 5. Team Workspace and Cedar Grove, under one philosophy. -->
    <section class="flowsec" id="workspace-grove" aria-labelledby="wg-title">
      <div class="flowsec-inner">
        <header class="flowsec-head">
          <h2 class="flowsec-title" id="wg-title">
            Higher plans add collaboration and memory, <span class="brand-em"
              >not a better economic model.</span
            >
          </h2>
        </header>
        <div class="pr-duo">
          <article class="pr-duo__card">
            <p class="h-kicker">Team Workspace &middot; Sapling</p>
            <p class="pr-duo__body">
              Shared projects, collaborative analysis, review and project management.
            </p>
          </article>
          <article class="pr-duo__card pr-duo__card--grove">
            <p class="h-kicker h-kicker--cedar">Cedar Grove &middot; Tree</p>
            <p class="pr-duo__body">
              A reusable organizational data and context layer combining Lumecon&rsquo;s
              analysis-ready datasets with your approved internal information.
            </p>
          </article>
        </div>
        <p class="pr-duo__creed">
          The economics stay the same. What changes is how much of your organization can work around
          them.
        </p>
      </div>
    </section>

    <!-- 7. Consultants -->
    <section class="flowsec pr-consult" id="consultants" aria-labelledby="consult-title">
      <div class="flowsec-inner">
        <header class="flowsec-head">
          <p class="h-kicker">{CONSULTANT.headline}</p>
          <h2 class="flowsec-title" id="consult-title">{CONSULTANT.positioning}</h2>
          <p class="pr-consult__audience">&ldquo;{CONSULTANT.audience}&rdquo;</p>
          <p class="flowsec-lede">{CONSULTANT.body}</p>
        </header>
        <ul class="pr-consult__points">
          {CONSULTANT.points.map((pt) => <li>{pt}</li>)}
        </ul>
        <div>
          <a class="btn2 btn2--primary" href={consultantMailto}>
            {CONSULTANT.ctaLabel}
            <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="pr-consult__note">{CONSULTANT.note}</p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
