---
/**
 * /pricing — one coherent thesis: standard pricing, tailored modeling.
 *
 * Lumecon is not less expensive because it is a stripped-down tool. It
 * is less expensive because it was built recently, on modern
 * infrastructure, around a simpler business model, without the
 * licensing constraints and commercial overhead that historically
 * surrounded professional economic modeling. The page structure after
 * the founder's shortening pass (each proposition argued exactly once):
 *
 *   1. Hero: simplicity as the opening argument.
 *   2. Free-account band: "don't take our word for it", before the tiers.
 *   3. Three understandable plans, consultant band, detail table.
 *   4. Complexity belongs in the model (product side, with the trio).
 *   5. Better economics made better pricing possible (the candid why).
 *   6. Commitment pricing.
 *   7. Pricing FAQ carries the skepticism; the table carries features.
 *
 * The reader should leave knowing: the model is serious, the pricing is
 * simple, they can verify the product free without a card, the plan
 * improves as Lumecon improves, and more of their money goes into the
 * thing they are buying than into the machinery selling it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MarkArt from '../components/MarkArt.astro';
import { site } from '../config';
import { PLANS, PLAN_TABLE_ROWS, CONSULTANT_BAND, PRICING_FAQ } from '../data/pricing';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/pricing.css';

const description =
  'Every paid Lumecon plan includes the full economic modeling foundation, unlimited analysis, every supported U.S. geography and Cedar. Higher plans add collaboration, organizational data capabilities and scale. Plans start at $1,000 a year, prices are public and you can try Lumecon free without a credit card.';

const bandMailto = `mailto:${site.email}?subject=${encodeURIComponent(CONSULTANT_BAND.ctaSubject)}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Lumecon',
    description,
    brand: { '@type': 'Brand', name: 'Lumecon' },
    offers: [
      ...PLANS.map((p) => ({
        '@type': 'Offer',
        name: `${p.name} plan`,
        price: p.priceAnnual,
        priceCurrency: 'USD',
        url: `https://lumecon.ai/pricing#plans`,
      })),
      {
        '@type': 'Offer',
        name: 'Free account',
        price: 0,
        priceCurrency: 'USD',
        description:
          'Create an account without a credit card, bring your documents, use Cedar and build an analysis end to end. Complete results unlock on any paid plan.',
        url: 'https://lumecon.ai/signup',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: PRICING_FAQ.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];
---

<BaseLayout
  title="Pricing | Lumecon"
  description={description}
  canonical="https://lumecon.ai/pricing"
  keywords="Lumecon pricing, economic impact analysis pricing, economic impact software cost, IMPLAN alternative pricing, REMI alternative pricing, economic modeling software price, Cedar AI pricing, tribal economic impact pricing, annual subscription, free economic impact software trial"
  ogTitle="Lumecon pricing: standard pricing, tailored modeling"
  ogDescription={description}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="pr" id="top" tabindex="-1">
    <!-- 1. Hero: simplicity is the opening argument. -->
    <section class="pr-hero">
      <MarkArt class="markart markart--tr" size={620} />
      <div class="pr-hero__inner">
        <p class="h-kicker">Pricing</p>
        <h1 class="pr-hero__title">
          We tailor the modeling. <span class="hero2-em">Your pricing stays standard.</span>
        </h1>
        <p class="pr-hero__sub">However complex your organization is, the pricing stays simple.</p>
        <p class="pr-hero__lede">
          Every paid Lumecon plan includes the full economic modeling foundation, unlimited
          analysis, every supported U.S. geography and Cedar. Higher plans add collaboration,
          organizational data capabilities and scale, and every tier runs the same economics.
        </p>
        <p class="pr-hero__callout">
          Plans start at $1,000 a year, and every price is on this page.
        </p>
        <div class="pr-hero__ctas">
          <a class="btn2 btn2--primary" href="/signup?tier=free">
            Try Lumecon for free <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn2 btn2--card" href="#plans">Compare plans</a>
        </div>
      </div>
    </section>

    <!-- 2. The free account, promoted: don't take our word for it. -->
    <section class="pr-plans" id="plans" aria-label="Plans">
      <aside class="pr-free" aria-labelledby="free-title">
        <div class="pr-free__main">
          <p class="h-kicker">The free account is the real product</p>
          <h2 class="pr-free__title" id="free-title">Don&rsquo;t take our word for it.</h2>
          <p class="pr-free__body">
            Create a free account and use the actual Lumecon platform. Bring your documents, work
            with Cedar and build an analysis end to end. There is no credit card, countdown or sales
            call. Full results unlock when you choose a paid plan.
          </p>
        </div>
        <div class="pr-free__side">
          <a class="btn2 btn2--primary" href="/signup?tier=free">
            Try Lumecon free <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <p class="pr-free__terms">No credit card &middot; No expiration &middot; No obligation</p>
        </div>
      </aside>

      <!-- 3. Three understandable plans. -->
      <div class="pr-plans__grid">
        {
          PLANS.map((p) => (
            <article
              class={`pr-plan${p.featured ? ' pr-plan--featured' : ''}`}
              id={`plan-${p.id}`}
              data-plan-card={p.ctaHref}
            >
              {p.featured && <p class="pr-plan__flag">Recommended</p>}
              <h2 class="pr-plan__name">{p.name}</h2>
              <p class="pr-plan__audience">&ldquo;{p.audience}&rdquo;</p>
              <p class="pr-plan__price">
                <span class="pr-plan__amount">{p.price}</span>
                <span class="pr-plan__period">{p.period}</span>
              </p>
              <p class="pr-plan__users">{p.users}</p>
              <p class="pr-plan__tag">{p.tagline}</p>
              <a
                class={`btn2 ${p.featured ? 'btn2--primary' : 'btn2--card'} pr-plan__cta`}
                href={p.ctaHref}
              >
                {p.ctaLabel}{' '}
                <span class="btn2-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            </article>
          ))
        }
      </div>

      <!-- Consultants: same plans, no separate edition. -->
      <aside class="pr-band" id="consultants" aria-labelledby="band-title">
        <div class="pr-band__main">
          <p class="h-kicker">{CONSULTANT_BAND.kicker}</p>
          <h2 class="pr-band__title" id="band-title">{CONSULTANT_BAND.headline}</h2>
          <p class="pr-band__body">{CONSULTANT_BAND.body}</p>
          <p class="pr-band__value">{CONSULTANT_BAND.value}</p>
        </div>
        <a class="btn2 btn2--card pr-band__cta" href={bandMailto}>
          {CONSULTANT_BAND.ctaLabel}
          <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>

      <!-- Detail table, folded away by default. The cards answer the question
           for most readers; the grid is for someone checking one capability.
           <details> rather than scripted state: no JavaScript, and keyboard
           operable for free. -->
      <details class="pr-more">
        <summary class="pr-more__summary">
          <span class="pr-more__label">Compare all plans</span>
          <span class="pr-more__hint">Every capability, side by side</span>
          <span class="pr-more__chev" aria-hidden="true"></span>
        </summary>
        <div class="pr-more__body">
          <div class="pr-table-wrap" role="region" aria-label="Plan comparison" tabindex="0">
            <table class="pr-table" data-plan-table>
              <thead>
                <tr>
                  <th scope="col"><span class="visually-hidden">Capability</span></th>
                  {PLANS.map((p) => <th scope="col">{p.name}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  PLAN_TABLE_ROWS.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      {row.values.map((v) => (
                        <td class={v === 'Same' || v === 'Not included' ? 'pr-table__quiet' : ''}>
                          {v}
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </details>
      <p class="pr-plans__note">
        Every plan runs the same model on the same data foundation. Prices include taxes and fees.{
          ' '
        }
        <a class="inline-link" href="/cedar">Learn what Cedar does</a>.
      </p>
    </section>

    <script is:inline>
      /* The whole plan card is a click target for its primary CTA; the
     links inside keep working as themselves. */
      document.querySelectorAll('[data-plan-card]').forEach(function (card) {
        card.addEventListener('click', function (e) {
          if (e.target.closest('a')) return;
          var href = card.getAttribute('data-plan-card');
          if (href) window.location.href = href;
        });
      });
    </script>

    <!-- 4. The product side: complexity is what the software is for. -->
    <section class="flowsec" aria-labelledby="why-title">
      <div class="flowsec-inner">
        <header class="flowsec-head">
          <h2 class="flowsec-title" id="why-title">
            Complexity belongs in the model, <span class="brand-em"
              >and the pricing stays simple.</span
            >
          </h2>
          <p class="flowsec-lede">
            Complex organizations can involve multiple years, multiple geographies, multiple
            enterprises, complicated organizational structures and specialized analyses. Lumecon
            doesn&rsquo;t charge more because the underlying question is harder.
          </p>
        </header>
        <p class="pr-why__single">
          Every paid plan uses the same economic modeling foundation. Higher plans reflect things
          that actually increase with organizational use: more people, collaboration, storage, data
          capabilities and support.
        </p>
        <ul class="pr-trio" role="list">
          <li class="pr-trio__item">
            <h3 class="pr-trio__t">One model</h3>
            <p class="pr-trio__b">The same economic foundation across every paid plan.</p>
          </li>
          <li class="pr-trio__item">
            <h3 class="pr-trio__t">Any supported geography</h3>
            <p class="pr-trio__b">No county, state or homelands add-ons.</p>
          </li>
          <li class="pr-trio__item">
            <h3 class="pr-trio__t">Unlimited analysis</h3>
            <p class="pr-trio__b">Complexity doesn&rsquo;t create another invoice.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- 5. The candid why, once. -->
    <section class="flowsec pr-economics" aria-labelledby="econ-title">
      <div class="flowsec-inner">
        <header class="flowsec-head">
          <h2 class="flowsec-title" id="econ-title">
            Better economics made <span class="brand-em">better pricing</span> possible.
          </h2>
          <p class="flowsec-lede">
            Economic impact analysis is established economic science. The expensive part is building
            and maintaining a reliable system around it: integrating changing datasets, cleaning and
            harmonizing them, regionalizing the model correctly, protecting organizational data and
            continuously validating the results.
          </p>
        </header>
        <div class="prose-stack">
          <p>
            Modern cloud computing makes that system dramatically less expensive to operate than it
            once was. We built Lumecon around that reality from the beginning, and lower cost never
            means lower standards: the methods are public at{' '}
            <a class="inline-link" href="/methodology">lumecon.ai/methodology</a>.
          </p>
          <p>
            We also spend less selling the platform and more improving it, which is why the price
            sits on this page instead of behind a call.
          </p>
        </div>
      </div>
    </section>

    <!-- 7. Commitment pricing, kept simple. -->
    <section class="pr-commit" aria-labelledby="commit-title">
      <div class="pr-commit__inner">
        <h2 class="pr-commit__title" id="commit-title">
          Straightforward pricing gets better with commitment.
        </h2>
        <div class="prose-stack">
          <p>Multi-year and prepaid commitments can receive preferred pricing.</p>
          <p>
            If you qualify for multiple discounts or program rates, you receive the{' '}
            <span class="brand-em">lowest applicable price</span> according to the program rules.
          </p>
        </div>
        <details class="pr-more pr-more--inline">
          <summary class="pr-more__summary">
            <span class="pr-more__label">Renewal and referrals</span>
            <span class="pr-more__chev" aria-hidden="true"></span>
          </summary>
          <div class="pr-more__body">
            <p class="pr-commit__notes">
              Subscriptions renew automatically. We email you 90 days and 30 days before the renewal
              date, and auto-renew can be turned off any time from Settings inside Lumecon.
            </p>
            <p class="pr-commit__notes">
              Refer an organization and we add a month to your subscription when they become a
              customer, up to a full year. Referrals are managed inside Lumecon.
            </p>
          </div>
        </details>
      </div>
    </section>

    <!-- 8. The FAQ carries the skepticism. -->
    <section class="flowsec pr-faq" id="faq" aria-labelledby="faq-title">
      <div class="flowsec-inner">
        <header class="flowsec-head">
          <h2 class="flowsec-title" id="faq-title">Pricing questions, answered plainly.</h2>
        </header>
        <div class="pr-faq__list">
          {
            PRICING_FAQ.map((f) => (
              <details class="pr-more pr-more--faq">
                <summary class="pr-more__summary">
                  <span class="pr-more__q">{f.q}</span>
                  <span class="pr-more__chev" aria-hidden="true" />
                </summary>
                <div class="pr-more__body">
                  {f.a.map((para) => (
                    <p class="pr-faq__p">{para}</p>
                  ))}
                </div>
              </details>
            ))
          }
        </div>
        <p class="pr-faq__foot">
          We are removing the old reasons rigorous economic analysis had to cost so much. What is
          left is the analysis, at a fair price.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
