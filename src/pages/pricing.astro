---
/**
 * /pricing — pricing and an FAQ, and very little else.
 *
 * Lumecon is meant to be self-serve. Someone deciding can read the
 * methodology, see the prices, try the product free and have their
 * remaining objection answered without emailing anyone. So this page
 * carries the numbers and the objections; the rest of the site carries
 * the product. The two full-width prose sections that used to argue
 * "complexity belongs in the model" and "better economics made better
 * pricing possible" are FAQ answers now, which is where a reader goes
 * looking for them anyway, and the commitment-pricing section is one
 * more question rather than a section of its own.
 *
 *   1. Hero: one model, clear annual pricing.
 *   2. Free-account band: don't take our word for it, before the tiers.
 *   3. Four plans led by Seed, the client-work marker, and Cedar Grove
 *      on its own.
 *   4. The full comparison table, folded away.
 *   5. The FAQ: one sentence to click, the argument behind it.
 *
 * The consultant band is gone. A consultancy needed to read a paragraph
 * to learn which plans cover client work; now the plan cards say so,
 * which is where the decision is being made.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import {
  SEED,
  PLANS,
  PLAN_TABLE_ROWS,
  CLIENT_WORK,
  CEDAR_GROVE,
  PRICING_FAQ,
} from '../data/pricing';

// Seed leads the card row and the table columns; PLANS stays the
// purchasable set that choose-plan and checkout iterate.
const ALL_PLANS = [SEED, ...PLANS];
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/pricing.css';

const description =
  'Every price on one page. Paid plans start at $1,000 a year with unlimited analyses, every supported U.S. geography and Cedar. Request Seed access for free.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://lumecon.ai/pricing#webpage',
    name: 'Pricing | Lumecon',
    url: 'https://lumecon.ai/pricing',
    description,
    isPartOf: { '@id': 'https://lumecon.ai#website' },
    about: { '@id': 'https://lumecon.ai#application' },
    publisher: { '@id': 'https://lumecon.ai#org' },
    inLanguage: 'en-US',
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://lumecon.ai' },
        { '@type': 'ListItem', position: 2, name: 'Pricing', item: 'https://lumecon.ai/pricing' },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Lumecon',
    description,
    brand: { '@type': 'Brand', name: 'Lumecon' },
    offers: [
      ...ALL_PLANS.map((p) => ({
        '@type': 'Offer',
        name: `${p.name} plan`,
        price: p.priceAnnual,
        priceCurrency: 'USD',
        ...(p.id === 'free' ? { description: p.tagline } : {}),
        url: `https://lumecon.ai/pricing#plans`,
      })),
      {
        '@type': 'Offer',
        name: 'Cedar Grove',
        price: 2500,
        priceCurrency: 'USD',
        description: CEDAR_GROVE.body,
        url: 'https://lumecon.ai/pricing#cedar-grove',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: PRICING_FAQ.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
    })),
  },
];
---

<BaseLayout
  title="Pricing | Lumecon"
  description={description}
  canonical="https://lumecon.ai/pricing"
  ogTitle="Lumecon pricing: one model, clear annual pricing"
  ogDescription={description}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="pr" id="top" tabindex="-1">
    {/* 1. Hero: simplicity is the opening argument. */}
    <section class="pr-hero">
      <div class="pr-hero__inner" data-reveal-group>
        <div class="pr-hero__copy">
          <p class="h-kicker">Pricing</p>
          <h1 class="pr-hero__title">
            Complete economic analysis with <span class="hero2-em">transparent annual pricing.</span
            >
          </h1>
          <p class="pr-hero__lede">
            Every paid plan runs the same regionalized input-output model with unlimited analyses
            and every supported U.S. geography. Higher plans add collaboration, organizational
            memory and scale. No per-analysis fees or geography add-ons.
          </p>
          <p class="pr-hero__callout">
            Plans start at $1,000 a year, and every price is on this page.
          </p>
          <div class="pr-hero__ctas">
            <a class="btn2 btn2--primary" href="/signup?tier=free">
              Request Seed access <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="btn2 btn2--card" href="#plans">Compare plans</a>
          </div>
        </div>
        <aside class="pr-hero__ledger" aria-label="Annual plan prices">
          <p class="pr-hero__ledger-k">Annual access</p>
          <ul>
            {
              ALL_PLANS.map((p) => (
                <li class={p.featured ? 'is-featured' : ''}>
                  <span>{p.name}</span>
                  <strong>{p.price}</strong>
                </li>
              ))
            }
          </ul>
          <p class="pr-hero__ledger-note">
            Every paid plan includes the same model, every supported geography and unlimited
            analyses.
          </p>
        </aside>
      </div>
    </section>

    {/* 2. The free account, promoted: don't take our word for it. */}
    <section class="pr-plans" id="plans" aria-label="Plans">
      <aside class="pr-free" aria-labelledby="free-title">
        <div class="pr-free__main">
          <p class="h-kicker">Evaluate Lumecon with Seed</p>
          <h2 class="pr-free__title" id="free-title">Request Seed access.</h2>
          <p class="pr-free__body">
            Access is opening in waves. Once admitted, bring your documents, work with Cedar, build
            an analysis and review direct effects on the results page. Indirect, induced and total
            effects unlock on a paid plan.
          </p>
        </div>
        <div class="pr-free__side">
          <a class="btn2 btn2--primary" href="/signup?tier=free">
            Request Seed access <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <p class="pr-free__terms">No credit card, expiration or obligation.</p>
        </div>
      </aside>

      {/* 3. Four understandable plans, Seed first. */}
      <div class="pr-plans__grid">
        {
          ALL_PLANS.map((p) => (
            <article class={`pr-plan${p.featured ? ' pr-plan--featured' : ''}`} id={`plan-${p.id}`}>
              <div class="pr-plan__head">
                <h2 class="pr-plan__name">{p.name}</h2>
                {p.featured && <p class="pr-plan__flag">Recommended</p>}
              </div>
              {/* Always rendered so the three cards keep the same rhythm.
                  Without the placeholder Sprout's price sat a chip-height
                  above the other two and the row read as ragged. */}
              <p
                class={`pr-plan__chip${p.clientWork ? '' : ' pr-plan__chip--placeholder'}`}
                aria-hidden={p.clientWork ? undefined : 'true'}
              >
                {CLIENT_WORK.chip}
              </p>
              <p class="pr-plan__audience">{p.audience}</p>
              <p class="pr-plan__price">
                <span class="pr-plan__amount">{p.price}</span>
                <span class="pr-plan__period">{p.period}</span>
              </p>
              <p class="pr-plan__users">{p.users}</p>
              <p class="pr-plan__tag">{p.tagline}</p>
              <a
                class={`btn2 ${p.featured ? 'btn2--primary' : 'btn2--card'} pr-plan__cta`}
                href={p.ctaHref}
              >
                {p.ctaLabel}{' '}
                <span class="btn2-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            </article>
          ))
        }
      </div>

      {
        /* One line for what used to be a consultant band. The cards
           carry the marker; this says what the marker means. */
      }
      <p class="pr-plans__clientnote" id="consultants">{CLIENT_WORK.note}</p>

      {
        /* Cedar Grove: the data library, sold on its own. It sits after
           the plans rather than as a fourth card because it is not a
           fourth tier of the same thing: no economic model, no Cedar
           Commons, unlimited people. Pricing it here is also what shows
           the model and Commons are the larger part of Tree. */
      }
      <aside class="pr-grove" id="cedar-grove" aria-labelledby="grove-title">
        <div class="pr-grove__main">
          <p class="h-kicker">{CEDAR_GROVE.kicker}</p>
          <h2 class="pr-grove__title" id="grove-title">
            {CEDAR_GROVE.name}. <span class="brand-em">{CEDAR_GROVE.headline}</span>
          </h2>
          <p class="pr-grove__body">{CEDAR_GROVE.body}</p>
          <ul class="pr-grove__list" role="list">
            {CEDAR_GROVE.bullets.map((t) => <li>{t}</li>)}
          </ul>
          <p class="pr-grove__note">{CEDAR_GROVE.proprietaryNote}</p>
          {
            CEDAR_GROVE.proprietaryDatasets.length > 0 && (
              <ul class="pr-grove__datasets" role="list">
                {CEDAR_GROVE.proprietaryDatasets.map((d) => (
                  <li>
                    <span class="pr-grove__dsname">{d.name}</span> {d.blurb}
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="pr-grove__side">
          <p class="pr-grove__price">
            <span class="pr-plan__amount">{CEDAR_GROVE.price}</span>
            <span class="pr-plan__period">{CEDAR_GROVE.period}</span>
          </p>
          <p class="pr-grove__users">{CEDAR_GROVE.users}</p>
          <a class="btn2 btn2--card pr-grove__cta" href={CEDAR_GROVE.ctaHref}>
            {CEDAR_GROVE.ctaLabel}
            <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </aside>

      {
        /* Detail table, folded away by default. The cards answer the question
           for most readers; the grid is for someone checking one capability.
           <details> rather than scripted state: no JavaScript, and keyboard
           operable for free. */
      }
      <details class="pr-more">
        <summary class="pr-more__summary">
          <span class="pr-more__label">Compare all plans</span>
          <span class="pr-more__hint">Every capability, side by side</span>
          <span class="pr-more__chev" aria-hidden="true"></span>
        </summary>
        <div class="pr-more__body">
          <div class="pr-table-wrap" role="region" aria-label="Plan comparison" tabindex="0">
            <table class="pr-table" data-plan-table>
              <thead>
                <tr>
                  <th scope="col"><span class="visually-hidden">Capability</span></th>
                  {ALL_PLANS.map((p) => <th scope="col">{p.name}</th>)}
                </tr>
              </thead>
              <tbody>
                {
                  PLAN_TABLE_ROWS.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      {row.values.map((v) => (
                        <td class={v === 'Same' || v === 'Not included' ? 'pr-table__quiet' : ''}>
                          {v}
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </details>
      <p class="pr-plans__note">
        Every paid plan includes Cedar Impact in full, on the same data foundation; Seed shows your
        direct effects. Prices include taxes and fees.{' '}
        <a class="inline-link" href="/cedar">Learn what Cedar does</a>.
      </p>
    </section>

    {
      /* The FAQ is the body of the page now: everything the two prose
         sections and the commitment section used to argue is an answer
         behind a one-sentence question. */
    }
    <section class="flowsec pr-faq" id="faq" aria-labelledby="faq-title">
      <div class="flowsec-inner">
        <header class="flowsec-head" data-reveal-group>
          <h2 class="flowsec-title" id="faq-title">Questions about plans and billing.</h2>
        </header>
        <div class="pr-faq__list">
          {
            PRICING_FAQ.map((f) => (
              <details class="pr-more pr-more--faq">
                <summary class="pr-more__summary">
                  <span class="pr-more__q">{f.q}</span>
                  <span class="pr-more__chev" aria-hidden="true" />
                </summary>
                <div class="pr-more__body">
                  {f.a.map((para) => (
                    <p class="pr-faq__p">{para}</p>
                  ))}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
