---
/**
 * /pricing — one platform, three plans.
 *
 * The old flow (pick a platform, then see per-platform tier prices)
 * is gone: there is one Lumecon application and the platform learns
 * what kind of organization the customer is. This page follows the
 * hierarchy from the pricing note:
 *
 *   1. Hero: economic analysis without enterprise software pricing.
 *   2. Three plan cards (Sapling recommended) + the 9-row detail
 *      table (kept deliberately readable; capabilities live inside
 *      Cedar, Team Workspace and Cedar Grove rather than as 25
 *      feature rows).
 *   3. The 50% competitive transition offer, presented as a major
 *      program immediately below the table.
 *   4. Why Lumecon is different, Whole Nation, Cedar, Team
 *      Workspace and Cedar Grove.
 *   5. Consultant licensing (custom pricing, no public number).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MarkArt from '../components/MarkArt.astro';
import WholeNation from '../components/WholeNation.astro';
import CedarFlow from '../components/CedarFlow.astro';
import { site } from '../config';
import { PLANS, PLAN_TABLE_ROWS, COMPETITIVE_OFFER, CONSULTANT } from '../data/pricing';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/home.css';
import '../styles/pricing.css';

const description =
  'One platform for economic impact analysis, organizational data and reporting. Every plan includes the Lumecon model, Cedar, unlimited analysis and every supported U.S. geography. Plans from $500 a year.';

const offerMailto = `mailto:${site.email}?subject=${encodeURIComponent(COMPETITIVE_OFFER.ctaSubject)}`;
const consultantMailto = `mailto:${site.email}?subject=${encodeURIComponent(CONSULTANT.ctaSubject)}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Lumecon',
    description,
    brand: { '@type': 'Brand', name: 'Lumecon' },
    offers: [
      ...PLANS.map((p) => ({
        '@type': 'Offer',
        name: `${p.name} plan`,
        price: p.priceAnnual,
        priceCurrency: 'USD',
        url: `https://lumecon.ai/pricing#plans`,
      })),
      {
        '@type': 'Offer',
        name: 'Free trial',
        price: 0,
        priceCurrency: 'USD',
        description:
          'Create an account, bring your documents and build an analysis end to end. Full results unlock on any paid plan.',
        url: 'https://lumecon.ai/signup',
      },
    ],
  },
];
---

<BaseLayout
  title="Pricing | Lumecon"
  description={description}
  canonical="https://lumecon.ai/pricing"
  keywords="Lumecon pricing, economic impact analysis pricing, economic impact software cost, IMPLAN alternative pricing, REMI alternative pricing, economic modeling software price, Cedar AI pricing, tribal economic impact pricing, annual subscription"
  ogTitle="Lumecon pricing: one platform, plans from $500 a year"
  ogDescription={description}
  jsonLd={jsonLd}
>
  <Nav />
  <main class="pr">
    <!-- 1. Hero -->
    <section class="pr-hero">
      <MarkArt class="markart markart--tr" size={620} />
      <div class="pr-hero__inner">
        <p class="h-kicker">Pricing</p>
        <h1 class="pr-hero__title">
          Economic analysis without <span class="hero2-em">enterprise software pricing.</span>
        </h1>
        <p class="pr-hero__lede">
          One platform for economic impact analysis, organizational data and reporting. Every plan
          includes the Lumecon model, Cedar, unlimited analysis and every supported U.S. geography.
        </p>
        <p class="pr-hero__callout">Starting at $500 a year.</p>
      </div>
    </section>

    <!-- 2. Plan cards -->
    <section class="pr-plans" id="plans" aria-label="Plans">
      <div class="pr-plans__grid">
        {
          PLANS.map((p) => (
            <article class={`pr-plan${p.featured ? ' pr-plan--featured' : ''}`} id={`plan-${p.id}`}>
              {p.featured && <p class="pr-plan__flag">Most popular</p>}
              <h2 class="pr-plan__name">{p.name}</h2>
              <p class="pr-plan__audience">&ldquo;{p.audience}&rdquo;</p>
              <p class="pr-plan__price">
                <span class="pr-plan__amount">{p.price}</span>
                <span class="pr-plan__period">{p.period}</span>
              </p>
              <p class="pr-plan__users">{p.users}</p>
              <p class="pr-plan__tag">{p.tagline}</p>
              <a
                class={`btn2 ${p.featured ? 'btn2--primary' : 'btn2--card'} pr-plan__cta`}
                href={p.ctaHref}
              >
                {p.ctaLabel}{' '}
                <span class="btn2-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
              <a class="pr-plan__buy" href={`/checkout?tier=${p.id}`}>
                or go straight to checkout
              </a>
            </article>
          ))
        }
      </div>

      <!-- Detail table: nine rows, readable. -->
      <div class="pr-table-wrap" role="region" aria-label="Plan comparison" tabindex="0">
        <table class="pr-table" data-plan-table>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Capability</span></th>
              {PLANS.map((p) => <th scope="col">{p.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              PLAN_TABLE_ROWS.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.values.map((v) => (
                    <td class={v === 'Same' || v === 'Not included' ? 'pr-table__quiet' : ''}>
                      {v}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="pr-plans__note">
        Every plan runs the same model on the same data foundation. Higher plans add collaboration,
        organizational memory and scale.
      </p>

      <!-- Free trial: the app is free to try; results unlock on a plan. -->
      <aside class="pr-trial" aria-label="Free trial">
        <div class="pr-trial__text">
          <p class="pr-trial__t">Still deciding? Try Lumecon for free.</p>
          <p class="pr-trial__b">
            Create an account, bring your documents and build an analysis end to end. Full results
            unlock the moment you pick a plan.
          </p>
        </div>
        <a class="btn2 btn2--primary" href="/signup">
          Try Lumecon for free <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </section>

    <!-- 3. Competitive transition offer: a major program, framed as a
         large bordered panel on the white surface (no colored slab). -->
    <section class="pr-offer" id="switch" aria-labelledby="offer-title">
      <div class="pr-offer__panel">
        <MarkArt class="markart markart--offer" size={520} />
        <header class="pr-offer__head">
          <p class="h-kicker">Competitive transition offer</p>
          <h2 class="pr-offer__title" id="offer-title">{COMPETITIVE_OFFER.headline}</h2>
          <p class="pr-offer__big">{COMPETITIVE_OFFER.subhead}</p>
          <p class="pr-offer__lede">{COMPETITIVE_OFFER.body}</p>
        </header>
        <div class="pr-offer__cta">
          <a class="btn2 btn2--primary" href={offerMailto}>
            {COMPETITIVE_OFFER.ctaLabel}
            <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="pr-offer__fine">{COMPETITIVE_OFFER.finePrint}</p>
      </div>
    </section>

    <!-- 4. Why different -->
    <section class="pr-why" aria-label="Why Lumecon is different">
      <ul class="pr-why__grid">
        <li>
          <p class="pr-why__t">Every geography.</p>
          <p class="pr-why__b">Counties, states, the nation and reservations.</p>
        </li>
        <li>
          <p class="pr-why__t">Unlimited analysis.</p>
          <p class="pr-why__b">No per-project fees and no geography add-ons.</p>
        </li>
        <li>
          <p class="pr-why__t">Cedar included.</p>
          <p class="pr-why__b">AI-assisted data intake, analysis and reporting in every plan.</p>
        </li>
        <li>
          <p class="pr-why__t">Built for Tribal Nations too.</p>
          <p class="pr-why__b">
            Tribal government, tribal enterprise and Whole Nation analysis are core architecture.
          </p>
        </li>
      </ul>
    </section>

    <!-- 5. Whole Nation + Cedar (shared homepage components) -->
    <WholeNation />
    <CedarFlow />

    <!-- 6. Team Workspace and Cedar Grove -->
    <section class="flowsec" id="workspace-grove" aria-label="Team Workspace and Cedar Grove">
      <div class="flowsec-inner">
        <div class="pr-duo">
          <article class="pr-duo__card">
            <p class="h-kicker">Team Workspace &middot; Sapling and up</p>
            <h2 class="pr-duo__title">Economic analysis becomes collaborative.</h2>
            <p class="pr-duo__body">
              Work from shared projects and inputs, collaborate on analyses, manage the work, review
              results and keep everyone in the same analytical environment. Sprout is for an
              individual. Sapling is for a team.
            </p>
          </article>
          <article class="pr-duo__card pr-duo__card--grove">
            <p class="h-kicker h-kicker--cedar">Cedar Grove &middot; Tree</p>
            <h2 class="pr-duo__title">Your organization&rsquo;s economic data library.</h2>
            <p class="pr-duo__body">
              Bring together administrative data, recurring internal datasets, prior analyses and
              other approved sources in one persistent library. Cedar Grove integrates that
              information with Lumecon so it can be reused across projects, analysis and recurring
              reporting.
            </p>
            <p class="pr-duo__body">
              Cedar understands the analysis you&rsquo;re working on. Cedar Grove remembers the
              organization you&rsquo;re working for.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- 7. Consultants -->
    <section class="flowsec pr-consult" id="consultants" aria-labelledby="consult-title">
      <div class="flowsec-inner">
        <header class="flowsec-head">
          <p class="h-kicker">{CONSULTANT.headline}</p>
          <h2 class="flowsec-title" id="consult-title">{CONSULTANT.positioning}</h2>
          <p class="pr-consult__audience">&ldquo;{CONSULTANT.audience}&rdquo;</p>
          <p class="flowsec-lede">{CONSULTANT.body}</p>
        </header>
        <ul class="pr-consult__points">
          {CONSULTANT.points.map((pt) => <li>{pt}</li>)}
        </ul>
        <div>
          <a class="btn2 btn2--primary" href={consultantMailto}>
            {CONSULTANT.ctaLabel}
            <span class="btn2-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="pr-consult__note">
          Consultant licensing is custom because commercial use, client workflows, support and Cedar
          calibration differ firm to firm. Standard customers keep the public plans above.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
