---
/**
 * /checkout — the payment step, and only the payment step. The plan
 * was chosen earlier (pricing, signup handoff or /choose-plan), so
 * this page performs one job: complete the subscription. Teal order
 * summary on the left, white transactional column on the right (the
 * third stage of the flow's teal progression; see flow.css).
 *
 * Routing rules enforced by the inline script:
 *   - no tier / unknown tier -> /choose-plan (nothing to pay for yet)
 *   - tier=free              -> /signup?tier=free (the free trial
 *     never passes through a payment page)
 *
 * The continue action posts to the upcoming Stripe integration's
 * endpoint (`POST /billing/checkout-session`, via lib/api.ts) and
 * redirects to the returned Stripe-hosted checkout URL. Until
 * PUBLIC_API_URL is set, the fallback captures the order intent
 * through the contact channel so no buyer is dropped.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Contours from '../components/Contours.astro';
import { PLANS } from '../data/pricing';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/auth.css';
import '../styles/flow.css';

/* What every plan includes; the differentiation the buyer is
   confirming, phrased the way pricing phrases it. */
const INCLUDED = [
  'Full Lumecon model',
  'Every supported U.S. geography',
  'Unlimited analysis',
  'Cedar included',
];
---

<BaseLayout
  title="Checkout | Lumecon"
  description="Complete your Lumecon subscription. Prices are annual and include taxes and fees."
  canonical="https://lumecon.ai/checkout"
  keywords="Lumecon checkout, Lumecon subscribe, economic impact analysis software pricing"
  cedar={false}
  noindex={true}
>
  <Nav />
  <main class="co2" id="top" tabindex="-1">
    <aside class="co2-summary tealfield tealfield--mark-left">
      <Contours />
      {
        PLANS.map((p) => (
          <div class="co2-summary__inner" data-co-summary={p.id} hidden>
            <p class="tealfield__kicker">Order summary</p>
            <p class="co2-summary__plan">{p.name}</p>
            <p class="co2-summary__users">{p.users}</p>
            <ul class="co2-summary__features">
              {INCLUDED.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <div class="co2-summary__due">
              <span class="co2-summary__due-label">Due today</span>
              <span class="co2-summary__due-value" data-co-total>
                {p.price}
              </span>
            </div>
            <p class="co2-summary__fine">
              Annual subscription. Taxes and fees included. Payment is processed by Stripe; Lumecon
              does not store card details.
            </p>
          </div>
        ))
      }
    </aside>

    <div class="co2-pay">
      <div class="co2-pay__inner">
        <p class="co2-kicker">Secure checkout</p>
        <h1 class="co2-title">Complete your subscription.</h1>
        <p class="co2-tagline">Everything you need to start measuring your impact is ready.</p>

        <form class="auth-form" data-co-form novalidate>
          <label class="auth-field">
            <span>Email for your receipt and account</span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              placeholder="you@organization.gov"
            />
          </label>

          <div class="auth-field">
            <span>Discount code</span>
            <div class="co-code">
              <input
                type="text"
                name="discountCode"
                autocomplete="off"
                autocapitalize="characters"
                placeholder="Optional"
              />
              <button type="button" class="co-code__apply" data-co-apply>Apply</button>
            </div>
            <p class="co-code__note" data-co-code-note hidden></p>
          </div>

          <p class="co2-paylabel">Payment</p>
          <p class="co2-paynote">
            Card, bank debit and invoicing options are presented on the next screen, hosted by
            Stripe.
          </p>

          <p class="auth-meta" data-auth-status role="status" aria-live="polite" hidden></p>

          <div class="auth-actions">
            <button type="submit" class="btn" data-co-submit>Complete purchase</button>
          </div>
        </form>

        <p class="co2-change">
          &larr; <a href="/choose-plan" data-co-change>Change plan</a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { submitCheckout, submitContact, apiConfigured } from '../lib/api';
  import { trackEvent, trackError } from '../lib/observability';

  const VALID_TIERS = ['starter', 'standard', 'leader'];

  function setStatus(el: HTMLElement | null, variant: 'ok' | 'err' | 'info', text: string): void {
    if (!el) return;
    el.textContent = text;
    el.hidden = false;
    el.classList.remove('auth-meta--ok', 'auth-meta--err');
    if (variant === 'ok') el.classList.add('auth-meta--ok');
    if (variant === 'err') el.classList.add('auth-meta--err');
  }

  function setup(): void {
    const form = document.querySelector<HTMLFormElement>('[data-co-form]');
    if (!form) return;

    const qs = new URLSearchParams(window.location.search);
    const tier = qs.get('tier') || '';
    const emailFromFlow = qs.get('email') || '';

    /* One job: payment. Anything that is not a payable plan gets
       routed to the step that handles it. */
    if (tier === 'free') {
      window.location.replace(
        `/signup?tier=free${emailFromFlow ? `&email=${encodeURIComponent(emailFromFlow)}` : ''}`,
      );
      return;
    }
    if (!VALID_TIERS.includes(tier)) {
      window.location.replace(
        `/choose-plan${emailFromFlow ? `?email=${encodeURIComponent(emailFromFlow)}` : ''}`,
      );
      return;
    }

    // Reveal the summary panel for the selected plan.
    document.querySelectorAll<HTMLElement>('[data-co-summary]').forEach((el) => {
      el.hidden = el.dataset.coSummary !== tier;
    });

    const status = form.querySelector<HTMLElement>('[data-auth-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-co-submit]');
    const codeInput = form.querySelector<HTMLInputElement>('input[name="discountCode"]');
    const codeNote = form.querySelector<HTMLElement>('[data-co-code-note]');
    const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
    if (emailInput && emailFromFlow) emailInput.value = emailFromFlow;

    // Keep the flow context on the quiet Change plan link.
    const changeLink = document.querySelector<HTMLAnchorElement>('[data-co-change]');
    if (changeLink && emailFromFlow)
      changeLink.href = `/choose-plan?email=${encodeURIComponent(emailFromFlow)}`;

    // The code itself is validated by the backend at payment time;
    // this control just confirms it will be carried through.
    form.querySelector('[data-co-apply]')?.addEventListener('click', () => {
      const code = codeInput?.value.trim().toUpperCase() ?? '';
      if (codeInput) codeInput.value = code;
      if (!codeNote) return;
      if (!code) {
        codeNote.hidden = true;
        return;
      }
      codeNote.textContent = `Code ${code} will be applied at payment.`;
      codeNote.hidden = false;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const discountCode = String(data.get('discountCode') ?? '')
        .trim()
        .toUpperCase();
      if (!email) return setStatus(status, 'err', 'Enter your email.');

      submitBtn?.setAttribute('disabled', 'true');
      setStatus(status, 'info', 'One moment...');

      try {
        if (apiConfigured()) {
          const res = await submitCheckout({
            tier,
            email,
            ...(discountCode ? { discountCode } : {}),
          });
          if (res.ok && res.data.url) {
            trackEvent('checkout.redirect', { tier, hasCode: Boolean(discountCode) });
            setStatus(status, 'ok', 'Taking you to secure payment...');
            window.location.href = res.data.url;
            return;
          }
          if (!res.ok && res.reason !== 'api-unconfigured') {
            trackEvent('checkout.fail', { tier, reason: res.reason });
            setStatus(
              status,
              'err',
              'We could not start the payment. Try again, or email contact@lumecon.ai.',
            );
            return;
          }
        }

        /* Payments not wired yet: capture the order intent. */
        const contactRes = await submitContact({
          name: 'Lumecon purchase request',
          email,
          message: `Purchase request via checkout. Plan: ${tier}. Discount code: ${discountCode || '(none)'}.`,
          source: 'checkout-page',
        });
        if (contactRes.ok) {
          setStatus(
            status,
            'ok',
            "Online payment is almost ready. We've got your order details and the team will complete your subscription by email, usually the same day.",
          );
          return;
        }
        const subject = encodeURIComponent('Lumecon subscription');
        const body = encodeURIComponent(
          `Hi Lumecon team,\n\nI'd like to subscribe.\n\nPlan: ${tier}\nEmail: ${email}\n${discountCode ? 'Discount code: ' + discountCode + '\n' : ''}`,
        );
        window.location.href = `mailto:contact@lumecon.ai?subject=${subject}&body=${body}`;
        setStatus(status, 'info', 'Opening your email client so you can reach us directly...');
      } catch (err: unknown) {
        trackError(err, { where: 'checkout.submit', tier });
        setStatus(
          status,
          'err',
          'Something went wrong on our end. Try again in a moment, or email contact@lumecon.ai.',
        );
      } finally {
        submitBtn?.removeAttribute('disabled');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
</script>
