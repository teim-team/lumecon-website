---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/footer.css';
import '../styles/legal.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  keywords: string;
  /** Additional schema objects (e.g. an FAQPage) appended to the defaults. */
  extraJsonLd?: object[];
}

const { title, description, canonical, keywords, extraJsonLd = [] } = Astro.props;

// Minimal but valid WebPage schema so legal pages aren't barren in
// structured-data audits. Tied to the homepage Organization @id.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    url: canonical,
    description,
    isPartOf: { '@id': `${site.url}#website` },
    publisher: { '@id': `${site.url}#org` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: title.split('|')[0].trim(), item: canonical },
    ],
  },
  ...extraJsonLd,
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords={keywords}
  jsonLd={jsonLd}
  bodyClass="legal-page"
>
  <Nav isHome={false} />
  <main id="top" tabindex="-1">
    <slot />
  </main>
  <Footer isHome={false} />

  <script>
    // The collapsible sections must not hide content from a printed
    // copy: open everything before print, restore the reader's state
    // after. (A closed <details> renders nothing on paper and CSS
    // alone cannot open it.)
    const opened: HTMLDetailsElement[] = [];
    window.addEventListener('beforeprint', () => {
      document
        .querySelectorAll<HTMLDetailsElement>('details.legal-sec:not([open])')
        .forEach((d) => {
          d.open = true;
          opened.push(d);
        });
    });
    window.addEventListener('afterprint', () => {
      opened.splice(0).forEach((d) => {
        d.open = false;
      });
    });
  </script>
</BaseLayout>
