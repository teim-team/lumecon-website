# No trailing slash: `node_modules/` matches directories only, so a symlink
# named node_modules slipped past it and was committed once (PR #349).
node_modules
dist/
.astro/

# Playwright + Lighthouse output
test-results/
playwright-report/
.lighthouseci/

# Local env (use .env.example as the template)
.env
.env.local
.env.*.local

# Raw Cedar Commons captures. `npm run shots:commons` writes the PNGs here
# and commits only the optimized webp files under public/app/.
.shots-commons/

# Python bytecode. `scripts/docs/methodology-questions-pdf.py` was replaced by
# an .mjs generator in 0b74694, but its compiled .pyc was committed by that
# same commit and outlived it. No .py file is tracked here any more.
__pycache__/
*.py[cod]
